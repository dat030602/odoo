<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="interest_rate_year_tree" model="ir.ui.view">
        <field name="name">interest.rate.year.tree</field>
        <field name="model">interest.rate.year</field>
        <field name="arch" type="xml">
            <tree create="1" edit="1" editable="bottom">
                <field name="year"/>
                <field name="type"/>
                <field name="rate"/>
                <field name="num_of_date"/>
            </tree>
        </field>
    </record>
    <record id="interest_rate_year_action" model="ir.actions.act_window">
        <field name="name">Lãi suất theo năm</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">interest.rate.year</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem id="interest_rate_year_tree_menu" name="Lãi suất theo năm" action="interest_rate_year_action"
                parent="account.account_invoicing_menu" sequence="50"/>
</odoo>
