<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="partner_debt_interest_form" model="ir.ui.view">
        <field name="name">partner.debt.interest.form</field>
        <field name="model">partner.debt.interest</field>
        <field name="arch" type="xml">
            <form>
            <header>
                <button name="action_confirm" string="Tổng hợp" type="object" class="btn-primary"/>
                <!-- <field name="state" widget="statusbar"/> -->
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_tree" type="object" icon="fa-globe icon">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Chi tiết</span>
                        </div>
                    </button>
                </div>

                <div class="oe_title">
                    <h1>
                        <field name="name" class="oe_inline"/>
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="partner_id" required="1" options="{'no_open': True, 'no_create': True}"/>
                        <field name="rate" required="1"/>
                        <field name="rate_penalty" required="1"/>
                        <field name="can_credit" force_save="1"/>
                        <field name="amount_paid"/>
                    </group>
                    <group>
                        <label for="date_from"/>
                        <div class="o_row">
                            <field name="date_from" required="1"/>
                            -
                            <field name="date_to" required="1"/>
                        </div>
                        <field name="currency_id" required="1" readonly="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Chi tiết" name="line1_ids">
                        <field name="line_ids">
                            <tree edit="1" create="0" editable="bottom">
                                <field name="interest_id" invisible="1"/>
                                <field name="partner_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="rate" invisible="1"/>
                                <field name="rate_penalty" invisible="1"/>
                                <field name="invoice_code"/>
                                <field name="move_id" invisible="0"/>
                                <field name="date"/>
                                <field name="type" invisible="1"/>
                                <field name="amount" sum="total_amount" invisible="1"/>
                                <field name="amount_buy" sum="total_amount_buy"/>
                                <field name="amount_pay" sum="total_amount_pay"/>
                                <field name="balance_amount" invisible="1"/>
                                <field name="balance_amount_debit"/>
                                <field name="balance_amount_credit"/>
                                <field name="payment_due_date"/>
                                <field name="interest_calc_date" invisible="1"/>
                                <field name="delay_days" sum="total_delay_days"/>
                                <field name="late_interest" sum="total_late_interest"/>
                                <field name="penalty_debt" sum="total_penalty_debt"/>
                                <field name="total_debt"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="activity_ids"/>
                <field name="message_ids"/>
            </div>
            </form>
        </field>
    </record>
    <record id="partner_debt_interest_tree" model="ir.ui.view">
        <field name="name">partner.debt.interest.tree</field>
        <field name="model">partner.debt.interest</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="currency_id"/>
                <field name="total_debt" sum="total_total_debt"/>
            </tree>
        </field>
    </record>
    <record id="partner_debt_interest_action" model="ir.actions.act_window">
        <field name="name">Lãi trả chậm</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">partner.debt.interest</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="partner_debt_interest_menu" name="Lãi trả chậm" action="partner_debt_interest_action"
                parent="account.menu_finance_entries_management" sequence="50"/>
</odoo>
