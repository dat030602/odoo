                    <div class="page-child-one">
                        <div class="row">
                            <div class="col-12 padding-left-row">
                                <span class="title-blue" style="margin-bottom: 0px; font-size: 18px;font-weight: bold;">Ngân Hàng TMCP Công Thương Việt Nam</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3">
                            </div>
                            <div class="col-6 text-center" style="position: relative;">
