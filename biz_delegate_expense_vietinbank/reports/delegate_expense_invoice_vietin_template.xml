                            <div class="col-6">
                            </div>
                            <div class="col-2">
                                <span class="title-vi">Số</span> No
                            </div>
                            <div class="col-1">
                            </div>
                            <div class="col-3">
                                <span class="title-vi">Ngày</span> Date <span t-esc="doc.date.strftime('%d/%m/%Y')"/>
                            </div>
                        </div>
                        <div class="row bg-row">
                            <div class="col-3 padding-left-row ">
                                <span class="title-blue">Ký hiệu </span>Invoice sign
                            </div>
                            <div class="col-2">
                                <span class="title-blue"> Số HĐ </span>Invoice No
                            </div>
                            <div class="col-3 text-center">
                                <!-- <span class="title-blue">Mẫu số</span> -->
                                <span class="title-blue">Mẫu số 01GTKT2/003</span>
                            </div>
                            <div class="col-3 text-right">
                                <span class="title-blue">Liên 1. Lưu </span>Copy 1, Bank's copy
                            </div>
                            <div class="col-1">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 padding-left-row ">
                                <span class="title-blue-one">Người/Đơn vị trả tiền </span>Applicant Name <b>Công ty TNHH Con Cò Vàng</b>
                            </div>
                        </div>
                        <div class="row">
                        <t t-set="number_bank" t-value="0"/>
                            <t t-set="number_bank" t-value="0"/>
                            <t t-set="name_bank" t-value="''"/>
                            <t t-foreach="doc.company_id.partner_id.bank_ids" t-as="bank">
                                <t t-if="bank.bank_id.bic == 'VietinBank'">
                                    <t t-set="number_bank" t-value="bank.acc_number"/>
                                    <t t-set="name_bank" t-value="bank.bank_id.name"/>
                                    <t t-break="true"/>
                                </t>
                            </t>
