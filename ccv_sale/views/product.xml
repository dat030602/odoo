<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_product_tree_inherit" model="ir.ui.view">
        <field name="name">product.product.tree.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']" position="after">
                <field name="qty_ordered" readonly="1" optional="show"/>
                <field name="qty_order_delivered" readonly="1" optional="show"/>
                <field name="qty_can_order" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
