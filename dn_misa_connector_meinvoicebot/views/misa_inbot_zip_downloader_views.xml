<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_misa_inbot_zip_downloader_tree" model="ir.ui.view">
        <field name="name">misa.inbot.zip.downloader.list</field>
        <field name="model">misa.inbot.zip.downloader</field>
        <field name="arch" type="xml">
            <list string="ZIP Download Tasks" decoration-info="state in ('draft', 'scheduled')" decoration-warning="state == 'downloading'" decoration-success="state == 'done'" decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="download_key"/>
                <field name="file_type"/>
                <field name="invoice_count"/>
                <field name="scheduled_time"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_misa_inbot_zip_downloader_form" model="ir.ui.view">
        <field name="name">misa.inbot.zip.downloader.form</field>
        <field name="model">misa.inbot.zip.downloader</field>
        <field name="arch" type="xml">
            <form string="ZIP Download Task">
                <header>
                    <button name="action_request_zip_key" string="Request Download Key" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_download_and_extract_zip" string="Download &amp; Extract ZIP Now" type="object" class="btn-primary" invisible="state not in ('scheduled', 'failed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,downloading,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Task Title"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="file_type"/>
                            <field name="is_inbot"/>
                            <field name="subscriber_id"/>
                            <field name="org_id"/>
                        </group>
                        <group string="Execution Info">
                            <field name="download_key" readonly="1"/>
                            <field name="invoice_count"/>
                            <field name="scheduled_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice IDs" name="invoices">
                            <field name="invoice_ids" placeholder="e.g. [&quot;inv_id_1&quot;, &quot;inv_id_2&quot;]"/>
                        </page>
                        <page string="Error / Log" name="error" invisible="not error_message">
                            <field name="error_message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_misa_inbot_zip_downloader" model="ir.actions.act_window">
        <field name="name">ZIP Download Tasks</field>
        <field name="res_model">misa.inbot.zip.downloader</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_misa_inbot_zip_downloader"
              name="ZIP Downloads"
              parent="menu_misa_inbot_root"
              action="action_misa_inbot_zip_downloader"
              sequence="40"/>
</odoo>
