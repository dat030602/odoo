<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_misa_inbot_document_tree" model="ir.ui.view">
        <field name="name">misa.inbot.document.list</field>
        <field name="model">misa.inbot.document</field>
        <field name="arch" type="xml">
            <list string="MISA INBOT Documents" decoration-info="t_thai_xu_ly == '0'" decoration-success="t_thai_xu_ly in ('3', '4')" decoration-danger="seller_risk_status in ('2', '4')">
                <field name="invoice_date"/>
                <field name="series"/>
                <field name="invoice_no"/>
                <field name="seller_name" invisible="not is_inbot"/>
                <field name="seller_tax_code" invisible="not is_inbot"/>
                <field name="buyer_name" invisible="is_inbot"/>
                <field name="buyer_tax_code" invisible="is_inbot"/>
                <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="seller_risk_status" widget="badge" decoration-danger="seller_risk_status in ('2', '4')" decoration-success="seller_risk_status == '1'"/>
                <field name="tinh_chat"/>
                <field name="t_thai_xu_ly" widget="badge" decoration-info="t_thai_xu_ly == '0'" decoration-success="t_thai_xu_ly in ('3', '4')"/>
                <field name="move_id"/>
                <field name="is_inbot" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_misa_inbot_document_form" model="ir.ui.view">
        <field name="name">misa.inbot.document.form</field>
        <field name="model">misa.inbot.document</field>
        <field name="arch" type="xml">
            <form string="MISA INBOT Document">
                <header>
                    <button name="action_create_account_move" string="Create Vendor Bill" type="object" class="oe_highlight" invisible="move_id or not is_inbot or seller_risk_status in ('2', '4')"/>
                    <button name="action_sync_accounting_date" string="Sync Accounting Date" type="object" invisible="not move_id"/>
                    <button name="action_sync_payment_status" string="Sync Payment Status" type="object" invisible="not move_id"/>
                    <field name="t_thai_xu_ly" widget="statusbar" statusbar_visible="0,1,3,4"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(account.action_move_in_invoice_type)d" type="action" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Account Move</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Document Title"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic &amp; System Info">
                            <field name="is_inbot"/>
                            <field name="source_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="move_id"/>
                            <field name="trans_id"/>
                            <field name="invoice_id"/>
                        </group>
                        <group string="Template &amp; Invoice Info">
                            <field name="template_no"/>
                            <field name="series"/>
                            <field name="invoice_no"/>
                            <field name="invoice_date"/>
                            <field name="issue_date"/>
                            <field name="mccqt"/>
                            <field name="payment_method"/>
                        </group>
                    </group>
                    <group>
                        <group string="Seller Information">
                            <field name="seller_tax_code"/>
                            <field name="seller_name"/>
                            <field name="seller_address"/>
                            <field name="seller_msdvcqhvns"/>
                        </group>
                        <group string="Buyer Information">
                            <field name="buyer_tax_code"/>
                            <field name="buyer_name"/>
                            <field name="buyer_address"/>
                            <field name="buyer_msdvcqhvns"/>
                            <field name="buyer_no_citizen_identity_card"/>
                            <field name="buyer_passport_number"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail Items" name="items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="line_number"/>
                                    <field name="item_name"/>
                                    <field name="unit_name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="amount_without_vat"/>
                                    <field name="vat_rate"/>
                                    <field name="vat_amount"/>
                                    <field name="discount_amount"/>
                                    <field name="amount"/>
                                    <field name="kind"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="currency_id" invisible="1"/>
                                <field name="total_amount_without_vat" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="total_vat_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="total_discount_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="total_tax_reduction_amount43" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="total_amount"/>
                                </div>
                                <field name="total_amount" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </page>
                        <page string="Tax &amp; Risk Compliance (CheckingResult)" name="compliance">
                            <group>
                                <group string="Risk Assessment">
                                    <field name="seller_risk_status" widget="radio"/>
                                    <field name="seller_status"/>
                                    <field name="buyer_status"/>
                                </group>
                                <group string="Signatures &amp; CQT">
                                    <field name="published_invoice_status"/>
                                    <field name="seller_signature_status"/>
                                    <field name="taxation_signature"/>
                                    <field name="tinh_chat"/>
                                    <field name="t_thai_hdon"/>
                                </group>
                            </group>
                        </page>
                        <page string="Decree 70 (NĐ70)" name="decree70">
                            <group>
                                <group string="Transport &amp; Location">
                                    <field name="license_plate"/>
                                    <field name="from_location"/>
                                    <field name="destination"/>
                                    <field name="number_agreement"/>
                                    <field name="agreement_date"/>
                                </group>
                                <group string="Decree 70 Flags">
                                    <field name="is_receipt_decree70"/>
                                    <field name="is_discount_decree70"/>
                                </group>
                            </group>
                        </page>
                        <page string="Related Invoices &amp; Fees" name="related_and_fees">
                            <group string="Related Invoices (InfoND123 / Replacement / Adjustment)">
                                <field name="related_line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="rel_template_no"/>
                                        <field name="rel_series"/>
                                        <field name="rel_invoice_no"/>
                                        <field name="rel_invoice_date"/>
                                        <field name="related_type"/>
                                        <field name="original_inbot_id"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Fees">
                                <field name="fee_line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="fee_name"/>
                                        <field name="fee_amount"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Raw Files &amp; Technical" name="files">
                            <group>
                                <group string="Attached Files">
                                    <field name="xml_filename" invisible="1"/>
                                    <field name="xml_file" filename="xml_filename"/>
                                    <field name="pdf_filename" invisible="1"/>
                                    <field name="pdf_file" filename="pdf_filename"/>
                                </group>
                                <group string="Technical IDs">
                                    <field name="subscriber_id"/>
                                    <field name="org_id"/>
                                    <field name="ccy_code"/>
                                    <field name="exchange_rate"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_misa_inbot_document_search" model="ir.ui.view">
        <field name="name">misa.inbot.document.search</field>
        <field name="model">misa.inbot.document</field>
        <field name="arch" type="xml">
            <search string="Search INBOT Documents">
                <field name="name"/>
                <field name="invoice_no"/>
                <field name="series"/>
                <field name="seller_name"/>
                <field name="seller_tax_code"/>
                <field name="buyer_name"/>
                <field name="buyer_tax_code"/>
                <separator/>
                <filter string="Inbound (Vendor)" name="inbound" domain="[('is_inbot', '=', True)]"/>
                <filter string="Outbound (Customer)" name="outbound" domain="[('is_inbot', '=', False)]"/>
                <separator/>
                <filter string="High Risk" name="high_risk" domain="[('seller_risk_status', 'in', ('2', '4'))]"/>
                <filter string="Unprocessed" name="unprocessed" domain="[('t_thai_xu_ly', '=', '0')]"/>
                <filter string="Linked to Move" name="linked_move" domain="[('move_id', '!=', False)]"/>
                <filter string="Not Linked to Move" name="not_linked_move" domain="[('move_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Seller" name="group_by_seller" context="{'group_by': 'seller_name'}"/>
                    <filter string="Invoice Date" name="group_by_date" context="{'group_by': 'invoice_date'}"/>
                    <filter string="Processing Status" name="group_by_status" context="{'group_by': 't_thai_xu_ly'}"/>
                    <filter string="Risk Status" name="group_by_risk" context="{'group_by': 'seller_risk_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions & Menus -->
    <record id="action_misa_inbot_document_inbound" model="ir.actions.act_window">
        <field name="name">Inbound Invoices (Đầu vào)</field>
        <field name="res_model">misa.inbot.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_inbot', '=', True)]</field>
        <field name="context">{'default_is_inbot': True}</field>
    </record>

    <record id="action_misa_inbot_document_outbound" model="ir.actions.act_window">
        <field name="name">Outbound Invoices (Đầu ra INBOT)</field>
        <field name="res_model">misa.inbot.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_inbot', '=', False)]</field>
        <field name="context">{'default_is_inbot': False}</field>
    </record>

    <!-- Top-level Menu under Accounting -->
    <menuitem id="menu_misa_inbot_root"
              name="MISA INBOT"
              parent="account.menu_finance"
              sequence="35"/>

    <menuitem id="menu_misa_inbot_inbound"
              name="Inbound Invoices (Đầu vào)"
              parent="menu_misa_inbot_root"
              action="action_misa_inbot_document_inbound"
              sequence="10"/>

    <menuitem id="menu_misa_inbot_outbound"
              name="Outbound Invoices (Đầu ra)"
              parent="menu_misa_inbot_root"
              action="action_misa_inbot_document_outbound"
              sequence="20"/>

    <menuitem id="menu_misa_inbot_sync"
              name="Synchronize Invoices"
              parent="menu_misa_inbot_root"
              action="action_misa_inbot_sync_wizard"
              sequence="30"/>
</odoo>
