<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_misa_inbot_document_line_tree" model="ir.ui.view">
        <field name="name">misa.inbot.document.line.list</field>
        <field name="model">misa.inbot.document.line</field>
        <field name="arch" type="xml">
            <list string="INBOT Document Lines" create="false">
                <field name="document_id"/>
                <field name="line_number"/>
                <field name="item_name"/>
                <field name="quantity"/>
                <field name="unit_name"/>
                <field name="unit_price"/>
                <field name="vat_rate"/>
                <field name="vat_amount"/>
                <field name="discount_amount"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="view_misa_inbot_document_line_form" model="ir.ui.view">
        <field name="name">misa.inbot.document.line.form</field>
        <field name="model">misa.inbot.document.line</field>
        <field name="arch" type="xml">
            <form string="INBOT Document Line">
                <sheet>
                    <group>
                        <group string="Basic Information">
                            <field name="document_id"/>
                            <field name="line_number"/>
                            <field name="item_id"/>
                            <field name="item_name"/>
                            <field name="unit_name"/>
                            <field name="kind"/>
                        </group>
                        <group string="Pricing &amp; Tax">
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount_without_vat"/>
                            <field name="vat_rate"/>
                            <field name="vat_amount"/>
                            <field name="discount_amount"/>
                            <field name="amount"/>
                        </group>
                    </group>
                    <group string="Decree 70 (Vehicle &amp; Logistics)">
                        <group>
                            <field name="specific_product_type"/>
                            <field name="vehicle_frame_number"/>
                            <field name="vehicle_engine_number"/>
                            <field name="transport_license_plate"/>
                        </group>
                        <group>
                            <field name="shipper_name"/>
                            <field name="shipper_address"/>
                            <field name="shipper_tax_code"/>
                            <field name="shipper_identifier"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
