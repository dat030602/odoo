<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_vnpay" model="ir.ui.view">
        <field name="name">payment.provider.form.vnpay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group string="VNPay Credentials" invisible="code != 'vnpay'">
                    <field name="vnpay_tmn_code" required="code == 'vnpay' and state != 'disabled'"/>
                    <field name="vnpay_hash_secret" password="True" required="code == 'vnpay' and state != 'disabled'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
