<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- mrp.production inherit form view -->
    <record id="stock_warehouse_orderpoint_inherit_view_form" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.inherit.view.form</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_to_order']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='qty_to_order']" position="after">
                <field name="qty_to_check" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="stock_warehouse_orderpoint_inherit_view_search" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.inherit.view.search</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.warehouse_orderpoint_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Cảnh báo tồn kho" name="qty_to_check" domain="[('qty_to_check','!=',0)]"/>
            </xpath>
        </field>
    </record>
</odoo>
