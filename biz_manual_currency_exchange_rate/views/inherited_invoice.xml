<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_extends_add_manual_currency_exchange_rate" model="ir.ui.view">
            <field name="name">view.move.form.extends.add.manual.currency.exchange.rate</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="invoice_date" position="after">
                    <field name="active_manual_currency_rate" attrs="{'invisible': 1}"/>
                    <field name="apply_manual_currency_exchange" attrs="{'invisible': [('active_manual_currency_rate', '=', False)]}"/>
                    <!-- <field name="apply_manual_currency_exchange" invisible="active_manual_currency_rate == False"/> -->
                    <field name="is_invisible" attrs="{'invisible': True}"/>
                    <field name="manual_currency_exchange_rate" attrs="{'invisible': ['|','|',('apply_manual_currency_exchange', '=', False),('active_manual_currency_rate', '=', False),('is_invisible', '=', True)],'required':[('apply_manual_currency_exchange', '=', True)]}"/>
                    <!-- <field name="manual_currency_exchange_rate" invisible="apply_manual_currency_exchange == False or active_manual_currency_rate == False" required="apply_manual_currency_exchange == True"/> -->
                    <field name="inverse_manural_currency_exchange_rate" attrs="{'invisible': ['|',('apply_manual_currency_exchange', '=', False),('active_manual_currency_rate', '=', False)],'required':[('apply_manual_currency_exchange', '=', True)]}"/>
                </field>
            </field>
        </record>

        <record model="ir.actions.server" id="action_update_old_payment">
            <field name="name">Update Old Payment</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
    if records:
        action = records.update_old_payment()
            </field>
        </record>
        
        <record model="ir.actions.server" id="action_update_manual_exchange_rate_old_account_move">
            <field name="name">Update Exchange Rate (Manual)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.update_exchange_rate_old_account_move()
            </field>
        </record>
    </data>
</odoo>