<?xml version="1.0" ?>
<odoo>
    <data>
        <!-- CRM => Menu Bán hàng => Khách hàng -->
        <record id="base.action_partner_form" model="ir.actions.act_window">
            <field name="view_mode">tree,kanban,form</field>
        </record>

        <record id="base.action_partner_tree_view1" model="ir.actions.act_window.view">
            <field name="sequence" eval="0"/>
        </record>

        <record id="base.action_partner_form_view1" model="ir.actions.act_window.view">
            <field eval="1" name="sequence"/>
        </record>

        <record id="base.action_partner_form_view2" model="ir.actions.act_window.view">
            <field eval="2" name="sequence"/>
        </record>
        <!-- Bán hàng => Menu Đơn hàng => Khách hàng -->
        <!-- Kế toán => Menu Khách hàng => Khách hàng -->
        <record id="account.res_partner_action_customer" model="ir.actions.act_window">
            <field name="view_mode">tree,kanban,form</field>
        </record>

        <!-- Kế toán => Menu Nhà cung cấp => Nhà cung cấp -->
        <!-- Mua hàng => Menu Đơn hàng => Nhà cung cấp -->

        <record id="account.res_partner_action_supplier" model="ir.actions.act_window">
            <field name="view_mode">tree,kanban,form</field>
        </record>
    </data>
</odoo>
