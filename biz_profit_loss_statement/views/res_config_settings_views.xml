<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_profit_loss_statement" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.profit.loss.statement</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='fiscal_localization_setting_container']//div[@class='content-group']" position="after">
                <div class="content-group">
                    <div class="row mt16">
                        <button name="update_profit_loss_statement" string="Update Data profit loss statement" type="object"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>