<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

        <record id="paperformat_report_business_pdf" model="report.paperformat">
            <field name="name">Plan Month A4</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">1</field>
            <field name="margin_right">1</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">25</field>
            <field name="dpi">90</field>
        </record>
            
         <record id="action_report_business_pdf" model="ir.actions.report">
            <field name="name">PDF print publishing</field>
            <field name="model">business.activities.results</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">biz_profit_loss_statement.report_business_pdf</field>
            <field name="report_file">biz_profit_loss_statement.report_business_pdf</field>
            <field name="print_report_name">"Template B02 - Profit loss statement"</field>
            <field name="binding_model_id" ref="model_business_activities_results"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_report_business_pdf"/>
        </record>

        <record id="action_report_business_xlsx" model="ir.actions.report">
            <field name="name">Excel print publishing</field>
            <field name="model">business.activities.results</field>
            <field name="report_type">xlsx</field>
            <field name="report_name">biz_profit_loss_statement.report_business_xlsx</field>
            <field name="report_file">biz_profit_loss_statement.report_business_xlsx</field>
            <field name="print_report_name">"Template B02 - Profit loss statement"</field>
            <field name="binding_model_id" ref="model_business_activities_results"/>
            <field name="binding_type">report</field>
            <field name="attachment_use">False</field>
        </record>
		
	</data>
</odoo>