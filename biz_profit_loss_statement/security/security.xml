<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="business_activities_config_comp_rule" model="ir.rule">
            <field name="name">Business activities config multi company rule</field>
            <field name="model_id" ref="model_business_activities_config"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

        <record id="business_activities_results_comp_rule" model="ir.rule">
            <field name="name">Business activities results multi company rule</field>
            <field name="model_id" ref="model_business_activities_results"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>