<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- có thể chạy nhiều báo cáo pdf-->
        <template id="bao_cao_so_du_ngan_hang_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="ccv_sql.bao_cao_so_du_ngan_hang_document"
                       t-lang="doc.user_id.partner_id.lang"/>
                </t>
            </t>
        </template>

        <!-- body của báo cáo-->
        <template id="bao_cao_so_du_ngan_hang_document">
            <t t-call="ccv_sql.ccv_header">
                <div class="page" style="font-size: 12px;font-family: Times New Roman">
                    <div class="col-xs-12" style="text-align: center; font-size: 20px;">
                        <strong><t t-esc="doc.name"/></strong>
                    </div>
                    <div class="col-xs-12" style="text-align: center; margin-top: 10px;">
                        <strong>Tài khoản 112; Loại tiền: Tổng hợp; Ngày: &amp;nbsp;<t t-esc="doc.convert_print(doc.date_to)"/>
                        </strong>
                    </div>
                    <div class="row">
                        <table class="table table-sm" style="border: solid 1px;width: 100%; margin-top: 10px;">
                                <tr>
                                    <td style="text-align: center; vertical-align: middle;"><strong>STT</strong>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;"><strong>Tài khoản ngân hàng</strong>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;"><strong>Tên ngân hàng</strong>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;"><strong>Chi nhánh</strong>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;"><strong>Số dư nợ cuối kỳ nguyên tệ (USD)</strong>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;"><strong>Số dư cuối kỳ (VND)</strong>
                                    </td>
                                </tr>
                            <t t-set="number" t-value="0"/>
                            <t t-foreach="doc.line6_ids.filtered(lambda x: x.end_debit > 0)" t-as="line">
                                <t t-set="number" t-value="number + 1"/>
                                <tr>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span style="text-align: center; vertical-align: middle;" t-esc="number"/>
                                    </td>
                                    <td style="text-align: left; vertical-align: middle;">
                                        <span t-esc="line.number_bank"/>
                                    </td>
                                    <td style="text-align: left; vertical-align: middle">
                                        <span t-esc="line.name_bank"/>
                                    </td>
                                    <td style="text-align: left; vertical-align: middle">
                                        <span t-esc="line.branch_bank"/>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.account_id.currency_id.id == 2">
                                            <span t-esc="doc.convert_usd(line.end_debit)"/>
                                        </t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <span t-esc="doc.convert_vnd(line.total)"/>
                                    </td>
                                </tr>
                            </t><!--end for-->
                            <tr>
                                <td colspan="4" style="text-align: left;">
                                    <strong>Tổng cộng</strong>
                                </td>
                                <td style="text-align: right;">
                                    <strong><span t-esc="doc.convert_usd(sum(doc.line6_ids.filtered(lambda l:l.account_id.currency_id.id == 2).mapped('end_debit')))"/></strong>
                                </td>
                                <td style="text-align: right;">
                                    <strong><span t-esc="doc.convert_vnd(sum(doc.line6_ids.mapped('total')))"/></strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </template>

        <record id="bao_cao_so_du_ngan_hang_report" model="ir.actions.report">
            <field name="name">Báo cáo số dư ngân hàng</field>
            <field name="model">alpha.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ccv_sql.bao_cao_so_du_ngan_hang_template</field>
            <field name="report_file">ccv_sql.bao_cao_so_du_ngan_hang_template</field>
            <field name="paperformat_id" ref="ccv_sql.format_a4"/>
            <field name="print_report_name">'Báo cáo số dư ngân hàng'</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>