        <record id="giay_bao_no_report" model="ir.actions.report">
            <field name="name">Giấy Báo Nợ</field>
            <field name="model">account.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ccv_sql.giay_bao_no_template</field>
            <field name="report_file">ccv_sql.giay_bao_no_template</field>
            <field name="paperformat_id" ref="ccv_sql.format_a4"/>
            <field name="print_report_name">'Giấy Báo Nợ'</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>