<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- có thể chạy nhiều báo cáo pdf-->
        <template id="danh_sach_chi_tiet_von_tu_co_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="ccv_sql.danh_sach_chi_tiet_von_tu_co_document"
                       t-lang="doc.user_id.partner_id.lang"/>
                </t>
            </t>
        </template>

        <!-- body của báo cáo-->
        <template id="danh_sach_chi_tiet_von_tu_co_document">
            <t t-call="ccv_sql.ccv_header">
                <div class="page" style="font-size: 10px;font-family: Times New Roman">
                    <div class="col-xs-12" style="text-align: center; font-size: 20px;">
                        <strong><t t-esc="doc.name"/></strong>
                    </div>
                    <div class="col-xs-12" style="text-align: center; margin-top: 10px;">
                        <strong>Ngày: <t t-esc="doc.convert_print(doc.date_to)"/>
                        </strong>
                    </div>
                    <div class="row">
                        <table class="table table-sm" style="border: solid 1px;width: 100%; margin-top: 10px;">
                                <tr>
                                    <td style="text-align: center; vertical-align: middle;"><strong>STT</strong>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;"><strong>Số chứng từ</strong>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;"><strong>Ngày hạch toán</strong>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;"><strong>Ngày chứng từ</strong>
                                    </td>
                                    <td style="text-align: left; vertical-align: middle;"><strong>Diễn giải</strong>
                                    </td>
                                    <td style="text-align: left; vertical-align: middle;"><strong>Số tiền</strong>
                                    </td>
                                    <td style="text-align: left; vertical-align: middle;"><strong>Đối tượng</strong>
                                    </td>
                                </tr>
                            <t t-set="number" t-value="0"/>
                            <t t-foreach="doc.line7_ids" t-as="line">
                                <t t-set="number" t-value="number + 1"/>
                                <tr>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span style="text-align: center; vertical-align: middle;" t-esc="number"/>
                                    </td>
                                    <td style="text-align: left; vertical-align: middle;">
                                        <span t-esc="line.move_id.name"/>
                                    </td>
                                    <td style="text-align: left; vertical-align: middle">
                                        <span t-esc="doc.convert_print(line.invoice_date)"/>
                                    </td>
                                    <td style="text-align: left; vertical-align: middle">
                                        <span t-esc="doc.convert_print(line.date)"/>
                                    </td>
                                    <td style="text-align: left; vertical-align: middle">
                                        <span t-esc="line.note"/>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle">
                                        <span t-esc="doc.convert_vnd(line.amount)"/>
                                    </td>
                                    <td style="text-align: left; vertical-align: middle;">
                                        <span t-esc="line.partner_id.name"/>
                                    </td>
                                </tr>
                            </t><!--end for-->
                            <tr>
                                <td colspan="5" style="text-align: left;">
                                    <strong>Tổng cộng</strong>
                                </td>
                                <td style="text-align: right;">
                                    <strong><span t-esc="doc.convert_vnd(sum(doc.line7_ids.mapped('amount')))"/></strong>
                                </td>
                                <td style="text-align: right;">

                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
        </template>

        <record id="danh_sach_chi_tiet_von_tu_co_report" model="ir.actions.report">
            <field name="name">Danh sách chi tiết vốn tự có</field>
            <field name="model">alpha.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ccv_sql.danh_sach_chi_tiet_von_tu_co_template</field>
            <field name="report_file">ccv_sql.danh_sach_chi_tiet_von_tu_co_template</field>
            <field name="paperformat_id" ref="ccv_sql.format_a4"/>
            <field name="print_report_name">'Danh sách chi tiết vốn tự có'</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>