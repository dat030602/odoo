<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- có thể chạy nhiều báo cáo pdf-->
        <template id="chi_tiet_cong_no_phai_thu_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="ccv_sql.chi_tiet_cong_no_phai_thu_document"
                       t-lang="doc.user_id.partner_id.lang"/>
                </t>
            </t>
        </template>

        <!-- body của báo cáo-->
        <template id="chi_tiet_cong_no_phai_thu_document">
            <t t-call="ccv_sql.ccv_header">
                <div class="page" style="font-size: 14px;font-family: Times New Roman">
                    <t t-set="is_many" t-value="doc.partner_state in ('0','2')"/>
                    <div class="col-xs-12" style="text-align: center; font-size: 20px;">
                        <strong><t t-esc="doc.name.upper() if doc.name else ''"/></strong>
                    </div>
                    <div class="col-xs-12" style="text-align: center; margin-top: 10px;">
                        <strong>
                            Từ ngày &amp;nbsp;<t t-esc="doc.convert_print(doc.date_from)"/>&amp;nbsp; đến ngày &amp;nbsp;
                            <t t-esc="doc.convert_print(doc.date_to)"/>
                        </strong>
                    </div>
                    <div class="row">
                        <table class="table table-sm fixed" style="border: solid 1px;width: 100%; margin-top: 10px;">
                            <col width="5%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="25%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <tr>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>STT</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Ngày chứng từ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Số chứng từ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Số hóa đơn</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Diễn giải</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>TK đối ứng</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>ĐVT</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Số lượng</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Đơn giá</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" colspan="2">
                                    <strong>Phát sinh</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" colspan="2">
                                    <strong>Số dư</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Mã hàng</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Mã đơn hàng</strong>
                                </td>
                            </tr>
                            <tr>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Nợ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Có</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Nợ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Có</strong>
                                </td>
                            </tr>


                            <t t-set="total_last_end_debit" t-value="0"/>
                            <t t-set="total_last_end_credit" t-value="0"/>
                            <t t-set="total_last_end_debit" t-value="0"/>
                            <t t-set="total_last_end_credit" t-value="0"/>
                            <!-- Lặp qua các đội bán hàng (team) -->
                            <t t-foreach="doc.line3_ids.mapped('team_id') or [None]" t-as="team_id">
                                <tr t-if="team_id" style="background-color: #f2f2f2;">
                                    <td colspan="15" style="text-align: left;">
                                        <strong>Đội bán hàng: <span t-esc="team_id.name"/></strong>
                                    </td>
                                </tr>

                                <t t-set="team_product_qty" t-value="0"/>
                                <t t-set="team_debit" t-value="0"/>
                                <t t-set="team_credit" t-value="0"/>
                                <t t-set="team_end_debit" t-value="0"/>
                                <t t-set="team_end_credit" t-value="0"/>

                                <!-- Lặp qua các khách hàng của team đó -->
                                <t t-set="partner_lines_all" t-value="doc.line3_ids.filtered(lambda l: l.team_id.id == (team_id.id if team_id else False))"/>
                                <t t-foreach="partner_lines_all.mapped('partner_id')" t-as="partner_id">
                                    <t t-set="number" t-value="0"/>
                                    <tr t-if="is_many">
                                        <td colspan="15" style="text-align: left; background-color: #fafafa;">
                                            &amp;nbsp;&amp;nbsp;&amp;nbsp;<strong><span t-esc="partner_id.display_name"/></strong>
                                        </td>
                                    </tr>
                                    <t t-foreach="partner_lines_all.filtered(lambda l:l.partner_id.id == partner_id.id)" t-as="line">
                                        <t t-set="number" t-value="number + 1"/>
                                        <tr>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span style="text-align: center; vertical-align: middle;" t-esc="number"/>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span t-esc="doc.convert_print(line.date)"/>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;color:blue">
                                                <span t-esc="line.move_id.name"/>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span t-esc="line.reference"/>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span t-esc="line.note"/>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span t-esc="line.account_dest_id.code"/>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <span t-esc="line.uom_id.name"/>
                                            </td>
                                            <td style="text-align: right; vertical-align: middle;">
                                                <t t-if="line.product_uom_qty > 0">
                                                    <span t-esc="doc.convert_number(line.product_uom_qty)"/>
                                                </t>
                                            </td>
                                            <td style="text-align: right; vertical-align: middle;">
                                                <t t-if="line.price_unit > 0">
                                                    <span t-esc="doc.convert_vnd(line.price_unit)"/>
                                                </t>
                                            </td>
                                            <td style="text-align: right; vertical-align: middle;">
                                                <t t-if="line.debit > 0">
                                                    <span t-esc="doc.convert_vnd(line.debit)"/>
                                                </t>
                                            </td>
                                            <td style="text-align: right; vertical-align: middle;">
                                                <t t-if="line.credit > 0">
                                                    <span t-esc="doc.convert_vnd(line.credit)"/>
                                                </t>
                                            </td>
                                            <td style="text-align: right; vertical-align: middle;">
                                                <t t-if="line.end_debit > 0">
                                                    <span t-esc="doc.convert_vnd(line.end_debit)"/>
                                                </t>
                                            </td>
                                            <td style="text-align: right; vertical-align: middle;">
                                                <t t-if="line.end_credit > 0">
                                                    <span t-esc="doc.convert_vnd(line.end_credit)"/>
                                                </t>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <t t-if="line.product_id">
                                                    <span t-esc="line.product_id.default_code"/>
                                                </t>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <t t-if="line.order_id">
                                                    <span t-esc="line.order_id.name"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </t><!--end for lines-->

                                    <t t-set="partner_lines" t-value="partner_lines_all.filtered(lambda l:l.partner_id.id == partner_id.id)"/>
                                    <t t-set="last_end_debit" t-value="partner_lines[-1].end_debit if partner_lines else 0"/>
                                    <t t-set="last_end_credit" t-value="partner_lines[-1].end_credit if partner_lines else 0"/>
                                    <t t-set="total_last_end_debit" t-value="total_last_end_debit + last_end_debit"/>
                                    <t t-set="total_last_end_credit" t-value="total_last_end_credit + last_end_credit"/>

                                    <t t-set="p_debit" t-value="sum(partner_lines.mapped('debit'))"/>
                                    <t t-set="p_credit" t-value="sum(partner_lines.mapped('credit'))"/>
                                    <t t-set="p_qty" t-value="sum(partner_lines.mapped('product_uom_qty'))"/>

                                    <t t-set="team_product_qty" t-value="team_product_qty + p_qty"/>
                                    <t t-set="team_debit" t-value="team_debit + p_debit"/>
                                    <t t-set="team_credit" t-value="team_credit + p_credit"/>
                                    <t t-set="team_end_debit" t-value="team_end_debit + last_end_debit"/>
                                    <t t-set="team_end_credit" t-value="team_end_credit + last_end_credit"/>

                                    <tr t-if="is_many">
                                        <td colspan="7" style="text-align: left;">
                                            <strong t-esc="'Tổng cộng khách hàng: ' + partner_id.display_name"></strong>
                                        </td>
                                        <td style="text-align: right;">
                                            <t t-if="p_qty > 0">
                                                <strong><span t-esc="doc.convert_number(p_qty)"/></strong>
                                            </t>
                                        </td>
                                        <td style="text-align: right;"></td>
                                        <td style="text-align: right;">
                                            <t t-if="p_debit > 0">
                                                <strong><span t-esc="doc.convert_vnd(p_debit)"/></strong>
                                            </t>
                                        </td>
                                        <td style="text-align: right;">
                                            <t t-if="p_credit > 0">
                                                <strong><span t-esc="doc.convert_vnd(p_credit)"/></strong>
                                            </t>
                                        </td>
                                        <td style="text-align: right;">
                                            <t t-if="last_end_debit > 0">
                                                <strong><span t-esc="doc.convert_vnd(last_end_debit)"/></strong>
                                            </t>
                                        </td>
                                        <td style="text-align: right;">
                                            <t t-if="last_end_credit > 0">
                                                <strong><span t-esc="doc.convert_vnd(last_end_credit)"/></strong>
                                            </t>
                                        </td>
                                        <td style="text-align: right;"></td>
                                        <td style="text-align: right;"></td>
                                    </tr>
                                </t><!--end for partner-->

                                <!-- Dòng tổng khu vực -->
                                <tr t-if="team_id" style="background-color: #dce6f1;">
                                    <td colspan="7" style="text-align: left;">
                                        <strong>Tổng khu vực: <span t-esc="team_id.name"/></strong>
                                    </td>
                                    <td style="text-align: right;">
                                        <t t-if="team_product_qty > 0">
                                            <strong><span t-esc="doc.convert_number(team_product_qty)"/></strong>
                                        </t>
                                    </td>
                                    <td style="text-align: right;"></td>
                                    <td style="text-align: right;">
                                        <t t-if="team_debit > 0">
                                            <strong><span t-esc="doc.convert_vnd(team_debit)"/></strong>
                                        </t>
                                    </td>
                                    <td style="text-align: right;">
                                        <t t-if="team_credit > 0">
                                            <strong><span t-esc="doc.convert_vnd(team_credit)"/></strong>
                                        </t>
                                    </td>
                                    <td style="text-align: right;">
                                        <t t-if="team_end_debit > 0">
                                            <strong><span t-esc="doc.convert_vnd(team_end_debit)"/></strong>
                                        </t>
                                    </td>
                                    <td style="text-align: right;">
                                        <t t-if="team_end_credit > 0">
                                            <strong><span t-esc="doc.convert_vnd(team_end_credit)"/></strong>
                                        </t>
                                    </td>
                                    <td style="text-align: right;"></td>
                                    <td style="text-align: right;"></td>
                                </tr>
                            </t><!--end for team-->

                            <tr style="background-color: #d3e4f5;">
                                <td colspan="7" style="text-align: left;">
                                    <strong>Tổng cộng báo cáo</strong>
                                </td>
                                <t t-set="total_debit" t-value="sum(doc.line3_ids.mapped('debit'))"/>
                                <t t-set="total_credit" t-value="sum(doc.line3_ids.mapped('credit'))"/>
                                <td style="text-align: right;">
                                    <t t-if="sum(doc.line3_ids.mapped('product_uom_qty')) > 0">
                                        <strong>
                                            <span t-esc="doc.convert_number(sum(doc.line3_ids.mapped('product_uom_qty')))"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_debit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_debit)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_credit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_credit)"/>
                                        </strong>
                                    </t>
                                </td>
                                
                                <td style="text-align: right;">
                                    <t t-if="total_last_end_debit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_last_end_debit)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_last_end_credit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_last_end_credit)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;"></td>
                                <td style="text-align: right;"></td>
                            </tr>
                        </table>
                    </div>
                    <t t-if="doc.page_break">
                        <p style="page-break-after:always;"></p>
                    </t>
                    <!-- Ngày tháng -->
                    <div class="row" style="padding-top: 20px;">
                        <div class="col-12" style="text-align: right; font-style: italic;">
                            <span t-esc="'Đồng Nai, Ngày %s Tháng %s năm %s' % (time.strftime('%d'), time.strftime('%m'), time.strftime('%Y'))"/>
                        </div>
                    </div>

                    <!-- Ký tên -->
                    <div class="row" style="margin-top: 10px; text-align: center; page-break-inside: avoid;">
                        <div class="col-2" style="width: 20%; flex: 0 0 20%; max-width: 20%;">
                            <strong>Lập Phiếu</strong>
                            <br/><span style="font-style: italic;">(Ký, họ tên)</span>
                            <t t-if="doc.state == 'approved' and doc.voter_id and doc.voter_id.sudo().sign_signature">
                                <br/><br/>
                                <img t-att-src="image_data_uri(doc.voter_id.sudo().sign_signature)" style="max-height: 80px; max-width: 100%;"/>
                                <br/>
                                <strong t-esc="doc.voter_id.name"/>
                            </t>
                            <t t-elif="doc.voter_id">
                                <br/><br/><br/><br/>
                                <strong t-esc="doc.voter_id.name"/>
                            </t>
                        </div>
                        <div class="col-2" style="width: 20%; flex: 0 0 20%; max-width: 20%;">
                            <strong>Trưởng bộ phận</strong>
                            <br/><span style="font-style: italic;">(Ký, họ tên)</span>
                            <t t-if="doc.state == 'approved' and doc.chief_dept_id and doc.chief_dept_id.sudo().sign_signature">
                                <br/><br/>
                                <img t-att-src="image_data_uri(doc.chief_dept_id.sudo().sign_signature)" style="max-height: 80px; max-width: 100%;"/>
                                <br/>
                                <strong t-esc="doc.chief_dept_id.name"/>
                            </t>
                            <t t-elif="doc.chief_dept_id">
                                <br/><br/><br/><br/>
                                <strong t-esc="doc.chief_dept_id.name"/>
                            </t>
                        </div>
                        <div class="col-2" style="width: 20%; flex: 0 0 20%; max-width: 20%;">
                            <strong>Kế toán tổng hợp</strong>
                            <br/><span style="font-style: italic;">(Ký, họ tên)</span>
                            <t t-if="doc.state == 'approved' and doc.debt_accountant_id and doc.debt_accountant_id.sudo().sign_signature">
                                <br/><br/>
                                <img t-att-src="image_data_uri(doc.debt_accountant_id.sudo().sign_signature)" style="max-height: 80px; max-width: 100%;"/>
                                <br/>
                                <strong t-esc="doc.debt_accountant_id.name"/>
                            </t>
                            <t t-elif="doc.debt_accountant_id">
                                <br/><br/><br/><br/>
                                <strong t-esc="doc.debt_accountant_id.name"/>
                            </t>
                        </div>
                        <div class="col-2" style="width: 20%; flex: 0 0 20%; max-width: 20%;">
                            <strong>Kế toán trưởng</strong>
                            <br/><span style="font-style: italic;">(Ký, họ tên)</span>
                            <t t-if="doc.state == 'approved' and doc.chief_acc_id and doc.chief_acc_id.sudo().sign_signature">
                                <br/><br/>
                                <img t-att-src="image_data_uri(doc.chief_acc_id.sudo().sign_signature)" style="max-height: 80px; max-width: 100%;"/>
                                <br/>
                                <strong t-esc="doc.chief_acc_id.name"/>
                            </t>
                            <t t-elif="doc.chief_acc_id">
                                <br/><br/><br/><br/>
                                <strong t-esc="doc.chief_acc_id.name"/>
                            </t>
                        </div>
                        <div class="col-2" style="width: 20%; flex: 0 0 20%; max-width: 20%;">
                            <strong>Thủ trưởng đơn vị</strong>
                            <br/><span style="font-style: italic;">(Ký, họ tên)</span>
                            <t t-if="doc.state == 'approved' and doc.unit_heads_id and doc.unit_heads_id.sudo().sign_signature">
                                <br/><br/>
                                <img t-att-src="image_data_uri(doc.unit_heads_id.sudo().sign_signature)" style="max-height: 80px; max-width: 100%;"/>
                                <br/>
                                <strong t-esc="doc.unit_heads_id.name"/>
                            </t>
                            <t t-elif="doc.unit_heads_id">
                                <br/><br/><br/><br/>
                                <strong t-esc="doc.unit_heads_id.name"/>
                            </t>
                        </div>
                    </div>


                </div>
            </t>
        </template>

        <record id="chi_tiet_cong_no_phai_thu_xlsx" model="ir.actions.report">
            <field name="name">Chi Tiết Công Nợ Phải Thu (Excel)</field>
            <field name="model">ccv.chi.tiet.cong.no.phai.thu</field>
            <field name="report_type">xlsx</field>
            <field name="report_name">ccv_sql.chi_tiet_cong_no_phai_thu_xlsx</field>
            <field name="report_file">ccv_sql.chi_tiet_cong_no_phai_thu_xlsx</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
        </record>

        <record id="chi_tiet_cong_no_phai_thu_report" model="ir.actions.report">
            <field name="name">Chi Tiết Công Nợ Phải Thu</field>
            <field name="model">alpha.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ccv_sql.chi_tiet_cong_no_phai_thu_template</field>
            <field name="report_file">ccv_sql.chi_tiet_cong_no_phai_thu_template</field>
            <field name="paperformat_id" ref="ccv_sql.format_a4_ngang"/>
            <field name="print_report_name">'Chi Tiết Công Nợ Phải Thu'</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>