<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- có thể chạy nhiều báo cáo pdf-->
        <template id="mrp_production_ccv_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="ccv_sql.mrp_production_ccv_document"
                       t-lang="doc.user_id.partner_id.lang"/>
                </t>
            </t>
        </template>

        <!-- body của báo cáo-->
        <template id="mrp_production_ccv_document">
            <t t-call="ccv_sql.ccv_header">
                <div class="page" style="font-size: 14px;font-family: Times New Roman">
                    <div class="col-xs-12" style="text-align: center; font-size: 20px;">
                        <strong>Lệnh sản xuất</strong>
                    </div>
                    <div class="col-xs-12" style="text-align: center; margin-top: 2px;">
                        <img
                            style="width:200px;height:30px;"
                            t-att-src="'report/barcode/?barcode_type=%s&amp;value=%s&amp;
                            width=%s&amp;height=%s'%('EAN13',doc.name,265,80)"/>
                    </div>
                    <div class="col-xs-12" style="text-align: left; margin-top: 2px;">
                        <strong>Số:</strong> <t t-esc="doc.name"/> &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; <strong>Ngày:</strong> <t t-esc="doc.date_planned_start.strftime('%d/%m/%Y')"/>
                    </div>
                    <div class="col-xs-12" style="text-align: left; margin-top: 2px;">
                        <strong>Diễn giải:</strong> <span t-esc="doc.interpretation"/>
                    </div>
                    <div class="col-xs-12" style="text-align: left; margin-top: 2px;">
                        <strong>Đơn hàng:</strong> <span t-esc="', '.join(doc.sale_ids.mapped('display_name')) if doc.sale_ids else ''"/>
                    </div>
                    <div class="col-xs-12" style="text-align: left; margin-top: 2px;">
                        <strong>Loại hoạt động:</strong> <span t-esc="doc.picking_type_id.display_name if doc.picking_type_id else ''"/>
                    </div>
                    <div class="col-xs-12" style="text-align: left; margin-top: 2px;">
                        <strong>Người phụ trách:</strong> <span t-esc="doc.user_id.name"/>
                    </div>
                    <div class="col-xs-12" style="text-align: left; margin-top: 2px;">
                        <strong>1.Thành phẩm</strong>
                    </div>
                    <div class="row">
                        <table class="table table-sm" style="border: solid 1px;width: 100%; margin-top: 2px;">
                            <tr>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Mã thành phẩm</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Tên thành phẩm</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>ĐVT</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Số lượng</strong>
                                </td>
                            </tr>
                            <tr>
                                <td style="text-align: left; vertical-align: middle;">
                                    <t t-esc="doc.product_id.default_code"/>
                                </td>
                                <td style="text-align: left; vertical-align: middle;">
                                    <t t-esc="doc.product_id.name"/>
                                </td>
                                <td style="text-align: left; vertical-align: middle;">
                                    <t t-esc="doc.product_uom_id.name"/>
                                </td>
                                <td style="text-align: right; vertical-align: middle;">
                                    <t t-esc="doc.env['alpha.report'].convert_number(doc.product_qty)"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-xs-12" style="text-align: left;">
                        <strong>2.Định mức nguyên vật liệu</strong>
                    </div>
                    <div class="row">
                        <table class="table table-sm" style="border: solid 1px;width: 100%; margin-top: 2px;">
                            <tr>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Ảnh bao bì</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Ảnh sản phẩm</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Mã thành phẩm</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Tên thành phẩm</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>ĐVT</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Số lượng</strong>
                                </td>
                            </tr>
                            <t t-foreach="doc.move_raw_ids" t-as="line">
                                <tr>
                                    <td style="width:100px; height:100px; text-align:center;">
                                        <t t-if="line.packaging_image_128">
                                            <img t-att-src="'data:image/png;base64,%s' % line.packaging_image_128.decode('utf-8')" style="max-width: 90px; max-height: 90px;; border:1px solid #ccc;"/>
                                        </t>
                                    </td>
                                    <td style="width:100px; height:100px; text-align:center;">
                                        <t t-if="line.product_image_128">
                                            <img t-att-src="'data:image/png;base64,%s' % line.product_image_128.decode('utf-8')" style="max-width: 90px; max-height: 90px; border:1px solid #ccc;"/>
                                        </t>
                                    </td>
                                    <td>
                                        <span t-esc="line.product_id.default_code"/>
                                    </td>
                                    <td>
                                        <span t-esc="line.product_id.name"/>
                                    </td>
                                    <td>
                                        <span t-esc="line.product_uom.name"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-esc="doc.env['alpha.report'].convert_number(line.product_uom_qty)"/>
                                    </td>
                                </tr>
                            </t><!--end for-->
                        </table>
                    </div>
                    <div class="row rowp" style="margin-left: 2px;text-align: center;">
                        <div class="col-3" style="text-align: center">
                            <span>
                                <strong>Người lập</strong>
                            </span>
                            <br/>
                            <span>(Ký, đóng dấu)</span>
                            <br/>
                            <t t-if="doc.mrp_approval_state == 'approved' and doc.preparer_id and doc.preparer_id.sudo().sign_signature">
                                <img t-att-src="image_data_uri(doc.preparer_id.sudo().sign_signature)" style="max-height: 80px; max-width: 150px;"/>
                                <br/>
                            </t>
                            <br/><br/>
                            <span t-esc="doc.preparer_id.name"/>
                        </div>
                        <div class="col-3" style="text-align: center">
                            <span>
                                <strong>Giám sát</strong>
                            </span>
                            <br/>
                            <span>(Ký, họ tên)</span>
                            <br/>
                            <t t-if="doc.mrp_approval_state == 'approved' and doc.supervisor_id and doc.supervisor_id.sudo().sign_signature">
                                <img t-att-src="image_data_uri(doc.supervisor_id.sudo().sign_signature)" style="max-height: 80px; max-width: 150px;"/>
                                <br/>
                            </t>
                            <br/><br/>
                            <span t-esc="doc.supervisor_id.name"/>
                        </div>
                        <div class="col-3" style="text-align: center">
                            <span>
                                <strong>Người phụ trách</strong>
                            </span>
                            <br/>
                            <span>(Ký, họ tên)</span>
                            <br/>
                            <t t-if="doc.mrp_approval_state == 'approved' and doc.user_id and doc.user_id.sudo().sign_signature">
                                <img t-att-src="image_data_uri(doc.user_id.sudo().sign_signature)" style="max-height: 80px; max-width: 150px;"/>
                                <br/>
                            </t>
                            <br/><br/>
                            <span t-esc="doc.user_id.name"/>
                        </div>
                        <div class="col-3" style="text-align: center">
                            <span>
                                <strong>Ban lãnh đạo</strong>
                            </span>
                            <br/>
                            <span>(Ký, họ tên)</span>
                            <br/>
                            <t t-if="doc.mrp_approval_state == 'approved' and doc.director_id and doc.director_id.sudo().sign_signature">
                                <img t-att-src="image_data_uri(doc.director_id.sudo().sign_signature)" style="max-height: 80px; max-width: 150px;"/>
                                <br/>
                            </t>
                            <br/><br/>
                            <span t-esc="doc.director_id.name"/>
                        </div>
                    </div>


                </div>
            </t>
        </template>

        <record id="mrp_production_ccv_report" model="ir.actions.report">
            <field name="name">Lệnh sản xuất CCV</field>
            <field name="model">mrp.production</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ccv_sql.mrp_production_ccv_template</field>
            <field name="report_file">ccv_sql.mrp_production_ccv_template</field>
            <field name="paperformat_id" ref="ccv_sql.format_a4_doc"/>
            <field name="print_report_name">'Lệnh sản xuất: %s' %object.name</field>
            <field name="binding_model_id" ref="mrp.model_mrp_production"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>