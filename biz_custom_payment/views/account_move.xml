<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_ccv" model="ir.ui.view">
        <field name="name">account.payment.form.ccv</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="sale_id" invisible="False if context.get('default_payment_type') == 'inbound' else True"/>
                <field name="purchase_id" invisible="False if context.get('default_payment_type') == 'outbound' else True"/>
            </xpath>
        </field>
    </record>
</odoo>