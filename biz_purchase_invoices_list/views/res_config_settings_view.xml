<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_config_settings_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account_reports.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='account_reports_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="remove_supplier_reports"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="remove_supplier_reports"/>
                        <span class="fa fa-lg fa-building-o" groups="base.group_multi_company"/>
                        <div class="text-muted">
                            If checked, reports including suppliers will be removed.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>