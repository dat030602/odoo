<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_ids']" position="after">
                <field name="commercial_entity" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="commercial_entity"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_inherit" model="ir.ui.view">
        <field name="name">sale.order.list.select.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field string="Commercial Entity" name="commercial_entity"/>
                <filter string="Commercial: Company" name="commercial_entity" domain="[('commercial_entity', '=', 'company')]"/>
                <filter string="Commercial: Individual" name="commercial_entity" domain="[('commercial_entity', '=', 'individual')]"/>
            </xpath>
            <filter name="order_month" position="after">
                <filter string="Commercial Entity" name="commercial_entity" domain="[]" context="{'group_by': 'commercial_entity'}"/>
            </filter>
        </field>
    </record>
</odoo>
