<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_smart_search_config_tree" model="ir.ui.view">
        <field name="name">smart.search.config.tree</field>
        <field name="model">smart.search.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="priority"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="search_field_names"/>
                <field name="subtitle_field_name"/>
                <field name="icon"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_smart_search_config_form" model="ir.ui.view">
        <field name="name">smart.search.config.form</field>
        <field name="model">smart.search.config</field>
        <field name="arch" type="xml">
            <form string="Smart Search Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_id"/>
                        <field name="active"/>
                        <field name="priority"/>
                        <field name="icon"/>
                    </group>
                    <group string="Search Strategy">
                        <field name="search_field_names" placeholder="name,ref,phone"/>
                        <field name="subtitle_field_name" placeholder="partner_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_smart_search_config" model="ir.actions.act_window">
        <field name="name">Smart Search</field>
        <field name="res_model">smart.search.config</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem id="menu_smart_search_root" name="Smart Search" parent="base.menu_administration" action="action_smart_search_config" sequence="60" groups="base.group_system"/>
</odoo>
