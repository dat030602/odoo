<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dn_smart_search.SmartSearchSystray" owl="1">
        <button type="button" class="btn btn-link o_nav_entry px-2 text-reset" t-on-click="onClick" title="Search everything" aria-label="Search everything">
            <i class="fa fa-search"/>
            <span class="ms-1 d-none d-lg-inline">Search everything...</span>
        </button>
    </t>

    <t t-name="dn_smart_search.SmartSearchDialog" owl="1">
        <Dialog header="false" footer="false" size="'lg'" contentClass="'o_smart_search_dialog'">
            <div class="d-flex flex-column gap-2 p-3">
                <div class="input-group input-group-lg border rounded-3 overflow-hidden bg-white shadow-sm">
                    <span class="input-group-text bg-transparent border-0 text-muted"><i class="fa fa-search"/></span>
                    <input t-ref="smartSearchInput" class="form-control border-0 shadow-none" type="text" t-att-placeholder="'Search everything...'" t-on-input="onInput" autocomplete="off" autocapitalize="off" spellcheck="false"/>
                    <span class="input-group-text bg-transparent border-0 text-muted" t-if="state.loading"><i class="fa fa-circle-o-notch fa-spin"/></span>
                </div>

                <div class="o_smart_search_results list-group overflow-auto">
                    <button t-foreach="renderedResults" t-as="result" t-key="result_index" type="button" class="list-group-item list-group-item-action d-flex align-items-start gap-3" t-att-class="{'active': state.selectedIndex === result_index}" t-on-click="() => this.openSelected(result_index)" t-on-mouseenter="() => this.onResultMouseEnter(result_index)">
                        <div class="flex-shrink-0 text-muted fs-4 pt-1">
                            <i t-att-class="'fa ' + (result.icon || 'fa-search')"/>
                        </div>
                        <div class="min-w-0 flex-grow-1">
                            <div class="fw-semibold text-truncate"><t t-out="result.displayHtml"/></div>
                            <div class="text-muted text-truncate small"><t t-out="result.subtitleHtml"/></div>
                        </div>
                        <div class="flex-shrink-0 small text-muted mt-1">
                            <span t-if="result.score"><t t-out="result.score"/></span>
                        </div>
                    </button>
                    <div t-if="!state.loading &amp;&amp; !state.results.length &amp;&amp; state.query" class="text-muted text-center py-5">
                        <i class="fa fa-search me-2"/>No result found
                    </div>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
