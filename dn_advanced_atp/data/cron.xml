<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_sequence_allocation_run" model="ir.sequence">
        <field name="name">Allocation Run</field>
        <field name="code">allocation.run</field>
        <field name="prefix">RUN/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <record id="ir_cron_allocation_run" model="ir.cron">
        <field name="name">Advanced ATP: Auto Allocation</field>
        <field name="model_id" ref="model_allocation_run"/>
        <field name="state">code</field>
        <field name="code"># env['allocation.run']._cron_run()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
