<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bank_deposit_book_form" model="ir.ui.view">
        <field name="name">bank.deposit.book.form</field>
        <field name="model">bank.deposit.book</field>
        <field name="inherit_id" ref="biz_bank_deposit_book.bank_deposit_book_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group>
                    <field name="type_print" invisible="1"/>
                    <field name="creator_id"/>
                    <field name="chief_id"/>
                    <field name="unit_head_id"/>
                </group>
            </xpath>
            <button name="action_print_excel" position="replace"/>
        </field>
    </record>

    <record id="bank_deposit_book_action_usd" model="ir.actions.act_window">
        <field name="name">Bank deposit book</field>
        <field name="res_model">bank.deposit.book</field>
        <field name="view_mode">form</field>
        <field name="context">{
                'default_type_print': 'usd'
            }</field>
        <field name="target">new</field>
    </record>

    <menuitem action="bank_deposit_book_action_usd" name="Bank deposit book USD (S08-DN)" id="bank_deposit_book_menu_usd" sequence="18"  
        parent='account_reports.account_reports_audit_reports_menu'/>
</odoo>