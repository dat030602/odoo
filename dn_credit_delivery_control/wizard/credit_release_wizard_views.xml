<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_credit_release_wizard_form" model="ir.ui.view">
        <field name="name">credit.release.wizard.form</field>
        <field name="model">credit.release.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="reason"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
