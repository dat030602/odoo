<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="template_send_mail_payslip_ccv" model="mail.template">
            <field name="name">Template send mail payslip</field>
            <field name="email_from">{{user.email_formatted}}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="subject">BẢNG LƯƠNG CHI TIẾT/PAY SLIP {{object.get_mail_month()}}</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Gửi các anh/chị, <br/></p>
    <p>Kính đề nghị kiểm tra và xác nhận phiếu lương</p>
    <p>Trân trọng!</p>
</div></field>
            <field name="report_template" ref="biz_payslip_excel_report.action_report_salary_slip_excel"/>
            <field name="report_name">Salary Slip (Excel) - {{ object.employee_id.name }}</field>
        </record>
    </data>
</odoo>