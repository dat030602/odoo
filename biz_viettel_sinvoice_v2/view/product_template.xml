<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="product_template_form_view_sinvoice" model="ir.ui.view">
    	<field name="name">product.template.common.form.sinvoice</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view" />
        <field name="arch" type="xml">
        	<group name="accounting" position="after">
        		<group string="Description for VAT" name="description_vat">
        			<group>
        				<field name="description_vat" nolabel="1" placeholder="This note will show up on sales orders &amp; invoices."/>
        			</group>
                </group>
        	</group>
        </field>
    </record>
</odoo>
