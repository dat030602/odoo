<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_viettel_sinvoice_item_type_set_tree" model="ir.ui.view">
            <field name="name">viettel.sinvoice.item.type.set.tree</field>
            <field name="model">viettel.sinvoice.item.type.set</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="is_default"/>
                </tree>
            </field>
        </record>

        <record id="view_viettel_sinvoice_item_type_set_form" model="ir.ui.view">
            <field name="name">viettel.sinvoice.item.type.set.form</field>
            <field name="model">viettel.sinvoice.item.type.set</field>
            <field name="arch" type="xml">
                <form>
                    <widget name="web_ribbon" title="Lưu trữ" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="is_default"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="item_type"/>
                                        <field name="key_value"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_viettel_sinvoice_item_type_set" model="ir.actions.act_window">
            <field name="name">Item Type Mapping</field>
            <field name="res_model">viettel.sinvoice.item.type.set</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="menu_viettel_sinvoice_item_type_set"
            name="Item Type Mapping"
            parent="biz_viettel_sinvoice_v2.menu_viettel_sinvoice_config_root"
            action="action_viettel_sinvoice_item_type_set"
            sequence="2"
            groups="biz_viettel_sinvoice_v2.group_viettel_user"
        />
    </data>
</odoo>
