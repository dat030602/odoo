<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="vsi_account_invoice_inherit_form_view" model="ir.ui.view">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_invoice_sent'][last()]" position="after">
                	<button name="action_create_data_sinvoice" string="Create S-Invoice" type="object" class="oe_highlight" attrs="{'invisible': ['|','|',('sinvoice_count','>', 0),('state', '!=', 'posted'),('move_type','not in', ['out_invoice','out_refund','entry'])]}"/>

                    <field name="sinvoice_count" invisible="1"/>
                </xpath>
                <field name='partner_id' position="after">
                    <field name="move_type" invisible="1" />
                	<field name="partner_vat_id" 
                        domain="['|',('id','=',partner_id),'&amp;',('type','=','invoice'),('parent_id','=',partner_id)]" 
                        attrs="{'invisible': [('move_type','not in', ['out_invoice','out_refund','entry'])]}"
                        context="{'type': move_type}"/>
                </field>
                <field name="payment_reference" position="after">
                    <field name="vat_sinvoice_number"/>
                </field>
                <xpath expr="//page[@name='other_info']" position="before">
                	<page string="Hóa đơn phát hành" name="sinvoice_info" attrs="{'invisible': [('move_type','not in', ['out_invoice','out_refund','entry'])]}">
                        <field name="origin_sinvoice_count" invisible="1"/>
                        <field name="origin_sinvoice_ids" invisible="1"/>
                        <separator string="Hóa đơn điện tử gốc (dùng để điều chỉnh)" attrs="{'invisible': ['|', ('move_type', '!=', 'out_refund'), ('origin_sinvoice_count', '=', 0)]}"/>
                        <field name="origin_sinvoice_line_ids" nolabel="1" readonly="1" options="{'no_create': True, 'no_create_edit': True}" attrs="{'invisible': ['|', ('move_type', '!=', 'out_refund'), ('origin_sinvoice_count', '=', 0)]}">
                            <tree>
                                <field name="sinvoice_id"/>
                                <field name="invoiceNo"/>
                                <field name="supplierTaxCode"/>
                                <field name="transactionID"/>
                                <field name="invoiceIssuedDate"/>
                                <field name="state"/>
                                <field name="total"/>
                            </tree>
                            <form>
                                <header>
                                    <button name="action_download_invoice_representation_file" type="object" class="oe_highlight" string="Download PDF" icon="fa-print" attrs="{'invisible': [('downloaded', '=', True)]}"/>
                                    <button name="action_download_exchange_invoice_file" type="object" class="oe_highlight" string="Download exchange invoice file" icon="fa-download" attrs="{'invisible': [('exchange_file_downloaded', '=', True)]}"/>
                                    <button name="%(biz_viettel_sinvoice_v2.action_sinvoice_edit)d" context="{'type': 'info', 'default_type': 'info'}" type="action" class="oe_highlight" string="Update SInvoice" icon="fa-edit" attrs="{'invisible': [('state', '!=', 'created')]}"/>
                                    <button name="action_get_invoices" type="object" string="Get Invoice" groups="base.group_no_one"/>
                                    <field name="state" widget="statusbar" nolabel="1" statusbar_visible="draft,created"/>
                                </header>
                                <group>
                                    <group>
                                        <field name="sinvoice_id" readonly="1"/>
                                        <field name="invoiceNo" readonly="1"/>
                                        <field name="type" readonly="1"/>
                                        <field name="reservationCode" readonly="1"/>
                                        <field name="invoiceIssuedDate" readonly="1"/>
                                        <field name="originalInvoiceIssueDate" readonly="1"/>
                                        <field name="templateCode" readonly="1"/>
                                        <field name="totalBeforeTax" readonly="1"/>
                                        <field name="buyerLegalName" readonly="1"/>
                                        <field name="buyerAddressLine" readonly="1"/>
                                        <field name="buyerTaxCode" readonly="1"/>
                                        <field name="buyerCode" readonly="1"/>
                                        <field name="currencyCode" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="transactionID" readonly="1"/>
                                        <field name="create_date" readonly="1"/>
                                        <field name="invoiceId" readonly="1"/>
                                        <field name="invoiceType" readonly="1"/>
                                        <field name="invoiceSeri" readonly="1"/>
                                        <field name="adjustmentType" readonly="1"/>
                                        <field name="invoiceNumber" readonly="1"/>
                                        <field name="taxAmount" readonly="1"/>
                                        <field name="buyerName" readonly="1"/>
                                        <field name="paymentStatus" readonly="1"/>
                                        <field name="createTime" readonly="1"/>
                                        <field name="total" readonly="1"/>
                                    </group>
                                    <group>
                                       <field name="downloaded" invisible="1"/>
                                       <field name="exchange_file_downloaded" invisible="1"/>
                                       <field name="attachment_ids" widget="many2many_binary" string="PDF file" colspan="2"/>
                                       <field name="exchange_file_ids" widget="many2many_binary" string="Exchange file" colspan="2"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                        <separator string="Hóa đơn điện tử phát hành từ phiếu này"/>
                        <field name="sinvoice_ids"/>
                    </page>
                </xpath>
                <div name="button_box" position="inside">
                    <button name="open_invoice_adjustment" class="oe_stat_button" icon="fa-bars" type="object" >
                        <field string="Invoice adjustment" name="count_adjust_invoice" widget="statinfo"/>
                    </button>
                </div>

            </field>
        </record>

        <record id="account_invoice_tree_inherit_view" model="ir.ui.view">
            <field name="name">account.invoice.tree.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_state']" position="after">
                    <field string="Number Invoice" name="number_invoice"/>
                </xpath>
                <xpath expr="//field[@name='amount_total_in_currency_signed']" position="after">
                <field name="vat_sinvoice_number" optional="show"/>
              </xpath>
            </field>
        </record>
    </data>
</odoo>
