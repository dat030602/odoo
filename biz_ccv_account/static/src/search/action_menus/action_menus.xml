<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
     <t t-name="biz_ccv_account.ActionMenus" t-inherit="web.ActionMenus" t-inherit-mode="extension" owl="1">
        <xpath expr="//Dropdown[@t-if='printItems.length']" position="replace">
            <t t-if="hideFields.check">
            </t>
            <t t-else="">
                <Dropdown t-if="printItems.length" class="'d-inline-block'" togglerClass="'btn btn-light'"
                          hotkey="'shift+u'">
                    <t t-set-slot="toggler">
                        <i class="me-md-1 fa fa-print"/>
                        <span class="o_dropdown_title">Print</span>
                    </t>
                    <t t-foreach="printItems" t-as="item" t-key="item.key">
                        <DropdownItem class="'o_menu_item'" onSelected="() => this.onItemSelected(item)">
                            <t t-esc="item.description"/>
                        </DropdownItem>
                    </t>
                </Dropdown>
            </t>

        </xpath>

         <xpath expr="//Dropdown[@t-if='actionItems.length']" position="replace">
            <t t-if="hideFields.check">
            </t>
             <t t-else="">
                <Dropdown t-if="actionItems.length" class="'d-inline-block'" togglerClass="'btn btn-light'"
                          hotkey="'u'">
                    <t t-set-slot="toggler">
                        <i class="me-md-1 fa fa-cog"/>
                        <span class="o_dropdown_title">Action</span>
                    </t>
                    <t t-foreach="actionItems" t-as="item" t-key="item.key">
                        <t t-if="item.Component" t-component="item.Component" t-props="item.props"/>
                        <DropdownItem t-else="" class="'o_menu_item'" onSelected="() => this.onItemSelected(item)">
                            <t t-esc="item.description"/>
                        </DropdownItem>
                    </t>
                </Dropdown>
            </t>

        </xpath>
    </t>
</templates>