<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_only_form_view_inherit_ccv_required" model="ir.ui.view">
        <field name="name">product.template.product.form.required.ccv</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="categ_id" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="default_code" position="attributes">
                <attribute name="attrs">{'invisible': [('product_variant_count', '>', 1)], 'required': [('product_variant_count', '&lt;=', 1)]}</attribute>
            </field>
            <field name="uom_id" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <field name="uom_po_id" position="attributes">
                <attribute name="required">1</attribute>
            </field>
        </field>
    </record>

    <record id="product_template_only_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.product.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tag_ids']" position="after">
                <field name="distributor_allowed_company_ids" widget="many2many_tags" options="{'no_create':1,'no_create_edit':1}" required="1"/>
            </xpath>
            
        </field>
    </record>
    
    <record id="product_template_form_view_inherit_ccv_sale" model="ir.ui.view">
        <field name="name">product.template.product.form.inherit.ccv.sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_po_id']" position="after">
                <field name="check_category_id" invisible="1"/>
                <field name="default_specification_id" domain="[('category_id','=',check_category_id)]" options="{'no_create':1}"/>
                <field name="packaging_specification_id" domain="[('category_id','=',check_category_id)]" options="{'no_create':1}"/>
            </xpath>
             <xpath expr="//field[@name='product_tag_ids']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
            </xpath>
        </field>
    </record>


    <record id="product_template_form_view_ccv" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='taxes_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
            </xpath>
        </field>
    </record>


    <record id="product_template_tree_view_ccv" model="ir.ui.view">
        <field name="name">product.template.product.tree.ccv</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tag_ids']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_open': True, 'color_field': 'color'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>