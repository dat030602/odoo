<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='invoice_date'][1]" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt','entry'))]}
                </attribute>
            </xpath>

            <field name="invoice_date" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('move_type', 'not in', ('entry','out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}
                </attribute>
            </field>
        </field>
    </record>

