<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="pos_payment_method_view_form_inherit_pos_vnpay" model="ir.ui.view">
		<field name="name">pos.payment.method.form.inherit.vnpay</field>
		<field name="model">pos.payment.method</field>
		<field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form" />
		<field name="arch" type="xml">
			<xpath expr="//field[@name='use_payment_terminal']" position="after">
				<div colspan="2" class="mt16" attrs="{'invisible': [('use_payment_terminal', '!=', 'vnpay')], 'required': [('use_payment_terminal', '=', 'vnpay')]}">
                    <button name="action_vnpay_key" type="object" icon="fa-arrow-right" string="Don't forget to complete VNPay config before using this payment method." class="btn-link" />
				</div>
                <field name="image_128" widget="image" class="oe_avatar" attrs="{'invisible': [('use_payment_terminal', '!=', 'vnpay')], 'required': [('use_payment_terminal', '=', 'vnpay')]}"/>
			</xpath>
		</field>
	</record>
</odoo>
