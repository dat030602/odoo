<odoo>
    <data>
        <record id="pos_payment_group_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="point_of_sale.group_pos_user" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="pos_payment_group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="point_of_sale.group_pos_manager" />
            <field name="implied_ids" eval="[(4, ref('pos_payment_group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')),(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>