<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_vnpay.CustomerFacingDisplayOrder" t-inherit="point_of_sale.CustomerFacingDisplayOrder" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[@class='pos-company_logo']" position="after">
            <div style="text-align: center;" t-if="srcQrCode != ''">
                <img t-att-src="srcQrCode" alt="VNPay Logo 2" style="width: 100%;max-width: 250px;" />
            </div>
        </xpath>
    </t>
</templates>
