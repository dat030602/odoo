<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paper_format_delegate_expense_mb" model="report.paperformat">
            <field name="name">Delegate Expense MB</field>
            <field name="default" eval="True"/>
            <field name="format">A5</field>
            <field name="orientation">Landscape</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">10</field>
            <field name="dpi">90</field>
        </record>
    </data>

    <record id="action_delegate_expense_mb" model="ir.actions.report">
        <field name="name">Delegate Expense MB</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">biz_delegate_expense_mbbank.delegate_expense_mb_template</field>
        <field name="report_file">biz_delegate_expense_mbbank.delegate_expense_mb_template</field>
        <field name="print_report_name">'Uy_nhiem_chi_(MB)_%s' % (object.partner_id.name)</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref='paper_format_delegate_expense_mb'/>
    </record>

    <record id="action_delegate_expense_invoice_mb" model="ir.actions.report">
        <field name="name">Delegate Expense MB</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">biz_delegate_expense_mbbank.i_d_e_mb_template</field>
        <field name="report_file">biz_delegate_expense_mbbank.i_d_e_mb_template</field>
        <field name="print_report_name">'Uy_nhiem_chi_(MB)_%s' % (object.partner_id.name)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref='paper_format_delegate_expense_mb'/>
    </record>
</odoo>