<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_fleet_services_registration_seq" model="ir.sequence">
            <field name="name">fleet service registration sequence</field>
            <field name="code">fleet.service.registration</field>
            <field name="prefix">DVDK</field>
            <field eval="1" name="number_next"/>
