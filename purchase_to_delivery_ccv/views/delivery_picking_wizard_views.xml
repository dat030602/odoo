<odoo>
    <record id="delivery_picking_wizard_form" model="ir.ui.view">
        <field name="name">delivery.picking.wizard.form</field>
        <field name="model">delivery.picking.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Deliveries by Container">
                <group>
                    <field name="picking_type_id"/>
                </group>
                <footer>
                    <button name="action_create_deliveries" type="object" string="Create" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_delivery_picking_wizard" model="ir.actions.act_window">
        <field name="name">Create Deliveries by Container</field>
        <field name="res_model">delivery.picking.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_purchase_order_id': active_id}</field>
    </record>
</odoo>
