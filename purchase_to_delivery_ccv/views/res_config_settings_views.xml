<odoo>
    <data>
        <record id="view_purchase_to_delivery_ccv_config_settings" model="ir.ui.view">
            <field name="name">purchase.to.delivery.ccv.config.settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='integration']" position="inside">
                    <group string="Purchase to Delivery Settings">
                        <field name="delivery_note_template"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
