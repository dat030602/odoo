<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Approval Reason Wizard Form View -->
        <record id="approval_reason_wizard_form" model="ir.ui.view">
            <field name="name">approval.reason.wizard.form</field>
            <field name="model">approval.reason.wizard</field>
            <field name="arch" type="xml">
                <form string="Approval Reason">
                    <sheet>
                        <group>
                            <field name="request_id" invisible="1"/>
                            <field name="action_type"/>
                            <field name="reason" required="1" placeholder="Please enter the reason..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action for Approval Reason Wizard -->
        <record id="action_approval_reason_wizard" model="ir.actions.act_window">
            <field name="name">Approval Reason</field>
            <field name="res_model">approval.reason.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
