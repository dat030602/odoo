<odoo>

  <record id="view_stock_snapshot_tree" model="ir.ui.view">
    <field name="name">stock.snapshot.list</field>
    <field name="model">stock.snapshot</field>
    <field name="arch" type="xml">
      <list string="Stock Snapshots" edit="false">
        <field name="date"/>
        <field name="product_id"/>
        <field name="location_id"/>
        <field name="quantity"/>
        <field name="source"/>
        <field name="created_at"/>
      </list>
    </field>
  </record>

  <record id="view_stock_snapshot_search" model="ir.ui.view">
    <field name="name">stock.snapshot.search</field>
    <field name="model">stock.snapshot</field>
    <field name="arch" type="xml">
      <search string="Stock Snapshots">
        <field name="date"/>
        <field name="product_id"/>
        <field name="location_id"/>
        <field name="source"/>
        <filter string="Non-Zero"
                domain="[('quantity', '!=', 0)]"/>
        <group expand="0" string="Group By">
          <filter string="Product"
                  name="group_by_product"
                  context="{'group_by': 'product_id'}"/>
          <filter string="Location"
                  name="group_by_location"
                  context="{'group_by': 'location_id'}"/>
          <filter string="Date"
                  name="group_by_date"
                  context="{'group_by': 'date'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_stock_snapshot_report" model="ir.actions.act_window">
    <field name="name">Stock Snapshot Viewer</field>
    <field name="res_model">stock.snapshot.report</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <record id="action_stock_snapshot" model="ir.actions.act_window">
    <field name="name">Stock Snapshots</field>
    <field name="res_model">stock.snapshot</field>
    <field name="view_mode">list</field>
    <field name="search_view_id" ref="view_stock_snapshot_search"/>
    <field name="views">[[False, "list"]]</field>
  </record>

</odoo>
