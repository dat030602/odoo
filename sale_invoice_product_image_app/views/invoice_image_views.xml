<?xml version="1.0"?>
<odoo>
    <record id="view_invoice_line_product_image" model="ir.ui.view">
         <field name="name">account.line.image</field>
         <field name="model">account.move</field>
         <field name="inherit_id" ref="account.view_move_form"/>
         <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='product_id']" position="before">
                <field name="products_image" widget="image" class="oe_avatar" string="Product Image"/>
            </xpath>
            <xpath expr="//field[@name='fiscal_position_id']" position="after">
                <field name="product_print" string="Print Product Image"/>
            </xpath>
         </field>
    </record>
</odoo>