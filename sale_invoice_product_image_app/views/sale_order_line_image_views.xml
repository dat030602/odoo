<?xml version="1.0"?>
<odoo>
    <record id="view_sale_order_line_procduct_image" model="ir.ui.view">
         <field name="name">sale.order.line.image</field>
         <field name="model">sale.order</field>
         <field name="inherit_id" ref="sale.view_order_form" />
         <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//form//field[@name='product_id']" position="before">
                <field name="product_image" widget="image" class="oe_avatar" string="Product Image"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='product_id']" position="before">
                <field name="product_image" widget="image" class="oe_avatar" string="Product Image"/>
            </xpath>
            <xpath expr="//field[@name='show_update_fpos']" position="before">
                <field name="product_print" string="Print Product Image"/>
            </xpath>
         </field>
    </record>

</odoo>
