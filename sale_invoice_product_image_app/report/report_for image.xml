<?xml version="1.0"?>
<odoo>
     <template id="report_inherit_sale_image" inherit_id="sale.report_saleorder_document">
            <xpath expr="//th[@name='th_description']" position="before">
                <t t-if="doc.product_print!= False">
                <th>Product Image </th>
            </t>
            </xpath>
             <xpath expr="//tbody/t[2]/tr/t[1]/td[1]" position="before">
                <t t-if="doc.product_print!= False">
                    <td class="text-center">
                        <span class="text-center">
                            <img t-if="line.product_image" t-att-src="image_data_uri(line.product_image)" style="max-height: 50px;max-width:50px;" alt="image"/>
                    </span>
                    </td>
                </t>                
            </xpath>
       </template>
        
</odoo>
