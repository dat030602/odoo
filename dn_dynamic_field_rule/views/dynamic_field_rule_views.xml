<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dynamic_field_rule_list" model="ir.ui.view">
        <field name="name">dynamic.field.rule.list</field>
        <field name="model">dynamic.field.rule</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="priority"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="apply_form"/>
                <field name="apply_tree"/>
                <field name="apply_kanban"/>
            </list>
        </field>
    </record>

    <record id="view_dynamic_field_rule_search" model="ir.ui.view">
        <field name="name">dynamic.field.rule.search</field>
        <field name="model">dynamic.field.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <field name="user_ids"/>
                <field name="group_ids"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="form" string="Form" domain="[('apply_form', '=', True)]"/>
                <filter name="tree" string="Tree" domain="[('apply_tree', '=', True)]"/>
                <filter name="kanban" string="Kanban" domain="[('apply_kanban', '=', True)]"/>
                <group>
                    <filter name="group_by_model" string="Model" context="{'group_by': 'model_id'}"/>
                    <filter name="group_by_priority" string="Priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dynamic_field_rule_form" model="ir.ui.view">
        <field name="name">dynamic.field.rule.form</field>
        <field name="model">dynamic.field.rule</field>
        <field name="arch" type="xml">
            <form string="Dynamic Field Rule">
                <sheet>
                    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True" />
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="priority"/>
                        </group>
                        <group string="Apply On">
                            <field name="apply_form"/>
                            <field name="apply_tree"/>
                            <field name="apply_kanban"/>
                        </group>
                    </group>

                    <group>
                        <group string="Users &amp; Groups">
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group string="Rule Notes">
                            <field name="condition" placeholder="state != 'draft'"/>
                            <field name="description" placeholder="Internal note for admins..."/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Field Rules" name="field_rules">
                            <field name="rule_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="field_id" domain="[('model_id', '=', parent.model_id)]"/>
                                    <field name="field_required" readonly="1"/>
                                    <field name="required"/>
                                    <field name="readonly"/>
                                    <field name="invisible"/>
                                    <field name="force"/>
                                    <field name="summary" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Preview" name="preview">
                            <group>
                                <field name="preview_text" nolabel="1" readonly="1" widget="text"/>
                            </group>
                        </page>
                        <page string="Affected Fields" name="affected_fields">
                            <group>
                                <field name="affected_field_summary" nolabel="1" readonly="1" widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dynamic_field_rule" model="ir.actions.act_window">
        <field name="name">Dynamic Field Rules</field>
        <field name="res_model">dynamic.field.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dynamic_field_rule_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <menuitem
        id="menu_dynamic_field_rule_root"
        name="Dynamic Field Rules"
        parent="base.menu_administration"
        action="action_dynamic_field_rule"
        sequence="65"
        groups="base.group_system"
    />
</odoo>
