<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Account Move Form View -->
        <record id="view_account_move_form_inherit" model="ir.ui.view">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <div class="oe_button_box" position="inside">
                    <button name="action_view_xml_import" type="object" class="oe_stat_button" icon="fa-file-code-o" 
                            invisible="xml_import_id == False">
                        <field name="xml_import_id" widget="statinfo" string="Source XML"/>
                    </button>
                </div>
                <field name="invoice_date" position="after">
                    <field name="xml_import_id" readonly="1" invisible="xml_import_id == False"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
