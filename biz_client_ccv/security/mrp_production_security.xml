<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp.group_mrp_user" model="res.groups">
        <field name="implied_ids" eval="[(6, 0, [ref('stock.group_stock_user')])]"/>
    </record>

    <record id="group_mrp_manager_production" model="res.groups">
        <field name="name">Manager Production</field>
        <field name="category_id" ref="base.module_category_manufacturing_manufacturing"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <record id="mrp.group_mrp_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user')), (4, ref('biz_client_ccv.group_mrp_manager_production'))]"/>
    </record>

    <record model="ir.rule" id="production_user_warehouse_rule">
        <field name="name">MRP Productions User Warehouse</field>
        <field name="model_id" ref="model_mrp_production"/>
        <field name="domain_force">[('user_id', '=', user.id), ('picking_type_id.warehouse_id', 'in', user.stock_warehouse_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <record model="ir.rule" id="production_manager_production_warehouse_rule">
        <field name="name">MRP Productions Manager Production Warehouse</field>
        <field name="model_id" ref="model_mrp_production"/>
        <field name="domain_force">[('picking_type_id.warehouse_id', 'in', user.stock_warehouse_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('biz_client_ccv.group_mrp_manager_production'))]"/>
    </record>

    <record model="ir.rule" id="production_manager_warehouse_rule">
        <field name="name">MRP Productions Manager Warehouse</field>
        <field name="model_id" ref="model_mrp_production"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
    </record>
</odoo>