    <record id="res_users_view_form_inherit_biz_client_ccv" model="ir.ui.view">
        <field name="name">res.users.form.inherit.biz.client.ccv</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <group name="Warehouses" position="inside">
                <field name="stock_warehouse_ids" widget="many2many_tags" groups="base.group_system" options="{'no_create': True}"/>
            </group>
            <xpath expr="//div[@class='oe_title']//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>
