<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.client.ccv</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_preview_production" type="object" class="oe_stat_button" icon="fa-globe icon">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Production</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>
  
    <record id="sale_timesheet.timesheet_report_sale_order" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="sale_renting.action_report_rental_saleorder" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>
  
</odoo>