<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai_import" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.import</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="65"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI Settings" string="AI Integration" name="dn_ai_document_import">
                    <block title="AI Providers &amp; API Keys" id="ai_providers_block">
                        <setting title="Google Gemini API Key" help="Used for Gemini 2.5 multimodal OCR &amp; document extraction">
                            <field name="google_key_enabled"/>
                            <div class="content-group">
                                <div class="mt8">
                                    <field name="google_key" password="True" placeholder="Paste your Google Gemini API key here..."/>
                                </div>
                            </div>
                        </setting>
                        <setting title="OpenAI API Key" help="Used for GPT-4.1 / GPT-5 document extraction">
                            <field name="openai_key_enabled"/>
                            <div class="content-group">
                                <div class="mt8">
                                    <field name="openai_key" password="True" placeholder="Paste your OpenAI API key here..."/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
