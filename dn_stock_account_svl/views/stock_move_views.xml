<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_dn_svl" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.dn.svl</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="dn_svl_count" invisible="1"/>
                <button name="action_dn_view_svl"
                        type="object"
                        string="Valuation"
                        class="oe_stat_button"
                        icon="fa-dollar"
                        groups="stock.group_stock_manager"
                        invisible="dn_svl_count == 0"/>
            </xpath>
        </field>
    </record>
</odoo>
