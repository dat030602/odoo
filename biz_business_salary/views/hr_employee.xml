<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="hr_employee_view_form_inherit_biz_business_salary" model="ir.ui.view">
        <field name="name">hr.employee.view.form.biz_business_salary</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='resource_calendar_id']" position="before">
                <field name="automatically_calculate_overtime" />
                <field name="default_enough_work"/>
                <field name="skip_timekeeping_machine"/>
                <field name="is_manager_sales"/>
            </xpath>
        </field>
    </record>
</odoo>