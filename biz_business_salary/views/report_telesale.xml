<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_report_telesale_tree" model="ir.ui.view">
        <field name="name">report.telesale.tree</field>
        <field name="model">report.telesale</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </tree>
        </field>
    </record>

    <record id="view_report_telesale_form" model="ir.ui.view">
        <field name="name">report.telesale.form</field>
        <field name="model">report.telesale</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="KPI summary" name="action_kpi_summary" type="object" class="oe_highlight"/>
                    <button string="Salary Calculation" name="salary_calculation" type="object" class="oe_highlight"/>
                    <button string="Export to Excel" name="export_to_excel" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <notebook>
                        <page string="Report Telesale" name="report_telesale">
                            <field name="line_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_report_telesale" model="ir.actions.act_window">
        <field name="name">KPI Salary for TeleSale</field>
        <field name="res_model">report.telesale</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_report_telesale"
        name="KPI Salary for TeleSale"
        parent="menu_common_telesale"
        sequence="20"
        action="action_report_telesale"
        />

</odoo>
