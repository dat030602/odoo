        <!-- Activity Templates for Attachment Reminder -->
        <record id="attachment_reminder_activity_template" model="mail.activity.type">
            <field name="name">Attachment Reminder</field>
            <field name="category">upload_file</field>
            <field name="icon">fa-paperclip</field>
            <field name="decoration_type">warning</field>
            <field name="sequence">100</field>
            <field name="delay_count">0</field>
            <field name="delay_from">current_date</field>
            <field name="summary">Missing Attachment?</field>
            <field name="default_note">It seems you may have forgotten to attach a file to this message. The content mentions attachments but no files were uploaded.</field>
        </record>
        
