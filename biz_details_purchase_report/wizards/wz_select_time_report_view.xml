<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wz_select_time_report_view_form" model="ir.ui.view">
        <field name="name">wz.select.time.report.view.form</field>
        <field name="model">wz.select.time.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="warehouse_ids" widget="many2many_tags"/>
                        <field name="creator_id"/>
                    </group>              
                    <group>
                        <field name="date_to"/>
                        <field name="accountant_chief_id"/>
                        <field name="unit_head_id"/>
                    </group>
                </group>
                
                <footer>
                    <button string="Export Excel" name="%(biz_details_purchase_report.action_details_purchase_report_xlsx)d" type="action" class="btn-primary"/>
                    <button string="Export PDF" name="%(biz_details_purchase_report.action_details_purchase_report_pdf)d" type="action" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id='action_wz_select_time_report' model='ir.actions.act_window'>
        <field name='name'>Details purchase report</field>
        <field name="type">ir.actions.act_window</field>
        <field name='res_model'>wz.select.time.report</field>
        <field name='view_mode'>form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_wz_select_time_report"
        parent="account.account_reports_legal_statements_menu"
        action="action_wz_select_time_report"
        name="Details purchase report"
    />
</odoo>