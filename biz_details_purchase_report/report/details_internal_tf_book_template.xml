<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="details_internal_tf_book_pdf_template">
        <t t-call="web.basic_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="company" t-value="o.env.company"/>
            <div class="header" style="font-family: 'Times New Roman';font-size:15px;">
                <div class="row" style="position: relative;">
                    <div style="justify-content: left; align-items: center;position: absolute">
                        <img t-att-src="image_data_uri(company.logo)" style="max-height: 70px;max-width: 90%"/>
                    </div>
                    <div class="col-12" style="height: 0px;">
                        <div class="" style="padding: 30px 0px 0 130px !important;">
                            <span/><span t-esc="company.name"/> - Mã số thuế: <span t-esc="company.vat"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Totals accumulators -->
            <t t-set="sum_quantity" t-value="0"/>
            <t t-set="sum_amount_total_w_currency" t-value="0"/>
            <t t-set="sum_amount_total" t-value="0"/>
            <t t-set="sum_return_quantity" t-value="0"/>
            <t t-set="sum_amount_total_return_w_currency" t-value="0"/>
            <t t-set="sum_amount_total_return" t-value="0"/>

            <div class="page" style="font-family: 'Times New Roman';font-size:12px; line-height: 22px">
                <div class="text-center">
                    <h5 class="bold">SỔ CHI TIẾT NHẬP HÀNG TẠI CẢNG</h5>
                    <h6 class="bold italic">
                        Kho: <t t-esc="', '.join(o.warehouse_ids.mapped('name')) if o.warehouse_ids else 'Tất cả'"/>
                        &amp;nbsp;|&amp;nbsp;
                        Từ ngày <span t-esc="o.date_from and o.date_from.strftime('%d/%m/%Y') or ''"/>
                        đến ngày <span t-esc="o.date_to and o.date_to.strftime('%d/%m/%Y') or ''"/>
                    </h6>
                </div>

                <table class="table-line">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 3%">STT</th>
                            <th class="text-center" style="width: 5%">Ngày CT</th>
                            <th class="text-center" style="width: 6%">Số CT</th>
                            <th class="text-center" style="width: 10%">Nhà cung cấp</th>
                            <th class="text-center" style="width: 5%">Mã hàng</th>
                            <th class="text-center" style="width: 10%">Tên hàng</th>
                            <th class="text-center" style="width: 3%">ĐVT</th>
                            <th class="text-center" style="width: 4%">SL nhập</th>
                            <th class="text-center" style="width: 4%">Tỷ giá</th>
                            <th class="text-center" style="width: 4%">ĐG NT</th>
                            <th class="text-center" style="width: 4%">Đơn giá</th>
                            <th class="text-center" style="width: 5%">GT mua NT</th>
                            <th class="text-center" style="width: 5%">GT mua</th>
                            <th class="text-center" style="width: 3%">Mã kho</th>
                            <th class="text-center" style="width: 4%">TK Kho</th>
                            <th class="text-center" style="width: 4%">TK ĐƯ</th>
                            <th class="text-center" style="width: 6%">Đơn MH</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.line_ids" t-as="line">
                            <t t-set="sum_quantity"                      t-value="sum_quantity + line.quantity"/>
                            <t t-set="sum_amount_total_w_currency"       t-value="sum_amount_total_w_currency + line.amount_total_w_currency"/>
                            <t t-set="sum_amount_total"                  t-value="sum_amount_total + line.amount_total"/>
                            <t t-set="sum_return_quantity"               t-value="sum_return_quantity + line.return_quantity"/>
                            <t t-set="sum_amount_total_return_w_currency" t-value="sum_amount_total_return_w_currency + line.amount_total_return_w_currency"/>
                            <t t-set="sum_amount_total_return"           t-value="sum_amount_total_return + line.amount_total_return"/>
                            <tr>
                                <td class="text-center vertical"><span t-esc="line_index + 1"/></td>
                                <td class="text-center vertical word"><span t-esc="line.date and line.date.strftime('%d/%m/%Y') or ''"/></td>
                                <td class="text-left vertical word" style="color: #0000FF;"><span t-esc="line.name or ''"/></td>
                                <td class="text-left vertical word"><span t-esc="line.partner_name or ''"/></td>
                                <td class="text-left vertical word"><span t-esc="line.product_code or ''"/></td>
                                <td class="text-left vertical word"><span t-esc="line.product_name or ''"/></td>
                                <td class="text-center vertical word"><span t-esc="line.uom_name or ''"/></td>
                                <td class="text-right vertical word"><span t-esc="format_float_number(line.quantity)"/></td>
                                <td class="text-right vertical word"><span t-esc="format_float_number(line.exchange_rate)"/></td>
                                <td class="text-right vertical word"><span t-esc="format_float_number(line.price_unit_w_currency)"/></td>
                                <td class="text-right vertical word"><span t-esc="format_float_number(line.price_unit)"/></td>
                                <td class="text-right vertical word"><span t-esc="format_float_number(line.amount_total_w_currency)"/></td>
                                <td class="text-right vertical word"><span t-esc="format_float_number(line.amount_total)"/></td>
                                <td class="text-center vertical word"><span t-esc="line.warehouse_code or ''"/></td>
                                <td class="text-center vertical word"><span t-esc="line.account or ''"/></td>
                                <td class="text-center vertical word"><span t-esc="line.account_ctp or ''"/></td>
                                <td class="text-left vertical word"><span t-esc="line.order_name or ''"/></td>
                            </tr>
                        </t>
                        <!-- Dòng tổng cộng -->
                        <tr>
                            <td colspan="7" class="text-left vertical bold">Tổng cộng</td>
                            <td class="text-right bold word"><span t-esc="format_float_number(sum_quantity)"/></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td class="text-right bold word"><span t-esc="format_float_number(sum_amount_total_w_currency)"/></td>
                            <td class="text-right bold word"><span t-esc="format_float_number(sum_amount_total)"/></td>
                            <td></td><td></td><td></td><td></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Phần ký tên -->
            <div style="page-break-inside: avoid; font-family: 'Times New Roman';font-size:14px; line-height: 25px" class="mt-3">
                <div class="row italic text-right">
                    <div class="col-10"/>
                    <div class="col-2 text-center">
                        <p>Ngày <t t-esc="datetime.datetime.now().strftime('%d')"/> tháng <t t-esc="datetime.datetime.now().strftime('%m')"/> năm <t t-esc="datetime.datetime.now().strftime('%Y')"/></p>
                    </div>
                </div>
                <div class="clearfix text-center" style="page-break-inside: avoid;">
                    <div style="width: 20%; float: left;">
                        <strong>Người lập</strong><br/>
                        <t t-if="o.state == 'approved' and o.sudo().voter_id.sign_signature">
                            <br/>
                            <img t-att-src="image_data_uri(o.sudo().voter_id.sign_signature)" style="width: 100px; height: 40px;"/>
                        </t>
                        <t t-else=""><br/><br/><br/><br/></t>
                        <br/>
                        <strong><t t-esc="o.sudo().voter_id.name_without_position if o.voter_id else ''"/></strong>
                    </div>
                    <div style="width: 20%; float: left;">
                        <strong>Phòng Thương mại</strong><br/>
                        <t t-if="o.state == 'approved' and o.sudo().chief_trade_id.sign_signature">
                            <br/>
                            <img t-att-src="image_data_uri(o.sudo().chief_trade_id.sign_signature)" style="width: 100px; height: 40px;"/>
                        </t>
                        <t t-else=""><br/><br/><br/><br/></t>
                        <br/>
                        <strong><t t-esc="o.sudo().chief_trade_id.name_without_position if o.chief_trade_id else ''"/></strong>
                    </div>
                    <div style="width: 20%; float: left;">
                        <strong>Phòng Kế toán</strong><br/>
                        <t t-if="o.state == 'approved' and o.sudo().accounting_department_id.sign_signature">
                            <br/>
                            <img t-att-src="image_data_uri(o.sudo().accounting_department_id.sign_signature)" style="width: 100px; height: 40px;"/>
                        </t>
                        <t t-else=""><br/><br/><br/><br/></t>
                        <br/>
                        <strong><t t-esc="o.sudo().accounting_department_id.name_without_position if o.accounting_department_id else ''"/></strong>
                    </div>
                    <div style="width: 20%; float: left;">
                        <strong>Kế toán trưởng</strong><br/>
                        <t t-if="o.state == 'approved' and o.sudo().chief_finance_id.sign_signature">
                            <br/>
                            <img t-att-src="image_data_uri(o.sudo().chief_finance_id.sign_signature)" style="width: 100px; height: 40px;"/>
                        </t>
                        <t t-else=""><br/><br/><br/><br/></t>
                        <br/>
                        <strong><t t-esc="o.sudo().chief_finance_id.name_without_position if o.chief_finance_id else ''"/></strong>
                    </div>
                    <div style="width: 20%; float: left;">
                        <strong>Thủ trưởng đơn vị</strong><br/>
                        <t t-if="o.state == 'approved' and o.sudo().director_id.sign_signature">
                            <br/>
                            <img t-att-src="image_data_uri(o.sudo().director_id.sign_signature)" style="width: 100px; height: 40px;"/>
                        </t>
                        <t t-else=""><br/><br/><br/><br/></t>
                        <br/>
                        <strong><t t-esc="o.sudo().director_id.name_without_position if o.director_id else ''"/></strong>
                    </div>
                </div>
            </div>

            <div class="footer">
                <div class="row" style="font-family: 'Times New Roman'; font-size: 13px;">
                    <div class="col-12 text-right" style="text-align: right;">
                        <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </div>

            <style>
                .table-line { width: 100%; }
                .table-line > :not(:first-child) { border-top: 0px solid currentColor; }
                .table-line tr, th, td { border: 1px solid #000; padding: 2px; }
                .table-line > thead > tr > th { line-height: normal; vertical-align: middle; }
                .vertical { vertical-align: middle; }
                .word { word-wrap: break-word; word-break: break-word; white-space: normal; }
                .text-center { text-align: center; }
                .text-right { text-align: right; }
                .text-left { text-align: left; }
                .italic { font-style: italic; }
                .bold { font-weight: bold; }
                .margin-p { margin: 0px }
                .page-break { page-break-before: always; }
            </style>
        </t>
    </template>

    <template id="int_tf_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="biz_details_purchase_report.details_internal_tf_book_pdf_template" t-lang="o.env.user.lang"/>
            </t>
        </t>
    </template>
</odoo>
