<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template Mẫu Ngoài Nước -->
        <template id="details_accounts_payable_book_template_out">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="biz_details_purchase_report.details_accounts_payable_book_document_out"/>
                </t>
            </t>
        </template>

        <template id="details_accounts_payable_book_document_out">
            <t t-call="ccv_sql.ccv_header">
                <div class="page" style="font-size: 14px;font-family: Times New Roman">
                    <div class="col-xs-12" style="text-align: center; font-size: 20px;">
                        <strong>Chi Tiết Công Nợ Phải Trả</strong>
                    </div>
                    <div class="col-xs-12" style="text-align: center; margin-top: 10px;">
                        <strong>Từ ngày &amp;nbsp;<t t-esc="doc.convert_print(doc.date_from)"/>&amp;nbsp; đến ngày &amp;nbsp;<t t-esc="doc.convert_print(doc.date_to)"/></strong>
                    </div>
                    <div class="row">
                        <table class="table table-sm fixed" style="border: solid 1px;width: 100%; margin-top: 10px;">
                            <col width="5%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <tr>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>STT</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Mã NCC</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Ngày chứng từ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Số chứng từ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Ngày hóa đơn</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Số hóa đơn</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Số lượng</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Đơn giá</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Diễn giải</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>TK công nợ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>TK đối ứng</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" colspan="2">
                                    <strong>Phát sinh</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" colspan="2">
                                    <strong>Số dư</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>ĐVT</strong>
                                </td>
                            </tr>
                            <tr>
                                <td style="text-align: center; vertical-align: middle;"><strong>Nợ</strong></td>
                                <td style="text-align: center; vertical-align: middle;"><strong>Có</strong></td>
                                <td style="text-align: center; vertical-align: middle;"><strong>Nợ</strong></td>
                                <td style="text-align: center; vertical-align: middle;"><strong>Có</strong></td>
                            </tr>

                            <t t-set="number" t-value="0"/>
                            <t t-foreach="doc.line_ids" t-as="line">
                                <t t-set="number" t-value="number + 1"/>
                                <tr>
                                    <td style="text-align: center; vertical-align: middle;"><span t-esc="number"/></td>
                                    <td style="text-align: left;"><span t-esc="line.partner_code"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-esc="doc.convert_print(line.date)"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-esc="line.move_id.name if line.move_id else ''"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-esc="doc.convert_print(line.invoice_date)"/></td>
                                    <td style="text-align: center; vertical-align: middle;"><span t-esc="line.reference"/></td>
                                    
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.product_uom_qty > 0"><span t-esc="doc.convert_number(line.product_uom_qty)"/></t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.price_unit > 0"><span t-esc="doc.convert_vnd(line.price_unit)"/></t>
                                    </td>
                                    
                                    <td style="text-align: center; vertical-align: middle;"><span t-esc="line.note"/></td>
                                    <td style="text-align: left; vertical-align: middle;"><span t-esc="line.account_id.code if line.account_id else ''"/></td>
                                    <td style="text-align: left; vertical-align: middle;"><span t-esc="line.account_dest_id.code if line.account_dest_id else ''"/></td>
                                    
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.debit > 0"><span t-esc="doc.convert_vnd(line.debit)"/></t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.credit > 0"><span t-esc="doc.convert_vnd(line.credit)"/></t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.end_debit > 0"><span t-esc="doc.convert_vnd(line.end_debit)"/></t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.end_credit > 0"><span t-esc="doc.convert_vnd(line.end_credit)"/></t>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span t-esc="line.uom_id.name if line.uom_id else ''"/>
                                    </td>
                                </tr>
                            </t>
                            
                            <tr>
                                <td colspan="6" style="text-align: left;"><strong>Tổng cộng</strong></td>
                                <td style="text-align: right;">
                                    <t t-if="sum(doc.line_ids.mapped('product_uom_qty')) > 0">
                                        <strong><span t-esc="doc.convert_vnd(sum(doc.line_ids.mapped('product_uom_qty')))"/></strong>
                                    </t>
                                </td>
                                <td style="text-align: right;"></td>
                                <td style="text-align: right;"></td>
                                <td style="text-align: right;"></td>
                                <td style="text-align: right;"></td>
                                <td style="text-align: right;">
                                    <t t-if="sum(doc.line_ids.mapped('debit')) > 0">
                                        <strong><span t-esc="doc.convert_vnd(sum(doc.line_ids.mapped('debit')))"/></strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="sum(doc.line_ids.mapped('credit')) > 0">
                                        <strong><span t-esc="doc.convert_vnd(sum(doc.line_ids.mapped('credit')))"/></strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="sum(doc.line_ids.mapped('end_debit')) > 0">
                                        <strong><span t-esc="doc.convert_vnd(sum(doc.line_ids.mapped('end_debit')))"/></strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="sum(doc.line_ids.mapped('end_credit')) > 0">
                                        <strong><span t-esc="doc.convert_vnd(sum(doc.line_ids.mapped('end_credit')))"/></strong>
                                    </t>
                                </td>
                                <td style="text-align: right;"></td>
                            </tr>
                        </table>
                    </div>
                    
                    <div class="row rowp" style="padding-top: 10px; margin-left: 2px;text-align: center;">
                        <div class="col-8"></div>
                        <div class="col-4"><span>Ngày <t t-esc="datetime.datetime.now().strftime('%d')"/> tháng <t t-esc="datetime.datetime.now().strftime('%m')"/> năm <t t-esc="datetime.datetime.now().strftime('%Y')"/></span></div>
                    </div>
                    
                    <div class="row rowp" style="padding-top: 2px; margin-left: 2px;text-align: center;">
                        <div class="col-3">
                            <span><strong>Người lập phiếu</strong></span><br/>
                            <t t-if="doc.state == 'approved' and doc.sudo().voter_id.sign_signature">
                                <br/><img t-att-src="image_data_uri(doc.sudo().voter_id.sign_signature)" style="width: 100px; height: 40px;"/><br/>
                            </t>
                            <t t-else=""><br/><br/><br/></t>
                            <t t-if="doc.voter_id"><strong><span t-esc="doc.sudo().voter_id.name_without_position if doc.voter_id else ''"/></strong></t>
                        </div>
                        <div class="col-3">
                            <span><strong>Trưởng phòng thương mại</strong></span><br/>
                            <t t-if="doc.state == 'approved' and doc.sudo().department_head_id.sign_signature">
                                <br/><img t-att-src="image_data_uri(doc.sudo().department_head_id.sign_signature)" style="width: 100px; height: 40px;"/><br/>
                            </t>
                            <t t-else=""><br/><br/><br/></t>
                            <t t-if="doc.department_head_id"><strong><span t-esc="doc.sudo().department_head_id.name_without_position if doc.department_head_id else ''"/></strong></t>
                        </div>
                        <div class="col-3">
                            <span><strong>Kế toán trưởng</strong></span><br/>
                            <t t-if="doc.state == 'approved' and doc.sudo().chief_accountant_id.sign_signature">
                                <br/><img t-att-src="image_data_uri(doc.sudo().chief_accountant_id.sign_signature)" style="width: 100px; height: 40px;"/><br/>
                            </t>
                            <t t-else=""><br/><br/><br/></t>
                            <t t-if="doc.chief_accountant_id"><strong><span t-esc="doc.sudo().chief_accountant_id.name_without_position if doc.chief_accountant_id else ''"/></strong></t>
                        </div>
                        <div class="col-3">
                            <span><strong>Thủ trưởng đơn vị</strong></span><br/>
                            <t t-if="doc.state == 'approved' and doc.sudo().director_id.sign_signature">
                                <br/><img t-att-src="image_data_uri(doc.sudo().director_id.sign_signature)" style="width: 100px; height: 40px;"/><br/>
                            </t>
                            <t t-else=""><br/><br/><br/></t>
                            <t t-if="doc.director_id"><strong><span t-esc="doc.sudo().director_id.name_without_position if doc.director_id else ''"/></strong></t>
                        </div>
                    </div>
                </div>
            </t>
        </template>


