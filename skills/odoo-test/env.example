# Copy to .env (or add these ODOO_* keys to your project .env / .agents/.env).
# The database name MUST contain "test" - the helpers refuse to run otherwise.
ODOO_TEST_DB=odoo19
ODOO_USER=admin
ODOO_PASSWORD=admin

# Optional
# ODOO_TEST_PORT=8070        # background test server (XML-RPC scenarios)
# ODOO_UNIT_PORT=8071        # unit-test run (must differ from the debug instance and the test server)
# ODOO_TEST_ACTION=-i        # first run on a new DB; use -u after the module is installed
# ODOO_TEST_LOGDIR=/tmp
# ODOO_ROOT=/opt/odoo        # folder that contains odoo-bin (auto-detected by default)
# ODOO_CONF=/opt/odoo/odoo.conf
# ODOO_PYTHON=/opt/odoo/venv/bin/python3
