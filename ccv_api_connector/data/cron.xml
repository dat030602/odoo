<odoo>
    <data noupdate="1">
        <record id="ir_cron_npk_weighing_factory_sync" model="ir.cron">
            <field name="name">NPK Weighing: Sync Factories</field>
            <field name="model_id" ref="model_npk_weighing_factory"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_factory()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_npk_weighing_machine_sync" model="ir.cron">
            <field name="name">NPK Weighing: Sync Machines</field>
            <field name="model_id" ref="model_npk_weighing_machine"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_machine()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_npk_weighing_history_sync" model="ir.cron">
            <field name="name">NPK Weighing: Sync History</field>
            <field name="model_id" ref="model_npk_weighing_history"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_history()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_sale_vehicle_in_out_send_to_conveyor" model="ir.cron">
            <field name="name">Sale Vehicle In/Out: Send to Conveyor</field>
            <field name="model_id" ref="model_sale_vehicle_in_out"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_to_conveyor()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
