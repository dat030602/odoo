<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree views -->
    <record id="view_sale_vehicle_map_tree" model="ir.ui.view">
        <field name="name">sale.vehicle.mapping.tree</field>
        <field name="model">sale.vehicle.mapping</field>
        <field name="arch" type="xml">
            <tree edit="1" editable="bottom">
                <field name="name"/>
                <field name="model"/>
                <field name="key"/>
                <field name="record_id"/>
            </tree>
        </field>
    </record>
    <record id="action_sale_vehicle_map" model="ir.actions.act_window">
        <field name="name">Vehicle Mapping</field>
        <field name="res_model">sale.vehicle.mapping</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="view_sale_vehicle_conveyor_map_tree" model="ir.ui.view">
        <field name="name">sale.vehicle.conveyor.mapping.tree</field>
        <field name="model">sale.vehicle.conveyor.mapping</field>
        <field name="arch" type="xml">
            <tree edit="1" editable="bottom">
                <field name="conveyor_gate"/>
                <field name="conveyor_line_id"/>
            </tree>
        </field>
    </record>

    <record id="action_sale_vehicle_conveyor_map" model="ir.actions.act_window">
        <field name="name">Băng tải mapping</field>
        <field name="res_model">sale.vehicle.conveyor.mapping</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
