<odoo>
    <!-- Tree views -->
    <record id="view_sale_vehicle_in_out_line_tree" model="ir.ui.view">
        <field name="name">sale.vehicle.in.out.line.tree</field>
        <field name="model">sale.vehicle.in.out.line</field>
        <field name="arch" type="xml">
            <tree class="ccv_auto_layout_tree" editable="bottom" delete="0" decoration-success="has_link_line==False and is_next_day==True and is_carried_over==False" decoration-danger="is_carried_over==True">
                <field name="is_baove_only" invisible="1"/>
                <field name="has_link_line" invisible="1"/>
                <field name="is_carried_over" invisible="1" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="has_loading" invisible="1"/>
                <field name="has_loading2" invisible="1"/>
                <field name="has_stocker" invisible="1"/>
                <field name="status" invisible="1"/>
                <button name="action_xac_nhan" string="Xác nhận xe đến" type="object" class="btn-info" attrs="{'invisible': ['|', ('status','=','lock'), ('canxe_status','!=','dang_ky')]}" groups="ccv_api_connector.group_admin,ccv_api_connector.group_vehicle_security,ccv_api_connector.group_vehicle_main_action"/>
                <button name="action_can_xong" string="Cân xong" type="object" class="btn-warning" attrs="{'invisible': ['|', ('status','=','lock'), ('canxe_status','!=','dang_cho')]}" groups="ccv_api_connector.group_admin,ccv_api_connector.group_vehicle_security,ccv_api_connector.group_vehicle_main_action"/>
                <button name="action_moi_vao" string="Mời vào" type="object" class="btn-primary" attrs="{'invisible': ['|', ('status','=','lock'), ('canxe_status','!=','chuan_bi')]}" groups="ccv_api_connector.group_admin,ccv_api_connector.group_vehicle_main_action,ccv_api_connector.group_vehicle_invite_only"/>
                <button name="action_xac_nhan_hoan_thanh" string="Xác nhận hoàn thành" type="object" class="btn-primary" attrs="{'invisible': ['|', ('status','=','lock'), ('canxe_status','!=','moi_vao')]}" groups="ccv_api_connector.group_admin,ccv_api_connector.group_vehicle_main_action,ccv_api_connector.group_vehicle_complete_only"/>
                <button name="action_xac_nhan_ra_cong" string="Xác nhận xe ra cổng" type="object" class="btn-danger" attrs="{'invisible': ['|', ('status','=','lock'), ('canxe_status','!=','xuat_nhap')]}" groups="ccv_api_connector.group_admin,ccv_api_connector.group_vehicle_out_confirm,ccv_api_connector.group_vehicle_security"/>
                <button name="dummy_action" string="Xe đã ra cổng" type="object" class="btn-success invisible" attrs="{'invisible': ['|', ('status','=','lock'), ('canxe_status','!=','hoan_thanh')]}"/>
                <field name="canxe_status" decoration-info="canxe_status == 'hoan_thanh'" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="name" readonly="1"/>
                <button name="action_open_popup" type="object" icon="fa-expand" title="Mở chi tiết (Pop-up)" class="btn-info" attrs="{'invisible': [('is_baove_only', '=', True)]}"/>
                <field name="type" readonly="1"/>
                <field name="partner_name" readonly="1"/>
                <field name="vehicle_num" readonly="1"/>
                <field name="gate" invisible="1"/>
                <field name="gate_id" optional="show" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="vehicle_driver" readonly="1"/>
                <field name="quantity" readonly="1"/>
                <field name="uom_id" readonly="1"/>
                <field name="quantity_plan" optional="show" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="bag_number" optional="show" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="date_in" optional="hide" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="loading" invisible="1"/>
                <field name="loading_id" optional="hide" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="loading2" invisible="1"/>
                <field name="loading2_id" optional="hide" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="stocker" invisible="1"/>
                <field name="stocker_id" optional="hide" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="date_start" optional="hide" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="date_end" optional="hide" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="bom_time" optional="hide" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="bom_time_over" optional="hide" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="note" invisible="1" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="user_note" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="quantity_bag" optional="show" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="quantity_stock" optional="show" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="quantity_done_stock" optional="show" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="is_next_day" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="next_day" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="create_at" optional="hide" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <button name="action_delete_self" type="object" icon="fa-trash" groups="base.group_system" string="" title="Xóa dòng" confirm="Bạn có chắc chắn muốn xóa dòng này không?" class="btn-dark" attrs="{'invisible': [('status','=','lock')]}"/>
            </tree>
        </field>
    </record>
    <!-- Form -->
    <record id="view_sale_vehicle_in_out_line_form" model="ir.ui.view">
        <field name="name">sale.vehicle.in.out.line.form</field>
        <field name="model">sale.vehicle.in.out.line</field>
        <field name="arch" type="xml">
            <form>
                <field name="is_baove_only" invisible="1"/>
                <field name="has_loading" invisible="1"/>
                <field name="has_loading2" invisible="1"/>
                <field name="has_stocker" invisible="1"/>
                <field name="status" invisible="1"/>
                <field name="has_link_line" invisible="1"/>
                <header>
                    <button name="action_create_next_day" type="object" string="Chuyển ngày" attrs="{'invisible':['|',('is_next_day','=', False),'|',('status','=', 'lock'),('has_link_line','=', True)]}"/>
                    <button name="action_update_fields_to_picking" type="object" string="Cập nhật B_Xếp,T_Kho" attrs="{'invisible': [('stocker_id','=', False), ('loading_id','=', False), ('vehicle_driver','=', False), ('vehicle_num','=', False)]}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object" class="oe_stat_button" attrs="{'invisible': [('sale_order_ids', '=', []), ('purchase_order_ids', '=', [])]}" icon="fa-truck" string="Phiếu kho"/>
                        <button name="action_view_sale_orders" type="object" class="oe_stat_button" attrs="{'invisible': [('sale_order_ids', '=', [])]}" icon="fa-shopping-cart" string="Đơn bán hàng"/>
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button" attrs="{'invisible': [('purchase_order_ids', '=', [])]}" icon="fa-shopping-cart" string="Đơn mua hàng"/>
                    </div>
                    <group>
                        <group>
                            <field name="canxe_status" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="name" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="type" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="sale_order_ids" widget="many2many_tags" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')], 'invisible': [('type', '=', 'in')]}"/>
                            <field name="purchase_order_ids" widget="many2many_tags" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')], 'invisible': [('type', '=', 'out')]}"/>
                            <field name="picking_id" widget="many2many_tags" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="sale_vehicle_check_picking" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="partner_name" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="vehicle_num" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="vehicle_driver" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="quantity" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="uom_id" domain="[('category_id','=',7)]" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="quantity_plan" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="bag_number" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="note" invisible="1" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                            <field name="user_note" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="quantity_bag" readonly="1"/>
                            <field name="quantity_stock" readonly="1"/>
                            <field name="quantity_done_stock" readonly="1"/>
                            <field name="uom_number" readonly="1" invisible="1"/>
                            <field name="to_push" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="is_next_day" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="next_day" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')], 'invisible': [('is_next_day', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="date_in" readonly="1"/>
                            <field name="gate" invisible="1"/>
                            <field name="gate_id" attrs="{'readonly':[('status','=', 'lock')]}"/>
                            <field name="loading" invisible="1"/>
                            <field name="loading_id" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="loading2" invisible="1"/>
                            <field name="loading2_id" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="stocker" invisible="1"/>
                            <field name="stocker_id" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="date_start" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                            <field name="bom_time" readonly="1"/>
                            <field name="bom_time_over" readonly="1"/>
                            <field name="odoo_tl_bao_bi" readonly="1" digits="[16, 5]"/>
                            <field name="weighing_order_id" string="Mã cân tham chiếu" attrs="{'readonly': ['|', ('is_baove_only', '=', True), ('status', '=', 'lock')]}"/>
                            <field name="weighing_history_ids" readonly="1" force_save="1"/>
                            <field name="can_ip" string="IP máy cân" placeholder="e.g. 192.168.1.48" readonly="0" force_save="1" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                            <div colspan="2">
                                <button name="action_gui_lenh_can" string="Gửi lệnh cân" type="object" class="btn-primary"/>
                            </div>
                            <field name="weighing_so_phieu" readonly="1"/>
                            <field name="weighing_tl_lan1" readonly="1" digits="[16, 3]"/>
                            <field name="weighing_tl_lan2" readonly="1" digits="[16, 3]"/>
                            <field name="weighing_tl_hang" readonly="1" digits="[16, 3]"/>
                            <field name="weighing_tl_bao_bi" readonly="1" digits="[16, 3]"/>
                            <field name="weighing_tl_sau_tru_bao_bi" readonly="1" digits="[16, 3]"/>
                            <field name="weighing_ngay_can_1" readonly="1"/>                            
                            <field name="weighing_ngay_can_2" readonly="1"/>
                            <field name="weighing_nhan_vien" readonly="1"/>
                            <field name="weighing_nhan_vien_bam_can" readonly="1"/>
                            <field name="weighing_is_export" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
            
        </field>
    </record>

    <record id="view_sale_vehicle_in_out_line_kanban" model="ir.ui.view">
        <field name="name">sale.vehicle.in.out.line.kanban</field>
        <field name="model">sale.vehicle.in.out.line</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="is_baove_only" invisible="1"/>
                <field name="name" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="type" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="sale_order_ids" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="purchase_order_ids" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="partner_name" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="vehicle_num" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="vehicle_driver" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="quantity" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="uom_id" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="note" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="user_note" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="uom_number" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="is_next_day" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                <field name="status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            Mã phiếu: <field name="name" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            Loại: <field name="type" attrs="{'readonly': [('is_baove_only', '=', True)]}"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="o_kanban_record_details">
                                        <div class="o_kanban_details">
                                            <div class="o_kanban_details_row">
                                                <span class="o_kanban_details_label">Đối tác: <field name="partner_name" attrs="{'readonly': [('is_baove_only', '=', True)]}"/></span>
                                            </div>
                                            <div class="o_kanban_details_row">
                                                <span class="o_kanban_details_label">Số xe: <field name="vehicle_num" attrs="{'readonly': [('is_baove_only', '=', True)]}"/></span>
                                            </div>
                                            <div class="o_kanban_details_row">
                                                <span class="o_kanban_details_label">Tài xế: <field name="vehicle_driver" attrs="{'readonly': [('is_baove_only', '=', True)]}"/></span>
                                            </div>
                                            <div class="o_kanban_details_row">
                                                <span class="o_kanban_details_label">Số lượng: <field name="quantity" attrs="{'readonly': [('is_baove_only', '=', True)]}"/> <field name="uom_id" attrs="{'readonly': [('is_baove_only', '=', True)]}"/></span>
                                            </div>
                                            <div class="o_kanban_details_row" attrs="{'invisible': [('user_note', '=', False)]}">
                                                <span class="o_kanban_details_label">Ghi chú: <field name="user_note" attrs="{'readonly': [('is_baove_only', '=', True)]}"/></span>
                                            </div>
                                            <div class="o_kanban_details_row" attrs="{'invisible': [('is_next_day', '=', False)]}">
                                                <span class="o_kanban_details_label">Ngày hôm sau: <field name="is_next_day" attrs="{'readonly': [('is_baove_only', '=', True)]}"/></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_sale_vehicle_in_out_line" model="ir.actions.act_window">
        <field name="name">Vehicle In/Out</field>
        <field name="res_model">sale.vehicle.in.out.line</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>
</odoo>