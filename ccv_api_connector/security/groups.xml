<odoo>
    <data noupdate="True">
        <!-- Module category -->
        <record id="module_category_api_connector" model="ir.module.category">
        <field name="name">API Connector</field>
        <field name="description">Access groups for API integration and device connections</field>
        <field name="sequence">30</field>
    </record>

    <!-- User Group -->
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_api_connector"/>
    </record>

    <!-- Admin Group -->
    <record id="group_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="module_category_api_connector"/>
        <field name="implied_ids" eval="[(4, ref('ccv_api_connector.group_user'))]"/>
    </record>

    <!-- Warehouse Readonly Group cho Đăng ký xe -->
    <record id="group_vehicle_warehouse_readonly" model="res.groups">
        <field name="name">Nhóm Kho: Chỉ Xem Đăng Ký Xe</field>
        <field name="category_id" ref="module_category_api_connector"/>
    </record>

    <!-- Security Guard Group (Quản lý cổng) -->
    <record id="group_vehicle_security" model="res.groups">
        <field name="name">Nhóm Bảo vệ: Quản lý Cổng</field>
        <field name="category_id" ref="module_category_api_connector"/>
    </record>

    <!-- Group: Hành động chính -->
    <record id="group_vehicle_main_action" model="res.groups">
        <field name="name">Nhóm Bảo vệ: Hành động chính</field>
        <field name="category_id" ref="module_category_api_connector"/>
    </record>

    <!-- Group: Chỉ mời vào -->
    <record id="group_vehicle_invite_only" model="res.groups">
        <field name="name">Nhóm Bảo vệ: Chỉ mời vào</field>
        <field name="category_id" ref="module_category_api_connector"/>
    </record>

    <!-- Group: Chỉ Hoàn thành -->
    <record id="group_vehicle_complete_only" model="res.groups">
        <field name="name">Nhóm Bảo vệ: Chỉ Hoàn thành</field>
        <field name="category_id" ref="module_category_api_connector"/>
    </record>

    <!-- Group: Tạo và xác nhận ra cổng -->
    <record id="group_vehicle_out_confirm" model="res.groups">
        <field name="name">Nhóm Bảo vệ: Tạo và xác nhận</field>
        <field name="category_id" ref="module_category_api_connector"/>
    </record>
    </data>
</odoo>
