<odoo>
    <data>
        <record id="invoice_misa_stock_wizard_form_view" model="ir.ui.view">
            <field name="name">invoice.misa.stock.wizard.form</field>
            <field name="model">invoice.misa.stock.wizard</field>
            <field name="arch" type="xml">
                <form string="Tạo phiếu kho">
                    <group>
                        <field name="invoice_data_id" invisible="1"/>
                        <field name="purchase_order_ids" invisible="1"/>
                        <field name="purchase_order_id" required="1"/>
                        <field name="picking_type_id" required="1"/>
                        <field name="location_dest_id" required="1"/>
                        <field name="date" required="1"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom" create="0">
                            <field name="wizard_id" invisible="1"/>
                            <field name="purchase_line_id" invisible="1"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price_unit" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                        </tree>
                    </field>
                    <footer>
                        <button name="create_stock_moves" string="Tạo phiếu" type="object" class="oe_highlight"/>
                        <button string="Hủy" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_invoice_misa_stock_wizard" model="ir.actions.act_window">
            <field name="name">Tạo phiếu kho</field>
            <field name="res_model">invoice.misa.stock.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
