<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_mapping_data_product_tree" model="ir.ui.view">
            <field name="name">mapping.data.product.tree</field>
            <field name="model">mapping.data.product</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="keyword"/>
                    <field name="product_id"/>
                    <field name="account_id"/>
                    <field name="active" invisible="1"/>
                    <field name="note"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_mapping_data_product_form" model="ir.ui.view">
            <field name="name">mapping.data.product.form</field>
            <field name="model">mapping.data.product</field>
            <field name="arch" type="xml">
                <form string="Mapping Sản Phẩm">
                    <sheet>
                        <widget name="web_ribbon" title="Lưu trữ" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <div class="oe_title">
                            <h1>
                                <field name="keyword" placeholder="Từ khóa mapping"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Thông tin mapping">
                                <field name="keyword"/>
                                <field name="product_id"/>
                                <field name="account_id"/>
                                <field name="active" invisible="1"/>
                                <field name="create_auto" invisible="1"/>
                            </group>
                            <group string="Ghi chú">
                                <field name="note" nolabel="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_mapping_data_product_search" model="ir.ui.view">
            <field name="name">mapping.data.product.search</field>
            <field name="model">mapping.data.product</field>
            <field name="arch" type="xml">
                <search>
                    <field name="keyword"/>
                    <field name="product_id"/>
                    <filter string="Hoạt động" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Không hoạt động" name="inactive" domain="[('active', '=', False)]"/>
                    <filter name="filter_auto" string="Tạo tự động" domain="[('create_auto', '=', True)]" />
                    <filter name="filter_not_auto" string="Tạo thủ công" domain="[('create_auto', '=', False)]" />
                    <group expand="0" string="Group By">
                        <filter string="Sản phẩm" name="group_by_product" context="{'group_by': 'product_id'}"/>
                        <filter string="Trạng thái" name="group_by_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_mapping_data_product" model="ir.actions.act_window">
            <field name="name">Mapping Sản Phẩm</field>
            <field name="res_model">mapping.data.product</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_mapping_data_product_tree"/>
            <field name="search_view_id" ref="view_mapping_data_product_search"/>
            <field name="context">{'search_default_filter_not_auto': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo mapping sản phẩm mới
                </p>
                <p>
                    Mapping sản phẩm giúp tự động ánh xạ từ dữ liệu hóa đơn sang sản phẩm trong hệ thống ERP.
                </p>
            </field>
        </record>
    </data>
</odoo>
