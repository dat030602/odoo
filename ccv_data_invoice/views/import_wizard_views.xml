<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_import_xml_wizard_form" model="ir.ui.view">
            <field name="name">import.xml.wizard.form</field>
            <field name="model">import.xml.wizard</field>
            <field name="arch" type="xml">
                <form string="Import dữ liệu XML">
                    <group>
                        <field name="xml_file" filename="xml_filename"/>
                        <field name="xml_filename" invisible="1"/>
                    </group>
                    
                    <group string="Thống kê import" attrs="{'invisible': [('total_invoices', '=', 0)]}">
                        <field name="total_invoices"/>
                        <field name="imported_invoices"/>
                        <field name="skipped_invoices"/>
                        <field name="error_messages" attrs="{'invisible': [('error_messages', '=', False)]}"/>
                    </group>
                    
                    <footer>
                        <button name="action_import_xml" string="Import XML" type="object" class="btn-primary"/>
                        <button string="Hủy" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_import_xml_wizard" model="ir.actions.act_window">
            <field name="name">Import XML</field>
            <field name="res_model">import.xml.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <!-- <field name="context">{}</field> -->
        </record>

        <!-- Menu for Import -->
        
    </data>
</odoo>
