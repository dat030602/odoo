<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Casso Transaction Wizard Form View -->
        <record id="view_casso_transaction_wizard_form" model="ir.ui.view">
            <field name="name">casso.transaction.wizard.form</field>
            <field name="model">casso.transaction.wizard</field>
            <field name="arch" type="xml">
                <form string="Casso Transaction Detail" edit="0">
                    <sheet>
                        <group>
                            <group string="Transaction Details">
                                <field name="casso_id"/>
                                <field name="casso_reference"/>
                                <field name="casso_description"/>
                                <field name="casso_amount"/>
                                <field name="casso_transactionDateTime"/>
                            </group>
                            <group string="Account Information">
                                <field name="casso_accountNumber"/>
                                <field name="casso_bankName"/>
                                <field name="casso_bankAbbreviation"/>
                                <field name="casso_virtualAccountNumber"/>
                                <field name="casso_virtualAccountName"/>
                            </group>
                        </group>
                        <group string="Counterpart Information">
                            <field name="casso_counterAccountName"/>
                            <field name="casso_counterAccountNumber"/>
                            <field name="casso_counterAccountBankId"/>
                            <field name="casso_counterAccountBankName"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Close" class="btn-primary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Casso Transaction Wizard Action -->
        <record id="action_casso_transaction_wizard" model="ir.actions.act_window">
            <field name="name">Casso Transaction Detail</field>
            <field name="res_model">casso.transaction.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
