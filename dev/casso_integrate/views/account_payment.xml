<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_account_payment_form_inherit" model="ir.ui.view">
            <field name="name">account.payment.form.inherit</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <header position="inside">
                    <button name="action_view_detail_casso_transaction" string="View Detail from Casso" type="object" invisible="not casso_id"/>
                </header>
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Casso Information" name="casso_info" invisible="not casso_id">
                            <group>
                                <group string="Transaction Details">
                                    <field name="casso_id"/>
                                    <field name="casso_reference"/>
                                    <field name="casso_description"/>
                                    <field name="casso_amount"/>
                                    <field name="casso_transactionDateTime"/>
                                </group>
                                <group string="Account Information">
                                    <field name="casso_accountNumber"/>
                                    <field name="casso_bankName"/>
                                    <field name="casso_bankAbbreviation"/>
                                    <field name="casso_virtualAccountNumber"/>
                                    <field name="casso_virtualAccountName"/>
                                </group>
                            </group>
                            <group string="Counterpart Information">
                                <field name="casso_counterAccountName"/>
                                <field name="casso_counterAccountNumber"/>
                                <field name="casso_counterAccountBankId"/>
                                <field name="casso_counterAccountBankName"/>
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
