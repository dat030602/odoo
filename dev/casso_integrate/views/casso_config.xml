<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_casso_config_tree" model="ir.ui.view">
            <field name="name">casso.config.tree</field>
            <field name="model">casso.config</field>
            <field name="arch" type="xml">
                <tree string="Casso Config" decoration-success="status == 'connected'" decoration-muted="status == 'draft'">
                    <field name="name"/>
                    <field name="status"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_casso_config_form" model="ir.ui.view">
            <field name="name">casso.config.form</field>
            <field name="model">casso.config</field>
            <field name="arch" type="xml">
                <form string="Casso Config">
                    <header>
                        <button name="action_authorize_token" string="Authorize" type="object" 
                                class="btn-primary" invisible="status == 'connected'"/>
                        <button name="action_refresh_token" string="Refresh Token" type="object" 
                                class="btn-secondary" invisible="status != 'connected'"/>
                        <button name="action_get_info_user" string="Get User Info" type="object" 
                                class="btn-secondary" invisible="status != 'connected'"/>
                        <button name="test_api_call" string="Test API" type="object" class="btn-secondary"/>
                        <button name="action_create_webhook" string="Create Webhook" type="object" class="btn-secondary"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,connected"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="status == 'connected'"/>
                            </h1>
                        </div>
                        <notebook>
                            <page string="OAuth Configuration" name="oauth_config">
                                <group>
                                    <group string="Client Information">
                                        <field name="token_type" readonly="status == 'connected'"/>
                                        <field name="client_id" password="True" invisible="token_type == 'Apikey'" readonly="status == 'connected'"/>
                                        <field name="client_secret" password="True" invisible="token_type == 'Apikey'" readonly="status == 'connected'"/>
                                        <field name="api_key" password="True" invisible="token_type == 'Bearer'"/>
                                        <field name="secure_token" password="True" readonly="status == 'connected'"/>
                                    </group>
                                    <group string="URL Configuration">
                                        <field name="webhook_url" readonly="status == 'connected'"/>
                                        <field name="api_url" readonly="status == 'connected'"/>
                                        <field name="redirect_authorize_uri" readonly="status == 'connected'"/>
                                        <field name="oauth_url" invisible="token_type == 'Apikey'" readonly="status == 'connected'"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Token Information" name="token_info" invisible="status != 'connected'">
                                <group>
                                    <group string="Access Token">
                                        <field name="access_token" password="True" readonly="1"/>
                                        <field name="token_expires_at" readonly="1"/>
                                    </group>
                                    <group string="Refresh Token">
                                        <field name="refresh_token" password="True" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="User Information" name="user_info" invisible="status != 'connected'">
                                <group>
                                    <group string="User Details">
                                        <field name="user_user_id" readonly="1"/>
                                        <field name="user_user_email" readonly="1"/>
                                    </group>
                                    <group string="Business Details">
                                        <field name="user_business_id" readonly="1"/>
                                        <field name="user_business_name" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Bank Accounts" name="bank_accounts" invisible="status != 'connected'">
                                <field name="bank_acc_ids" nolabel="1">
                                    <tree string="Bank Accounts">
                                        <field name="bank_id" widget="many2one"/>
                                        <field name="bank_bin"/>
                                        <field name="bank_code_name"/>
                                        <field name="bank_account_name"/>
                                        <field name="bank_sub_acc_id"/>
                                        <field name="connect_status"/>
                                        <field name="plan_status"/>
                                    </tree>
                                    <form string="Bank Account">
                                        <sheet>
                                            <group>
                                                <group string="Bank Information">
                                                    <field name="bank_id" widget="many2one"/>
                                                    <field name="bank_bin"/>
                                                    <field name="bank_code_name"/>
                                                </group>
                                                <group string="Account Information">
                                                    <field name="bank_account_name"/>
                                                    <field name="bank_sub_acc_id"/>
                                                    <field name="connect_status"/>
                                                    <field name="plan_status"/>
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_casso_config_search" model="ir.ui.view">
            <field name="name">casso.config.search</field>
            <field name="model">casso.config</field>
            <field name="arch" type="xml">
                <search string="Casso Config">
                    <field name="name"/>
                    <field name="status"/>
                    <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                    <filter string="Connected" name="connected" domain="[('status', '=', 'connected')]"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Active" name="group_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_casso_config" model="ir.actions.act_window">
            <field name="name">Casso Config</field>
            <field name="res_model">casso.config</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Casso Configuration
                </p>
                <p>
                    Configure your Casso integration settings to connect with Casso API.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
         <menuitem id="menu_casso_config"
                  name="Casso Config"
                  parent="account.menu_finance_configuration"
                  sequence="100"/>
        <menuitem id="menu_sale_order_casso"
                  name="Casso Config"
                  action="action_casso_config"
                  parent="menu_casso_config"
                  sequence="100"/>
    </data>
</odoo>
