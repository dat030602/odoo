<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_casso_webhook_tree" model="ir.ui.view">
            <field name="name">casso.webhook.tree</field>
            <field name="model">casso.webhook</field>
            <field name="arch" type="xml">
                <tree string="Casso Webhook">
                    <field name="name"/>
                    <field name="url"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_casso_webhook_form" model="ir.ui.view">
            <field name="name">casso.webhook.form</field>
            <field name="model">casso.webhook</field>
            <field name="arch" type="xml">
                <form string="Casso Webhook">
                    <header>
                        <button name="action_create_webhook" string="Create webhook" type="object" 
                                class="btn-primary" invisible="status == 'pushed'"/>
                        <button name="action_update_webhook" string="Update webhook" type="object" 
                                class="btn-secondary" invisible="status != 'pushed'"/>
                        <button name="action_delete_webhook" string="Remove webhook" type="object" 
                                class="btn-danger" invisible="status != 'pushed'"/>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="status == 'pushed'"/>
                                <field name="url" readonly="status == 'pushed'"/>
                                <field name="config_id" readonly="status == 'pushed'"/>
                            </group>
                            <group></group>
                            <group string="Casso Info">
                                <field name="casso_id" readonly="1"/>
                                <field name="casso_channel" readonly="1"/>
                                <field name="casso_param1" readonly="1"/>
                                <field name="casso_param2" readonly="1"/>
                                <field name="casso_send_only_income" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_casso_webhook" model="ir.actions.act_window">
            <field name="name">Casso Webhook</field>
            <field name="res_model">casso.webhook</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Casso Webhook
                </p>
                <p>
                    Configure your Casso integration settings to connect with Casso API.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_webhook_casso"
                  name="Webhook"
                  action="action_casso_webhook"
                  parent="menu_casso_config"
                  sequence="100"/>
    </data>
</odoo>
