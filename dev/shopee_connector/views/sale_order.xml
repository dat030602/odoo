<odoo>
    <record id="view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Shopee" invisible="shopee_connector_id == False">
                    <group>
                        <field name="shopee_connector_id" />
                        <field name="shopee_name_order"/>
                    </group>
                    <group>
                        <group string="Shopee" name="shopee_group">
                            <field name="shopee_full_address"/>
                            <field name="shopee_order_status"/>
                            <field name="shopee_payment_method"/>
                            <field name="shopee_pay_time"/>
                            <field name="shopee_buyer_cancel_reason"/>
                            <field name="shopee_cancel_reason"/>
                            <field name="shopee_total_amount"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
