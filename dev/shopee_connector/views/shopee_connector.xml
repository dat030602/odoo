<odoo>
    <record id="view_shopee_connector_form" model="ir.ui.view">
        <field name="name">shopee.connector.form</field>
        <field name="model">shopee.connector</field>
        <field name="arch" type="xml">

            <form string="Shopee Connector">
                <header>
                    <button name="action_authen" type="object" icon="fa-check" string="Authentication" invisible="state == 'active'" class="btn-primary"/>
                    <button name="action_active" type="object" icon="fa-check" string="Active" invisible="state == 'active' and access_token == False"/>
                    <button name="action_draft" type="object" icon="fa-times" string="Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Sandbox" bg_color="bg-danger" invisible="environment != 'sandbox' or state == 'draft'"/>
                    <widget name="web_ribbon" title="Production" bg_color="bg-success" invisible="environment != 'production' or state == 'draft'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="oe_inline" readonly="state == 'active'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="environment" readonly="state == 'active'" invisible="state == 'active'"/>
                        </group>
                        <group>
                            <field name="default_partner_id" readonly="state == 'active'"/>
                            <field name="default_customer_id" readonly="state == 'active'"/>
                            <field name="default_invoice_partner_id" readonly="state == 'active'"/>
                            <field name="default_warehouse_id" readonly="state == 'active'"/>
                            <field name="default_product_promotion_id" readonly="state == 'active'"/>
                            <field name="default_product_shiping_id" readonly="state == 'active'"/>
                            <!-- <field name="default_sale_order_type_id" readonly="state == 'active'"/> -->
                        </group>
                    </group>
                <notebook>  
                    <page string="Shopee">
                        <group>
                            <group string="Config">
                                <field name="shopee_partner_id" readonly="state == 'active'"/>
                                <field name="shopee_partner_key" readonly="state == 'active'"/>
                                <field name="shopee_shop_id" readonly="state == 'active'"/>
                                <field name="shopee_merchant_id" readonly="state == 'active'"/>
                                <field name="shopee_main_account_id" readonly="state == 'active'"/>
                            </group>
                            <group string="Shop Info">
                                <field name="shopee_shop_name" readonly="1"/>
                                <field name="shopee_shop_status" readonly="1"/>
                                <field name="shopee_is_main_shop" readonly="1"/>
                            </group>
                        </group>
                    </page>
                    <page string="Information">
                        <group>
                            <field name="access_token" readonly="1" widget="password"/>
                            <field name="refresh_token" readonly="1" widget="password"/>
                            <field name="time_to_refresh_token" readonly="1"/>
                            <field name="last_time_run" readonly="1"/>
                        </group>
                    </page>
                </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_shopee_connector_tree" model="ir.ui.view">
        <field name="name">shopee.connector.tree</field>
        <field name="model">shopee.connector</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="environment" />
                <field name="state" />
                <field name="last_time_run" />
            </tree>
        </field>
    </record>
    <record id="view_shopee_connector_search" model="ir.ui.view">
        <field name="name">shopee.connector.search</field>
        <field name="model">shopee.connector</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="environment" />
                <field name="state" />
                <field name="last_time_run" />
                <group expand="0">
                    <filter string="Environment" name="environment" context="{'group_by': 'environment'}"/>
                    <filter string="State" name="state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_shopee_connector" model="ir.actions.act_window">
        <field name="name">Shopee Connector</field>
        <field name="res_model">shopee.connector</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create first Shopee Connector
            </p>
            <p>
                Manage Shopee Connector data.
            </p>
        </field>
    </record>
</odoo> 
