<odoo>
    <record id="view_shopee_product_mapping_tree" model="ir.ui.view">
        <field name="name">shopee.product.mapping.tree</field>
        <field name="model">shopee.product.mapping</field>
        <field name="arch" type="xml">
            <tree create="0" editable="bottom">
                <field name="shopee_item_id" />
                <field name="shopee_sku" />
                <field name="shopee_product_name" />
                <field name="odoo_product_id" />
            </tree>
        </field>
    </record>
    <record id="view_shopee_product_mapping_search" model="ir.ui.view">
        <field name="name">shopee.product.mapping.search</field>
        <field name="model">shopee.product.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="shopee_sku" />
                <field name="shopee_product_name" />
                <field name="odoo_product_id" />
                <field name="shopee_item_id" />
                <group expand="0">
                    <filter string="Odoo Product" name="odoo_product" context="{'group_by': 'odoo_product_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_shopee_product_mapping" model="ir.actions.act_window">
        <field name="name">Shopee Product Mapping</field>
        <field name="res_model">shopee.product.mapping</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create first Shopee Product Mapping
            </p>
            <p>
                Manage Shopee Product Mapping data.
            </p>
        </field>
    </record>
</odoo> 
