<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Marketplace Groups -->
    <record id="group_marketplace_user" model="res.groups">
        <field name="name">Marketplace User</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="comment">CCV User - Read-only access to marketplace data but cannot access configuration</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_marketplace_admin" model="res.groups">
        <field name="name">Marketplace Administrator</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="comment">CCV Admin - Full access to marketplace configuration and all features</field>
        <field name="implied_ids" eval="[(4, ref('group_marketplace_user')), (4, ref('base.group_system'))]"/>
    </record>

</odoo>
