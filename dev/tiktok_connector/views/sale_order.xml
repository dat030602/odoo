<odoo>
    <record id="view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="TikTok" invisible="tiktok_connector_id == False">
                    <group>
                        <field name="tiktok_connector_id" />
                        <field name="tiktok_name_order"/>
                    </group>
                    <group>
                        <group string="TikTok" name="tiktok_group">
                            <field name="tiktok_full_address"/>
                            <field name="tiktok_order_status"/>
                            <field name="tiktok_payment_method"/>
                            <field name="tiktok_pay_time"/>
                            <field name="tiktok_buyer_cancel_reason"/>
                            <field name="tiktok_cancel_reason"/>
                            <field name="tiktok_total_amount"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
