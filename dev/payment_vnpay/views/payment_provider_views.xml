<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">VNPay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'vnpay'" name="vnpay_credentials">
                    <field name="vnpay_tmn_code" required="code == 'vnpay' and state != 'disabled'"/>
                    <field name="vnpay_hash_secret_key" required="code == 'vnpay' and state != 'disabled'" password="True"/>
                    <field name="vnpay_return_url" required="code == 'vnpay' and state != 'disabled'"/>
                    <field name="vnpay_webhook_url" required="code == 'vnpay' and state != 'disabled'"/>
                    <field name="vnpay_payment_url" required="code == 'vnpay' and state != 'disabled'"/>
                    <field name="vnpay_api_url" required="code == 'vnpay' and state != 'disabled'"/>
                    <field name="vnpay_version" required="code == 'vnpay' and state != 'disabled'"/>
                    <field name="vnpay_currency_code" required="code == 'vnpay' and state != 'disabled'"/>
                </group>
            </group>
        </field>            
    </record>

</odoo>
