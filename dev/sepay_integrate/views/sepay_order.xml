<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_sepay_order_tree" model="ir.ui.view">
            <field name="name">sepay.order.tree</field>
            <field name="model">sepay.order</field>
            <field name="arch" type="xml">
                <tree string="SePay Config" decoration-success="status == 'connected'" decoration-muted="status == 'draft'">
                    <field name="name"/>
                    <field name="bank_id"/>
                    <field name="sepay_order_id"/>
                    <field name="order_id"/>
                    <field name="amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="status" widget="badge" decoration-success="status == 'paid'" decoration-warning="status == 'partial'"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_sepay_order_form" model="ir.ui.view">
            <field name="name">sepay.order.form</field>
            <field name="model">sepay.order</field>
            <field name="arch" type="xml">
                <form string="SePay Config">
                    <header>
                        <button name="action_get_transactions" string="Sync Transactions" type="object" 
                                class="btn-secondary"/>
                        <button name="action_get_banks" string="Get Banks" type="object" 
                                class="btn-secondary"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,paid,partial"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" class="oe_edit_only" readonly="status == 'connected'"/>
                                <span class="oe_read_only"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Configuration Details" name="config_details">
                                <field name="bank_id"/>
                                <field name="bank_config_id"/>
                                <field name="date_pushed"/>
                            </group>
                            <group>
                                <label string="Duration" for="duration"/>
                                <div class="o_row">
                                    <field name="duration"/>
                                    <field name="duration_type"/>
                                </div>
                                <field name="expiration_datetime"/>
                                <field name="max_duration" invisible="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="SePay Order" name="sepay_order">
                                <group>
                                    <field name="sepay_order_id"/>
                                    <field name="va_holder_name"/>
                                    <field name="order_id"/>
                                    <field name="amount"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="qr_url" widget="CopyClipboardURL"/>
                                    <field name="qr_code" widget="image"/>
                                </group>
                            </page>
                            <page string="VA" name="va_ids" invisible="va_ids == []">
                                <field name="va_ids" nolabel="1">
                                    <tree string="Bank Accounts" create="0" edit="0" delete="1">
                                        <field name="va_number"/>
                                        <field name="va_holder_name"/>
                                        <field name="amount"/>
                                        <field name="expired_at"/>
                                        <field name="paid_at"/>
                                        <field name="status" widget="badge"/>
                                    </tree>
                                    <form string="Bank Account" create="0" edit="1" delete="0">
                                        <sheet>
                                            <group>
                                                <field name="va_number"/>
                                                <field name="va_holder_name"/>
                                                <field name="amount"/>
                                                <field name="expired_at"/>
                                                <field name="paid_at"/>
                                                <field name="status" widget="badge"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_sepay_order_search" model="ir.ui.view">
            <field name="name">sepay.order.search</field>
            <field name="model">sepay.order</field>
            <field name="arch" type="xml">
                <search string="SePay Config">
                    <field name="name"/>
                    <field name="status"/>
                    <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                    <filter string="Connected" name="connected" domain="[('status', '=', 'connected')]"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Active" name="group_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_sepay_order" model="ir.actions.act_window">
            <field name="name">SePay Config</field>
            <field name="res_model">sepay.order</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first SePay Configuration
                </p>
                <p>
                    Configure your SePay integration settings to connect with SePay API.
                    SePay provides real-time transaction synchronization for MBBank and other banks.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_sepay_order"
                  name="SePay Config"
                  action="action_sepay_order"
                  parent="sepay_integrate.menu_sepay_config_config"
                  sequence="50"/>
    </data>
</odoo>
