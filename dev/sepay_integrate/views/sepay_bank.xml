<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_sepay_bank_form_inherit" model="ir.ui.view">
            <field name="name">sepay.bank.form.inherit</field>
            <field name="model">sepay.bank</field>
            <field name="inherit_id" ref="sepay_qr_integrate.view_sepay_bank_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='sepay_bank_info']" position="after">
                     <field name="sepay_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
