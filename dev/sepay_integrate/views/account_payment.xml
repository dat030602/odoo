<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_account_payment_form_inherit" model="ir.ui.view">
            <field name="name">account.payment.form.inherit</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="ref_src" invisible="transaction_code == False"/>
                    <field name="transaction_code" invisible="transaction_code == False"/>
                </xpath>
                <xpath expr="//group[@name='group2']" position="inside">
                    <field name="acc_counterpart_no" invisible="transaction_code == False"/>
                    <field name="acc_counterpart_name" invisible="transaction_code == False"/>
                </xpath>
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="SePay Information" name="sepay_info" invisible="not sepay_transaction_id">
                            <group>
                                <group string="Transaction Details">
                                    <field name="sepay_transaction_id"/>
                                    <field name="sepay_reference_number"/>
                                    <field name="sepay_code"/>
                                    <field name="sepay_transaction_date"/>
                                </group>
                                <group string="Amount Information">
                                    <field name="sepay_amount_in"/>
                                    <field name="sepay_amount_out"/>
                                    <field name="sepay_accumulated"/>
                                </group>
                                <group string="Account Information">
                                    <field name="sepay_account_number"/>
                                    <field name="sepay_bank_brand_name"/>
                                    <field name="sepay_bank_account_id"/>
                                    <field name="sepay_sub_account"/>
                                </group>
                            </group>
                            <group>
                                <field name="sepay_transaction_content" nolabel="1" widget="text"/>
                            </group>
                            <group>
                                <button name="action_view_detail_sepay_transaction" string="View Detail from SePay" type="object" class="btn-primary" invisible="not sepay_transaction_id"/>
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
        <record id="view_account_payment_search_inherit" model="ir.ui.view">
            <field name="name">account.payment.search.inherit</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="acc_counterpart_name" string="Transaction Information" filter_domain="['|', '|', ('acc_counterpart_name', 'ilike', self), ('acc_counterpart_no', 'ilike', self), ('transaction_code', 'ilike', self)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
