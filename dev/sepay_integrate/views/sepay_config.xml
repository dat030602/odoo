<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_sepay_config_tree" model="ir.ui.view">
            <field name="name">sepay.config.tree</field>
            <field name="model">sepay.config</field>
            <field name="arch" type="xml">
                <tree string="SePay Config" decoration-success="status == 'connected'" decoration-muted="status == 'draft'">
                    <field name="name"/>
                    <field name="status" widget="badge" decoration-success="status == 'connected'" decoration-muted="status == 'draft'"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_sepay_config_form" model="ir.ui.view">
            <field name="name">sepay.config.form</field>
            <field name="model">sepay.config</field>
            <field name="arch" type="xml">
                <form string="SePay Config">
                    <header>
                        <button name="action_get_transactions" string="Sync Transactions" type="object" 
                                class="btn-secondary"/>
                        <button name="action_get_banks" string="Get Banks" type="object" 
                                class="btn-secondary"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,connected"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" class="oe_edit_only" readonly="status == 'connected'"/>
                                <span class="oe_read_only"/>
                            </h1>
                        </div>
                        <notebook>
                            <page string="API Configuration" name="api_config">
                                <group string="API Settings">
                                    <field name="api_token" password="True" required="1" readonly="status == 'connected'"/>
                                    <field name="api_url" readonly="status == 'connected'"/>
                                    <field name="webhook_url" readonly="status == 'connected'"/>
                                </group>
                                <div class="alert alert-info" role="alert">
                                    <p><strong>Setup Instructions:</strong></p>
                                    <ol>
                                        <li>Register at <a href="https://my.sepay.vn/register" target="_blank">my.sepay.vn/register</a></li>
                                        <li>Add your Bank account</li>
                                        <li>Go to API Access and create an API Token</li>
                                        <li>Enter the API Token above</li>
                                        <li>Click "Test Connection" to verify</li>
                                    </ol>
                                </div>
                            </page>
                            <page string="Bank Accounts" name="bank_accounts" invisible="status != 'connected'">
                                <field name="bank_acc_ids" nolabel="1">
                                    <tree string="Bank Accounts" create="0" edit="0" delete="1">
                                        <field name="account_id" optional="hide"/>
                                        <field name="account_number"/>
                                        <field name="account_holder_name"/>
                                        <field name="label"/>
                                        <field name="bank_short_name"/>
                                        <field name="bank_full_name" optional="hide"/>
                                        <field name="bank_bin"/>
                                        <field name="bank_code"/>
                                        <field name="journal_id"/>
                                        <field name="active" optional="hide"/>
                                        <field name="last_transaction" optional="hide"/>
                                        <field name="created_at" optional="hide"/>
                                    </tree>
                                    <form string="Bank Account" create="0" edit="1" delete="0">
                                        <header>
                                            <button name="action_create_account_bank" string="Create Bank Account" type="object" class="btn-secondary"/>
                                        </header>
                                        <sheet>
                                            <group>
                                                <group string="Account Information">
                                                    <field name="account_id" readonly="1"/>
                                                    <field name="account_holder_name" readonly="1"/>
                                                    <field name="account_number" readonly="1"/>
                                                    <field name="label" readonly="1"/>
                                                    <field name="bank_short_name" readonly="1"/>
                                                    <field name="bank_full_name" readonly="1"/>
                                                    <field name="bank_bin" readonly="1"/>
                                                    <field name="bank_code" readonly="1"/>
                                                    <field name="journal_id"/>
                                                    <field name="bank_sepay_id" invisible="1"/>
                                                </group>
                                                <group string="Status">
                                                    <field name="last_transaction" readonly="1"/>
                                                    <field name="created_at" readonly="1"/>
                                                    <field name="active" readonly="1"/>
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_sepay_config_search" model="ir.ui.view">
            <field name="name">sepay.config.search</field>
            <field name="model">sepay.config</field>
            <field name="arch" type="xml">
                <search string="SePay Config">
                    <field name="name"/>
                    <field name="status"/>
                    <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                    <filter string="Connected" name="connected" domain="[('status', '=', 'connected')]"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Active" name="group_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_sepay_config" model="ir.actions.act_window">
            <field name="name">SePay Config</field>
            <field name="res_model">sepay.config</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first SePay Configuration
                </p>
                <p>
                    Configure your SePay integration settings to connect with SePay API.
                    SePay provides real-time transaction synchronization for MBBank and other banks.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_sepay_config"
                  name="SePay Config"
                  parent="account.menu_finance_configuration"
                  sequence="101"/>
        <menuitem id="menu_sepay_config_config"
                  name="SePay Config"
                  action="action_sepay_config"
                  parent="menu_sepay_config"
                  sequence="101"/>
    </data>
</odoo>
