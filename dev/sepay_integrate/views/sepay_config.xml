<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_sepay_config_tree" model="ir.ui.view">
            <field name="name">sepay.config.tree</field>
            <field name="model">sepay.config</field>
            <field name="arch" type="xml">
                <tree string="SePay Config" decoration-success="status == 'connected'" decoration-muted="status == 'draft'">
                    <field name="name"/>
                    <field name="status"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_sepay_config_form" model="ir.ui.view">
            <field name="name">sepay.config.form</field>
            <field name="model">sepay.config</field>
            <field name="arch" type="xml">
                <form string="SePay Config">
                    <header>
                        <button name="action_test_connection" string="Test Connection" type="object" 
                                class="btn-primary" invisible="status == 'connected'"/>
                        <button name="action_sync_transactions" string="Sync Transactions" type="object" 
                                class="btn-secondary" invisible="status != 'connected'"/>
                        <button name="action_create_webhook" string="Webhook Info" type="object" 
                                class="btn-secondary" invisible="status != 'connected'"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,connected"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="API Configuration" name="api_config">
                                <group>
                                    <group string="API Settings">
                                        <field name="api_token" password="True" required="1"/>
                                        <field name="api_url"/>
                                        <field name="webhook_url"/>
                                    </group>
                                    <group string="Instructions">
                                        <div class="alert alert-info" role="alert">
                                            <p><strong>Setup Instructions:</strong></p>
                                            <ol>
                                                <li>Register at <a href="https://my.sepay.vn/register" target="_blank">my.sepay.vn/register</a></li>
                                                <li>Add your MBBank account</li>
                                                <li>Go to API Access and create an API Token</li>
                                                <li>Enter the API Token above</li>
                                                <li>Click "Test Connection" to verify</li>
                                            </ol>
                                        </div>
                                    </group>
                                </group>
                            </page>
                            <page string="User Information" name="user_info" invisible="status != 'connected'">
                                <group>
                                    <group string="User Details">
                                        <field name="user_email" readonly="1"/>
                                        <field name="user_name" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Bank Accounts" name="bank_accounts" invisible="status != 'connected'">
                                <field name="bank_acc_ids" nolabel="1">
                                    <tree string="Bank Accounts" create="1" edit="1" delete="1">
                                        <field name="account_number"/>
                                        <field name="bank_brand_name"/>
                                        <field name="bank_id" widget="many2one"/>
                                        <field name="is_active"/>
                                        <field name="last_sync_date"/>
                                        <button name="action_sync_transactions" string="Sync" type="object" 
                                                class="btn-sm btn-primary" title="Sync transactions for this account"/>
                                        <button name="action_get_transactions" string="Get Transactions" type="object" 
                                                class="btn-sm btn-secondary" title="Get transactions"/>
                                    </tree>
                                    <form string="Bank Account">
                                        <sheet>
                                            <group>
                                                <group string="Account Information">
                                                    <field name="account_number"/>
                                                    <field name="bank_brand_name"/>
                                                    <field name="bank_id" widget="many2one"/>
                                                    <field name="bank_account_id"/>
                                                    <field name="sub_account"/>
                                                </group>
                                                <group string="Status">
                                                    <field name="is_active"/>
                                                    <field name="last_sync_date"/>
                                                </group>
                                            </group>
                                        </sheet>
                                        <footer>
                                            <button name="action_sync_transactions" string="Sync Transactions" type="object" class="btn-primary"/>
                                            <button name="action_discover_accounts" string="Discover Accounts" type="object" class="btn-secondary"/>
                                        </footer>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_sepay_config_search" model="ir.ui.view">
            <field name="name">sepay.config.search</field>
            <field name="model">sepay.config</field>
            <field name="arch" type="xml">
                <search string="SePay Config">
                    <field name="name"/>
                    <field name="status"/>
                    <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                    <filter string="Connected" name="connected" domain="[('status', '=', 'connected')]"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Active" name="group_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_sepay_config" model="ir.actions.act_window">
            <field name="name">SePay Config</field>
            <field name="res_model">sepay.config</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first SePay Configuration
                </p>
                <p>
                    Configure your SePay integration settings to connect with SePay API.
                    SePay provides real-time transaction synchronization for MBBank and other banks.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_sepay_config"
                  name="SePay Config"
                  action="action_sepay_config"
                  parent="account.menu_finance_configuration"
                  sequence="101"/>
    </data>
</odoo>
