<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- SePay Transaction Wizard Form View -->
        <record id="view_sepay_transaction_wizard_form" model="ir.ui.view">
            <field name="name">sepay.transaction.wizard.form</field>
            <field name="model">sepay.transaction.wizard</field>
            <field name="arch" type="xml">
                <form string="SePay Transaction Detail" edit="0">
                    <sheet>
                        <group>
                            <group string="Transaction Information">
                                <field name="transaction_id"/>
                                <field name="account_number"/>
                                <field name="transaction_date"/>
                                <field name="reference_number"/>
                                <field name="code"/>
                            </group>
                            <group string="Amount Information">
                                <field name="amount_in"/>
                                <field name="amount_out"/>
                                <field name="accumulated"/>
                            </group>
                        </group>
                        <group>
                            <group string="Bank Information">
                                <field name="bank_brand_name"/>
                                <field name="bank_account_id"/>
                                <field name="sub_account"/>
                            </group>
                        </group>
                        <group>
                            <field name="transaction_content" nolabel="1" widget="text"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Close" class="btn-primary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- SePay Transaction Wizard Action -->
        <record id="action_sepay_transaction_wizard" model="ir.actions.act_window">
            <field name="name">SePay Transaction Detail</field>
            <field name="res_model">sepay.transaction.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
