<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- SePay Transaction Wizard Form View -->
        <record id="view_sepay_transaction_wizard_form" model="ir.ui.view">
            <field name="name">sepay.transaction.wizard.form</field>
            <field name="model">sepay.transaction.wizard</field>
            <field name="arch" type="xml">
                <form string="SePay Transaction Detail" edit="0">
                    <sheet>
                        <group>
                                <group string="Transaction Details">
                                    <field name="sepay_id"/>
                                    <field name="sepay_gateway"/>
                                    <field name="sepay_reference_code"/>
                                    <field name="sepay_code"/>
                                    <field name="sepay_description"/>
                                </group>
                                <group string="Account Information">
                                    <field name="sepay_transaction_date"/>
                                    <field name="sepay_account_number"/>
                                    <field name="sepay_transfer_type"/>
                                    <field name="sepay_transfer_amount"/>
                                    <field name="sepay_sub_account"/>
                                </group>
                            </group>
                            <group>
                                <field name="sepay_content" nolabel="1" widget="text"/>
                            </group>
                    </sheet>
                    <footer>
                        <button string="Close" class="btn-primary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- SePay Transaction Wizard Action -->
        <record id="action_sepay_transaction_wizard" model="ir.actions.act_window">
            <field name="name">SePay Transaction Detail</field>
            <field name="res_model">sepay.transaction.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
