<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_create_vietqr_wizard_form" model="ir.ui.view">
        <field name="name">create.vietqr.wizard.form</field>
        <field name="model">create.vietqr.wizard</field>
        <field name="arch" type="xml">
            <form string="Create VietQR Code">
                <group>
                    <field name="resource_id" invisible="1"/>
                    <field name="resource_model" invisible="1"/>
                    <field name="amount"/>
                    <field name="bank_id"/>
                    <field name="description"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button string="Create" type="object" name="action_create" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_create_vietqr_wizard" model="ir.actions.act_window">
        <field name="name">Create VietQR Code</field>
        <field name="res_model">create.vietqr.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>