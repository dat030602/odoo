<odoo>
    <record id="view_vietqr_bank_config_form" model="ir.ui.view">
        <field name="name">vietqr.bank.config.form</field>
        <field name="model">vietqr.bank.config</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="fetch_banks" string="Fetch Banks from VietQR" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="logo_url" invisible="1"/>
                    <field name="logo_image" widget="image" class="oe_avatar" invisible="logo_url == False"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. My Company"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="swift_code"/>
                            <field name="bin"/>
                        </group>
                        <group>
                            <field name="transfer_supported"/>
                            <field name="lookup_supported"/>
                            <field name="is_transfer"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_vietqr_bank_config_tree" model="ir.ui.view">
        <field name="name">vietqr.bank.config.tree</field>
        <field name="model">vietqr.bank.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="swift_code"/>
                <field name="bin"/>
            </tree>
        </field>
    </record>
    <record id="action_vietqr_bank_config" model="ir.actions.act_window">
        <field name="name">VietQR Bank Config</field>
        <field name="res_model">vietqr.bank.config</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_sale_order_vietqr_config" name="Config" parent="menu_vietqr_bank" action="action_vietqr_bank_config" sequence="100"/>
</odoo>
