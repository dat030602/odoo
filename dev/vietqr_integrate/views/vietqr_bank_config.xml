<odoo>
    <record id="view_vietqr_bank_config_form" model="ir.ui.view">
        <field name="name">vietqr.bank.config.form</field>
        <field name="model">vietqr.bank.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_qr" string="Test QR" type="object"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_default"/>
                        <field name="vietqr_bank_id"/>
                        <field name="template_code"/>
                        <field name="partner_bank_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_vietqr_bank_config_tree" model="ir.ui.view">
        <field name="name">vietqr.bank.config.tree</field>
        <field name="model">vietqr.bank.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="vietqr_bank_id"/>
                <field name="partner_bank_id"/>
                <field name="is_default"/>
            </tree>
        </field>
    </record>
    <record id="action_vietqr_bank_config" model="ir.actions.act_window">
        <field name="name">VietQR Bank Config</field>
        <field name="res_model">vietqr.bank.config</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_vietqr_bank_config" name="VietQR Bank Config" parent="sale.menu_sale_config" action="action_vietqr_bank_config"/>
</odoo>
