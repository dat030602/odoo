<odoo>
    <record id="view_vietqr_bank_form" model="ir.ui.view">
        <field name="name">vietqr.bank.form</field>
        <field name="model">vietqr.bank</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_qr" string="Test QR" type="object"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_default"/>
                        <field name="vietqr_bank_id"/>
                        <field name="template_type"/>
                        <field name="template_code" invisible="template_type != 'custom'" required="template_type == 'custom'"/>
                        <field name="partner_bank_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_vietqr_bank_tree" model="ir.ui.view">
        <field name="name">vietqr.bank.tree</field>
        <field name="model">vietqr.bank</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="vietqr_bank_id"/>
                <field name="partner_bank_id"/>
                <field name="is_default"/>
            </tree>
        </field>
    </record>
    <record id="action_vietqr_bank" model="ir.actions.act_window">
        <field name="name">VietQR Bank</field>
        <field name="res_model">vietqr.bank</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_vietqr_bank" name="VietQR Bank" parent="sale.menu_sale_config"/>
    <menuitem id="menu_vietqr_bank_account" name="Account Bank" parent="menu_vietqr_bank" action="action_vietqr_bank" sequence="50"/>
</odoo>
