<odoo>
    <record id="view_vietqr_bank_form" model="ir.ui.view">
        <field name="name">vietqr.bank.form</field>
        <field name="model">vietqr.bank</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="logo_url" invisible="1"/>
                    <field name="logo_image" widget="image" class="oe_avatar" attrs="{'invisible': [('logo_url', '=', False)]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. My Company"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="swift_code"/>
                            <field name="bin"/>
                        </group>
                        <group>
                            <field name="transfer_supported"/>
                            <field name="lookup_supported"/>
                            <field name="is_transfer"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_vietqr_bank_tree" model="ir.ui.view">
        <field name="name">vietqr.bank.tree</field>
        <field name="model">vietqr.bank</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="swift_code"/>
                <field name="bin"/>
            </tree>
        </field>
    </record>
    <record id="action_vietqr_bank" model="ir.actions.act_window">
        <field name="name">VietQR Bank</field>
        <field name="res_model">vietqr.bank</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_sale_order_vietqr" name="VietQR Bank" parent="sale.menu_sale_config" action="action_vietqr_bank"/>
</odoo>
