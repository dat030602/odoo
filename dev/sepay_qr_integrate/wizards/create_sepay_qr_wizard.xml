<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_create_sepay_qr_wizard_form" model="ir.ui.view">
        <field name="name">create.sepay.qr.wizard.form</field>
        <field name="model">create.sepay.qr.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Sepay QR Code">
                <group>
                    <field name="sale_order_id" invisible="0"/>
                    <field name="amount"/>
                    <field name="bank_id"/>
                    <field name="description"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button string="Create" type="object" name="action_create" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>