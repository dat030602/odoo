<odoo>
    <record id="view_sepay_bank_config_form" model="ir.ui.view">
        <field name="name">sepay.bank.config.form</field>
        <field name="model">sepay.bank.config</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="fetch_banks" string="Fetch Banks from Sepay" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="logo_url" invisible="1"/>
                    <field name="logo_image" widget="image" class="oe_avatar" invisible="logo_url == False"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. My Bank"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="short_name"/>
                            <field name="bin"/>
                        </group>
                        <group>
                            <field name="supported"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_sepay_bank_config_tree" model="ir.ui.view">
        <field name="name">sepay.bank.config.tree</field>
        <field name="model">sepay.bank.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="short_name"/>
                <field name="bin"/>
                <field name="supported"/>
            </tree>
        </field>
    </record>
    <record id="action_sepay_bank_config" model="ir.actions.act_window">
        <field name="name">Sepay Bank Config</field>
        <field name="res_model">sepay.bank.config</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_sale_order_sepay" name="Config" parent="menu_sepay_bank" action="action_sepay_bank_config" sequence="100"/>
</odoo>
