<odoo>
    <record id="view_sepay_bank_form" model="ir.ui.view">
        <field name="name">sepay.bank.form</field>
        <field name="model">sepay.bank</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_qr" string="Test QR" type="object"/>
                </header>
                <sheet>
                    <group>
                        <group string="Sepay Bank Information" name="sepay_bank_info">
                            <field name="name"/>
                            <field name="is_default"/>
                            <field name="sepay_bank_id"/>
                            <field name="template"/>
                            <field name="partner_bank_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_sepay_bank_tree" model="ir.ui.view">
        <field name="name">sepay.bank.tree</field>
        <field name="model">sepay.bank</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="sepay_bank_id"/>
                <field name="template"/>
                <field name="partner_bank_id"/>
                <field name="is_default"/>
            </tree>
        </field>
    </record>
    <record id="action_sepay_bank" model="ir.actions.act_window">
        <field name="name">Sepay Bank</field>
        <field name="res_model">sepay.bank</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_sepay_bank" name="Sepay Bank" parent="sale.menu_sale_config"/>
    <menuitem id="menu_sepay_bank_account" name="Account Bank" parent="menu_sepay_bank" action="action_sepay_bank" sequence="50"/>
</odoo>
