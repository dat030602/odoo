<?xml version='1.0' ?>
<odoo>
    <record id="cancel_einvoice_form_view" model="ir.ui.view">
        <field name="name">cancel.einvoice.form.view</field>
        <field name="model">cancel.einvoice</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <group>
                    <div class="oe_grey" colspan="4">
                        Input require information before cancel invoice.
                        <br/>
                    </div>
                </group>
                <group>
                        <field name="reason_adjust_einv" required="1"/>
                        <field name="seller_responsible" required="1" options="{'no_open': True}"/>
                        <field name="seller_position" required="1"/>
                        <field name="buyer_responsible" required="1" options="{'no_open': True}"/>
                        <field name="buyer_position" required="1"/>
                </group>
                <footer>
                    <button name="action_cancel_inv" string="Confirm" type="object" confirm="Thông tin hóa đơn sẽ bị hủy trên hệ thống hóa đơn điện tử (nếu có). Bạn có chắc chắn muốn Hủy hóa đơn?"/>
                    <button name="cancel" string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cancel_einvoice" model="ir.actions.act_window">
            <field name="name">Cancel E-Invoice</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cancel.einvoice</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="vinhhy_einvoice_service.cancel_einvoice_form_view"/>
            <field name="target">new</field>
        </record>
</odoo>