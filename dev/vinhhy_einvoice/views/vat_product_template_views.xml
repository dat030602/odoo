<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="vat_product_template_tree_view" model="ir.ui.view">
      <field name="name">vat.product.template.tree</field>
      <field name="model">vat.product.template</field>
      <field name="arch" type="xml">
        <tree string="VAT Product Template" multi_edit="1" duplicate="false" sample="1">
          <field name="name" optional="show" />
          <field name="price" optional="show" />
          <field name="qty_available" optional="show" />
          <field name="vat_code" optional="show" />
          <field name="uom_id" optional="show" />
          <field name="active" invisible="1" />
          <field name="taxes_ids" optional="hide" widget="many2many_tags"/>
        </tree>
      </field>
    </record>

    <record id="vat_product_template_form_view" model="ir.ui.view">
      <field name="name">vat.product.template.form</field>
      <field name="model">vat.product.template</field>
      <field name="mode">primary</field>
      <field name="arch" type="xml">
        <form string="VAT Product">
          <header></header>
          <sheet name="product_form">
            <field name="active" invisible="1" />
            <div class="oe_button_box" name="button_box"></div>
            <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}" />
            <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}" />
            <div class="oe_title">
              <label for="name" string="VAT Product Name" />
              <h1>
                <div class="d-flex">
                  <!-- <field name="priority" widget="priority" class="mr-3" /> -->
                  <field class="o_text_overflow" name="name" placeholder="e.g. Cheese Burger" />
                </div>
              </h1>
            </div>
            <group>
              <group>
                <field name="vat_code" />
                <field name="uom_id" groups="uom.group_uom" options="{'no_create': True}" />
              </group>
              <group name="group_standard_price">
                <field name="currency_id" invisible="1" />
                <label for="price" class="mt-1" />
                <div name="pricing">
                  <field name="price" class="oe_inline" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}" />
                </div>
                <field name="qty_available" string="Quantity On Hand" />
                <field name="taxes_ids" widget="many2many_tags" />
              </group>
            </group>
            <notebook>
              <page name="internal_product_reference" string="Internal Product Reference">
                <field name="src_product_ids">
                  <tree string="Internal Product">
                    <field name="name" />
                    <field name="default_code" />
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" />
            <field name="activity_ids" />
            <field name="message_ids" />
          </div>
        </form>
      </field>
    </record>

    <record id="vat_product_template_filter" model="ir.ui.view">
            <field name="name">vat.product.template.search</field>
            <field name="model">vat.product.template</field>
            <field name="arch" type="xml">
                <search string="Search VAT Product">
                    <field name="name" string="Name" filter_domain="['|','|', ('name', 'ilike', self), ('vat_code', 'ilike', self), ('src_product_ids.name', 'ilike', self)]"/>
                    <field name="vat_code" string="VAT Code" filter_domain="[('vat_code', 'ilike', self)]"/>
                    <group expand="0" string="Group By">
                        <filter string="VAT Code" name="group_vat_code" domain="[]" context="{'group_by': 'vat_code'}"/>
                    </group>
                </search>
            </field>
        </record>

    <record id="vat_product_template_action_view" model="ir.actions.act_window">
      <field name="name">VAT Product Template</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">vat.product.template</field>
      <field name="view_mode">tree,form</field>
      <!-- <field name="search_view_id" ref="product_template_search_form_view_stock" /> -->
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
              No product found. Let's create one!
          </p>
      </field>
    </record>

  </data>
</odoo>
