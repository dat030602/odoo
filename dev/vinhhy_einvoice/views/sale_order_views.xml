<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vinhhy_view_order_form_inherit" model="ir.ui.view">
        <field name="name">vinhhy.sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header[1]" position="inside">
                <field name="vh_einv_count" invisible="1" />
                <button name="action_create_view_vh_einv" string="Create VH E-Invoice" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('state', 'not in', ('sale', 'done')), ('vh_einv_count','&gt;', 0)]}"/>
                <button name="action_create_view_vh_einv" string="Create VH E-Invoice" type="object" attrs="{'invisible': ['|', ('state', 'not in', ('sale', 'done')), ('vh_einv_count','=', 0)]}"/>
            </xpath>
            <xpath expr="//field[@name='team_id']" position='after'>
                <!-- <group></group> -->
                <!-- <group string='E-INVOICE INFORMATION'> -->
                    <field name="partner_vat_id" options="{'no_quick_create': True}"/>
                    <field name="partner_contact_id" options="{'no_quick_create': True}"/>
                    <field name="vh_einv_ref"/>
                <!-- </group>     -->
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Vinh Hy E-Invoice" attrs="{'invisible': [('vh_einv_ids', '=', [])]}">
                    <field name="vh_einv_ids" widget="section_and_note_one2many" mode="tree" readonly="1">
                        <tree>
                            <field name="name" />
                            <field name="partner_id" />
                            <field name="partner_vat_id" />
                            <field name="amount_untaxed" sum="Total" />
                            <field name="amount_tax" sum="Total" />
                            <field name="amount_total" sum="Total" />
                            <field name="date_invoice" readonly="1" />
                            <field name="state" />
                            <button name="action_open_invoice" type="object" icon="fa-arrow-right" width="0.1" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_vat_id" optional="show"/>
                <field name="partner_contact_id" optional="show"/>
            </field>
        </field>
    </record>
    
    <record id="sale_view_order_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_vat_id" optional="show"/>
                <field name="partner_contact_id" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
