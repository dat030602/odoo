<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vinhhy_view_order_form_inherit" model="ir.ui.view">
        <field name="name">vinhhy.sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header[1]" position="inside">
                <field name="vh_einv_count" invisible="1" />
                <button name="action_create_einvoice" string="Create VH E-Invoice" type="object" class="oe_highlight" invisible="state not in ('sale', 'done') or vh_einv_count > 0"/>
                <button name="action_create_einvoice" string="Create VH E-Invoice" type="object" invisible="state not in ('sale', 'done') or vh_einv_count == 0"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_vh_einv"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o"
                    invisible="vh_einv_count == 0">
                    <field name="vh_einv_count" widget="statinfo" string="VH E-Invoices"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='team_id']" position='after'>
                <!-- <group></group> -->
                <!-- <group string='E-INVOICE INFORMATION'> -->
                    <field name="vh_einv_ref"/>
                <!-- </group>     -->
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Vinh Hy E-Invoice" invisible="vh_einv_ids == []">
                    <field name="vh_einv_ids" widget="section_and_note_one2many" mode="tree" readonly="1">
                        <tree>
                            <field name="name" />
                            <field name="partner_id" />
                            <field name="amount_untaxed" sum="Total" />
                            <field name="amount_tax" sum="Total" />
                            <field name="amount_total" sum="Total" />
                            <field name="date_invoice" readonly="1" />
                            <field name="state" />
                            <button name="action_open_invoice" type="object" icon="fa-arrow-right" width="0.1" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
