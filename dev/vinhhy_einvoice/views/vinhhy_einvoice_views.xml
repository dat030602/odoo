<odoo>
    <data>
        <record model="ir.ui.view" id="vinhhy_einvoice_list">
            <field name="name">vinhhy.einvoice.list</field>
            <field name="model">vinhhy.einvoice</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="partner_id" />
                    <field name="date_invoice" />
                    <field name="customer_code" />
                    <field name="amount_untaxed" sum="Untaxed Amount" />
                    <field name="amount_tax" sum="Tax Amount" />
                    <field name="amount_total" sum="Total" />
                    <field name="state" widget="badge" decoration-info="state == 'M'" decoration-success="state == 'CM'" decoration-warning="state == 'N'" decoration-danger="state == 'H'" />
                </tree>
            </field>
        </record>

        <record id="vinhhy_einvoice_form" model="ir.ui.view">
            <field name="name">vinhhy.einvoice.form</field>
            <field name="model">vinhhy.einvoice</field>
            <field name="arch" type="xml">
                <form string="Vinh Hy E-Invoice" class="o_invoice_form">
                    <header>
                        <button name="action_send_to_issue_vh_einv" string="Issue invoice" type="object" class="oe_highlight" groups="account.group_account_invoice" invisible="state != 'XN'"/>
                        <button name="comfirm_2_issue" string="Confirm to Issue" type="object" class="oe_highlight" groups="account.group_account_invoice" invisible="state != 'N'"/>
                        <button name="action_get_invoice_status" string="Get Invoice Status" type="object" class="oe_highlight" groups="account.group_account_invoice" invisible="state == 'N'"/>
                        <button name="action_get_einv_pdf" string="Get Invoice PDF" type="object" class="oe_highlight" groups="account.group_account_invoice" invisible="state in ('N','XN')"/>
                        <button name="%(vinhhy_einvoice.action_cancel_einvoice)d" string="Cancel invoice" type="action" class="oe_highlight" groups="account.group_account_invoice" invisible="state not in ('M','CM')"/>
                    </header>
                    <sheet string="Vinh Hy E-Invoice">
                        <field name="state" invisible="1"/>
                        <widget name="web_ribbon" title="Issued" invisible="state != 'CM'" />
                        <widget name="web_ribbon" title="Canceled" bg_color="bg-danger" invisible="state != 'H'" />
                        <widget name="web_ribbon" title="New" bg_color="bg-info" invisible="state != 'M'" />
                        <widget name="web_ribbon" title="Confirm To Issue" bg_color="bg-info" invisible="state != 'XN'" />
                        <widget name="web_ribbon" title="Draft" bg_color="bg-warning" invisible="state != 'N'" />
                        <div class="oe_button_box" name="button_box"></div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1" force_save="1" />
                            </h1>
                        </div>
                        <group>
                            <group string="Partner Information">
                                <field name="partner_id" string="Buyer" />
                                <field name="customer_name" invisible="0" force_save="1"/>
                                <field name="customer_code" force_save="1"/>
                                <field name="customer_vat"  force_save="1"/>
                                <field name="customer_address" />
                                <field name="customer_email" />
                                <field name="currency_id" />
                            </group>
                            <group string="E-Invoice Information">
                                <field name="vh_inv_template_id" required="1" />
                                <field name="template_code" required="1" />
                                <field name="invoice_series" required="1" />
                                <field name="sale_ids" widget="many2many_tags"/>
                                <field name="invoice_ids" widget="many2many_tags"/>
                                <field name="date_invoice" required="1"/>
                                <field name="payment_method" required="1"/>
                                <field name="user_id" />
                                <field name="team_id" />
                                <field name="einv_type" invisible="1"/>
                                <field name="adjustmentInvoiceType" invisible="1"/>
                                <field name="company_id" invisible="1"/>
                                <field name="lookup_code" invisible="1"/>
                                <field name="vh_einv_key" invisible="1"/>
                                <field name="vh_einv_fkey" invisible="1"/>
                                <field name="is_update_vat_prod_qty" invisible="1"/>
                                <field name="inv_attachment_ids" widget="many2many_binary"/>
                            </group>
                        </group>
                        <notebook colspan="4">
                            <page string="E-Invoice Line">
                                <field name="line_ids" widget="section_and_note_one2many">
                                    <tree editable="bottom">
                                        <field name="product_id" domain="[('sale_ok','=',True)]" force_save="1" />
                                        <field name="name" widget="section_and_note_text" force_save="1" optional="hide"/>
                                        <field name="product_id" required="1"/>
                                        <field name="quantity" />
                                        <field name="uom_id" />
                                        <field name="tax_id" />
                                        <field name="price_unit" />
                                        <field name="price_total" />
                                    </tree>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="amount_untaxed"/>
                                    <field name="amount_tax"/>
                                    <field name="amount_discount" invisible="amount_discount == 0"/>
                                    <field name="amount_total" class="oe_subtotal_footer_separator"/>
                                </group>
                            </page>
                            <page string="Adjust Invoice Information" invisible="einv_type not in ('replacement_invoice','adjustment_invoice')">
                                <group>
                                    <field name="seller_responsible" options="{'no_create': 1}" required="einv_type in ('replacement_invoice','adjustment_invoice')"/>
                                    <field name="seller_position" required="einv_type in ('replacement_invoice','adjustment_invoice')"/>
                                    <field name="seller_address" required="einv_type == 'replacement_invoice'"/>
                                    <field name="buyer_responsible" options="{'no_create': 1}" required="einv_type in ('replacement_invoice','adjustment_invoice')"/>
                                    <field name="buyer_position" required="einv_type in ('replacement_invoice','adjustment_invoice')"/>
                                    <field name="buyer_address" required="einv_type == 'replacement_invoice'"/>
                                    <field name="reason_adjust_einv" required="einv_type in ('replacement_invoice','adjustment_invoice')"/>
                                </group>
                            </page>
                            <page string="Other">
                                <field name="notes" placeholder="Internal Note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" />
                        <field name="activity_ids" />
                        <field name="message_ids" />
                    </div>
                </form>
            </field>
        </record>
        <record id="view_vinhhy_einvoice_filter" model="ir.ui.view">
            <field name="name">vinhhy.einvoice.search</field>
            <field name="model">vinhhy.einvoice</field>
            <field name="arch" type="xml">
                <search string="Search VH E-Invoice">
                    <field name="name" string="VH E-Invoice" filter_domain="['|', '|', ('name', 'ilike', self), ('partner_id.partner_id', 'child_of', self), ('partner_id', 'ilike', self)]"/>
                    <field name="partner_id" string="Partner" filter_domain="['|', ('partner_id.partner_id', 'child_of', self), ('partner_id', 'child_of', self)]"/>
                    <field name="customer_code" string="Customer Code" filter_domain="[('customer_code', 'ilike', self)]"/>
                    <separator/>
                    <filter name="date_invoice" string="Invoice Date"  date="date_invoice"/>
                    <filter name="create_date" string="Create Date" date="create_date"/>
                    <group expand="0" string="Group By">
                        <filter string="Buyer" name="group_partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                        <filter string="State" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                        <filter string="Customer Code" name="group_customer_code" domain="[]" context="{'group_by': 'customer_code'}"/>
                        <separator/>
                        <filter string="Create Date" name="group_create_date" domain="[]" context="{'group_by': 'create_date'}"/>
                        <filter string="Invoice Date" name="group_date_invoice" domain="[]" context="{'group_by': 'date_invoice'}"/>
                        <separator/>
                        <filter string="Individual Customer/Company" name="group_is_individual_customer" domain="[]" context="{'group_by': 'is_individual_customer'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_vinhhy_einvoice">
            <field name="name">Vinh Hy E-Invoice</field>
            <field name="res_model">vinhhy.einvoice</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="vinhhy_einvoice_list" />
        </record>
    </data>
</odoo>
