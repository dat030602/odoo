<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_inherit_form_view" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header[1]" position="inside">
                <field name="vh_einv_count" invisible="1" />
                <!-- <button name="action_create_view_vh_einv" string="Create VH E-Invoice" type="object" class="oe_highlight" attrs="{'invisible': ['|', '|', ('state', 'in', ('draft', 'cancel')), ('vh_einv_count','>', 0), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_refund'))]}" />
                <button name="action_create_view_vh_einv" string="Create VH E-Invoice" type="object" attrs="{'invisible': ['|', '|', ('state', 'in', ('draft', 'cancel')), ('vh_einv_count','=', 0), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_refund'))]}" /> -->
            </xpath>
            <field name="partner_id" position="after">
                <field name="partner_contact_id" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'in_refund'))]}" options="{'no_quick_create': True}" />
                <field name="partner_vat_id" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'in_refund'))]}" options="{'no_quick_create': True}" />
            </field>
            <xpath expr="//field[@name='payment_reference']" position="before">
                <field name="vh_einv_ref" attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}" />
                <field name="vh_einv_ids" widget="many2many_tags" />
            </xpath>
            <!-- <xpath expr="//page[@id='aml_tab']" position="after">
                <page string="Vinh Hy E-Invoice" attrs="{'invisible': [('vh_einv_ids', '=', [])]}">
                    <field name="vh_einv_ids" widget="section_and_note_one2many" mode="tree" readonly="1">
                        <tree>
                            <field name="name" />
                            <field name="partner_id" />
                            <field name="partner_vat_id" />
                            <field name="amount_untaxed" sum="Total" />
                            <field name="amount_tax" sum="Total" />
                            <field name="amount_total" sum="Total" />
                            <field name="date_invoice" readonly="1" />
                            <field name="state" />
                            <button name="action_open_invoice" type="object" icon="fa-arrow-right" width="0.1" />
                        </tree>
                    </field>
                </page>
            </xpath> -->
        </field>
    </record>
    <record id="view_account_move_tree_inherit" model="ir.ui.view">
        <field name="name">account.move.tree.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="field[@name='invoice_origin']" position="after">
                <field name="vh_einv_ref" invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund','out_receipt')" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_move_filter_inherit" model="ir.ui.view">
        <field name="name">account.move.search.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="vh_einv_ids" />
            </field>
        </field>
    </record>
</odoo>