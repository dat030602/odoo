<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_inherit_form_view" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header[1]" position="inside">
                <field name="vh_einv_count" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='payment_reference']" position="before">
                <field name="vh_einv_ref" invisible="move_type != 'out_invoice'" />
                <field name="vh_einv_ids" widget="many2many_tags" />
            </xpath>
        </field>
    </record>
    <record id="view_account_move_tree_inherit" model="ir.ui.view">
        <field name="name">account.move.tree.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="field[@name='invoice_origin']" position="after">
                <field name="vh_einv_ref" invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund','out_receipt')" optional="hide"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_move_filter_inherit" model="ir.ui.view">
        <field name="name">account.move.search.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="vh_einv_ids" />
            </field>
        </field>
    </record>
</odoo>