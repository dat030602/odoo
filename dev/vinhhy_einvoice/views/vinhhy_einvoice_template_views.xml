<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vinhhy_einvoice_template_tree" model="ir.ui.view">
        <field name="name">vinhhy.einvoice.template.tree</field>
        <field name="model">vinhhy.einvoice.template</field>
        <field name="arch" type="xml">
            <tree string="Vinh Hy E-Invoice Template">
                <field name="template_code" />
                <field name="series" invisible="0" />
                <field name="type_id" />
            </tree>
        </field>
    </record>
    <record id="view_vinhhy_einvoice_template_form" model="ir.ui.view">
        <field name="name">vinhhy.einvoice.template.form</field>
        <field name="model">vinhhy.einvoice.template</field>
        <field name="arch" type="xml">
            <form string="Vinh Hy E-Invoice Template">
                <header></header>
                <sheet string="Vinh Hy E-Invoice Template">
                    <group>
                        <group>
                            <field name="type_id" options="{'no_create': True, 'no_open': True}" />
                            <field name="template_code" />
                            <field name="series" />
                            <field name="active" widget="boolean_toggle" />
                            <field name="company_id" invisible="1" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
    <record id="action_open_vinhhy_einvoice_template" model="ir.actions.act_window">
        <field name="name">Vinh Hy E-Invoice Templates</field>
        <field name="res_model">vinhhy.einvoice.template</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_vinhhy_einvoice_template_tree" />
    </record>
</odoo>