<odoo>
    <data>
        <record model="ir.ui.view" id="partner_vat_list">
            <field name="name">partner.vat.list</field>
            <field name="model">partner.vat</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="ref" />
                    <field name="name" />
                    <field name="partner_id" />
                    <field name="partner_address" />
                    <field name="vat" />
                </tree>
            </field>
        </record>
        <record id="partner_vat_form" model="ir.ui.view">
            <field name="name">partner.vat.form</field>
            <field name="model">partner.vat</field>
            <field name="arch" type="xml">
                <form string="Partner VAT" class="o_invoice_form">
                    <!-- <header>
                    </header> -->
                    <sheet string="Partner VAT">
                        <div class="oe_title mb24">
                            <field name="company_type" widget="radio" options="{'horizontal': true}" />
                            <h1>
                                <field class="o_text_overflow" name="name" default_focus="1"
                                    placeholder="e.g. Lumber Inc" />
                            </h1>
                            <h3>
                                <field name="ref" placeholder="e.g. NB001" required="True"/>
                            </h3>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" />
                                <field name="street" class="o_address_street"
                                    placeholder="Street..." />
                                <field name="ward_id" class="o_address_city"
                                    attrs="{'invisible': [('district_id', '=', False)]}"
                                    domain="[('district_id', '=', district_id)]" placeholder="Ward"
                                    options="{'no_create': True, 'no_open': True}" />
                                <field name="district_id" class="o_address_state"
                                    attrs="{'invisible': [('city_id', '=', False)]}"
                                    domain="[('city_id', '=', city_id)]" placeholder="District"
                                    options="{'no_create': True, 'no_open': True}" />
                                <field name="city_id" class="o_address_zip"
                                    domain="[('country_id', '=', country_id)]" placeholder="City"
                                    options="{'no_create': True, 'no_open': True}" />
                                <field name="country_id" class="o_address_country"
                                    placeholder="Country"
                                    options="{'no_create': True, 'no_open': True}" />
                                <field name="partner_address" invisible="1" />
                                <field name="vat"
                                    attrs="{'required': [('company_type','=','company')]}" />
                            </group>
                            <group>
                                <field name="email" />
                                <field name="phone" />
                                <!-- <field name="mobile" /> -->
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" />
                        <field name="activity_ids" />
                        <field name="message_ids" />
                    </div>
                </form>
            </field>
        </record>
        <record id="view_partner_vat_filter" model="ir.ui.view">
            <field name="name">partner.vat.search</field>
            <field name="model">partner.vat</field>
            <field name="arch" type="xml">
                <search string="Search VH E-Invoice">
                    <field name="name" string="Partner Name" filter_domain="['|','|', ('name', 'ilike', self), ('ref', 'ilike', self), ('partner_id', 'child_of', self)]"/>
                    <field name="email" string="Email" filter_domain="[('email', 'ilike', self)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Contact" name="group_partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_partner_vat">
            <field name="name">Partner VAT</field>
            <field name="res_model">partner.vat</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="partner_vat_list" />
        </record>
    </data>
</odoo>