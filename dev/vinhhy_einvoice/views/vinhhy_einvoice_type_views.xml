<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vinhhy_einvoice_type_tree" model="ir.ui.view">
        <field name="name">vinhhy.einvoice.type.tree</field>
        <field name="model">vinhhy.einvoice.type</field>
        <field name="arch" type="xml">
            <tree string="Vinh Hy E-Invoice">
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>
    <record id="vinhhy_einvoice_type_form" model="ir.ui.view">
        <field name="name">vinhhy.einvoice.type.form</field>
        <field name="model">vinhhy.einvoice.type</field>
        <field name="arch" type="xml">
            <form string="Vinh Hy E-Invoice Type">
                <header>
                </header>
                <sheet string="Invoice Type">
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_open_vinhhy_einvoice_type" model="ir.actions.act_window">
        <field name="name">Vinh Hy E-Invoice Types</field>
        <field name="res_model">vinhhy.einvoice.type</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="vinhhy_einvoice_type_tree"/>
        <field name="context">{'create': False, 'edit': False}</field>
    </record>
</odoo>