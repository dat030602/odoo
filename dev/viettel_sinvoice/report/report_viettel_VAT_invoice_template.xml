<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_viettel_VAT_invoice">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                <div class="report_page">
                    <!-- <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/> -->
                    <div class="page">
                        <!-- Report Header Start -->
                        <div class="report_header report_font">
                            <div class="report_logo" valign="middle" height="100%">
                                <!-- Logo Company -->
                                <table class="table-borderless" height="100%" width="100%" border="0" cellspacing="5" cellpadding="0" align="justify" valign="middle">
                                    <tbody>
                                        <tr>
                                            <td>
                                                <img t-if="doc.branch_id.logo" t-att-src="image_data_uri(doc.branch_id.logo)" width="100%" alt="LOGO"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="report_title">
                                <!-- Title -->
                                <h4>HÓA ĐƠN GIÁ TRỊ GIA TĂNG</h4>
                                <h5 class="header_title_translator">(VAT INVOICE)</h5>
                                <p class="header_note"><b>Bản thể hiện của hóa đơn điện tử</b></p>
                                <p class="header_note_translator">(Electronic invoice display)</p>
                                <div class="header_date">
                                    Ngày (date) 
                                    <span t-esc='doc.invoiceIssuedDate.day'></span> 
                                    tháng (month) 
                                    <span t-esc='doc.invoiceIssuedDate.month'></span> 
                                    năm (year) 
                                    <span t-esc='doc.invoiceIssuedDate.year'></span>
                                </div>
                            </div>
                            <div class="report_serial">
                                <!-- Serial && No -->
                                <div>
                                    <table class="table-borderless serial" width="100%" border="0" cellspacing="5" cellpadding="0" align="justify">
                                        <tbody>
                                            <!-- <tr>
                                                <td align="center" colspan="2" valign="top" cellpadding="10"><h2>NHÁP</h2></td>
                                            </tr> -->
                                            <tr>
                                                <td width="80%"><b>Ký hiệu</b> <i>(Serial):</i></td>
                                                <td style="color: #FF0000;"><b t-esc='doc.invoiceSeries'></b></td>
                                            </tr>
                                            <tr>
                                              
                                                <td style="padding-top: 10px;"><b>Số </b><i>(No.):</i></td>
                                                <td></td>
                                            </tr>
                                           
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- Report Header End -->

                        <!-- Report Saler Information Start -->
                        <div style="margin-top:10px; margin-bottom: 6px; border-top: solid 1px black; width: 100%"/>
                        <div class="report_saler_information">
                            <table class="table-borderless report_font full_width">
                                <tr>
                                    <td width="40%"><b>Đơn vị bán hàng</b> <i>(Seller)</i></td>
                                    <td width="2%"><b>:</b></td>
                                    <td><b t-field='doc.company_id.partner_id.name'></b></td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 8px;"><b>Mã số thuế </b><i>(Tax code)</i></td>
                                    <td><b>:</b></td>
                                    <td><b t-field='doc.company_id.partner_id.vat'></b></td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 8px;"><b>Địa chỉ</b> <i>(Address)</i></td>
                                    <td>:</td>
                                    <td><span t-field='doc.company_id.partner_id.partner_address'></span></td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 6px;"><b>Điện thoại</b> <i>(Tel)</i></td>
                                    <td>:</td>
                                    <td><span t-field='doc.company_id.phone'></span></td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 6px;"><b>Website</b></td>
                                    <td>:</td>
                                    <td><span t-field='doc.company_id.website'></span></td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 6px;"><b>Số tài khoản</b> <i>(A/C No.)</i></td>
                                    <td>:</td>
                                    <td><span t-field='doc.branch_id.acc_number'></span></td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 8px;"><b>Ngân hàng</b> <i>(Bank)</i></td>
                                    <td>:</td>
                                    <td><span t-field='doc.branch_id.bank'></span></td>
                                </tr>
                            </table>
                        </div>
                        <!-- Report Saler Information End -->

                        <!-- Report Buyer Information Start -->
                        <div style="margin-top:14px; margin-bottom: 6px; border-top: solid 1px black; width: 100%"/>
                        <div class="report_buyer">
                            <table class="table-borderless report_font full_width">
                                <tr>
                                    <td width="40%" ><b>Họ tên người mua hàng</b> <i>(Buyer)</i></td>
                                    <td width="2%">:</td>
                                    <td>
                                        <b t-field='doc.customer_name'></b>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 8px;"><b>Tên đơn vị</b> <i>(Company name)</i></td>
                                    <td>:</td>
                                    <td><span t-field='doc.legal_customer_name'></span></td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 6px;"><b>Mã số thuế </b><i>(Tax code)</i></td>
                                    <td>:</td>
                                    <td><span t-field='doc.customer_vat'></span></td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 6px;"><b>Địa chỉ</b> <i>(Address)</i></td>
                                    <td>:</td>
                                    <td><span t-field='doc.customer_address'></span></td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 6px;">Mã ĐVQHNS</td>
                                    <td>:</td>
                                    <td><span t-field='doc.customer_budget_code'></span></td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 6px;">CCCD</td>
                                    <td>:</td>
                                    <td><span t-field='doc.customer_id_no'></span></td>
                                </tr>
                                <tr>
                                    <td style="padding-top: 8px;"><b>Hình thức thanh toán</b> <i>(Payment)</i></td>
                                    <td>:</td>
                                    <td><span t-field='doc.paymentMethodName'></span></td>
                                </tr>
                            </table>
                        </div>
                        <!-- Report Buyer Information End-->

                        <!-- Report Table Start -->
                        <div class="report_table_detail">
                            <table class="report_table report_font">
                                <tbody>
                                    <tr>
                                        <th><b>STT</b><br/><i>(No.)</i></th>
                                        <th><b>Tên hàng hóa, dịch vụ</b><br/><i>(Description)</i></th>
                                        <th><b>Đơn vị tính</b><br/><i>(Unit)</i></th>
                                        <th><b>Số lượng</b><br/><i>(Quantity)</i></th>
                                        <th><b>Đơn giá</b><br/><i>(Unit price)</i></th>
                                        <th><b>Thành tiền</b><br/><i>(Amount)</i></th>
                                    </tr>
                                    <tr>
                                        <th>1</th>
                                        <th>2</th>
                                        <th>3</th>
                                        <th>4</th>
                                        <th>5</th>
                                        <th>6 = 4 x 5</th>
                                    </tr>
                                    <t t-set="line_no" t-value='0'/>
                                    <t t-foreach="doc.sinvoice_line" t-as="line">
                                        <t t-set="line_no" t-value="line_no + 1"></t>
                                        <tr>
                                            <td class="text_center"><span><t t-esc='line_no'/></span></td>
                                            <td class="text_left"><span t-field='line.name'></span></td>
                                            <td class="text_center"><span t-field='line.uom_id.name'></span></td>
                                            <td class="text_right"><span t-field='line.quantity'></span></td>
                                            <td class="text_right"><span t-field='line.price_unit'></span></td>
                                            <td class="text_right"><span t-field='line.price_subtotal'></span></td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td  class="text_right" colspan="5"><b>Cộng tiền hàng </b><i>(Total amount):</i></td>
                                        <td class="text_right"><span t-field='doc.amount_untaxed'></span></td>
                                    </tr>
                                    <tr>
                                        <t t-if="doc.sinvoice_line.tax_id">
                                            <t t-set="Tax" t-value="doc.sinvoice_line.mapped('tax_id')[0].amount"/>
                                        </t>
                                        <t t-else="">
                                            <t t-set="Tax" t-value=""/>
                                        </t>
                                        
                                        <td  class="text_center" colspan="2"><b>Thuế suất GTGT </b><i>(VAT rate):</i> <t t-esc='Tax'/>%</td>
                                        <td class="text_center" colspan="3" align="justify"><b>Tiền thuế GTGT</b><i>(VAT amount):</i></td>
                                        <td class="text_right"><span t-field='doc.amount_tax'></span></td>
                                    </tr>
                                    <tr>
                                        <td class="text_right" colspan="5"><b>TỔNG CỘNG TIỀN THANH TOÁN </b><i>(Total payment):</i></td>
                                        <td class="text_right"><span t-field='doc.amount_total'></span></td>
                                    </tr>
                                    <tr>
                                        <td colspan="6">
                                            <b>Số tiền viết bằng chữ </b>
                                            <i>(Amount in words):</i> 
                                            <span><t t-esc="doc.get_amount_text(doc.amount_total)"/></span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- Report Table End -->

                        <!-- Break Page -->
                        <!-- <t t-set='count' t-value='len(doc.sinvoice_line)'></t>
                        <t t-set='count_mod' t-value='0'></t>
                        <t t-if='count > 33 '>
                            <t t-set='count_mod' t-value='count - 33'></t>
                        </t> -->
                        <!-- 22 là số dòng của bảng tối đa để chưa break page 1, 33 là số dòng tối đa của bảng để break page 1 không có ký tên -->
                        <!-- 79 - 33 = 46, 79 là số dòng của bảng tối đa để chưa break page lớn hơn 2 -->
                        <!-- <t t-if='(count > 22 and 6 > count % 22 and 33 > count) or (count_mod > 45 and 6 > count_mod % 45)'>
                            <div style="page-break-after: always;"></div>
                        </t> -->

                        <!-- Report signature Start -->
                        <div class="report_signature report_font">
                            <!-- Buyer Signature -->
                            <div class="buyer_signature"><b>Người mua hàng</b> <i>(Buyer)</i></div>
                            <!-- Saler Signature -->
                            <div class="saler_signature"><b>Người bán hàng</b> <i>(Seller)</i></div>
                        </div>
                        <!-- <div t-esc='count'></div> -->
                        <!-- Report signature End -->

                        <!-- Report Footer Start -->
                        <div></div>
                        <!-- Report Footer End -->
                        <style type="text/css">
                            .report_page {
                                font-family: 'Roboto', serif; 
                                min-height: 99%;
                                padding: 5px;
                                border: 4px double black;
                            }
                            .report_header{
                                height: 134px;
                                display: flex;
                            }
                            .report_logo {
                                top: 0px;
                                display: inline-block;
                                width: 24%;
                                height: 100%;
                            }
                            .report_header .report_title {
                                display: inline-block;
                                width: 50%;
                                height: 120%;
                                text-align: center;
                            }
                            .report_header .header_title {
                                font-weight: 600;
                                line-height: 1;
                            }
                            .report_header .header_title_translator {
                                font-style: italic;
                                line-height: 1;
                                margin-top: -6px;
                            }
                            .report_header .header_note {
                                font-weight: 500;
                                margin-bottom: 5px;
                            }
                            .report_header .header_note_translator {
                                font-style: italic;
                                margin-top: -8px;
                            }
                            .report_header .header_date{
                                margin-top: -10px;
                            }
                            .report_header .report_serial {
                                display: inline-block;
                                width: 24%;
                                height: 100%;
                            }

                            .report_table_detail {
                                margin-top: 10px;
                            }
                            .report_table_detail table.report_table {
                                border: 1px solid  #808084;
                                border-spacing: 0px;
s                                width: 100%
                            }
                            .report_table_detail .report_table th i{
                                font-weight: 200;
                            }
                            .report_table_detail .report_table td, th {
                                height: 20px;
                                border-top: 1px solid  #808084;
                                border-spacing: 2px;
                                border-collapse: collapse;
                            }
                            .report_table_detail .report_table th:first-child {
                                width: 5%;
                            }
                            .report_table_detail .report_table th:nth-child(2){
                                width: 44%;
                            }
                            .report_table_detail .report_table th:nth-child(3){
                                width: 10%;
                            }
                            .report_table_detail .report_table th:nth-child(4){
                                width: 10%;
                            }
                            .report_table_detail .report_table th:nth-child(5){
                                width: 15%;
                            }
                            .report_table_detail .report_table th:last-child {
                                width: 15%;
                            }
                            .report_signature {
                                height: 100px;
                                width: 99%
                                display: block;
                                text-align: center;
                                vertical-align: text-top;
                                margin-top: 10px;
                            }
                            .report_signature .buyer_signature {
                                width: 49%;
                                heigh: 100px;
                                display: inline-block;
                            }
                            .report_signature .saler_signature {
                                width: 49%;
                                heigh: 100px;
                                display: inline-block;
                            }
                            .full_width {
                                width: 100%;
                            }
                            .text_left {
                                text-align: left;
                            }
                            .text_center {
                                text-align: center;
                            }
                            .text_right {
                                text-align: right;
                            }
                            .report_font {
                                font-size: 16px;
                            }
                            .serial{
                                margin-top: 10px;
                            }
                        </style>
                    </div>
                </div>
                </t>
            </t>
        </t>
    </template>
    <record id="action_report_viettel_VAT_invoice_customize" model="ir.actions.report">
        <field name="name">Hoá Đơn Giá Trị Gia Tăng</field>
        <field name="model">viettel.sinvoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">viettel_sinvoice.report_viettel_VAT_invoice</field>
        <field name="report_file">viettel_sinvoice.report_viettel_VAT_invoice</field>
		<field name="print_report_name">'Hoá Đơn Giá Trị Gia Tăng - %s' % (object.id or '',)</field>
        <field name="binding_model_id" ref="viettel_sinvoice.model_viettel_sinvoice" />
        <field name="paperformat_id" ref="viettel_sinvoice.paperformat_VAT_invoice"/>
    </record>
</odoo>
