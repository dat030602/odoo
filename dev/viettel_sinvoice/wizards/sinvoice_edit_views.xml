<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="view_sinvoice_edit_info_form">
			<field name="name">sinvoice.edit.form</field>
			<field name="model">viettel.sinvoice.edit</field>
			<field name="arch" type="xml">
				<form string="Cập nhật hóa đơn">
					<sheet>
						<group>
							<field name="sinvoice_edit_type"/>
							<field name="company_id" invisible="1"/>
							<field name="journal_id" invisible="1"/>
						</group>
						<group>
							<group name="customer" string="Thông tin người mua cũ" invisible="sinvoice_edit_type not in ('info')">

							</group>
							<group string="Thông tin người mua">
								<field name="partner_id" readonly="sinvoice_edit_type == 'amount'" options="{'always_reload': True}"/>
								<field name="partner_vat_id" readonly="sinvoice_edit_type == 'amount'" options="{'always_reload': True}"/>

							</group>
						</group>
						<group name="customer_info">
							<group name="customer_info_left">
								<field name="customer_name" readonly="1" string="Tên người mua"/>
								<field name="legal_customer_name" readonly="1" string="Tên đơn vị"/>
								<field name="customer_code" readonly="1"/>
								<field name="customer_vat" readonly="1"/>
 								<field name="customer_email" readonly="1"/>
								<field name="customer_address" readonly="1"/>
							</group>
							<group name="customer_info_right" invisible="sinvoice_edit_type not in ('info', 'replace')">
								<field name="new_customer_name" string="Tên người mua mới"/>
								<field name="new_legal_customer_name" string="Tên đơn vị mới"/>
								<field name="new_customer_code"/>
								<field name="new_customer_vat"/>
 								<field name="new_customer_email"/>
								<field name="new_customer_address"/>
							</group>
						</group>
						<group string="Thông tin chung">
							<group>
								<field name="viettel_sinvoice_template_id" options="{'no_create': True, 'no_open': True}"/>
								<field name="branch_id"/>
								<field name="vsi_template" readonly="1" string="Mẫu số"/>
	                        	<field name="originalInvoiceId" readonly="1" string="Hoá đơn điện tử gốc"/>
							</group>
							<group>
								<field name="invoiceIssuedDate" string="Ngày phát hành"/>
	                        	<field name="additionalReferenceDesc" required="1" string="Văn bản thoả thuận"/>
	                        	<field name="additionalReferenceDate" required="1" string="Ngày thoả thuận"/>
							</group>
	                    </group>
						<notebook colspan="4" invisible="sinvoice_edit_type not in ('amount','replace')">
							<page string="Chi tiết hóa đơn">
								<field name="sinvoice_edit_line" widget="section_and_note_one2many" nolabel="1" on_change="1" context="{'journal_id': journal_id, 'default_sinvoice_edit_type': sinvoice_edit_type}">
									<tree editable="bottom">
										<field name="selection" invisible="sinvoice_edit_type != 'replace'"/>
										<field name="sinvoice_edit_type" invisible="1"/>
										<field name="sinvoice_id" invisible="1"/>
										<field name="edit_type"/>
										<field name="org_line_id" invisible="1"/>
										<field name="product_id"/>
										<field name="name"/>
										<field name="sinvoice_line_tax_id"/>
										<field name="uom_id" groups="uom.group_uom"/>
										<field name="quantity"/>
										<field name="price_unit"/>
										<field name="price_subtotal"/>
									</tree>
									<form>
										<group>
											<field name="price_total" invisible="1"/>
											<field name="sinvoice_edit_type" invisible="1"/>
											<field name="sinvoice_id" invisible="1"/>
											<group>
												<field name="product_id"/>
												<field name="name"/>
												<field name="account_id" groups="account.group_account_user"/>
												<field name="uom_id" groups="uom.group_uom"/>
											</group>
											<group>
												<field name="quantity"/>
												<field name="price_unit" string="Unit Price"/>
												<field name="sinvoice_line_tax_id" options="{'no_create': True}" context="{'tree_view_ref': 'account.account_tax_view_tree', 'search_view_ref': 'account.account_tax_view_search'}" domain="[('type_tax_use','=','sale'),('company_id', '=', parent.company_id)]"/>
												<field name="price_subtotal" string="Subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
												<field name="price_total" string="Total" groups="account.group_show_line_subtotals_tax_included"/>
											</group>
										</group>
									</form>
								</field>
								<group class="oe_subtotal_footer oe_right">
                                	<field name="amount_untaxed"/>
									<field name="amount_tax"/>
									<field name="amount_total" class="oe_subtotal_footer_separator"/>
                            	</group>
							</page>
						</notebook>
						<footer>
	                        <button string="PHÁT HÀNH HOÁ ĐƠN" name="action_edit_sinvoice" type="object" default_focus="1" class="btn-primary"/>
	                        <button string="Discard" class="btn-secondary" special="cancel"/>
	                    </footer>
					</sheet>
				</form>
			</field>
		</record>

		<record id="action_sinvoice_edit" model="ir.actions.act_window">
			<field name="name">Lập hóa đơn thay thế/điều chỉnh</field>
			<field name="res_model">viettel.sinvoice.edit</field>
			<field name="target">new</field>
			<field name="view_mode">form</field>
		</record>
    </data>
</odoo>