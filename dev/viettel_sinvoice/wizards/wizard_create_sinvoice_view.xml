<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_create_sinvoice" model="ir.ui.view">
            <field name="name">Create Sinvoice</field>
            <field name="model">wizard.create.sinvoice</field>
            <field name="arch" type="xml">
            <form string="Create SInvoice">
                <field name="move_ids" invisible="1"/>
                <group>
                    <div>Nhấn xác nhận để gộp các Công nợ đã chọn thành một Hóa đơn điện tử SInvoice!</div>
                </group>
                <footer>
                    <button string="Confirm" name="action_create_sinoice" type="object" default_focus="1" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
            </field>
        </record>

        <record id="action_account_create_sinvoice" model="ir.actions.act_window">
            <field name="name">Create Sinvoice</field>
            <field name="res_model">wizard.create.sinvoice</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="account_create_sinvoice"/>
            <field name="target">new</field>
            <field name="groups_id" eval="[(6, 0, [ref('account.group_account_invoice')])]"/>
            <field name="binding_model_id" ref="account.model_account_move" />
            <field name="binding_view_types">list</field>
        </record>
    </data>
</odoo>
