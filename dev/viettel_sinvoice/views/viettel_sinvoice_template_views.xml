<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_viettel_sinvoice_template_tree" model="ir.ui.view">
        <field name="name">viettel.sinvoice.template.tree</field>
        <field name="model">viettel.sinvoice.template</field>
        <field name="arch" type="xml">
            <tree string="Sinvoice Template">
                <field name="template_code"/>
                <field name="series"/>
                <field name="branch_id"/>
                <field name="vat"/>
                <field name="type_id"/>
            </tree>
        </field>
    </record>
    <record id="view_viettel_sinvoice_template_form" model="ir.ui.view">
        <field name="name">viettel.sinvoice.template.form</field>
        <field name="model">viettel.sinvoice.template</field>
        <field name="arch" type="xml">
            <form string="S-Invoice Template">
            <header>
                <button name="get_info_dynamic_fields" string="Get dynamic fields" type="object" class="oe_highlight"/>
                <button name="check_vsi_server" string="Check Connection Status" type="object" class="oe_highlight"/>
            </header>
                <sheet string="Invoice Template">
                    <group>
                        <group>
                            <field name="branch_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="type_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="template_code"/>
                            <field name="series"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_open_viettel_sinvoice_template" model="ir.actions.act_window">
        <field name="name">S-Invoice Templates</field>
        <field name="res_model">viettel.sinvoice.template</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_viettel_sinvoice_template_tree"/>
    </record>
    <menuitem id="menu_viettel_sinvoice_template"
              action="action_open_viettel_sinvoice_template"
              parent="viettel_sinvoice.menu_viettel_sinvoice_conf"
              groups="account.group_account_manager"
              sequence="107"/>
</odoo>