<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_viettel_sinvoice_tree" model="ir.ui.view">
        <field name="name">viettel.sinvoice.tree</field>
        <field name="model">viettel.sinvoice</field>
        <field name="arch" type="xml">
            <tree string="Viettel Sinvoice">
                <field name="name"/>
                <field name="partner_vat_id"/>
                <field name="partner_id"/>
                <field name="invoice_ids" widget="many2many_tags"/>
                <field name="viettel_sinvoice_template_id" readonly="state != 'draft'"/>
                <field name="invoiceType"/>
                <field name="base_sinvoice_id" optional="hide"/>
                <field name="invoiceIssuedDate" readonly="state != 'draft'"/>
                <field name="user_id" optional="hide"/>
                <field name="amount_untaxed" sum="Total"/>
                <field name="amount_tax" sum="Total"/>
                <field name="amount_total" sum="Total"/>
                <field name="invoiceIssuedDate" readonly="state != 'draft'"/>
                <field name="state"/>
                <field name="invoices_total" optional="hide"/>
                <field name="invoice_sinvoice_diff" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_viettel_sinvoice_form" model="ir.ui.view">
        <field name="name">viettel.sinvoice.form</field>
        <field name="model">viettel.sinvoice</field>
        <field name="arch" type="xml">
            <form string="Invoice">
                <header>
                    <field name="downloaded" invisible="1"/>
                    <field name="invoice_type_code" invisible="1" readonly="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state not in ('draft')"/>
                    <button name="action_reset_draft" string="Reset" type="object" class="oe_highlight" invisible="state not in ('confirm')"/>
                    <button name="action_create_sinvoice" string="Phát hành hóa đơn" type="object" class="oe_highlight" invisible="state != 'confirm'"/>
                    <button name="action_get_sinvoice_pdf_file" type="object" class="oe_highlight" string="Tải Hóa Đơn" icon="fa-print" invisible="downloaded == True or state in ('draft','confirm')"/>
                    <button name="%(action_sinvoice_cancel)d" type="action" class="oe_highlight" string="Hủy Hóa Đơn" icon="fa-remove"
                        invisible="state not in ('created', 'replace', 'edit_info')" />
                    <button name="%(action_sinvoice_edit)d" context="{'type': 'info', 'default_type': 'info'}"
                            type="action" class="oe_highlight" string="Cập nhật hóa đơn" icon="fa-edit"
                            invisible="state not in ('created', 'replace', 'is_edited_amount', 'is_edited_info') or invoice_type_code != '01GTKT'"/>
                    <button name="action_check_invoice_by_transactionID" type="object" class="oe_highlight" string="Get info"
                        invisible="state not in ('draft', 'confirm')" />
                    <field name="state" widget="statusbar"/>
                </header>
                <div class="alert alert-info text-center" role="alert" style="margin-bottom:0px; background-color:#c6d9de;" invisible="adjustmentType == 1 or  state == 'canceled'">
                    <h3>
                    <strong>
                        <field name="adjustmentType" nolabel="1" class="oe_inline" readonly="1"/> <span invisible=" base_sinvoice_id == False"> cho hóa đơn số </span> <field name="base_sinvoice_id" nolabel="1" class="oe_inline" readonly="1"/>
                    </strong>
                    </h3>
                </div>
                <sheet string="Invoice">
                    <div class="oe_button_box" name="button_box">
                        <field name="inherited_sinvoice_ids" invisible="1"/>
                        <button name="action_view_inherited_sinvoice" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="inherited_sinvoice_count == 0">
                            <field name="inherited_sinvoice_count" widget="statinfo" string="S-Invoice(s)"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" string="Người mua" readonly="state != 'draft'" options="{'always_reload': True}"/>
                            <field name="customer_name" string="Tên người mua"/>
                            <field name="partner_vat_id" string="Đơn vị" readonly="state != 'draft'" options="{'always_reload': True}"/>
                            <field name="legal_customer_name" string="Tên đơn vị"/>
                            <field name="customer_code"/>
                            <field name="currency_id" invisible="1" readonly="state != 'draft'"/>
                            <field name="customer_vat" string="Mã số thuế"/>
                            <field name="customer_address" string="Địa chỉ"/>
                            <field name="customer_email"/>
			    <field name="customer_budget_code" string="Mã ngân sách nhà nước"/>
			    <field name="customer_id_no" string="Số CCCD"/>
                            <field name="additional_emails"/>
                            <field name="user_id" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                            <field name="paymentMethodName"/>
                            <field name="paymentStatus"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="viettel_sinvoice_template_id" required="True" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                            <field name="branch_id"/>
                            <field name="invoiceType" required="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="templateCode" string="Mẫu số"/>
                            <field name="invoiceSeries" string="Ký hiệu"/>
                            <field name="invoice_ids" widget='many2many_tags' readonly="1" string="Odoo Invoices" invisible="invoice_ids == False"/>
                            <field name="picking_id" readonly="1" string="Odoo Picking" invisible="picking_id == False"/>
                            <field name="internal_move_type" readonly="1" invisible="not internal_move_type"/>
                            <field name="ref" required="not invoice_ids and not picking_id" readonly="state != 'draft'"/>
                            <field name="base_sinvoice_id" readonly="1" invisible="base_sinvoice_id == False"/>
                            <field name="transactionID" invisible="1"/>
                            <field name="reservationCode" invisible="1"/>
                            <field name="code_of_tax"/>
                            <field name="invoiceIssuedDate" required="1" string="Ngày lập" readonly="state != 'draft'"/>
                            <field name="adjustmentType" readonly="1"/>
                            <field name="adjustmentInvoiceType" readonly="1" invisible="adjustmentInvoiceType == False"/>
                            <field name="journal_id" invisible="1" readonly="state != 'draft'"/>
                            <field name="attachment_ids" widget="many2many_binary" string="Bản in PDF"/>
                        </group>
                        <group invisible="invoice_type_code != '03XKNB'">
                            <field name="commandNo" readonly="state != 'draft'"/>
                            <field name="commandOf" readonly="state != 'draft'"/>
                            <field name="commandDes" readonly="state != 'draft'"/>
                            <field name="contractNo" readonly="state != 'draft'"/>
                            <field name="commandDate" readonly="state != 'draft'"/>
                            <field name="exportAt" readonly="state != 'draft'"/>
                            <field name="importAt" readonly="state != 'draft'"/>
                            <field name="vehicle" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="additionalReferenceDesc" invisible="additionalReferenceDesc == False"/>
                            <field name="additionalReferenceDate" invisible="additionalReferenceDate == False"/>
                            <field name="note"/>
                            <field name="reason"/>
                            <field name="refund_note" invisible="internal_move_type != 'in_refund'"/>
                        </group>
                    </group>
                    <notebook colspan="4">
                        <page string="S-Invoice Items">
                            <field name="sinvoice_line" no-edit="0" nolabel="1" widget="section_and_note_one2many" mode="tree,kanban"
                                context="{'journal_id': journal_id, 'default_sinvoice_id': id}" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <control>
                                        <create name="add_product_control" string="Add a product"/>
                                        <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note', 'default_selection': '2'}"/>
                                    </control>
                                    <field name="selection" optional="hide"/>
                                    <field name="display_type" invisible="1"/>
                                    <field name="product_id"
                                           domain="[('sale_ok','=',True)]"
                                           required="selection != '2'"
                                    />
                                    <field name="origin" invisible="1"/>
                                    <field name="name" widget="section_and_note_text" required="1" force_save="1"/>
                                    <field name="company_id" invisible="1"/>
                                    <field name="account_id" optional="hide" groups="account.group_account_user" domain="[('company_id', '=', parent.company_id), ('deprecated', '=', False)]"/>
                                    <field name="sinvoice_line_tax_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" required="selection != '2'" groups="uom.group_uom"/>

                                    <field name="price_unit" string="Unit Price"/>
                                    <field name="discount" optional="hide"/>
                                    <field name="price_subtotal" string="Subtotal" optional="hide"/>
                                    <field name="price_total" string="Total" optional="show"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="price_total" invisible="1"/>
                                        <field name="sinvoice_id" invisible="1"/>
                                        <group>
                                            <field name="is_valid"/>
                                            <field name="product_id" options="{'always_reload': True}"/>
                                            <field name="name"/>
                                            <field name="account_id"/>
                                            <field name="sinvoice_line_tax_id"/>
                                            <field name="org_line_id" invisible="child_line_id == False"/>
                                            <field name="child_line_id" widget="many2many_tags" invisible="child_line_id == False"/>
                                        </group>
                                        <group>
                                            <field name="quantity"/>
                                            <field name="uom_id" groups="uom.group_uom"/>
                                            <field name="price_unit" string="Unit Price"/>
                                            <field name="price_subtotal" string="Subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                            <field name="price_tax"/>
                                            <field name="price_total" string="Total" groups="account.group_show_line_subtotals_tax_included"/>
                                            <field name="price_discount"/>
                                            <field name="discount"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                    <!-- Attachment preview -->
                    <div class="o_attachment_preview" />
                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
            </form>
        </field>
    </record>
    <record id="view_viettel_sinvoice_filter" model="ir.ui.view">
        <field name="name">viettel.sinvoice.search</field>
        <field name="model">viettel.sinvoice</field>
        <field name="arch" type="xml">
            <search string="Search S-Invoice">
                <field name="name" string="S-Invoice" filter_domain="['|', '|', '|', ('name', 'ilike', self), ('ref', 'ilike', self), ('invoice_ids', 'ilike', self), ('partner_id', 'child_of', self)]"/>
                <field name="partner_vat_id" string="Partner" filter_domain="['|', ('partner_id', 'child_of', self), ('partner_vat_id', 'child_of', self)]"/>
                <filter string="Khách lẻ" name="individual_customer" domain="[('is_individual_customer', '=', True)]"/>
                <filter string="Đơn vị" name="legal_customer" domain="[('is_individual_customer', '=', False)]"/>
                <separator/>
                <filter name="invoiceIssuedDate" string="Issued Date"  date="invoiceIssuedDate"/>
                <filter name="create_date" string="Created Date" date="create_date"/>
                <group expand="0" string="Group By">
                    <filter string="Người mua" name="group_partner" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Đơn vị" name="group_partner_vat" domain="[]" context="{'group_by': 'partner_vat_id'}"/>
                    <filter string="Trạng thái" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <separator/>
                    <filter string="Ngày tạo" name="group_create_date" domain="[]" context="{'group_by': 'create_date'}"/>
                    <filter string="Ngày phát hành" name="group_invoiceIssuedDate" domain="[]" context="{'group_by': 'invoiceIssuedDate'}"/>
                    <separator/>
                    <filter string="Khách lẻ/Đơn vị" name="group_is_individual_customer" domain="[]" context="{'group_by': 'is_individual_customer'}"/>
                    <filter string="Loại HĐĐT" name="group_invoice_type" domain="[]" context="{'group_by': 'invoiceType'}"/>
                    <filter string="Loại điều chỉnh" name="group_adjustment_type" domain="[]" context="{'group_by': 'adjustmentType'}"/>
                    <filter string="Loại hoá đơn nội bộ" name="group_internal_move_type" domain="[]" context="{'group_by': 'internal_move_type'}"/>
                    <filter string="Mẫu hoá đơn" name="group_template_id" domain="[]" context="{'group_by': 'viettel_sinvoice_template_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sinvoice_report_view_pivot" model="ir.ui.view">
        <field name="name">viettel.sinvoice.report.pivot</field>
        <field name="model">viettel.sinvoice</field>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <pivot string="Viettel S-Invoice Analysis" sample="1">
                <field name="invoiceIssuedDate" interval="day" type="col"/>
                <field name="create_uid" type="row"/>
                <field name="state" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="action_open_viettel_sinvoice" model="ir.actions.act_window">
        <field name="name">Viettel S-Invoice</field>
        <field name="res_model">viettel.sinvoice</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="view_id" ref="view_viettel_sinvoice_tree"/>
    </record>

    <menuitem id="menu_viettel_sinvoice"
              action="action_open_viettel_sinvoice"
              parent="account.menu_finance_receivables"
              groups="account.group_account_user,account.group_account_invoice"
              sequence="100"/>
</odoo>
