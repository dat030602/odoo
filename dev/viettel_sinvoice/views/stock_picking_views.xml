<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.sinvoice</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <field name="sinvoice_count" invisible="1"/>
                <button name="action_create_data_sinvoice" string="Tạo HĐ ĐCNB" type="object" class="oe_highlight"
                    invisible="state in ('draft', 'cancel') or sinvoice_count > 0 or picking_type_code != 'internal' or is_int_trans_invoiced == False"/>
                <button name="action_create_data_sinvoice" string="Tạo HĐ ĐCNB" type="object"
                    invisible="state in ('draft', 'cancel') or sinvoice_count > 0 or picking_type_code != 'internal' or is_int_trans_invoiced == False"/>
            </xpath>
            <xpath expr="//field[@name='owner_id']" position="after">
                <field name="is_int_trans_invoiced" string="Tạo hoá đơn điện tử" widget="boolean_toggle"/>
                <field name="viettel_sinvoice_template_id"  invisible="not is_int_trans_invoiced" domain="[('invoice_type_code','=','03XKNB')]"/>
                <field name="vehicle" invisible="not is_int_trans_invoiced"/>
            </xpath>
            <xpath expr="//page[@name='note']" position="after">
                <page string="Viettel S-Invoice" name="s_invoice" invisible="sinvoice_count == 0">
                    <field name="sinvoice_ids" widget="section_and_note_one2many" mode="tree,form">
                        <tree>
                            <field name="name"/>
                            <field name="partner_vat_id"/>
                            <field name="invoice_ids" widget="many2many_tags"/>
                            <field name="reservationCode" invisible="1"/>
                            <field name="code_of_tax"/>
                            <field name="transactionID" invisible="1"/>
                            <field name="invoiceIssuedDate" readonly="state != 'draft'"/>
                            <field name="amount_untaxed" sum="Total"/>
                            <field name="amount_tax" sum="Total"/>
                            <field name="amount_total" sum="Total"/>
                            <field name="invoiceIssuedDate" readonly="state != 'draft'"/>
                            <field name="state"/>
                            <button name="action_open_invoice" type="object" icon="fa-arrow-right" width="0.1"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>