<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_branch_tree" model="ir.ui.view">
        <field name="name">company.branch.type.tree</field>
        <field name="model">company.branch</field>
        <field name="arch" type="xml">
            <tree string="Branch">
                <field name="partner_id"/>
                <field name="name"/>
                <field name="vat"/>
                <field name="bank"/>
                <field name="acc_number"/>
            </tree>
        </field>
    </record>
    <record id="view_company_branch_form" model="ir.ui.view">
        <field name="name">company.branch.type.form</field>
        <field name="model">company.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <header>
                </header>
                <sheet string="Branch">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_templates" type="object"
                                class="oe_stat_button" icon="fa-wpforms">
                            <field name="templates_count" widget="statinfo" string="Template(s)"/>
                        </button>
                    </div>
                    <!-- logo -->
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="name"/>
                            <field name="vat"/>
                        </group>
                        <group>
                            <field name="bank"/>
                            <field name="acc_number"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_open_company_branch" model="ir.actions.act_window">
        <field name="name">Branch</field>
        <field name="res_model">company.branch</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_company_branch_tree"/>
        <field name="context">{}</field>
    </record>
    <menuitem id="menu_company_branch_tree"
              action="action_open_company_branch"
              parent="viettel_sinvoice.menu_viettel_sinvoice_conf"
              groups="account.group_account_manager"
              sequence="108"/>
</odoo>