<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_inherit_form_view" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header[1]" position="inside">
                <field name="sinvoice_count" invisible="1"/>
                <button name="action_create_data_sinvoice" string="Tạo HĐĐT" type="object" class="oe_highlight"
                    invisible="state in ('draft', 'cancel') or sinvoice_count > 0 or move_type not in ('out_invoice', 'in_refund')"/>
                <button name="action_create_data_sinvoice" string="Tạo HĐĐT" type="object"
                invisible="state in ('draft', 'cancel') or  sinvoice_count == 0 or move_type not in ('out_invoice', 'in_refund')"/>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/group[1]/group[@id='header_left_group']/field[@name='partner_shipping_id']" position='after'>
                <field name="sinvoice_count" invisible="1"/>
                <field name="partner_contact_id" string="Người mua" invisible="move_type not in ('out_invoice', 'in_refund')"/>
                <field name="partner_vat_id" string="Đơn vị" invisible="move_type not in ('out_invoice', 'in_refund')"/>
                <field name="sinvoice_ref" invisible=" move_type != 'out_invoice'"/>
            </xpath>
            <xpath expr="//page[@id='aml_tab']" position="after">
                <page string="Viettel S-Invoice" invisible="sinvoice_count == 0">
                    <field name="viettel_sinvoice_ids" readonly="1" widget="section_and_note_one2many" mode="tree,form">
                        <tree>
                            <field name="name"/>
                            <field name="partner_vat_id"/>
                            <field name="invoice_ids" widget="many2many_tags"/>
                            <field name="reservationCode" invisible="1"/>
                            <field name="transactionID" invisible="1"/>
                            <field name="invoiceIssuedDate" readonly="state != 'draft'"/>
                            <field name="amount_untaxed" sum="Total"/>
                            <field name="amount_tax" sum="Total"/>
                            <field name="amount_total" sum="Total"/>
                            <field name="invoiceIssuedDate" readonly="state != 'draft'"/>
                            <field name="state"/>
                            <button name="action_open_invoice" type="object" icon="fa-arrow-right" width="0.1"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_account_move_tree_inherit" model="ir.ui.view">
        <field name="name">account.move.tree.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="field[@name='invoice_origin']" position="after">
                <field name="sinvoice_ref"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_move_filter_inherit" model="ir.ui.view">
        <field name="name">account.move.search.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="viettel_sinvoice_ids"/>
            </field>
        </field>
    </record>
</odoo>