<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_misa_config_tree" model="ir.ui.view">
            <field name="name">misa.config.tree</field>
            <field name="model">misa.config</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="vat"/>
                    <field name="user_name"/>
                    <field name="api_url"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_misa_config_form" model="ir.ui.view">
            <field name="name">misa.config.form</field>
            <field name="model">misa.config</field>
            <field name="arch" type="xml">
                <form string="MISA Configuration">
                    <header>
                        <button name="action_lock" string="Lock" type="object" class="oe_highlight" invisible="state == 'lock'"/>
                        <button name="action_unlock" string="Unlock" type="object" class="oe_highlight" invisible="state == 'new'"/>
                        <field name="state" widget="statusbar" statusbar_visible="new,lock"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Configuration Name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="General Information">
                                <field name="name"/>
                                <field name="vat"/>
                            </group>
                            <group string="API Configuration">
                                <field name="user_name"/>
                                <field name="user_password" password="True"/>
                                <field name="api_url"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_misa_config_search" model="ir.ui.view">
            <field name="name">misa.config.search</field>
            <field name="model">misa.config</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="vat"/>
                    <field name="user_name"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_misa_config" model="ir.actions.act_window">
            <field name="name">MISA Configuration</field>
            <field name="res_model">misa.config</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first MISA configuration
                </p>
                <p>
                    Configure MISA API connection settings.
                </p>
            </field>
        </record>
    </data>
</odoo>

