<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_gdt_einvoice_tree" model="ir.ui.view">
            <field name="name">gdt.einvoice.tree</field>
            <field name="model">gdt.einvoice</field>
            <field name="arch" type="xml">
                <tree string="GDT EInvoice List" decoration-warning="state == 'processing'" decoration-success="state == 'done'">
                    <field name="invoice_date"/>
                    <field name="invoice_code"/>
                    <field name="invoice_number"/>
                    <field name="seller_name"/>
                    <field name="seller_tax_code"/>
                    <field name="buyer_name"/>
                    <field name="buyer_tax_code"/>
                    <field name="move_type" widget="badge"/>
                    <field name="invoice_status" widget="badge" decoration-success="invoice_status == '1'" decoration-warning="invoice_status in ('2','3')" decoration-danger="invoice_status == '4'" decoration-info="invoice_status == '0'"/>
                    <field name="state" widget="badge" decoration-warning="state == 'processing'" decoration-success="state == 'done'"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_gdt_einvoice_form" model="ir.ui.view">
            <field name="name">gdt.einvoice.form</field>
            <field name="model">gdt.einvoice</field>
            <field name="arch" type="xml">
                <form string="GDT EInvoice">
                    <header>
                        <button name="action_find_product" string="Find Products" type="object" class="oe_highlight" invisible="state not in ('draft', 'processing')" />
                        <button name="action_create_invoice" string="Create Invoice" type="object" class="oe_highlight" invisible="state not in ('processing')" />
                        <button name="action_create_partner_seller" string="Create Seller Partner" type="object" invisible="partner_seller_id != False"/>
                        <button name="action_create_partner_buyer" string="Create Buyer Partner" type="object" invisible="partner_buyer_id != False"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,processing,done"/>
                        <field name="invoice_status" invisible="1"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <field name="invoice_ids" invisible="1"/>
                            <button name="action_view_invoice"
                                    type="object"
                                    class="oe_stat_button"
                                    string="View Created Invoices"
                                    icon="fa-pencil-square-o"
                                    invisible="invoice_ids == []"/>
                        </div>
                        <widget name="web_ribbon" title="Replacement" bg_color="text-bg-warning" invisible="invoice_status != '2'"/>
                        <widget name="web_ribbon" title="Adjustment" bg_color="text-bg-warning" invisible="invoice_status != '3'"/>
                        <widget name="web_ribbon" title="Canceled" bg_color="text-bg-danger" invisible="invoice_status != '4'"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Invoice Number" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="General Information">
                                <field name="invoice_code" readonly="1"/>
                                <field name="invoice_number" readonly="1"/>
                                <field name="invoice_date" readonly="1"/>
                                <field name="move_type" readonly="state == 'done'"/>
                                <field name="currency_id" readonly="1"/>
                                <field name="currency_rate" readonly="state == 'done'"/>
                                <field name="currency_name" invisible="1"/>
                            </group>
                            <group string="Seller Information">
                                <field name="seller_name" readonly="1"/>
                                <field name="partner_seller_id"/>
                                <field name="seller_tax_code" readonly="1"/>
                                <field name="seller_address" readonly="1"/>
                            </group>
                            <group string="Buyer Information">
                                <field name="buyer_name" readonly="1"/>
                                <field name="partner_buyer_id"/>
                                <field name="buyer_tax_code" readonly="1"/>
                                <field name="buyer_address" readonly="1"/>
                            </group>
                            <group string="Related Orders">
                                <field name="sale_order_id" readonly="state == 'done'" invisible="move_type not in ('out_invoice', 'out_refund')"/>
                                <field name="purchase_order_id" readonly="state == 'done'" invisible="move_type not in ('in_invoice', 'in_refund')"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Invoice Lines">
                                <field name="invoice_line_ids" readonly="state == 'done'">
                                    <tree editable="bottom">
                                        <field name="parent_id" column_invisible="True"/>
                                        <field name="name" readonly="1"/>
                                        <field name="product_id" readonly="parent_id.state == 'done'"/>
                                        <field name="unit" column_invisible="True" readonly="1"/>
                                        <field name="uom_id"/>
                                        <field name="quantity" sum="quantity" readonly="1"/>
                                        <field name="qty_to_invoice" optional="hide"/>
                                        <field name="unit_price" readonly="parent_id.state == 'done'"/>
                                        <field name="tax_rate" column_invisible="True"/>
                                        <field name="tax_id" readonly="parent_id.state == 'done'"/>
                                        <field name="price_subtotal"/>
                                        <field name="price_tax" optional="hide"/>
                                        <field name="price_total" optional="hide"/>
                                        <field name="currency_id" column_invisible="True"/>
                                    </tree>
                                </field>
                                <group name="note_group" col="6" class="mt-2 mt-md-0">
                                    <group colspan="4">
                                        <field colspan="2" name="note" nolabel="1" placeholder="Note..."/>
                                    </group>
                                    <group class="oe_subtotal_footer" colspan="2" name="sale_total">
                                        <field name="tax_totals" widget="account-tax-totals-field" nolabel="1" colspan="2" readonly="1"/>
                                    </group>
                                    <div class="clearfix"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_gdt_einvoice_search" model="ir.ui.view">
            <field name="name">gdt.einvoice.search</field>
            <field name="model">gdt.einvoice</field>
            <field name="arch" type="xml">
                <search string="Search GDT EInvoice">
                    <field name="invoice_number"/>
                    <field name="invoice_code"/>
                    <field name="seller_name"/>
                    <field name="seller_tax_code"/>
                    <field name="buyer_name"/>
                    <field name="buyer_tax_code"/>
                    <field name="invoice_status"/>
                    <field name="state"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Processing" name="processing" domain="[('state','=','processing')]"/>
                    <filter string="Done" name="done" domain="[('state','=','done')]"/>
                    <separator/>
                    <filter string="Has Created Invoice" name="has_invoice" domain="[('invoice_ids','!=',[])]"/>
                    <filter string="No Invoice" name="no_invoice" domain="[('invoice_ids','=',[])]"/>
                    <separator/>
                    <filter string="Today" name="today" domain="[('invoice_date','=',context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="This Month" name="this_month" domain="[('invoice_date','>=',context_today().strftime('%Y-%m-01'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                        <filter string="Invoice Status" name="group_invoice_status" context="{'group_by':'invoice_status'}"/>
                        <filter string="Invoice Date" name="group_date" context="{'group_by':'invoice_date:day'}"/>
                        <filter string="Seller" name="group_seller" context="{'group_by':'seller_name'}"/>
                        <filter string="Buyer" name="group_buyer" context="{'group_by':'buyer_name'}"/>
                        <filter string="Move Type" name="group_move_type" context="{'group_by':'move_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_gdt_einvoice_out" model="ir.actions.act_window">
            <field name="name">Out Invoices</field>
            <field name="res_model">gdt.einvoice</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_today': 1, 'default_move_type': 'out_invoice'}</field>
            <field name="domain">[('move_type','=', 'out_invoice')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first invoice
                </p>
                <p>
                    Manage invoice data imported from XML files.
                </p>
            </field>
        </record>
        <record id="action_gdt_einvoice_in" model="ir.actions.act_window">
            <field name="name">In Invoices</field>
            <field name="res_model">gdt.einvoice</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_today': 1, 'default_move_type': 'in_invoice'}</field>
            <field name="domain">[('move_type','=', 'in_invoice')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first invoice
                </p>
                <p>
                    Manage invoice data imported from XML files.
                </p>
            </field>
        </record>
    </data>
</odoo>

