<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_gdt_map_product_tree" model="ir.ui.view">
            <field name="name">gdt.map.product.tree</field>
            <field name="model">gdt.map.product</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="keyword"/>
                    <field name="product_id"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="create_auto" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_gdt_map_product_form" model="ir.ui.view">
            <field name="name">gdt.map.product.form</field>
            <field name="model">gdt.map.product</field>
            <field name="arch" type="xml">
                <form string="Product Mapping">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="keyword" placeholder="Mapping keyword"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Mapping Information">
                                <field name="keyword"/>
                                <field name="product_id"/>
                                <field name="active"/>
                                <field name="create_auto" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_gdt_map_product_search" model="ir.ui.view">
            <field name="name">gdt.map.product.search</field>
            <field name="model">gdt.map.product</field>
            <field name="arch" type="xml">
                <search>
                    <field name="keyword"/>
                    <field name="product_id"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <filter name="filter_auto" string="Auto Created" domain="[('create_auto', '=', True)]" />
                    <filter name="filter_not_auto" string="Manual Created" domain="[('create_auto', '=', False)]" />
                    <group expand="0" string="Group By">
                        <filter string="Product" name="group_by_product" context="{'group_by': 'product_id'}"/>
                        <filter string="Status" name="group_by_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_gdt_map_product" model="ir.actions.act_window">
            <field name="name">Product Mapping</field>
            <field name="res_model">gdt.map.product</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_gdt_map_product_tree"/>
            <field name="search_view_id" ref="view_gdt_map_product_search"/>
            <field name="context">{'search_default_filter_not_auto': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new product mapping
                </p>
                <p>
                    Product mapping helps automatically map invoice data to products in the ERP system.
                </p>
            </field>
        </record>
    </data>
</odoo>

