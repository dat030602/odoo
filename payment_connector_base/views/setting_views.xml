<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Setting Form View -->
        <record id="view_connector_setting_form" model="ir.ui.view">
            <field name="name">connector.setting.form</field>
            <field name="model">connector.setting</field>
            <field name="arch" type="xml">
                <form string="Connector Setting">
                    <sheet>
                        <div class="oe_title">
                            <field name="name" placeholder="Setting Name"/>
                            <field name="code" placeholder="setting_code"/>
                        </div>
                        <group>
                            <group>
                                <field name="provider_id" required="1"/>
                                <field name="environment_id"/>
                                <field name="company_id"/>
                            </group>
                            <group>
                                <field name="value_type"/>
                                <field name="encrypt"/>
                                <field name="required"/>
                                <field name="readonly"/>
                            </group>
                        </group>
                        <group>
                            <field name="value" password="True" invisible="encrypt == False"/>
                            <field name="value" invisible="encrypt == True"/>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Setting Tree View -->
        <record id="view_connector_setting_tree" model="ir.ui.view">
            <field name="name">connector.setting.tree</field>
            <field name="model">connector.setting</field>
            <field name="arch" type="xml">
                <tree string="Connector Settings">
                    <field name="sequence" widget="handle"/>
                    <field name="provider_id"/>
                    <field name="environment_id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="value_type"/>
                    <field name="encrypt"/>
                    <field name="active" widget="toggle"/>
                </tree>
            </field>
        </record>
        
        <!-- Setting Search View -->
        <record id="view_connector_setting_search" model="ir.ui.view">
            <field name="name">connector.setting.search</field>
            <field name="model">connector.setting</field>
            <field name="arch" type="xml">
                <search string="Search Settings">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="provider_id"/>
                    <field name="environment_id"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="encrypted" string="Encrypted" domain="[('encrypt', '=', True)]"/>
                    <separator/>
                    <group>
                        <filter name="provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                        <filter name="environment" string="Environment" context="{'group_by': 'environment_id'}"/>
                        <filter name="type" string="Value Type" context="{'group_by': 'value_type'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Setting Action -->
        <record id="action_connector_setting" model="ir.actions.act_window">
            <field name="name">Connector Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">connector.setting</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_active': True}</field>
        </record>
        
        <!-- Setting Menu Item -->
        <menuitem id="menu_connector_setting" 
                  name="Settings" 
                  parent="payment_connector_base.menu_connector_root" 
                  action="action_connector_setting"
                  sequence="3"/>
        
    </data>
</odoo>
