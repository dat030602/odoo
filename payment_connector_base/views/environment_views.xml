<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Environment Form View -->
        <record id="view_connector_environment_form" model="ir.ui.view">
            <field name="name">connector.environment.form</field>
            <field name="model">connector.environment</field>
            <field name="arch" type="xml">
                <form string="Connector Environment">
                    <sheet>
                        <div class="oe_title">
                            <field name="name" placeholder="Environment Name"/>
                            <field name="code" placeholder="environment_code"/>
                        </div>
                        <group>
                            <group>
                                <field name="provider_id" required="1"/>
                                <field name="company_id" required="1"/>
                            </group>
                            <group>
                                <field name="base_url"/>
                                <field name="priority"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Settings">
                                <field name="setting_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="value_type"/>
                                        <field name="encrypt"/>
                                        <field name="active"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Endpoints">
                                <field name="endpoint_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="api_id"/>
                                        <field name="method"/>
                                        <field name="active"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Environment Tree View -->
        <record id="view_connector_environment_tree" model="ir.ui.view">
            <field name="name">connector.environment.tree</field>
            <field name="model">connector.environment</field>
            <field name="arch" type="xml">
                <tree string="Connector Environments">
                    <field name="sequence" widget="handle"/>
                    <field name="provider_id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="company_id"/>
                    <field name="active" widget="toggle"/>
                </tree>
            </field>
        </record>
        
        <!-- Environment Search View -->
        <record id="view_connector_environment_search" model="ir.ui.view">
            <field name="name">connector.environment.search</field>
            <field name="model">connector.environment</field>
            <field name="arch" type="xml">
                <search string="Search Environments">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="provider_id"/>
                    <field name="company_id"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                    <separator/>
                    <group>
                        <filter name="provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                        <filter name="company" string="Company" context="{'group_by': 'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Environment Action -->
        <record id="action_connector_environment" model="ir.actions.act_window">
            <field name="name">Connector Environments</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">connector.environment</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_active': True}</field>
        </record>
        
        <!-- Environment Menu Item -->
        <menuitem id="menu_connector_environment" 
                  name="Environments" 
                  parent="payment_connector_base.menu_connector_root" 
                  action="action_connector_environment"
                  sequence="2"/>
        
    </data>
</odoo>
