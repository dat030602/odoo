<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- API Form View -->
        <record id="view_connector_api_form" model="ir.ui.view">
            <field name="name">connector.api.form</field>
            <field name="model">connector.api</field>
            <field name="arch" type="xml">
                <form string="Connector API">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_endpoints" type="object" class="oe_stat_button" icon="fa-link">
                                <field name="endpoint_count" widget="statinfo" string="Endpoints"/>
                            </button>
                            <button name="action_view_mappings" type="object" class="oe_stat_button" icon="fa-exchange-alt">
                                <field name="mapping_count" widget="statinfo" string="Mappings"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <field name="name" placeholder="API Name"/>
                            <field name="code" placeholder="api_code"/>
                        </div>
                        <group>
                            <group>
                                <field name="provider_id" required="1"/>
                                <field name="version"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                            <page string="Endpoints">
                                <field name="endpoint_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="environment_id"/>
                                        <field name="method"/>
                                        <field name="active"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Mappings">
                                <field name="mapping_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="type"/>
                                        <field name="sequence"/>
                                        <field name="active"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- API Tree View -->
        <record id="view_connector_api_tree" model="ir.ui.view">
            <field name="name">connector.api.tree</field>
            <field name="model">connector.api</field>
            <field name="arch" type="xml">
                <tree string="Connector APIs">
                    <field name="sequence" widget="handle"/>
                    <field name="provider_id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="version"/>
                    <field name="active" widget="toggle"/>
                </tree>
            </field>
        </record>
        
        <!-- API Search View -->
        <record id="view_connector_api_search" model="ir.ui.view">
            <field name="name">connector.api.search</field>
            <field name="model">connector.api</field>
            <field name="arch" type="xml">
                <search string="Search APIs">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="provider_id"/>
                    <field name="version"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <separator/>
                    <group>
                        <filter name="provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                        <filter name="version" string="Version" context="{'group_by': 'version'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- API Action -->
        <record id="action_connector_api" model="ir.actions.act_window">
            <field name="name">Connector APIs</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">connector.api</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_active': True}</field>
        </record>
        
        <!-- API Menu Item -->
        <menuitem id="menu_connector_api" 
                  name="APIs" 
                  parent="payment_connector_base.menu_connector_root" 
                  action="action_connector_api"
                  sequence="4"/>
        
    </data>
</odoo>
