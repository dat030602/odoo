<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Hash Method Form View -->
        <record id="view_connector_hash_method_form" model="ir.ui.view">
            <field name="name">connector.hash.method.form</field>
            <field name="model">connector.hash.method</field>
            <field name="arch" type="xml">
                <form string="Connector Hash Method">
                    <sheet>
                        <div class="oe_title">
                            <field name="name" placeholder="Hash Method Name"/>
                            <field name="code" placeholder="hash_code"/>
                        </div>
                        <group>
                            <group>
                                <field name="algorithm" required="1"/>
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                        </group>
                        <group attrs="{'invisible': [('algorithm', '!=', 'custom')]}">
                            <field name="python_class" placeholder="module.ClassName"/>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Hash Method Tree View -->
        <record id="view_connector_hash_method_tree" model="ir.ui.view">
            <field name="name">connector.hash.method.tree</field>
            <field name="model">connector.hash.method</field>
            <field name="arch" type="xml">
                <tree string="Connector Hash Methods">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="algorithm"/>
                    <field name="active" widget="toggle"/>
                </tree>
            </field>
        </record>
        
        <!-- Hash Method Action -->
        <record id="action_connector_hash_method" model="ir.actions.act_window">
            <field name="name">Connector Hash Methods</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">connector.hash.method</field>
            <field name="view_mode">tree,form</field>
        </record>
        
        <!-- Hash Menu Item -->
        <menuitem id="menu_connector_hash" 
                  name="Hash Methods" 
                  parent="payment_connector_base.menu_connector_root" 
                  action="action_connector_hash_method"
                  sequence="9"/>
        
    </data>
</odoo>
