<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Mapping Form View -->
        <record id="view_connector_mapping_form" model="ir.ui.view">
            <field name="name">connector.mapping.form</field>
            <field name="model">connector.mapping</field>
            <field name="arch" type="xml">
                <form string="Connector Mapping">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_lines" type="object" class="oe_stat_button" icon="fa-list">
                                <field name="line_count" widget="statinfo" string="Lines"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <field name="name" placeholder="Mapping Name"/>
                            <field name="code" placeholder="mapping_code"/>
                        </div>
                        <group>
                            <group>
                                <field name="api_id" required="1"/>
                                <field name="type" required="1"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                            <page string="Mapping Lines">
                                <field name="line_ids">
                                    <tree>
                                        <field name="sequence" widget="handle"/>
                                        <field name="key"/>
                                        <field name="source_type"/>
                                        <field name="datatype"/>
                                        <field name="required"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Mapping Tree View -->
        <record id="view_connector_mapping_tree" model="ir.ui.view">
            <field name="name">connector.mapping.tree</field>
            <field name="model">connector.mapping</field>
            <field name="arch" type="xml">
                <tree string="Connector Mappings">
                    <field name="sequence" widget="handle"/>
                    <field name="api_id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="type"/>
                    <field name="active" widget="toggle"/>
                </tree>
            </field>
        </record>
        
        <!-- Mapping Search View -->
        <record id="view_connector_mapping_search" model="ir.ui.view">
            <field name="name">connector.mapping.search</field>
            <field name="model">connector.mapping</field>
            <field name="arch" type="xml">
                <search string="Search Mappings">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="api_id"/>
                    <field name="type"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <separator/>
                    <group>
                        <filter name="api" string="API" context="{'group_by': 'api_id'}"/>
                        <filter name="type" string="Type" context="{'group_by': 'type'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Mapping Action -->
        <record id="action_connector_mapping" model="ir.actions.act_window">
            <field name="name">Connector Mappings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">connector.mapping</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_active': True}</field>
        </record>
        
        <!-- Mapping Menu Item -->
        <menuitem id="menu_connector_mapping" 
                  name="Mappings" 
                  parent="payment_connector_base.menu_connector_root" 
                  action="action_connector_mapping"
                  sequence="6"/>
        
    </data>
</odoo>
