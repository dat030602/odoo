<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Endpoint Form View -->
        <record id="view_connector_endpoint_form" model="ir.ui.view">
            <field name="name">connector.endpoint.form</field>
            <field name="model">connector.endpoint</field>
            <field name="arch" type="xml">
                <form string="Connector Endpoint">
                    <sheet>
                        <div class="oe_title">
                            <field name="name" placeholder="Endpoint Name"/>
                        </div>
                        <group>
                            <group>
                                <field name="api_id" required="1"/>
                                <field name="environment_id" required="1"/>
                                <field name="company_id"/>
                            </group>
                            <group>
                                <field name="method" required="1"/>
                                <field name="active"/>
                                <field name="sequence"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="url" required="1"/>
                                <field name="timeout"/>
                                <field name="retry"/>
                            </group>
                            <group>
                                <field name="body_type"/>
                                <field name="parser"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="auth_method_id"/>
                                <field name="hash_method_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Endpoint Tree View -->
        <record id="view_connector_endpoint_tree" model="ir.ui.view">
            <field name="name">connector.endpoint.tree</field>
            <field name="model">connector.endpoint</field>
            <field name="arch" type="xml">
                <tree string="Connector Endpoints">
                    <field name="sequence" widget="handle"/>
                    <field name="api_id"/>
                    <field name="environment_id"/>
                    <field name="name"/>
                    <field name="method"/>
                    <field name="active" widget="toggle"/>
                </tree>
            </field>
        </record>
        
        <!-- Endpoint Search View -->
        <record id="view_connector_endpoint_search" model="ir.ui.view">
            <field name="name">connector.endpoint.search</field>
            <field name="model">connector.endpoint</field>
            <field name="arch" type="xml">
                <search string="Search Endpoints">
                    <field name="name"/>
                    <field name="api_id"/>
                    <field name="environment_id"/>
                    <field name="method"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <separator/>
                    <group>
                        <filter name="api" string="API" context="{'group_by': 'api_id'}"/>
                        <filter name="environment" string="Environment" context="{'group_by': 'environment_id'}"/>
                        <filter name="method" string="Method" context="{'group_by': 'method'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Endpoint Action -->
        <record id="action_connector_endpoint" model="ir.actions.act_window">
            <field name="name">Connector Endpoints</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">connector.endpoint</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_active': True}</field>
        </record>
        
        <!-- Endpoint Menu Item -->
        <menuitem id="menu_connector_endpoint" 
                  name="Endpoints" 
                  parent="payment_connector_base.menu_connector_root" 
                  action="action_connector_endpoint"
                  sequence="5"/>
        
    </data>
</odoo>
