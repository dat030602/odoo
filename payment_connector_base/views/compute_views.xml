<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Compute Function Form View -->
        <record id="view_connector_compute_function_form" model="ir.ui.view">
            <field name="name">connector.compute.function.form</field>
            <field name="model">connector.compute.function</field>
            <field name="arch" type="xml">
                <form string="Connector Compute Function">
                    <sheet>
                        <div class="oe_title">
                            <field name="name" placeholder="Function Name"/>
                            <field name="code" placeholder="function_code"/>
                        </div>
                        <group>
                            <group>
                                <field name="category"/>
                                <field name="type"/>
                            </group>
                            <group>
                                <field name="safe"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                            <page string="Python Code" invisible="type != 'custom'">
                                <field name="python_code" widget="code"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Compute Function Tree View -->
        <record id="view_connector_compute_function_tree" model="ir.ui.view">
            <field name="name">connector.compute.function.tree</field>
            <field name="model">connector.compute.function</field>
            <field name="arch" type="xml">
                <tree string="Connector Compute Functions">
                    <field name="category"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="type"/>
                    <field name="safe"/>
                    <field name="active" widget="toggle"/>
                </tree>
            </field>
        </record>
        
        <!-- Compute Function Action -->
        <record id="action_connector_compute_function" model="ir.actions.act_window">
            <field name="name">Connector Compute Functions</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">connector.compute.function</field>
            <field name="view_mode">tree,form</field>
        </record>
        
        <!-- Compute Pipeline Form View -->
        <record id="view_connector_compute_pipeline_form" model="ir.ui.view">
            <field name="name">connector.compute.pipeline.form</field>
            <field name="model">connector.compute.pipeline</field>
            <field name="arch" type="xml">
                <form string="Connector Compute Pipeline">
                    <sheet>
                        <group>
                            <group>
                                <field name="mapping_line_id" required="1"/>
                                <field name="function_id" required="1"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="stop_if_none"/>
                            </group>
                        </group>
                        <group>
                            <field name="parameter_json" placeholder="{}"/>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Compute Pipeline Tree View -->
        <record id="view_connector_compute_pipeline_tree" model="ir.ui.view">
            <field name="name">connector.compute.pipeline.tree</field>
            <field name="model">connector.compute.pipeline</field>
            <field name="arch" type="xml">
                <tree string="Connector Compute Pipelines">
                    <field name="sequence" widget="handle"/>
                    <field name="mapping_line_id"/>
                    <field name="function_id"/>
                    <field name="stop_if_none"/>
                </tree>
            </field>
        </record>
        
        <!-- Compute Pipeline Action -->
        <record id="action_connector_compute_pipeline" model="ir.actions.act_window">
            <field name="name">Connector Compute Pipelines</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">connector.compute.pipeline</field>
            <field name="view_mode">tree,form</field>
        </record>
        
        <!-- Compute Menu Item -->
        <menuitem id="menu_connector_compute" 
                  name="Compute Functions" 
                  parent="payment_connector_base.menu_connector_root" 
                  action="action_connector_compute_function"
                  sequence="7"/>
        
    </data>
</odoo>
