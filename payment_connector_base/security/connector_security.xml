<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Security Groups -->
        <record id="group_connector_user" model="res.groups">
            <field name="name">Connector User</field>
            <field name="category_id" ref="base.module_category_connectivity"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="group_connector_manager" model="res.groups">
            <field name="name">Connector Manager</field>
            <field name="category_id" ref="base.module_category_connectivity"/>
            <field name="implied_ids" eval="[(4, ref('payment_connector_base.group_connector_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
        
        <!-- Record Rules for Multi-Company -->
        <record id="connector_provider_company_rule" model="ir.rule">
            <field name="name">Connector Provider: Multi-Company</field>
            <field name="model_id" ref="payment_connector_base.model_connector_provider"/>
            <field name="domain_force">['|', ('company_dependent', '=', False), ('company_id', '=', user.company_id.id)]</field>
        </record>
        
        <record id="connector_environment_company_rule" model="ir.rule">
            <field name="name">Connector Environment: Multi-Company</field>
            <field name="model_id" ref="payment_connector_base.model_connector_environment"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        </record>
        
        <record id="connector_setting_company_rule" model="ir.rule">
            <field name="name">Connector Setting: Multi-Company</field>
            <field name="model_id" ref="payment_connector_base.model_connector_setting"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        </record>
        
        <record id="connector_execution_company_rule" model="ir.rule">
            <field name="name">Connector Execution: Multi-Company</field>
            <field name="model_id" ref="payment_connector_base.model_connector_execution"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        </record>
        
        <!-- Log Visibility Rules -->
        <record id="connector_request_log_user_rule" model="ir.rule">
            <field name="name">Connector Request Log: User View</field>
            <field name="model_id" ref="payment_connector_base.model_connector_request_log"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('payment_connector_base.group_connector_user'))]"/>
        </record>
        
        <record id="connector_response_log_user_rule" model="ir.rule">
            <field name="name">Connector Response Log: User View</field>
            <field name="model_id" ref="payment_connector_base.model_connector_response_log"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('payment_connector_base.group_connector_user'))]"/>
        </record>
        
        <record id="connector_error_log_user_rule" model="ir.rule">
            <field name="name">Connector Error Log: User View</field>
            <field name="model_id" ref="payment_connector_base.model_connector_error_log"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('payment_connector_base.group_connector_user'))]"/>
        </record>
        
    </data>
</odoo>
