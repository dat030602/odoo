<odoo>
    <record id="view_salary_payment_list_wizard" model="ir.ui.view">
        <field name="name">salary.payment.list.wizard.form</field>
        <field name="model">salary.payment.list.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Stock Move Report">
                <group>
                    <group string="Dữ liệu">
                        <field name="month"/>
                        <field name="year"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="advance_salary"/>
                    </group>
                    <group string="Ký tên">
                        <field name="voter_id"/>
                        <field name="chief_finance_id"/>
                        <field name="human_resources_dept_id"/>
                        <field name="director_id"/>
                    </group>
                </group>
                <footer>
                    <button string="In" type="object" name="action_generate_report" class="oe_highlight"/>
                    <button string="Hủy" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_salary_payment_list_wizard_action" model="ir.actions.act_window">
        <field name="name">Danh sách chi lương</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">salary.payment.list.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_salary_payment_list_wizard"/>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_salary_payment_list_wizard" name="Danh sách chi lương" action="view_salary_payment_list_wizard_action"
                  parent="hr_payroll.menu_hr_payroll_payslips" sequence="20"/>
</odoo>
