<odoo>
    <template id="ccv_header_img">
        <div class="header row">
            <div class="col-2" style="display:inline-block">
                <img t-if="user.company_id.logo" t-att-src="image_data_uri(user.company_id.logo)" style="width: auto; max-height: 50px;" class="float-left" alt="Logo"/>
            </div>
            <div class="col-6" style="text-align: left;margin-top:16px; font-size: 11px; font-family: Times New Roman !important;">
                <span t-esc="user.company_id.name"/>
                <br/>
                <span>Mã Số Thuế: <span t-esc="user.company_id.vat"/></span>
                <br/>
                <span>Địa chỉ: <span t-esc="user.company_id.partner_id.full_address_vi"/></span>
            </div>
            <div class="col-4" style="text-align: center;margin-top:16px; font-size: 11px; font-family: Times New Roman !important;">
                <span>Mẫu số: 05-TT</span>
                <br/>
                <span>(Ban hành theo thông tư số 99/2025/TT-BTC <br/> ngày 27/10/2025 của Bộ Tài chính)</span>
            </div>
        </div>
        <div class="article o_report_layout_standard">
            <t t-out="0"/>
        </div>
        <div class="footer o_standard_footer">
            <div class="text-center" style="text-align: center">
                <div class="text-muted" style="font-size: 12px;font-family: Times New Roman; color: black !important">
                    Trang: <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </div>
    </template>
    <template id="ccv_no_header">
        <div class="header">
        </div>
        <div class="article o_report_layout_standard">
            <t t-out="0"/>
        </div>
        <div class="footer o_standard_footer">
            <div class="text-muted" style="padding-bottom:40px;">
                <div class="container">
                    <strong>Ghi chú:</strong>
                    <ul>
                    <li>Trước khi đi công tác, cán bộ đề nghị điều xe phải làm lệnh trình lãnh đạo duyệt, sau đó photo 01 bản nộp cho Bảo vệ để các bên ghi chép chỉ số Km lúc đi, tình trạng xăng lúc đi.</li>
                    <li>Khi về các bên ghi chỉ số Km lúc về, quãng đường đi, lái xe đề xuất đổ đầy xăng/ dầu để tính lượng nhiên liệu tiêu thụ (cộng cả lượng nhiên liệu đổ thêm trên đường đi).</li>
                    <li>Các bên chịu trách nhiệm trước lãnh đạo về thông tin xác thực trong lệnh điều động, những ai không chấp hành sẽ bị xử lý theo quy chế Công ty và không được quyết toán nhiên liệu cho chuyến đi.</li>
                    </ul>
                </div>
            </div>
        </div>
    </template>
    <record id="format_a4_ccv_bao_cao" model="report.paperformat">
        <field name="name">CCV format A4</field>
        <field name="default" eval="False"/>
        <field name="disable_shrinking" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>
    <record id="format_a4_ccv_bao_cao1" model="report.paperformat">
        <field name="name">CCV format A4</field>
        <field name="default" eval="False"/>
        <field name="disable_shrinking" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">96</field>
    </record>
</odoo>