<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<template id="ccv_bao_cao.giay_de_nghi_thanh_toan_document">
    <t t-call="ccv_bao_cao.ccv_header_img">
    <style>
        .page &gt; *{
            font-size: 14px;
            font-family: Times New Roman !important;
        }
        .name-user {
            margin-top: 80px;
            font-weight: bold;
        }
    </style>
    <div class="page" style="padding:0px;font-size: 14px;font-family: Times New Roman">
        <div class="col-xs-12" style="padding:0px;text-align: center; font-size: 20px;">
            <strong>
                GIẤY ĐỀ NGHỊ THANH TOÁN
            </strong>
        </div>
        <div class="row" style="padding:0px;margin-left: 2px">
            <div class="col-8">
                <span>Kính gởi: <strong class="fw-bolder">BAN LÃNH ĐẠO</strong></span>
            </div>
            <div class="col-4" style="text-align: center;">
                <span style="font-size: 16px;"><strong>Số: <t t-esc="doc.name"/></strong></span>
            </div>
        </div>
        <t t-set="employee_id" t-value="doc.env['hr.employee'].search([('user_id.partner_id', '=', doc.partner_id.id)])"/>
        <t t-set="hr_expense_sheet_env" t-value="doc.env['hr.expense.sheet']"/>
        
        <div class="row" style="padding:0px;margin-left: 2px">
            <div class="col-12">
                <span>Họ và tên người đề nghị thanh toán: <t t-esc="employee_id.user_id.name_without_position or employee_id.user_id.name if employee_id.user_id else employee_id.name"/></span>, <span>
                    Bộ phận: 
                    <t t-if="employee_id.department_id">
                        <t t-esc="employee_id.department_id.name"/>
                    </t>
                </span>
            </div>
        </div>
        <div class="row" style="padding:0px;margin-left: 2px">
            <div class="col-12">
                <span>Nội dung thanh toán: <t t-esc="doc.note"/></span>
            </div>
        </div>
        <div class="row" style="padding:0px;margin-left: 2px">
            <div class="col-12">
                <span>
                    Tên Đơn vị/Cá nhân Thụ Hưởng:
                    <t t-if="doc.partner_bank_id">
                        <t t-esc="doc.partner_name"/>
                    </t>
                </span>
            </div>
        </div>
        <t t-if="doc.type != 'cash'">
            <div class="row" style="padding:0px;margin-left: 2px">
                <div class="col-4">
                    <span>STK: <t t-if="doc.partner_bank_id" t-esc="doc.partner_bank_id.acc_number"/></span>
                </div>
                <div class="col-8">
                    <span>Tại Ngân hàng: <t t-if="doc.partner_bank_id" t-esc="doc.partner_bank_id.bank_id.name"/></span>
                </div>
            </div>
        </t>
        <div t-if="doc.payment_date" class="row" style="padding:0px;margin-left: 2px">
            <div class="col-12">
                <span>
                    Ngày thanh toán:
                    <t t-if="doc.payment_date">
                        <t t-esc="doc.payment_date.strftime('%d/%m/%Y')"/>
                    </t>
                </span>
            </div>
        </div>
        <div class="row">
            <table class="table table-sm" style="padding:0px;border: solid 1px; width: 100%; margin-top: 4px;">
                <thead>
                    <tr>
                        <td class="border border-dark" rowspan="2" style="padding:0 6px;text-align: center; vertical-align: middle;">
                            <strong>STT</strong>
                        </td>
                        <td class="border border-dark" colspan="2" style="padding:0 6px;text-align: center; vertical-align: middle;">
                            <strong>Chứng từ</strong>
                        </td>
                        <td class="border border-dark" rowspan="2" style="padding:0 6px;text-align: center; vertical-align: middle;">
                            <strong>Diễn giải</strong>
                        </td>
                        <td class="border border-dark" rowspan="2" style="padding:0 6px;text-align: center; vertical-align: middle;">
                            <strong>Số tiền (<t t-esc="doc.currency_id.sudo().currency_unit_label"/>)</strong>
                        </td>
                    </tr>
                    <tr>
                        <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;">
                            <strong>Loại</strong>
                        </td>
                        <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;">
                            <strong>Ngày</strong>
                        </td>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="number" t-value="0"/>
                    <t t-if="len(doc.payment_note_ids) > 0">
                        <tr t-foreach="doc.payment_note_ids" t-as="note_id">
                            <t t-set="number" t-value="number + 1"/>
                            <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;">
                                <span style="padding:0 6px;text-align: center; vertical-align: middle;" t-esc="number"/>
                            </td>
                            <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;"/>
                            <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle"><t t-esc="hr_expense_sheet_env.convert_date(note_id.invoice_date)"/></td>
                            <td class="border border-dark" style="padding:0 6px;text-align: left; vertical-align: middle">
                                <span t-esc="note_id.name"/>
                            </td>
                            <td class="border border-dark" style="padding:0 6px;text-align: right; vertical-align: middle">
                                <t t-if="doc.currency_id.sudo().name == 'VND' or str(doc.currency_id.sudo().currency_unit_label).lower() == 'vnd'">
                                    <span t-esc="doc.currency_id.sudo().format(note_id.amount_total)"/>
                                </t>
                                <t t-else="">
                                    <span t-esc="doc.currency_id.sudo().format(note_id.fcurrent_amount)"/>
                                </t>
                            </td>
                        </tr>
                    </t>
                    <t t-else="">
                        <tr>
                            <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;">
                                <span style="padding:0 6px;text-align: center; vertical-align: middle;" t-esc="1"/>
                            </td>
                            <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;"/>
                            <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle"><t t-esc="hr_expense_sheet_env.convert_date(doc.date)"/></td>
                            <td class="border border-dark" style="padding:0 6px;text-align: left; vertical-align: middle">
                                <span t-esc="doc.note"/>
                            </td>
                            <td class="border border-dark" style="padding:0 6px;text-align: right; vertical-align: middle">
                                <span t-esc="doc.currency_id.sudo().format(doc.total_amount)"/>
                            </td>
                        </tr>
                    </t>
                    <tr>
                        <td class="border border-dark" colspan="4" style="padding:0 6px;text-align: left;">
                            <strong>Tổng cộng</strong>
                        </td>
                        <td class="border border-dark" style="padding:0 6px;text-align: right;">
                            <strong>
                                <t t-if="doc.currency_id.sudo().name == 'VND' or str(doc.currency_id.sudo().currency_unit_label).lower() == 'vnd'">
                                    <span style="padding:0 6px;text-decoration: underline;" t-esc="doc.currency_id.sudo().format(sum(doc.payment_note_ids.mapped('amount_total')))"/>
                                </t>
                                <t t-else="">
                                    <span style="padding:0 6px;text-decoration: underline;" t-esc="doc.currency_id.sudo().format(sum(doc.payment_note_ids.mapped('fcurrent_amount')))"/>
                                </t>
                            </strong>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="row" style="padding:0px;margin-left: 4px">
            <div class="col-12" style="text-align: left;">
                <span style="font-size: 12px;">Số:<strong> <t t-esc="doc.name"/></strong></span>
            </div>
        </div>
        <div class="row" style="padding:0px;margin-left: 4px">
            <div class="col-12">
                <span>Số tiền bằng chữ: <t t-esc="hr_expense_sheet_env.convert_money(doc.total_amount, doc.currency_id)"/>&amp;nbsp;<t t-esc="doc.currency_id.sudo().currency_unit_label"/>./.</span>
            </div>
        </div>
        <div class="row" style="padding:0px;margin-left: 4px">
            <div class="col-12">
                <span>
                    Hình thức thanh toán:
                    <input style="padding:0px;margin-left: 12px" type="checkbox" t-att-checked="doc.type == 'cash'"/>
                    <label>Tiền mặt</label>
                    <input style="padding:0px;margin-left: 12px" type="checkbox" t-att-checked="doc.type == 'transfer'"/>
                    <label>Chuyển khoản</label>
                </span>
            </div>
        </div>
        <div class="" style="padding:0px;text-align: end;">
            <t t-set="approval_date" t-value="doc.date"/>
            <span>Đồng Nai, Ngày <t t-esc="approval_date.strftime('%d')"/> tháng <t t-esc="approval_date.strftime('%m')"/> năm <t t-esc="approval_date.strftime('%Y')"/></span>
        </div>
        <div class="row rowp" style="padding:0px;margin-left: 2px;">
            <t t-set="signs" t-value="doc.sudo().get_signer_filter()"/>
            <t t-set="signs_display" t-value="[s for s in signs if s['allow_sign'] == 0][:4]"/>
            <table class="table-borderless" style="width: 100%;">
                <thead>
                    <tr>
                        <t t-foreach="signs_display" t-as="sign">
                            <th style="text-align: center; vertical-align: top; width: 25%;">
                                <t t-set="default_title" t-value="'Kế Toán'"/>                                
                                <t t-if="sign_index == 2"><t t-set="default_title" t-value="'Kế Toán trưởng'"/></t>
                                <t t-elif="sign_index == 3"><t t-set="default_title" t-value="'Thủ trưởng đơn vị'"/></t>
                                <strong><t t-esc="sign['title'] if sign['title'] and str(sign['title']).strip() else default_title"/></strong>
                            </th>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <tr style="height: 70px; border: none;">
                        <t t-foreach="signs_display" t-as="sign">
                            <td style="vertical-align: middle; text-align: center; width: 25%; height: 70px;">
                                <t t-if="sign['is_signed'] and sign['user_id'] and sign['user_id'].sign_signature">
                                    <img t-att-src="image_data_uri(sign['user_id'].sign_signature)" width="100px" style="max-height: 70px;"/>
                                </t>
                            </td>
                        </t>
                    </tr>
                    <tr style="border: none;">
                        <t t-foreach="signs_display" t-as="sign">
                            <td style="text-align: center; vertical-align: top; width: 25%;">
                                <div style="text-align: center;">
                                    <strong><span t-esc="sign['user_id'].name_without_position or sign['user_id'].name if sign['user_id'] else ''"/></strong>
                                </div>
                            </td>
                        </t>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    </t>
</template>
</odoo>
