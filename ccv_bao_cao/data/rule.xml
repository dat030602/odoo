<?xml version='1.0' encoding='utf-8'?>
<odoo noupdate="1">
<record id="report_line_rule_user" model="ir.rule">
    <field name="name">report_line User</field>
    <field name="model_id" ref="ccv_bao_cao.model_sale_order_line_report_line"/>
    <field name="domain_force">['|', ('partner_id.user_id', '=', user.id), ('partner_id.user_id', '=', False)]</field>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
</record>
<record id="report_line_rule_sales_admin" model="ir.rule">
    <field name="name">report_line sales_admin</field>
    <field name="model_id" ref="ccv_bao_cao.model_sale_order_line_report_line"/>
    <field name="domain_force">['|', ('partner_id.sales_assistant_ids', 'in', [user.id]), ('partner_id.sales_assistant_ids', '=', False)]</field>
    <field name="groups" eval="[(4, ref('biz_ccv_account.group_sales_admin_sales_team_leader'))]"/>
</record>
<record id="report_line_rule_leader" model="ir.rule">
    <field name="name">report_line leader</field>
    <field name="model_id" ref="ccv_bao_cao.model_sale_order_line_report_line"/>
    <field name="domain_force">['|', ('partner_id.sales_team_captain_id', '=', user.id), ('partner_id.sales_team_captain_id', '=', False)]</field>
    <field name="groups" eval="[(4, ref('biz_ccv_account.group_sales_team_leader'))]"/>
</record>
<record id="report_line_rule_manager" model="ir.rule">
    <field name="name">report_line Manager</field>
    <field name="model_id" ref="ccv_bao_cao.model_sale_order_line_report_line"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads')),(4, ref('sales_team.group_sale_manager'))]"/>
</record>
</odoo>