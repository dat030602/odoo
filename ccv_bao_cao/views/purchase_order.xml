<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref='purchase.purchase_order_form'/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]/group[1]" position="inside">
                <field name="transportation_id" required="1" force_save="1"/>
                <field name="requirement_id" force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
                <field name="warranty" optional="hide"/>
                <field name="country_origin" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
