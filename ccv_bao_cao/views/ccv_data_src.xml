<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ccv_data_src_tree" model="ir.ui.view">
        <field name="name">ccv.data.src.tree</field>
        <field name="model">ccv.data.src</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="single"/>
                <field name="multi"/>
                <field name="type"/>
            </tree>
        </field>
    </record>
    <record id="view_ccv_data_src_form" model="ir.ui.view">
        <field name="name">ccv.data.src.form</field>
        <field name="model">ccv.data.src</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="type"/>
                    </group>
                    <group>
                        <field name="single" attrs="{'invisible':[('type','!=','single')]}"/>
                        <field name="multi" attrs="{'invisible':[('type','!=','multi')]}"/>
                        <field name="picking_type_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ccv_data_src_action" model="ir.actions.act_window">
        <field name="name">ccv.data.src.action</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ccv.data.src</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
