    <!-- Search Views -->
    <record id="tong_hop_cong_no_phai_thu_beta_view_search" model="ir.ui.view">
        <field name="name">beta.view.search.thu</field>
        <field name="model">beta.report.line1</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="customer_name"/>
                <field name="customer_code"/>
                <field name="customer_group"/>
                <field name="account_id"/>
                <separator/>
                <filter string="Có số dư đầu kỳ" name="has_start_balance" domain="['|', ('start_debit', '>', 0), ('start_credit', '>', 0)]"/>
                <filter string="Có phát sinh" name="has_ps" domain="['|', ('ps_debit', '>', 0), ('ps_credit', '>', 0)]"/>
                <filter string="Có số dư cuối kỳ" name="has_end_balance" domain="['|', ('end_debit', '>', 0), ('end_credit', '>', 0)]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhóm khách hàng" name="group_customer_group" context="{'group_by': 'customer_group'}"/>
                    <filter string="Tài khoản" name="group_account" context="{'group_by': 'account_id'}"/>
                </group>
            </search>
        </field>
    </record>

