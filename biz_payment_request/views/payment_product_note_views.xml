<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View for Payment Product Note -->
        <record id="view_payment_product_note_tree" model="ir.ui.view">
            <field name="name">payment.product.note.tree</field>
            <field name="model">payment.product.note</field>
            <field name="arch" type="xml">
                <tree string="Payment Product Notes" editable="bottom">
                    <field name="invoice_date"/>
                    <field name="invoice_name"/>
                    <field name="name" placeholder="Mô tả sản phẩm"/>
                    <field name="product_id" placeholder="Chọn sản phẩm"/>
                    <field name="quantity"/>
                    <field name="fcurrency_rate" attrs="{'column_invisible': [('parent.currency_name', '=', 'VND')]}"/>
                    <field name="fprice_unit" widget="float" attrs="{'column_invisible': [('parent.currency_name', '=', 'VND')]}"/>
                    <field name="price_unit" widget="float"/>
                    <field name="tax_id"/>
                    <field name="famount_untax" widget="float" readonly="0" attrs="{'column_invisible': [('parent.currency_name', '=', 'VND')]}"/>
                    <field name="amount_untax" widget="float" readonly="0"/>
                    <field name="famount_tax" widget="float" readonly="0" attrs="{'column_invisible': [('parent.currency_name', '=', 'VND')]}"/>
                    <field name="amount_tax" widget="float" readonly="0"/>
                    <field name="fcurrent_amount" widget="float" readonly="0" attrs="{'column_invisible': [('parent.currency_name', '=', 'VND')]}"/>
                    <field name="amount_total" widget="float" readonly="0"/>
                    <field name="uom_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                </tree>
            </field>
        </record>

        <!-- Form View for Payment Product Note -->
        <record id="view_payment_product_note_form" model="ir.ui.view">
            <field name="name">payment.product.note.form</field>
            <field name="model">payment.product.note</field>
            <field name="arch" type="xml">
                <form string="Payment Product Note">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" placeholder="Nhập mô tả sản phẩm"/>
                                <field name="product_id" placeholder="Chọn sản phẩm" invisible="1"/>
                                <field name="fcurrency_rate"/>
                                <field name="fprice_unit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="price_unit" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                                <field name="quantity" widget="float_time"/>
                                <field name="uom_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="tax_id"/>
                                <field name="invoice_date"/>
                                <field name="invoice_name" placeholder="Số hóa đơn"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="famount_untax" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                <field name="amount_untax" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                                <field name="famount_tax" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                <field name="amount_tax" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                                <field name="fcurrent_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                <field name="amount_total" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                                <field name="company_currency_id" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Kanban View for Payment Product Note -->
        <record id="view_payment_product_note_kanban" model="ir.ui.view">
            <field name="name">payment.product.note.kanban</field>
            <field name="model">payment.product.note</field>
            <field name="arch" type="xml">
                <kanban string="Payment Product Notes" class="o_kanban_small_column" default_group_by="product_id">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="price_unit"/>
                    <field name="quantity"/>
                    <field name="amount_total"/>
                    <field name="invoice_date"/>
                    <field name="currency_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div class="row">
                                            <div class="col-6">
                                                <strong>Sản phẩm:</strong>
                                                <field name="product_id"/>
                                            </div>
                                            <div class="col-6">
                                                <strong>Đơn giá:</strong>
                                                <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6">
                                                <strong>Số lượng:</strong>
                                                <field name="quantity"/>
                                            </div>
                                            <div class="col-6">
                                                <strong>Thành tiền:</strong>
                                                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12">
                                                <strong>Ngày:</strong>
                                                <field name="invoice_date"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Search View for Payment Product Note -->
        <record id="view_payment_product_note_search" model="ir.ui.view">
            <field name="name">payment.product.note.search</field>
            <field name="model">payment.product.note</field>
            <field name="arch" type="xml">
                <search string="Search Payment Product Notes">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="invoice_name"/>
                    <filter string="Hôm nay" name="today" domain="[('invoice_date', '=', context_today())]"/>
                    <filter string="Tuần này" name="this_week" domain="[('invoice_date', '>=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                    <filter string="Tháng này" name="this_month" domain="[('invoice_date', '>=', context_today().strftime('%Y-%m-01'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Sản phẩm" name="group_product" context="{'group_by': 'product_id'}"/>
                        <filter string="Ngày" name="group_date" context="{'group_by': 'invoice_date'}"/>
                        <filter string="Thuế" name="group_tax" context="{'group_by': 'tax_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action for Payment Product Note -->
        <record id="action_payment_product_note" model="ir.actions.act_window">
            <field name="name">Payment Product Notes</field>
            <field name="res_model">payment.product.note</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="search_view_id" ref="view_payment_product_note_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo ghi chú sản phẩm thanh toán đầu tiên
                </p>
                <p>
                    Ghi chú sản phẩm thanh toán giúp bạn quản lý thông tin chi tiết về các sản phẩm trong quá trình thanh toán.
                </p>
            </field>
        </record>
    </data>
</odoo>
