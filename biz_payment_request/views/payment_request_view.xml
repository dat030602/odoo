<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="payment_request_search_view" model="ir.ui.view">
            <field name="name">payment.request.search</field>
            <field name="model">payment.request</field>
            <field name="type">search</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter name="group_by_date" context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="payment_request_tree" model="ir.ui.view">
            <field name="name">payment.request.tree</field>
            <field name="model">payment.request</field>
            <field name="arch" type="xml">
                <tree default_order="date desc">
                    <field name="date"/>
                    <field name="name"/>
                    <field name="total_amount" sum="Tổng tiền"/>
                    <field name="note" optional="show"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="payment_request_form" model="ir.ui.view">
            <field name="name">payment.request.form</field>
            <field name="model">payment.request</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button string="Confirm" name="action_confirm" type="object" class="oe_highlight"
                                attrs="{'invisible':[('state', '!=', 'draft')]}"/>
                        <field name="is_user_current" invisible="1"/>
                        <button name="action_agree" string="Agree"
                                attrs="{'invisible':['|', ('is_user_current','=', False), ('state','not in', ('approve'))]}"
                                type="object" class="oe_highlight"/>
                        <button name="action_refuse" string="Refuse"
                                attrs="{'invisible':['|', ('is_user_current','=', False), ('state','not in', ('approve'))]}"
                                type="object"/>
                        <button string="Tạo thanh toán" name="do_action" type="object" class="oe_highlight"
                                groups="account.group_account_invoice"
                                attrs="{'invisible':[('state', '!=', 'approved')]}"/>
                        <button name="action_create_expense" string="Tạo chi phí"
                                attrs="{'invisible':['|', ('has_expense','!=', False), ('state','not in', ('approved'))]}"
                                type="object" class="oe_highlight"/>
                        <button name="action_bank_transfer" string="Chuyển khoản"
                                attrs="{'invisible':['|', ('type','!=', 'transfer'), ('state','!=', 'approved')]}"
                                type="object"/>
                        <button name="action_bank_transfer_tk_name" string="Cập Nhật ngân hàng"
                                attrs="{'invisible':['|', ('type','!=', 'transfer'), ('state','=', 'done')]}"
                                type="object"/>
                        <button string="Undo" type="object" name="action_undo"
                                invisible="1"/>
                        <button string="Cancel" type="object" name="action_cancel"
                                attrs="{'invisible':[('state', '!=', 'draft')]}"/>
                        <button string="Cancel" type="object" name="action_cancel"
                                attrs="{'invisible':[('state', '!=', 'approved')]}" groups="account.group_account_invoice"/>
                        <button string="Thiết lập về nháp" type="object" name="action_draft"
                                attrs="{'invisible':[('state', 'not in', ('cancel', 'refuse'))]}"/>
                        <field name="is_allowed_to_complete" invisible="1"/>
                        <button string="Hoàn thành (Fix Lỗi)" name="action_force_done" type="object" class="oe_highlight btn-danger"
                                attrs="{'invisible':['|', ('is_allowed_to_complete', '=', False), ('state', '=', 'done')]}"
                                confirm="Bạn có chắc chắn muốn ép phiếu này sang trạng thái Hoàn Thành không?"/>
                        <button string="Trở về nháp (Fix Lỗi)" name="action_force_draft" type="object" class="btn-warning"
                                attrs="{'invisible':['|', ('is_allowed_to_complete', '=', False), ('state', '=', 'draft')]}"
                                confirm="Bạn có chắc chắn muốn ép phiếu này về trạng thái Nháp không?"/>
                          <!-- <button name="action_create_payment" string="Create Payment" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'done')]}" /> -->
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box" groups="base.group_user">
                            <button class="oe_stat_button" name="action_view_payment" type="object"
                                    groups="account.group_account_invoice"
                                    icon="fa-pencil-square-o" attrs="{'invisible':['|', ('count_payment', '=', 0),('state', '!=', 'done')]}">
                                <field name="count_payment" widget="statinfo" string="Payment"/>
                            </button>
                            <button class="oe_stat_button" name="action_view_expense" type="object"
                                    icon="fa-pencil-square-o" attrs="{'invisible':['|', ('has_expense', '=', False),('state', 'not in', ('approved','done'))]}">
                                Chi phí
                            </button>
                            <button class="oe_stat_button" name="action_view_invoice" type="object"
                                    groups="account.group_account_invoice"
                                    icon="fa-pencil-square-o" attrs="{'invisible':['|', ('count_invoice', '=', 0),('state', '!=', 'done')]}">
                                <field name="count_invoice" widget="statinfo" string="Journal Entry" />
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <field name="company_id" invisible="1"/>
                        <field name="company_currency_id" invisible="1"/>
                        <field name="has_expense" invisible="1"/>

                        <group>
                            <group>
                                <field name="user_id" required="0" invisible="1"
                                       attrs="{'readonly':[('state', '!=', 'draft')]}"/>
                                <field name="partner_id" options="{'no_open': True, 'no_create': True}" />
                                <field name="move_id" invisible="1"/>
                                <field name="invoice_name" />
                                <field name="date" readonly="1" required="1"/>
                                    <field name="payment_date" attrs="{'readonly':[('state', '!=', 'draft')]}"/>
                                    <label for="total_amount"/>
                                    <div class="o_row">
                                        <field name="total_amount" attrs="{'readonly':[('state', '!=', 'draft')]}"/>
                                        <field name="currency_id" required="1"
                                            attrs="{'readonly':[('state', '!=', 'draft')]}"/>
                                    </div>
                                    <field name="currency_name" invisible="1"/>
                                    <field name="fcurrency_rate" attrs="{'invisible': [('currency_name', '=', 'VND')], 'readonly':[('state', '!=', 'draft')]}"/>
                                    <field name="vnd_value" attrs="{'invisible': [('currency_name', '=', 'VND')]}"/>
                                    <field name="journal_id" attrs="{'readonly':[('state', '!=', 'draft')]}"/>
                                    <field name="account_id" invisible="1"/>
                                    <field name="destination_account_id" invisible="1"/>
                                    <field name="type"/>
                                    <field name="note" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                            <group>
                                <group string="TÀI KHOẢN GỬI" colspan="2" attrs="{'invisible': [('type', '!=', 'transfer')]}">
                                    <field name="fixed_sender_tk" domain="[('is_unc_sender', '=', True)]" readonly="1"/>                                       
                                    <field name="fixed_sender_tk_name" readonly="1"/>
                                </group>
                                <group string="THÔNG TIN THỤ HƯỞNG" colspan="2">
                                    <field name="partner_bank_id" attrs="{'invisible': [('type', '!=', 'transfer')], 'readonly': [('state', '!=', 'draft')]}"/>
                                    <field name="partner_napas_code" attrs="{'invisible': [('type', '!=', 'transfer')], 'readonly': [('state', '!=', 'draft')]}"/>
                                    <field name="partner_tk_name" string="Chủ số tài khoản thụ hưởng (ngân hàng)" attrs="{'invisible': [('type', '!=', 'transfer')]}" readonly="1"/>
                                    <field name="partner_name"/>
                                    <field name="note_chuyen_khoan" attrs="{'invisible': [('type', '!=', 'transfer')],'required': [('type', '=', 'transfer')]}"/>
                                </group>
                                
                            </group>
                        </group>

                        <group string="Lý do hủy" attrs="{'invisible':[('trp_approve_reason_note','=', False)]}">
                            <field name="trp_approve_reason_id" string="Phân loại" readonly="1"/>
                            <field name="trp_approve_reason_note" string="Mô tả" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Chi tiết">
                                <field name="payment_note_ids" attrs="{'readonly': [('state', '!=', 'draft')]}" context="{'force_currency_id': currency_id, 'force_company_currency_id': company_currency_id, 'force_fcurrency_rate': fcurrency_rate, 'default_currency_id': currency_id, 'default_company_currency_id': company_currency_id, 'default_fcurrency_rate': fcurrency_rate}"/>
                                <group name="note_group" col="6" class="mt-2 mt-md-0" style="position: relative;">
                                    <group colspan="6" style="position: absolute; right: 325px; bottom: 0; width: auto;" attrs="{'invisible': [('currency_name', '=', 'VND')]}">
                                        <field name="famount_total" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_subtotal_footer_separator"/>
                                    </group>
                                    <group class="oe_subtotal_footer oe_right" colspan="6" name="sale_total">
                                        <field name="amount_untax_total" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                                        <field name="amount_tax_total" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                                        <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                            <label for="amount_total"/>
                                        </div>
                                        <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                                    </group>
                                    <div class="clearfix"/>
                                </group>
                            </page>
                            <page name="trp_approve_history" string="Aproval History">
                                <group attrs="{'invisible':[('trp_approve_config_line_id','=', False)]}">
                                    <group>
                                        <field name="trp_approve_config_line_id" invisible="1"/>
                                        <field name="current_approve_user_ids"
                                               attrs="{'invisible':[('trp_approve_config_line_id','=', False)]}"
                                               widget="many2many_tags" groups="base.group_system"/>
                                        <field name="delegate_approver_ids"
                                               attrs="{'invisible':[('trp_approve_config_line_id','=', False)]}"
                                               widget="many2many_tags"
                                               domain="[('id','not in',current_approve_user_ids)]"
                                               groups="base.group_system"/>
                                    </group>
                                </group>
                                <field name="trp_approve_history_ids" nolabel="1" readonly="1">
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="payment_request_action" model="ir.actions.act_window">
            <field name="name">Payment Request</field>
            <field name="res_model">payment.request</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_payment_request" name="Payment Request"
                  action="payment_request_action"
                  parent="account.menu_finance_entries" sequence="-11"/>
        <menuitem id="menu_payment_request_2" name="Payment Request"
                  action="payment_request_action"
                  parent="hr_expense.menu_hr_expense_my_expenses" sequence="10"/>
    </data>
</odoo>
