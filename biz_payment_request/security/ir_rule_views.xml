<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="ir_rule_alpha_internal_account_internal_user" model="ir.rule">
            <field name="name">Phiếu tạm ứng: nguời dùng</field>
            <field name="model_id" ref="biz_payment_request.model_payment_request"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <field name="active" eval="True"/>
            <field name="domain_force">[('user_id','=',user.id)]</field>
        </record>

        <record id="ir_rule_alpha_internal_account_manage_user" model="ir.rule">
            <field name="name">Phiếu tạm ứng: Trưởng phòng</field>
            <field name="model_id" ref="biz_payment_request.model_payment_request"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <field name="active" eval="True"/>
            <field name="domain_force">['|', ('current_approve_user_ids', 'in', [user.id]), ('delegate_approver_ids', 'in', [user.id])]</field>
        </record>

        <record id="ir_rule_alpha_internal_account_user" model="ir.rule">
            <field name="name">Phiếu tạm ứng: kế toán</field>
            <field name="model_id" ref="biz_payment_request.model_payment_request"/>
            <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <field name="active" eval="True"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>
    </data>
</odoo>