<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ccv_auditlog_line_report_wizard_form" model="ir.ui.view">
        <field name="name">ccv.auditlog.line.report.wizard.form</field>
        <field name="model">ccv.auditlog.line.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Xuất báo cáo Audit Log">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" string="Xuất Excel" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ccv_auditlog_line_report_wizard" model="ir.actions.act_window">
        <field name="name">Báo cáo Audit Log</field>
        <field name="res_model">ccv.auditlog.line.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_ccv_auditlog_line_report_wizard"
        name="Báo cáo Audit Log"
        parent="auditlog.menu_audit"
        action="action_ccv_auditlog_line_report_wizard"
        sequence="30"
        groups="base.group_system"
    />
</odoo>
