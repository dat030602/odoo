<odoo>
    <record id="server_action_export_delivery_report" model="ir.actions.server">
        <field name="name">Export Delivery Orders Report</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="state">code</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">action</field>
        <field name="code">
action = env['purchase.order'].browse(record.id).action_open_export_delivery_report_wizard()
        </field>
        <field name="groups_id" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
    </record>
</odoo>