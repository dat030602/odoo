<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_material_detail_book_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- Header với logo công ty -->
                <div class="header row">
                    <div class="col-2" style="display:inline-block">
                        <img t-if="user.company_id.logo" t-att-src="image_data_uri(user.company_id.logo)" style="width: auto; max-height: 50px;" class="float-left" alt="Logo"/>
                    </div>
                    <div class="col-6" style="text-align: left;margin-top:16px; font-size: 11px; font-family: 'Times New Roman', Times, serif !important;">
                        <span t-esc="user.company_id.name"/>
                        <br/>
                        <span>Mã Số Thuế: <span t-esc="user.company_id.vat"/></span>
                        <br/>
                        <span>Địa chỉ: <span t-esc="user.company_id.partner_id.full_address_vi"/></span>
                    </div>
                    <div class="col-4" style="text-align: center;margin-top:16px; font-size: 11px; font-family: 'Times New Roman', Times, serif !important;">
                        <span>Mẫu số: S10-DN</span>
                        <br/>
                        <span>(Ban hành theo thông tư số 200/2014/TT-BTC <br/> ngày 22/12/2014 của Bộ Tài chính)</span>
                    </div>
                </div>
                <div class="article o_report_layout_standard">
                    <style>
                        .page * {
                            font-size: 12px;
                            line-height: 16px;
                        }
                    </style>
                    <t t-set="data" t-value="o.get_report_pdf_data()"/>
                    <div class="page" style="font-size: 12px; font-family: 'Times New Roman', Times, serif; padding-top: 10px;">
                        <!-- Tiêu đề -->
                        <div style="text-align: center; margin-bottom: 4px;">
                            <strong style="font-size: 16px;">SỔ CHI TIẾT VẬT TƯ HÀNG HÓA</strong>
                        </div>
                        <div style="text-align: center; margin-bottom: 2px;">
                            <span>Kho: <strong><t t-esc="', '.join(o.warehouse_ids.mapped('name')) if o.warehouse_ids else 'Tất cả'"/></strong></span>
                            <span> &amp;nbsp;|&amp;nbsp; </span>
                            <span>Từ ngày <strong><t t-esc="o.from_date.strftime('%d/%m/%Y')"/></strong> đến ngày <strong><t t-esc="o.to_date.strftime('%d/%m/%Y')"/></strong></span>
                        </div>

                        <table style="width: 100%; border-collapse: collapse; font-size: 10px; table-layout: fixed;">
                            <thead>
                                <tr style="background-color: #f2f2f2;">
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 8%;">Mã hàng</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 12%;">Tên hàng</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 7%;">Ngày HT</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 8%;">Số CT</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 18%;">Diễn giải</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 5%;">ĐVT</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 7%;">Nhập</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 7%;">Xuất</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 7%;">Tồn</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 7%;">TK kho</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 7%;">TK đối ứng</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 8%;">Tên đối tượng</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 8%;">Lệnh SX</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 5%;">Kho</th>
                                    <th style="border: 1px solid #000; padding: 3px; text-align: center; width: 10%;">Người phụ trách SX</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data['warehouses']" t-as="wh">
                                    <!-- Warehouse header -->
                                    <tr style="background-color: #e6e6e6;">
                                        <td colspan="15" style="border: 1px solid #000; padding: 3px; font-weight: bold;">
                                            <t t-esc="wh['name']"/> (<t t-esc="wh['lines_count']"/>)
                                        </td>
                                    </tr>
                                    <t t-foreach="wh['products']" t-as="prod">
                                        <!-- Initial balance row -->
                                        <tr>
                                            <td style="border: 1px solid #000; padding: 3px; font-weight: bold;">
                                                <t t-esc="prod['default_code']"/> (<t t-esc="prod['lines_count']"/>)
                                            </td>
                                            <td style="border: 1px solid #000; padding: 3px; font-weight: bold;">
                                                <t t-esc="prod['name']"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 3px;"/>
                                            <td style="border: 1px solid #000; padding: 3px;"/>
                                            <td style="border: 1px solid #000; padding: 3px; font-weight: bold;">Số dư đầu kỳ</td>
                                            <td style="border: 1px solid #000; padding: 3px;"/>
                                            <td style="border: 1px solid #000; padding: 3px;"/>
                                            <td style="border: 1px solid #000; padding: 3px;"/>
                                            <td style="border: 1px solid #000; padding: 3px; text-align: right; font-weight: bold;">
                                                <t t-esc="prod['initial_balance']" t-options='{"widget": "float", "precision": 3}'/>
                                            </td>
                                            <td colspan="6" style="border: 1px solid #000; padding: 3px;"/>
                                        </tr>
                                        <!-- Detail lines -->
                                        <t t-foreach="prod['lines']" t-as="line">
                                            <tr>
                                                <td style="border: 1px solid #000; padding: 3px;"><t t-esc="line['product_code']"/></td>
                                                <td style="border: 1px solid #000; padding: 3px;"><t t-esc="line['product_name']"/></td>
                                                <td style="border: 1px solid #000; padding: 3px; text-align: center;">
                                                    <t t-esc="line['accounting_date'].strftime('%d/%m/%Y')" t-if="line['accounting_date']"/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 3px;"><t t-esc="line['document_number']"/></td>
                                                <td style="border: 1px solid #000; padding: 3px;"><t t-esc="line['explain']"/></td>
                                                <td style="border: 1px solid #000; padding: 3px; text-align: center;"><t t-esc="line['uom_id']"/></td>
                                                <td style="border: 1px solid #000; padding: 3px; text-align: right;">
                                                    <t t-esc="line['qty_import']" t-options='{"widget": "float", "precision": 3}'/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 3px; text-align: right;">
                                                    <t t-esc="line['qty_export']" t-options='{"widget": "float", "precision": 3}'/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 3px; text-align: right;">
                                                    <t t-esc="line['qty_inv']" t-options='{"widget": "float", "precision": 3}'/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 3px; text-align: center;"><t t-esc="line['account_warehouse_code']"/></td>
                                                <td style="border: 1px solid #000; padding: 3px; text-align: center;"><t t-esc="line['ctp_account_ids']"/></td>
                                                <td style="border: 1px solid #000; padding: 3px;"><t t-esc="line['partner_id']"/></td>
                                                <td style="border: 1px solid #000; padding: 3px;"><t t-esc="line['production_id']"/></td>
                                                <td style="border: 1px solid #000; padding: 3px; text-align: center;"><t t-esc="line['warehouse_id']"/></td>
                                                <td style="border: 1px solid #000; padding: 3px;"><t t-esc="line['factory_manager_name']"/></td>
                                            </tr>
                                        </t>
                                        <!-- Product total row -->
                                        <tr style="background-color: #fafafa;">
                                            <td colspan="4" style="border: 1px solid #000; padding: 3px; font-weight: bold;">
                                                Tổng cộng mã hàng: <t t-esc="prod['default_code']"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 3px;"/>
                                            <td style="border: 1px solid #000; padding: 3px;"/>
                                            <td style="border: 1px solid #000; padding: 3px; text-align: right; font-weight: bold;">
                                                <t t-esc="prod['sum_import']" t-options='{"widget": "float", "precision": 3}'/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 3px; text-align: right; font-weight: bold;">
                                                <t t-esc="prod['sum_export']" t-options='{"widget": "float", "precision": 3}'/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 3px; text-align: right; font-weight: bold;">
                                                <t t-esc="prod['last_qty_inv']" t-options='{"widget": "float", "precision": 3}'/>
                                            </td>
                                            <td colspan="6" style="border: 1px solid #000; padding: 3px;"/>
                                        </tr>
                                    </t>
                                </t>
                                <!-- Grand total row -->
                                <tr style="background-color: #f2f2f2;">
                                    <td colspan="4" style="border: 1px solid #000; padding: 3px; font-weight: bold;">
                                        Tổng số dòng: <t t-esc="data['total_lines']"/>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 3px;"/>
                                    <td style="border: 1px solid #000; padding: 3px;"/>
                                    <td style="border: 1px solid #000; padding: 3px; text-align: right; font-weight: bold;">
                                        <t t-esc="data['total_import']" t-options='{"widget": "float", "precision": 3}'/>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 3px; text-align: right; font-weight: bold;">
                                        <t t-esc="data['total_export']" t-options='{"widget": "float", "precision": 3}'/>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 3px;"/>
                                    <td colspan="6" style="border: 1px solid #000; padding: 3px;"/>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Ngày tháng -->
                        <div class="row" style="padding-top: 20px;">
                            <div class="col-12" style="text-align: right;">
                                <span><t t-esc="'Đồng Nai, Ngày %s Tháng %s năm %s' % (o.create_date.strftime('%d'), o.create_date.strftime('%m'), o.create_date.strftime('%Y'))"/></span>
                            </div>
                        </div>

                        <!-- Ký tên -->
                        <div class="row" style="margin-top: 30px; text-align: center;">
                            <div class="col-2">
                                <strong>Người lập phiếu</strong>
                                <br/><span style="font-style: italic;">(Ký, họ tên)</span>
                                <t t-if="o.state == 'approved' and o.voter_id and o.voter_id.sudo().sign_signature">
                                    <br/><br/>
                                    <img t-att-src="image_data_uri(o.voter_id.sudo().sign_signature)" width="120px" height="80px"/>
                                    <br/>
                                    <strong t-esc="o.voter_id.name"/>
                                </t>
                                <t t-elif="o.voter_id">
                                    <br/><br/><br/><br/>
                                    <strong t-esc="o.voter_id.name"/>
                                </t>
                            </div>
                            <div class="col-2">
                                <strong>Thủ Kho/Nhà Máy</strong>
                                <br/><span style="font-style: italic;">(Ký, họ tên)</span>
                                <t t-if="o.state == 'approved' and o.warehouse_manager_id and o.warehouse_manager_id.sudo().sign_signature">
                                    <br/><br/>
                                    <img t-att-src="image_data_uri(o.warehouse_manager_id.sudo().sign_signature)" width="120px" height="80px"/>
                                    <br/>
                                    <strong t-esc="o.warehouse_manager_id.name"/>
                                </t>
                                <t t-elif="o.warehouse_manager_id">
                                    <br/><br/><br/><br/>
                                    <strong t-esc="o.warehouse_manager_id.name"/>
                                </t>
                            </div>
                            <div class="col-2">
                                <strong>Chuyên viên kiểm soát kho</strong>
                                <br/><span style="font-style: italic;">(Ký, họ tên)</span>
                                <t t-if="o.state == 'approved' and o.stock_controller_id and o.stock_controller_id.sudo().sign_signature">
                                    <br/><br/>
                                    <img t-att-src="image_data_uri(o.stock_controller_id.sudo().sign_signature)" width="120px" height="80px"/>
                                    <br/>
                                    <strong t-esc="o.stock_controller_id.name"/>
                                </t>
                                <t t-elif="o.stock_controller_id">
                                    <br/><br/><br/><br/>
                                    <strong t-esc="o.stock_controller_id.name"/>
                                </t>
                            </div>
                            <div class="col-2">
                                <strong>Phòng kế toán</strong>
                                <br/><span style="font-style: italic;">(Ký, họ tên)</span>
                                <t t-if="o.state == 'approved' and o.chief_acc_id and o.chief_acc_id.sudo().sign_signature">
                                    <br/><br/>
                                    <img t-att-src="image_data_uri(o.chief_acc_id.sudo().sign_signature)" width="120px" height="80px"/>
                                    <br/>
                                    <strong t-esc="o.chief_acc_id.name"/>
                                </t>
                                <t t-elif="o.chief_acc_id">
                                    <br/><br/><br/><br/>
                                    <strong t-esc="o.chief_acc_id.name"/>
                                </t>
                            </div>
                            <div class="col-2">
                                <strong>Phòng HCNS</strong>
                                <br/><span style="font-style: italic;">(Ký, họ tên)</span>
                                <t t-if="o.state == 'approved' and o.hcns_id and o.hcns_id.sudo().sign_signature">
                                    <br/><br/>
                                    <img t-att-src="image_data_uri(o.hcns_id.sudo().sign_signature)" width="120px" height="80px"/>
                                    <br/>
                                    <strong t-esc="o.hcns_id.name"/>
                                </t>
                                <t t-elif="o.hcns_id">
                                    <br/><br/><br/><br/>
                                    <strong t-esc="o.hcns_id.name"/>
                                </t>
                            </div>
                            <div class="col-2">
                                <strong>Thủ trưởng đơn vị</strong>
                                <br/><span style="font-style: italic;">(Ký, họ tên)</span>
                                <t t-if="o.state == 'approved' and o.unit_heads_id and o.unit_heads_id.sudo().sign_signature">
                                    <br/><br/>
                                    <img t-att-src="image_data_uri(o.unit_heads_id.sudo().sign_signature)" width="120px" height="80px"/>
                                    <br/>
                                    <strong t-esc="o.unit_heads_id.name"/>
                                </t>
                                <t t-elif="o.unit_heads_id">
                                    <br/><br/><br/><br/>
                                    <strong t-esc="o.unit_heads_id.name"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
