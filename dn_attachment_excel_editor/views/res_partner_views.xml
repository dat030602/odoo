<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_excel_attachment" model="ir.ui.view">
        <field name="name">res.partner.form.excel.attachment</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="excel_attachment_ids" widget="many2many_binary"
                       options="{'accepted_file_extensions': '.xlsx,.xlsm,.pdf,.png,.jpg,.docx'}"/>
            </xpath>
        </field>
    </record>
</odoo>
