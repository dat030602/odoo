<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_simple_modif_excel" model="ir.ui.view">
        <field name="name">res.users.preferences.form.excel</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="excel_editor_save_option" widget="radio"/>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_excel" model="ir.ui.view">
        <field name="name">res.users.form.excel</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="excel_editor_save_option" widget="radio"/>
            </xpath>
        </field>
    </record>
</odoo>
