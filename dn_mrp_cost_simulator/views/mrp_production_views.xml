<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_form_view_inherit_cost_sim" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.cost.sim</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_cost_variance" type="object" class="oe_stat_button" icon="fa-bar-chart" string="Cost Variance" invisible="state in ('draft', 'cancel')"/>
                <button name="action_view_consumption_variance" type="object" class="oe_stat_button" icon="fa-balance-scale" string="Consumption Variance" invisible="state in ('draft', 'cancel')"/>
            </div>
        </field>
    </record>

</odoo>
