<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_bom_form_view_inherit_cost_sim" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.cost.sim</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_create_simulation" string="Simulate Cost" type="object" class="btn-secondary"/>
                </header>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_simulations" type="object" class="oe_stat_button" icon="fa-calculator">
                    <field name="simulation_count" widget="statinfo" string="Simulations"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
