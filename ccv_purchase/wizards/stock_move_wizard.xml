<odoo>
    <data>
        <record id="stock_move_wizard_form_view" model="ir.ui.view">
            <field name="name">stock.move.wizard.form</field>
            <field name="model">stock.move.wizard</field>
            <field name="arch" type="xml">
                <form string="Điều chỉnh chốt lô">
                    <p>Nhập số lượng chênh lệch để tạo phiếu điều chỉnh kho.</p>
                    <!-- <p>Số lượng chênh lệch âm (&lt;0) là thừa hàng.</p>
                    <p>Số lượng chênh lệch dương (&gt;0) là thiếu hàng.</p> -->
                    <group>
                        <field name="purchase_order_id" invisible="0"/>
                        <field name="default_location_id" string="Kho cảng" required="1"/>
                        <field name="location_id" string="Kho chốt lô" required="1"/>
                        <field name="date" required="1"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom" create="0">
                            <field name="wizard_id" invisible="1"/>
                            <field name="location_id" invisible="1"/>
                            <field name="purchase_line_id" invisible="1"/>
                            <field name="type"/>
                            <field name="debit_account_id"/>
                            <field name="credit_account_id"/>
                            <field name="product_id"/>
                            <field name="invoiced_qty" invisible="1"/>
                            <field name="delivered_qty" invisible="1"/>
                            <field name="diff_qty"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price_unit" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                            <field name="price_total" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                        </tree>
                    </field>
                    <footer>
                        <button name="create_stock_moves" string="Xác nhận" type="object" class="oe_highlight"/>
                        <button string="Hủy" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_stock_move_wizard" model="ir.actions.act_window">
            <field name="name">Điều chỉnh chốt lô</field>
            <field name="res_model">stock.move.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
