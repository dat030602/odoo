                    }

                    .mm-btn-primary {
                        background: var(--mm-primary);
                        color: #ffffff;
                    }

                    .mm-btn-secondary {
                        background: #ffffff;
                        border: 1px solid var(--mm-border-dark);
                        color: var(--mm-text-main);
                    }

                    .mm-btn-success {
                        background: var(--mm-success);
                        color: #ffffff;
                    }

                    /* Footer */
                    .mm-footer {
                        text-align: center;
                        font-size: 13px;
                        color: var(--mm-text-muted);
                        margin-top: 40px;
                        padding-top: 24px;
                        border-top: 1px solid var(--mm-border);
                    }
                </style>
            </head>
