<odoo>

    <record id="view_meta_migration_job_form" model="ir.ui.view">
        <field name="name">meta.migration.job.form</field>
        <field name="model">meta.migration.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test" type="object" string="Test" class="btn-secondary"/>
                    <button name="action_run" type="object" string="Run" class="btn-primary"
                            confirm="Run will write directly to the target system. Continue?"/>
                    <button name="action_sort_steps" type="object" string="Sort by dependency"/>
                    <button name="action_generate_field_steps" type="object" string="Generate field steps"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="d-flex align-items-center justify-content-between">
                            <label for="name" string="Job Name"/>
                            <a href="/meta_migrator/guide" target="_blank"
                               class="text-muted small text-decoration-none"
                               style="font-size: 12px; opacity: 0.7;">
                                <i class="fa fa-book me-1"/> User Guide &amp; Workflow
                            </a>
                        </div>
                        <h1>
                            <field name="name" placeholder="e.g. Sales Customization Migration"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Connections">
                            <field name="source_connection_id"/>
                            <field name="target_connection_id"/>
                        </group>
                        <group string="Execution Options">
                            <field name="on_conflict"/>
                            <field name="stop_on_error"/>
                            <field name="run_in_background"/>
                            <field name="last_run_summary" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Steps">
                            <field name="step_ids" context="{'default_job_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="active" widget="boolean_toggle"/>
                                    <field name="action" widget="badge"
                                           decoration-success="action == 'create'"
                                           decoration-warning="action == 'update'"/>
                                    <field name="object_type" widget="badge"/>
                                    <field name="model_name"/>
                                    <field name="label" string="Step Summary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Runs">
                            <field name="run_ids" readonly="1">
                                <list default_order="id desc"
                                      decoration-success="state == 'done'"
                                      decoration-danger="state == 'failed'"
                                      decoration-muted="state == 'cancelled'"
                                      decoration-info="state in ('queued', 'running')">
                                    <field name="name"/>
                                    <field name="mode" widget="badge"/>
                                    <field name="target_connection_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="progress"/>
                                    <field name="summary_text"/>
                                    <field name="is_in_sync" widget="boolean_toggle"/>
                                    <field name="create_date" string="Created At"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_meta_migration_job_list" model="ir.ui.view">
        <field name="name">meta.migration.job.list</field>
        <field name="model">meta.migration.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source_connection_id"/>
                <field name="target_connection_id"/>
                <field name="on_conflict"/>
                <field name="stop_on_error"/>
                <field name="run_in_background"/>
                <field name="last_run_summary"/>
            </list>
        </field>
    </record>

    <record id="action_meta_migration_job" model="ir.actions.act_window">
        <field name="name">Migration Jobs</field>
        <field name="res_model">meta.migration.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Step Views -->
    <record id="view_meta_migration_step_form" model="ir.ui.view">
        <field name="name">meta.migration.step.form</field>
        <field name="model">meta.migration.step</field>
        <field name="arch" type="xml">
            <form string="Migration Step">
                <sheet>
                    <div class="oe_title">
                        <label for="label" string="Step Summary"/>
                        <h2>
                            <field name="label" readonly="1"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Step Configuration">
                            <field name="object_type" required="1"/>
                            <field name="action" required="1"
                                   readonly="object_type not in ('view', 'server_action')" force_save="1"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="job_id" invisible="1"/>
                        </group>
                    </group>

                    <!-- 1. MODEL SETUP -->
                    <group string="Model Definition" invisible="object_type != 'model'">
                        <group>
                            <field name="model_name" required="object_type == 'model'"
                                   placeholder="e.g. sale.order or x_custom_model"/>
                            <field name="model_description" placeholder="e.g. Custom Sales Order"/>
                        </group>
                        <group>
                            <field name="target_model_name" placeholder="Leave empty to keep source model name"/>
                            <field name="transient"/>
                        </group>
                        <group string="Related Options (Auto-create on target)" colspan="2">
                            <group>
                                <field name="create_list_view"/>
                                <field name="create_form_view"/>
                                <field name="create_search_view"/>
                            </group>
                            <group>
                                <field name="create_menu"/>
                                <field name="copy_access_rights"/>
                                <field name="copy_record_rules"/>
                            </group>
                        </group>
                    </group>

                    <!-- 2. FIELD SETUP -->
                    <group string="Field Definition" invisible="object_type != 'field'">
                        <group>
                            <field name="model_name" required="object_type == 'field'"
                                   placeholder="e.g. sale.order"/>
                            <field name="field_name"
                                   placeholder="e.g. x_custom_field (empty = all manual fields)"/>
                            <field name="field_description" placeholder="e.g. Custom Notes"/>
                            <field name="ttype"/>
                            <field name="help" placeholder="Tooltip text displayed to users"/>
                        </group>
                        <group>
                            <field name="relation"
                                   invisible="ttype not in ('many2one', 'one2many', 'many2many')"
                                   required="ttype in ('many2one', 'one2many', 'many2many')"
                                   placeholder="e.g. res.partner"/>
                            <field name="relation_field"
                                   invisible="ttype != 'one2many'"
                                   required="ttype == 'one2many'"
                                   placeholder="e.g. order_id"/>
                            <field name="on_delete"
                                   invisible="ttype != 'many2one'"/>
                            <field name="selection"
                                   invisible="ttype != 'selection'"
                                   required="ttype == 'selection'"
                                   placeholder="[('draft', 'Draft'), ('done', 'Done')]"/>
                        </group>
                        <group string="Field Properties" colspan="2">
                            <group>
                                <field name="required"/>
                                <field name="readonly"/>
                                <field name="store"/>
                            </group>
                            <group>
                                <field name="index"/>
                                <field name="copied"/>
                                <field name="translate" invisible="ttype not in ('char', 'text', 'html')"/>
                            </group>
                        </group>
                        <group string="Compute &amp; Advanced Logic" colspan="2">
                            <field name="compute"
                                   invisible="related"
                                   required="object_type == 'field' and not related and depends"
                                   placeholder="# Python compute code: for rec in self: rec.x_field = ..."/>
                            <field name="depends"
                                   invisible="related"
                                   required="object_type == 'field' and not related and compute"
                                   placeholder="e.g. partner_id,order_line.price_subtotal"/>
                            <field name="related"
                                   invisible="compute or depends"
                                   placeholder="e.g. partner_id.name"/>
                        </group>
                    </group>

                    <!-- 3. VIEW SETUP -->
                    <group string="View Definition" invisible="object_type != 'view'">
                        <group>
                            <field name="model_name"
                                   required="object_type == 'view' and action == 'create'"
                                   placeholder="e.g. sale.order"/>
                            <field name="view_name" placeholder="e.g. sale.order.form.custom"/>
                            <field name="view_type"
                                   required="object_type == 'view' and action == 'create'"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="xml_id"
                                   required="object_type == 'view' and action == 'update'"
                                   placeholder="e.g. sale.view_order_form"/>
                            <field name="inherit_xml_id" placeholder="e.g. base.view_partner_form"/>
                            <field name="mode"/>
                        </group>
                        <group string="Architecture XML" colspan="2">
                            <field name="arch" placeholder="&lt;form&gt; ... &lt;/form&gt; or &lt;data&gt; ... &lt;/data&gt;"/>
                        </group>
                    </group>

                    <!-- 4. SERVER ACTION SETUP -->
                    <group string="Server Action Definition" invisible="object_type != 'server_action'">
                        <group>
                            <field name="action_name" placeholder="e.g. Update Partner Status"/>
                            <field name="model_name" placeholder="e.g. res.partner"/>
                            <field name="xml_id" required="object_type == 'server_action'"
                                   placeholder="e.g. custom_module.action_update_partner"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="binding_model" placeholder="e.g. res.partner"/>
                            <field name="binding_type"/>
                        </group>
                        <group string="Python Code" colspan="2">
                            <field name="code" placeholder="# Python code executed by the server action"/>
                        </group>
                    </group>

                    <!-- 5. ACCESS RIGHT SETUP -->
                    <group string="Access Right (ACL) Definition" invisible="object_type != 'access_right'">
                        <group>
                            <field name="access_name" placeholder="e.g. access_x_custom_model_user"/>
                            <field name="model_name" required="object_type == 'access_right'"
                                   placeholder="e.g. x_custom_model"/>
                            <field name="group_xml_id" placeholder="e.g. base.group_user (empty = all users)"/>
                        </group>
                        <group string="Permissions">
                            <field name="perm_read"/>
                            <field name="perm_write"/>
                            <field name="perm_create"/>
                            <field name="perm_unlink"/>
                        </group>
                    </group>

                    <!-- 6. RECORD RULE SETUP -->
                    <group string="Record Rule Definition" invisible="object_type != 'record_rule'">
                        <group>
                            <field name="rule_name" placeholder="e.g. Multi-Company Rule"/>
                            <field name="model_name" required="object_type == 'record_rule'"
                                   placeholder="e.g. x_custom_model"/>
                            <field name="group_xml_id" placeholder="e.g. base.group_user (empty = all groups)"/>
                            <field name="rule_active" widget="boolean_toggle"/>
                        </group>
                        <group string="Permissions">
                            <field name="perm_read"/>
                            <field name="perm_write"/>
                            <field name="perm_create"/>
                            <field name="perm_unlink"/>
                        </group>
                        <group string="Domain Filter" colspan="2">
                            <field name="domain_force" placeholder="['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]"/>
                        </group>
                    </group>

                    <!-- 7. MENU SETUP -->
                    <group string="Menu Definition" invisible="object_type != 'menu'">
                        <group>
                            <field name="menu_name" placeholder="e.g. Custom Management"/>
                            <field name="model_name" required="object_type == 'menu'"
                                   placeholder="e.g. x_custom_model"/>
                        </group>
                        <group>
                            <field name="parent_xml_id" placeholder="e.g. base.menu_custom"/>
                            <field name="menu_sequence"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_meta_migration_step_list" model="ir.ui.view">
        <field name="name">meta.migration.step.list</field>
        <field name="model">meta.migration.step</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="action" widget="badge"
                       decoration-success="action == 'create'"
                       decoration-warning="action == 'update'"/>
                <field name="object_type" widget="badge"/>
                <field name="model_name"/>
                <field name="field_name" optional="show"/>
                <field name="xml_id" optional="hide"/>
                <field name="label" string="Step Summary"/>
            </list>
        </field>
    </record>

</odoo>
