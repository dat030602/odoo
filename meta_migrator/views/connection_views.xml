<odoo>

    <record id="view_meta_migration_connection_form" model="ir.ui.view">
        <field name="name">meta.migration.connection.form</field>
        <field name="model">meta.migration.connection</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_test_connection" type="object"
                                string="Test Connection" class="oe_stat_button" icon="fa-plug"/>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="url"/>
                        <field name="db"/>
                        <field name="username"/>
                        <field name="password" password="True"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_meta_migration_connection_list" model="ir.ui.view">
        <field name="name">meta.migration.connection.list</field>
        <field name="model">meta.migration.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="url"/>
                <field name="db"/>
                <field name="username"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_meta_migration_connection" model="ir.actions.act_window">
        <field name="name">Odoo Connections</field>
        <field name="res_model">meta.migration.connection</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
