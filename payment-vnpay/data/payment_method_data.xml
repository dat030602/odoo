<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_icon_cc_payment" model="payment.method">
        <field name="sequence">9</field>
        <field name="name">VNPay</field>
        <field name="code">vnpay</field>
        <field name="active">True</field>
        <field name="image" type="base64" file="payment_vnpay/static/description/icon.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">full_only</field>
        <field name="supported_country_ids" eval="[Command.set([])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.VND'),])]"
        />
     </record>
</odoo>