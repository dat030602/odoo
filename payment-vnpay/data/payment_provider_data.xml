<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- Visible in dashboard Payment Provider -->
   <record id="payment_provider_vnpay" model="payment.provider">
      <field name="code">vnpay</field>
      <field name="name">VNPay</field>
      <!-- <field name="redirect_form_view_id" ref="redirect_form"/> -->
      <field name="module_id" ref="base.module_payment_vnpay"/>
      <field name="image_128" type="base64" file="payment_vnpay/static/description/icon.png"/>
      <field name="payment_method_ids"
            eval="[Command.set([
                        ref('payment_vnpay.payment_icon_cc_payment')
                     ])]"/>
  </record>
</odoo>
