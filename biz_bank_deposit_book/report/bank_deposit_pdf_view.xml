<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="rp_bank_deposit_book_pdf_document">
    <t t-call="web.basic_layout">
        <t t-set="company" t-value="doc.env.company"/>
        <div class="page" style="font-family:Times New Roman; font-size:18px;">
            <div class="oe_structure"/>
            <div class="row">
                <div class="col-6">
                    <p><b>Đơn vị: <span t-esc="company.name"/></b></p>
                    <p><b>Địa chỉ: <span t-esc="get_company_address(company)"/></b></p>
                </div>
                <div class="col-6 text-center">
                    <p><b>Mẫu số: S08-DN</b></p>
                    <p>(Ban hành theo Thông tư số 99/2025/TT-BTC</p>
                    <p>Ngày 27/10/2025 của Bộ Tài chính)</p>
                </div>
            </div>

            <div class="text-center my-5">
                <h4 class="bold">SỔ TIỀN GỬI NGÂN HÀNG</h4>
                <p>Nơi mở tài khoản giao dịch: <span t-field="doc.journal_id.bank_account_id"/></p>
                <p>Số hiệu tài khoản tại nơi gửi: <span t-field="doc.journal_id.bank_id"/></p>
            </div>  
            <table class="table">
                <thead>
                    <tr>
                        <th rowspan="2">Ngày, tháng ghi sổ</th>
                        <th colspan="2">Chứng từ</th>
                        <th rowspan="2">Diễn giải</th>
                        <th rowspan="2">TK đối ứng</th>
                        <th colspan="3">Số tiền</th>
                        <th rowspan="2">Ghi chú</th>
                    </tr>
                    <tr>
                        <th>Số hiệu</th>
                        <th>Ngày, tháng</th>
                        <th>Thu (gửi vào)</th>
                        <th>Chi (rút ra)</th>
                        <th>Còn lại</th>
                    </tr>
                    <tr>
                        <th>A</th>
                        <th>B</th>
                        <th>C</th>
                        <th>D</th>
                        <th>E</th>
                        <th>1</th>
                        <th>2</th>
                        <th>3</th>
                        <th>F</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="initital" t-value="get_initial_balance(doc)"/>
                    <t t-set="remaining" t-value="initital"/>
                    <t t-set="data" t-value="get_lines(doc)"/>
                    <tr>
                        <td rowspan="2"></td>
                        <td rowspan="2"></td>
                        <td rowspan="2"></td>
                        <td class="bold">- Số dư đầu kỳ</td>
                        <td></td>
                        <td></td>
                        <td><span t-esc="row"/></td>
                        <td class="nowrap"><span t-esc="format_number(initital)" /></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td class="bold">- Số phát sinh trong kỳ</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr t-foreach="data['lines']" t-as="line">
                        <t t-set="remaining" t-value="remaining + line['debit'] - line['credit']"/>
                        <td><span t-esc="line['date']"/></td>
                        <td><span t-esc="line['move_name']"/></td>
                        <td><span t-esc="line['date']"/></td>
                        <td><span t-esc="line['name']"/></td>
                        <td><span t-esc="line['cpt_code']"/></td>
                        <td class="nowrap"><span t-esc="format_number(line['debit'])"/></td>
                        <td class="nowrap"><span t-esc="format_number(line['credit'])"/></td>
                        <td class="nowrap"><span t-esc="format_number(remaining)"/></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="bold">- Cộng phát sinh trong kỳ</td>
                        <td></td>
                        <td class="nowrap"><span t-esc="format_number(data['sum_debit'])"/></td>
                        <td class="nowrap"><span t-esc="format_number(data['sum_credit'])"/></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="bold">- Số dư cuối kỳ</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="nowrap"><span t-esc="format_number(initital + data['sum_debit'] - data['sum_credit'])"/></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>

            <div>
                <p>- Sổ này có ... trang, đánh số từ trang 01 đến trang...</p>
                <p>- Ngày mở sổ: ...</p>
            </div>

            <div class="text-center mt-4" style='page-break-inside: avoid;'>
                <div class="row">
                    <div class="col-8"/>
                    <div class="col-4">
                        <i>Ngày.....tháng.....năm.....</i>
                    </div>
                </div>
                <div class="row">
                    <div class="col-4">
                        <p><b>Người ghi sổ</b></p>
                        <p><i>(Ký, họ tên)</i></p>
                    </div>
                    <div class="col-4">
                        <p><b>Kế toán trưởng</b></p>
                        <p><i>(Ký, họ tên)</i></p>
                    </div>
                    <div class="col-4">
                        <p><b>Giám đốc</b></p>
                        <p><i>(Ký, họ tên, đóng dấu)</i></p>
                    </div>
                </div>
            </div>
            <div class="footer">
                <div class="text-right" style="text-align: right">
                    <div class="text-muted">
                        Page: <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </div>

            <style>
                .bold{
                    font-weight: bold;
                }
                p{
                    margin: 0  !important;
                }
                table{
                    border:  1px solid;
                    width: 100%;
                }
                td, th{
                    padding: 5px;
                }
                thead {
                    border-bottom: 0 !important;
                }
                tbody{
                    border-top: 0 !important;
                }
                thead tr, thead td{
                    border:  1px solid;
                }
                tbody tr,tbody td{
                    border-bottom: 1px solid !important;
                    border-top: 1px solid !important;
                    border-left: 1px solid !important;
                    border-right: 1px solid !important;
                }
                tr{
                    page-break-inside: avoid;
                }
                .nowrap{
                    white-space: nowrap;
                    text-align: right;
                }
            </style>
        </div>
    </t>
</template>


<template id="rp_bank_deposit_book_pdf">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
            <t t-call="biz_bank_deposit_book.rp_bank_deposit_book_pdf_document" t-lang="doc.env.user.lang"/>
        </t>
    </t>
</template>

</odoo>
