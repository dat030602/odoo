<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paper_format_s08" model="report.paperformat">
        <field name="name">S08-DN</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_rp_bank_deposit_book" model="ir.actions.report">
        <field name="name">Bank deposit book (PDF)</field>
        <field name="model">bank.deposit.book</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">biz_bank_deposit_book.rp_bank_deposit_book_pdf</field>
        <field name="report_file">biz_bank_deposit_book.rp_bank_deposit_book_pdf</field>
        <field name="print_report_name">'%s' % (object.get_report_name(),)</field>
        <field name="paperformat_id" ref='paper_format_s08'/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_rp_bank_deposit_book_xlsx" model="ir.actions.report">
        <field name="name">Bank deposit book (Excel)</field>
        <field name="model">bank.deposit.book</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">biz_bank_deposit_book.rp_bank_deposit_book_xlsx</field>
        <field name="report_file">biz_bank_deposit_book.rp_bank_deposit_book_xlsx</field>
        <field name="print_report_name">'%s' % (object.get_report_name(),)</field>
        <field name="binding_type">report</field>
    </record>

</odoo>
