<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bank_deposit_book_tree" model="ir.ui.view">
        <field name="name">bank.deposit.book.tree</field>
        <field name="model">bank.deposit.book</field>
        <field name="arch" type="xml">
            <tree>
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="journal_id"/>
            </tree>
        </field>
    </record>

    <record id="bank_deposit_book_form" model="ir.ui.view">
        <field name="name">bank.deposit.book.form</field>
        <field name="model">bank.deposit.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="from_date"/>
                            <field name="to_date"/>
                            <field name="journal_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf" string="Export PDF" type="object" class="btn-primary"/>
                    <button name="action_print_excel" string="Export Excel" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="bank_deposit_book_action" model="ir.actions.act_window">
        <field name="name">Bank deposit book</field>
        <field name="res_model">bank.deposit.book</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem action="bank_deposit_book_action" name="Bank deposit book (S08-DN)" id="bank_deposit_book_menu" sequence="18"  
        parent='account_reports.account_reports_audit_reports_menu'/>

</odoo>