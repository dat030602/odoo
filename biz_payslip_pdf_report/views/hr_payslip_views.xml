<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_inherit_kd" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.kd</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']" position="before">
                <field name="is_kd_structure" invisible="1"/>
                <field name="kd_report_html" widget="html" readonly="1" nolabel="1" attrs="{'invisible': [('is_kd_structure', '=', False)]}"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_kd_structure', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
