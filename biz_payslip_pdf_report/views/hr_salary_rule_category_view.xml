<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_salary_rule_category_form_inherit" model="ir.ui.view">
            <field name="name">hr.salary.rule.category.inherit.form</field>
            <field name="model">hr.salary.rule.category</field>
            <field name="inherit_id" ref="hr_payroll.hr_salary_rule_category_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='category_details']" position="after">
                    <group>
                        <group></group>
                        <group>
                            <field name="print_payslip"/>
                            <field name="print_scale"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>