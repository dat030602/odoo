<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_payslip_form_inherit" model="ir.ui.view">
            <field name="name">hr.payslip.form.inherit</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//header//button[@name='action_print_payslip']" position="after">
                    <button string="Print PDF" name="action_print_payslip_pdf" type="object"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree" position="inside">
                    <field name="number_rule_payslip" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree" position="attributes">
                    <attribute name="default_order">number_rule_payslip</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>