<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
         <record id="res_config_settings_view_form_inherited_biz_ods" model="ir.ui.view">
	        <field name="name">res.config.settings.form.inherited.biz_conveyor_picking</field>
	        <field name="model">res.config.settings</field>
	        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
	        <field name="arch" type="xml">
	        	<xpath expr="//div[hasclass('settings')]" position="inside">
					<div class="app_settings_block" data-string="Conveyor" string="Conveyor" data-key="biz_conveyor_picking">
						<h2>Conveyor</h2>
						<div class="row mt16 o_settings_container">
                            <div class="col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                </div>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">
                                        Connect Conveyor
                                    </span>
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label for="conveyor_username" class="col-lg-3 o_light_label" string="User name"/>
                                            <field name="conveyor_username" class="col-lg-2 p-0"/>
                                        </div>
                                        <div class="row mt2">
                                            <label for="conveyor_password" class="col-lg-3 o_light_label" string="Password"/>
                                            <field name="conveyor_password" class="col-lg-2 p-0"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
					</div>
	            </xpath>
	        </field>
	    </record>
    </data>
</odoo>
