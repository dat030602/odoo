<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_sale_invoicelist_form" model="ir.ui.view">
        <field name="name">wizard.sale.invoicelist.form</field>
        <field name="model">wizard.sale.invoicelist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="from_date"/>
                            <field name="to_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_sale_invoicelist_action" model="ir.actions.act_window">
        <field name="name">Print sales invoice list</field>
        <field name="res_model">wizard.sale.invoicelist</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

