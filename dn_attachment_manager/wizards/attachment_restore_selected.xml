<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_attachment_restore_selected_form" model="ir.ui.view">
        <field name="name">attachment.restore.selected.form</field>
        <field name="model">attachment.restore.selected</field>
        <field name="arch" type="xml">
            <form string="Restore Selected Attachments">
                <group>
                    <field name="attachment_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Restore" type="object" name="action_restore" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>