<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_attachment_cleanup_wizard_form" model="ir.ui.view">
        <field name="name">attachment.cleanup.wizard.form</field>
        <field name="model">attachment.cleanup.wizard</field>
        <field name="arch" type="xml">
            <form string="Attachment Cleanup">
                <group>
                    <field name="orphan"/>
                    <field name="duplicate"/>
                    <field name="larger_than_mb"/>
                    <field name="before_date"/>
                </group>
                <group>
                    <field name="preview_count" readonly="1"/>
                    <field name="preview_size" readonly="1"/>
                </group>
                <footer>
                    <button string="Preview" type="object" name="action_preview" class="btn-primary"/>
                    <button string="Delete" type="object" name="action_confirm_delete" class="btn-danger"/>
                    <button string="Close" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>