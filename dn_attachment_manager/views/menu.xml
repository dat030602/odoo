<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<!-- Actions -->
	<record id="action_attachment_all" model="ir.actions.act_window">
		<field name="name">All Attachments</field>
		<field name="res_model">ir.attachment</field>
		<field name="view_mode">list,form</field>
		<field name="domain">[("in_trash","=",False), ('name','not like','.js'), ('name','not like','.css'), ('name','not like','.scss')]</field>
		<field name="view_id" ref="view_attachment_list"/>
	</record>

	<record id="action_attachment_large" model="ir.actions.act_window">
		<field name="name">Large Files</field>
		<field name="res_model">ir.attachment</field>
		<field name="view_mode">list,form</field>
		<field name="domain">[("in_trash","=",False),("file_size", ">", 20971520), ('name','not like','.js'), ('name','not like','.css'), ('name','not like','.scss')]</field>
		<field name="view_id" ref="view_attachment_list"/>
	</record>

	<record id="action_attachment_duplicates" model="ir.actions.act_window">
		<field name="name">Duplicate Files</field>
		<field name="res_model">ir.attachment</field>
		<field name="view_mode">list,form</field>
		<field name="domain">[("in_trash","=",False),("is_duplicate","=",True), ('name','not like','.js'), ('name','not like','.css'), ('name','not like','.scss')]</field>
		<field name="view_id" ref="view_attachment_list"/>
	</record>

	<record id="action_attachment_orphan" model="ir.actions.act_window">
		<field name="name">Orphan Files</field>
		<field name="res_model">ir.attachment</field>
		<field name="view_mode">list,form</field>
		<field name="domain">[("in_trash","=",False),("is_orphan","=",True), ('name','not like','.js'), ('name','not like','.css'), ('name','not like','.scss')]</field>
		<field name="view_id" ref="view_attachment_list"/>
	</record>

	<record id="action_attachment_cleanup_wizard" model="ir.actions.act_window">
		<field name="name">Cleanup Wizard</field>
		<field name="res_model">attachment.cleanup.wizard</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
		<field name="view_id" ref="view_attachment_cleanup_wizard_form"/>
	</record>

	<!-- Move to Trash action for selection -->
	<record id="action_attachment_move_to_trash" model="ir.actions.act_window">
		<field name="name">Move to Trash (Attachment Manager)</field>
		<field name="res_model">attachment.move.trash</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
		<field name="binding_model_id" ref="base.model_ir_attachment"/>
		<field name="view_id" ref="view_attachment_move_trash_form"/>
	</record>

	<!-- Restore action for selection -->
	<record id="action_attachment_restore_selected" model="ir.actions.act_window">
		<field name="name">Restore Selected (Attachment Manager)</field>
		<field name="res_model">attachment.restore.selected</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
		<field name="binding_model_id" ref="base.model_ir_attachment"/>
		<field name="view_id" ref="view_attachment_restore_selected_form"/>
	</record>

	<!-- Recycle Bin view -->
	<record id="action_attachment_recycle_bin" model="ir.actions.act_window">
		<field name="name">Recycle Bin</field>
		<field name="res_model">ir.attachment</field>
		<field name="view_mode">list,form</field>
		<field name="domain">[("in_trash","=",True), ('name','not like','.js'), ('name','not like','.css'), ('name','not like','.scss')]</field>
		<field name="view_id" ref="view_attachment_list"/>
	</record>

	<!-- Menu -->
	<menuitem id="menu_attachment_manager_root" name="Attachment Manager" sequence="100"/>
	<menuitem id="menu_attachment_all" name="All Attachments" parent="menu_attachment_manager_root" action="action_attachment_all"/>
	<menuitem id="menu_attachment_large" name="Large Files" parent="menu_attachment_manager_root" action="action_attachment_large"/>
	<menuitem id="menu_attachment_duplicates" name="Duplicate Files" parent="menu_attachment_manager_root" action="action_attachment_duplicates"/>
	<menuitem id="menu_attachment_orphan" name="Orphan Files" parent="menu_attachment_manager_root" action="action_attachment_orphan"/>
	<menuitem id="menu_attachment_cleanup" name="Cleanup Wizard" parent="menu_attachment_manager_root" action="action_attachment_cleanup_wizard"/>
	<menuitem id="menu_attachment_recycle" name="Recycle Bin" parent="menu_attachment_manager_root" action="action_attachment_recycle_bin"/>

</odoo>
