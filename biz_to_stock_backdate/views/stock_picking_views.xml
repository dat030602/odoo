<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="vpicktree_tree_view_inherit" model="ir.ui.view">
            <field name="name">vpicktree.tree.view.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='json_popover']" position="after">
                    <field name="create_date"/>
                    <field name="mrp_production_id"/>
                </xpath>
            </field>
        </record>
        <record id="view_picking_ccv_form_inherit" model="ir.ui.view">
            <field name="name">view.picking.ccv.form.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_deadline']" position="before">
                    <field name="stock_date_receipt"/>
                </xpath>
            </field>
        </record>
        <record id="model_stock_picking_action_confirm_multi" model="ir.actions.server">
            <field name="name">Confirm stock picking multi</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = records.action_confirm_multi()</field>
        </record>
        <record id="model_stock_picking_button_validate_backdate_multi" model="ir.actions.server">
            <field name="name">Confirm backdate multi</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                action = records.button_validate_backdate_multi()
            </field>
        </record>
        <record id="model_stock_picking_update_date_done" model="ir.actions.server">
            <field name="name">Update date done</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                action = records.update_date_done()
            </field>
        </record>
    </data>
</odoo>