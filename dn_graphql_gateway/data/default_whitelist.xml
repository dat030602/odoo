<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Whitelisted Models -->
        <record id="graphql_model_res_partner" model="dn.graphql.model">
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="allow_read">True</field>
            <field name="allow_create">True</field>
            <field name="allow_write">True</field>
            <field name="allow_unlink">True</field>
            <field name="default_limit">20</field>
            <field name="max_limit">100</field>
            <field name="active">True</field>
        </record>

        <record id="graphql_model_res_company" model="dn.graphql.model">
            <field name="model_id" ref="base.model_res_company"/>
            <field name="allow_read">True</field>
            <field name="allow_create">False</field>
            <field name="allow_write">False</field>
            <field name="allow_unlink">False</field>
            <field name="default_limit">10</field>
            <field name="max_limit">50</field>
            <field name="active">True</field>
        </record>

        <record id="graphql_model_res_country" model="dn.graphql.model">
            <field name="model_id" ref="base.model_res_country"/>
            <field name="allow_read">True</field>
            <field name="allow_create">False</field>
            <field name="allow_write">False</field>
            <field name="allow_unlink">False</field>
            <field name="default_limit">25</field>
            <field name="max_limit">250</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
