<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_graphql" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.graphql</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="GraphQL Gateway" string="GraphQL Gateway" name="dn_graphql_gateway">
                    <block title="Security &amp; Scraping Protection" name="graphql_protection_settings">
                        <setting id="graphql_max_depth_setting" string="Maximum Query Depth" help="Limit nested relationship query depth (default 6).">
                            <field name="dn_graphql_max_depth"/>
                        </setting>
                        <setting id="graphql_rate_limit_setting" string="Rate Limit (Per Minute)" help="Maximum requests allowed per API Key per minute (default 60).">
                            <field name="dn_graphql_rate_limit_minute"/>
                        </setting>
                        <setting id="graphql_max_nodes_setting" string="Maximum Records per Request" help="Upper ceiling on total records retrieved in a query (default 1000).">
                            <field name="dn_graphql_max_nodes"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_dn_graphql_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'dn_graphql_gateway'}</field>
    </record>
</odoo>
