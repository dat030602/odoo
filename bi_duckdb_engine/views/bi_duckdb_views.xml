<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bi_duckdb_report_list" model="ir.ui.view">
        <field name="name">bi.duckdb.report.list</field>
        <field name="model">bi.duckdb.report</field>
        <field name="arch" type="xml">
            <list string="DuckDB Reports">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="cache_ttl"/>
                <button name="action_open_report" type="object" string="Run Report" class="btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_bi_duckdb_report_form" model="ir.ui.view">
        <field name="name">bi.duckdb.report.form</field>
        <field name="model">bi.duckdb.report</field>
        <field name="arch" type="xml">
            <form string="DuckDB Analytical Report">
                <header>
                    <button name="action_open_report" type="object" string="Run Report (DuckDB WASM)" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="cache_ttl"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="1. PostgreSQL Extract SQL (Server)">
                            <p class="text-muted">
                                Requires <code>:company_ids</code>. Dynamic variables like <code>:date_from</code>, <code>:warehouse_id</code> will automatically generate UI filter inputs.
                            </p>
                            <field name="pg_extract_sql" widget="code" options="{'mode': 'sql'}"/>
                        </page>
                        <page string="2. DuckDB Views (Client WASM)">
                            <field name="view_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="duckdb_sql"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bi_duckdb_report" model="ir.actions.act_window">
        <field name="name">DuckDB SQL Reports</field>
        <field name="res_model">bi.duckdb.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bi_duckdb_client" model="ir.actions.client">
        <field name="name">Visual Analytics Report</field>
        <field name="tag">bi_duckdb_engine.report_action</field>
        <field name="target">main</field>
    </record>
</odoo>
