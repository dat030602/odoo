<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_misa_certificate_tree" model="ir.ui.view">
        <field name="name">misa.certificate.list</field>
        <field name="model">misa.certificate</field>
        <field name="arch" type="xml">
            <list string="Digital Certificates" decoration-danger="not is_active_cert" decoration-success="is_active_cert">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="issuer"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="sign_type"/>
                <field name="is_active_cert" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_misa_certificate_form" model="ir.ui.view">
        <field name="name">misa.certificate.form</field>
        <field name="model">misa.certificate</field>
        <field name="arch" type="xml">
            <form string="Digital Certificate">
                <header>
                    <button name="sync_certificates" string="Sync Certificates from MISA" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Certificate Subject Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Certificate Information">
                            <field name="serial_number"/>
                            <field name="issuer"/>
                            <field name="sign_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Validity Period">
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="is_active_cert" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_misa_certificate_search" model="ir.ui.view">
        <field name="name">misa.certificate.search</field>
        <field name="model">misa.certificate</field>
        <field name="arch" type="xml">
            <search string="Search Digital Certificates">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="issuer"/>
                <filter string="Valid Certificates" name="valid" domain="[('is_active_cert', '=', True)]"/>
                <filter string="HSM / Remote Sign" name="hsm_sign" domain="[('sign_type', '=', '2')]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_misa_certificate" model="ir.actions.act_window">
        <field name="name">Digital Certificates</field>
        <field name="res_model">misa.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_misa_certificate_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No digital certificates registered!
            </p>
            <p>
                Click "Sync Certificates from MISA" to retrieve connected HSM/remote eSign certificates.
            </p>
        </field>
    </record>

    <menuitem id="menu_misa_certificate"
              name="Digital Certificates"
              parent="dn_misa_connector_base.menu_misa_root"
              action="action_misa_certificate"
              sequence="25"/>
</odoo>
