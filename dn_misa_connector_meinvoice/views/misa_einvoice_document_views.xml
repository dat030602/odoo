<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_misa_einvoice_document_tree" model="ir.ui.view">
        <field name="name">misa.einvoice.document.list</field>
        <field name="model">misa.einvoice.document</field>
        <field name="arch" type="xml">
            <list string="MISA e-Invoices" decoration-info="state == 'draft'" decoration-warning="state == 'created'" decoration-success="state == 'published'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="inv_no"/>
                <field name="inv_series"/>
                <field name="inv_date"/>
                <field name="buyer_legal_name"/>
                <field name="buyer_tax_code"/>
                <field name="total_amount_without_vat_oc" widget="monetary"/>
                <field name="total_vat_amount_oc" widget="monetary"/>
                <field name="total_amount_oc" widget="monetary"/>
                <field name="sign_type"/>
                <field name="reference_type"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'published'"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_misa_einvoice_document_form" model="ir.ui.view">
        <field name="name">misa.einvoice.document.form</field>
        <field name="model">misa.einvoice.document</field>
        <field name="arch" type="xml">
            <form string="MISA e-Invoice Document">
                <header>
                    <button name="action_publish_hsm" string="Publish e-Invoice (HSM / POS)" type="object" class="btn-primary" invisible="state not in ['draft', 'created'] or sign_type == '1'"/>
                    <button name="action_create_raw_xml" string="Generate Raw XML (Token)" type="object" class="btn-primary" invisible="state != 'draft' or sign_type != '1'"/>
                    <button name="action_publish_signed_xml" string="Publish Signed XML (Token)" type="object" class="btn-success" invisible="state != 'created' or sign_type != '1'"/>
                    <button name="action_get_preview_url" string="Preview e-Invoice (5 min)" type="object" class="btn-secondary"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state in ['draft', 'published']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,created,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Series &amp; Invoice Info">
                            <field name="inv_series"/>
                            <field name="inv_template_no"/>
                            <field name="inv_no" readonly="state == 'published'"/>
                            <field name="inv_date"/>
                            <field name="sign_type"/>
                            <field name="payment_method_name"/>
                        </group>
                        <group string="Origin &amp; Links">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="exchange_rate"/>
                            <field name="move_id" readonly="1"/>
                            <field name="pos_order_id" readonly="1"/>
                            <field name="picking_id" readonly="1"/>
                            <field name="origin_einvoice_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Detail Lines (OriginalInvoiceDetail)">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="line_number" widget="handle"/>
                                    <field name="item_type"/>
                                    <field name="item_code"/>
                                    <field name="item_name"/>
                                    <field name="unit_name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="amount_oc" widget="monetary"/>
                                    <field name="discount_rate"/>
                                    <field name="discount_amount_oc" widget="monetary"/>
                                    <field name="amount_without_vat_oc" widget="monetary"/>
                                    <field name="vat_rate_name"/>
                                    <field name="vat_amount_oc" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="company_currency_id" invisible="1"/>
                                </list>
                            </field>
                            <group col="12" class="oe_invoice_lines_tab">
                                <group colspan="8">
                                    <field name="total_amount_in_words" placeholder="Total in words..."/>
                                </group>
                                <group colspan="4" class="oe_subtotal_footer">
                                    <field name="total_sale_amount_oc" widget="monetary"/>
                                    <field name="total_discount_amount_oc" widget="monetary"/>
                                    <field name="total_amount_without_vat_oc" widget="monetary"/>
                                    <field name="total_vat_amount_oc" widget="monetary"/>
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                        <label for="total_amount_oc"/>
                                    </div>
                                    <field name="total_amount_oc" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                                </group>
                            </group>
                        </page>

                        <page string="Tax Rate Summary (TaxRateInfo)">
                            <field name="tax_line_ids" readonly="1">
                                <list>
                                    <field name="vat_rate_name"/>
                                    <field name="amount_without_vat_oc" widget="monetary"/>
                                    <field name="vat_amount_oc" widget="monetary"/>
                                    <field name="amount_without_vat" widget="monetary"/>
                                    <field name="vat_amount" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="company_currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Buyer Information">
                            <group>
                                <group string="Legal Information">
                                    <field name="buyer_legal_name"/>
                                    <field name="buyer_tax_code"/>
                                    <field name="buyer_budget_code"/>
                                    <field name="buyer_address"/>
                                    <field name="buyer_code"/>
                                </group>
                                <group string="Contact &amp; Bank">
                                    <field name="buyer_full_name"/>
                                    <field name="buyer_phone_number"/>
                                    <field name="buyer_email"/>
                                    <field name="buyer_bank_account"/>
                                    <field name="buyer_bank_name"/>
                                    <field name="buyer_id_number"/>
                                    <field name="buyer_passport"/>
                                </group>
                            </group>
                            <group string="Email Delivery Options">
                                <field name="is_send_email"/>
                                <field name="receiver_name" invisible="not is_send_email"/>
                                <field name="receiver_email" invisible="not is_send_email"/>
                                <field name="is_invoice_summary"/>
                            </group>
                        </page>

                        <page string="Adjustment &amp; Replacement" invisible="reference_type == '0'">
                            <group>
                                <group string="Reference &amp; Reason (Circular 91 / Appx XVII)">
                                    <field name="reference_type"/>
                                    <field name="adjust_replace_reason_code" required="reference_type in ['1', '2']"/>
                                    <field name="invoice_note"/>
                                </group>
                                <group string="Original Document Info">
                                    <field name="org_invoice_type"/>
                                    <field name="org_inv_template_no"/>
                                    <field name="org_inv_series"/>
                                    <field name="org_inv_no"/>
                                    <field name="org_inv_date"/>
                                </group>
                            </group>
                        </page>

                        <page string="Stock Delivery Note (PXK)" invisible="not picking_id and not inv_series.startswith('6')">
                            <group>
                                <group string="Internal Dispatch Order">
                                    <field name="internal_command"/>
                                    <field name="internal_command_no"/>
                                    <field name="internal_command_owner"/>
                                    <field name="internal_command_date"/>
                                    <field name="transporter_name"/>
                                    <field name="transport"/>
                                    <field name="transport_contract_code"/>
                                </group>
                                <group string="Entities">
                                    <field name="stock_out_legal_name"/>
                                    <field name="stock_out_tax_code"/>
                                    <field name="stock_out_address"/>
                                    <field name="stock_out_full_name"/>
                                    <field name="stock_in_legal_name"/>
                                    <field name="stock_in_tax_code"/>
                                    <field name="stock_in_full_name"/>
                                    <field name="stock_in_address"/>
                                    <field name="contract_code"/>
                                    <field name="contract_date"/>
                                    <field name="journal_memo"/>
                                </group>
                            </group>
                        </page>

                        <page string="Hospitality / Utilities">
                            <group>
                                <group string="Hospitality">
                                    <field name="check_in"/>
                                    <field name="check_out"/>
                                    <field name="room_no"/>
                                    <field name="service_fee_rate"/>
                                    <field name="excise_tax_rate"/>
                                </group>
                                <group string="Utilities (Water/Electricity)">
                                    <field name="period_name"/>
                                    <field name="old_index"/>
                                    <field name="new_index"/>
                                    <field name="clock_infos"/>
                                </group>
                            </group>
                        </page>

                        <page string="Technical &amp; XML Payloads">
                            <group>
                                <group string="Identification">
                                    <field name="ref_id" readonly="1"/>
                                    <field name="transaction_id" readonly="1"/>
                                    <field name="view_url" widget="url"/>
                                </group>
                            </group>
                            <group string="USB Token XML (SignType 1)">
                                <field name="raw_xml" widget="ace" options="{'mode': 'xml'}"/>
                                <field name="signed_xml" widget="ace" options="{'mode': 'xml'}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_misa_einvoice_document_search" model="ir.ui.view">
        <field name="name">misa.einvoice.document.search</field>
        <field name="model">misa.einvoice.document</field>
        <field name="arch" type="xml">
            <search string="Search MISA e-Invoices">
                <field name="name"/>
                <field name="inv_no"/>
                <field name="inv_series"/>
                <field name="buyer_legal_name"/>
                <field name="buyer_tax_code"/>
                <field name="transaction_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
                <filter string="Replacement / Adjustment" name="adj_rep" domain="[('reference_type', 'in', ['1', '2'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Invoice Series" name="group_series" context="{'group_by': 'inv_series'}"/>
                    <filter string="Invoice Date" name="group_date" context="{'group_by': 'inv_date:month'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_misa_einvoice_document" model="ir.actions.act_window">
        <field name="name">e-Invoice Documents</field>
        <field name="res_model">misa.einvoice.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_misa_einvoice_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No e-Invoice documents generated yet!
            </p>
            <p>
                Create e-Invoice documents directly or generate them from Customer Invoices, POS Orders, or Delivery Orders.
            </p>
        </field>
    </record>

    <menuitem id="menu_misa_einvoice_document"
              name="e-Invoices &amp; Receipts"
              parent="dn_misa_connector_base.menu_misa_root"
              action="action_misa_einvoice_document"
              sequence="10"/>
</odoo>
