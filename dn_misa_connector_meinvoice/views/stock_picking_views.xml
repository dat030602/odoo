<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_misa" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.misa</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_misa_einvoice_document"
                        string="Create MISA PXK"
                        type="object"
                        class="btn-secondary"
                        invisible="state not in ['assigned', 'done'] or misa_einvoice_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_misa_einvoice_documents"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="misa_einvoice_count == 0">
                    <field name="misa_einvoice_count" widget="statinfo" string="MISA PXK"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="misa_einvoice_id" readonly="1" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
