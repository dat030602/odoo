<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_misa_einvoice_document_line_tree" model="ir.ui.view">
        <field name="name">misa.einvoice.document.line.list</field>
        <field name="model">misa.einvoice.document.line</field>
        <field name="arch" type="xml">
            <list string="Invoice Details">
                <field name="line_number" widget="handle"/>
                <field name="item_type"/>
                <field name="item_code"/>
                <field name="item_name"/>
                <field name="unit_name"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="amount_oc" widget="monetary"/>
                <field name="discount_rate"/>
                <field name="discount_amount_oc" widget="monetary"/>
                <field name="amount_without_vat_oc" widget="monetary"/>
                <field name="vat_rate_name"/>
                <field name="vat_amount_oc" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_misa_einvoice_document_line_form" model="ir.ui.view">
        <field name="name">misa.einvoice.document.line.form</field>
        <field name="model">misa.einvoice.document.line</field>
        <field name="arch" type="xml">
            <form string="Invoice Line Detail">
                <sheet>
                    <group>
                        <group string="Product / Item Information">
                            <field name="document_id" readonly="1"/>
                            <field name="line_number"/>
                            <field name="sort_order"/>
                            <field name="item_type"/>
                            <field name="item_code"/>
                            <field name="item_name"/>
                            <field name="unit_name"/>
                        </group>
                        <group string="Quantity &amp; Pricing">
                            <field name="currency_id" invisible="1"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount_oc" widget="monetary"/>
                            <field name="amount" widget="monetary"/>
                        </group>
                    </group>
                    <group>
                        <group string="Discount">
                            <field name="discount_rate"/>
                            <field name="discount_amount_oc" widget="monetary"/>
                            <field name="discount_amount" widget="monetary"/>
                        </group>
                        <group string="VAT Breakdown">
                            <field name="amount_without_vat_oc" widget="monetary"/>
                            <field name="amount_without_vat" widget="monetary"/>
                            <field name="vat_rate_name"/>
                            <field name="vat_amount_oc" widget="monetary"/>
                            <field name="vat_amount" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Automobile &amp; Transportation Details" invisible="item_type != '5'">
                            <group>
                                <group>
                                    <field name="chassis_number"/>
                                    <field name="engine_number"/>
                                </group>
                                <group>
                                    <field name="license_plate"/>
                                </group>
                            </group>
                        </page>
                        <page string="Lot &amp; Expiry">
                            <group>
                                <group>
                                    <field name="lot_no"/>
                                </group>
                                <group>
                                    <field name="expiry_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
