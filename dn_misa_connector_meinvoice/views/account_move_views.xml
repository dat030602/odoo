<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_misa" model="ir.ui.view">
        <field name="name">account.move.form.inherit.misa</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_misa_einvoice_document"
                        string="Create MISA e-Invoice"
                        type="object"
                        class="btn-secondary"
                        invisible="move_type not in ['out_invoice', 'out_refund'] or state != 'posted' or misa_einvoice_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_misa_einvoice_documents"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="misa_einvoice_count == 0">
                    <field name="misa_einvoice_count" widget="statinfo" string="MISA Invoices"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="misa_einvoice_id" readonly="1" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
