<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_misa_einvoice_preview_wizard_form" model="ir.ui.view">
        <field name="name">misa.einvoice.preview.wizard.form</field>
        <field name="model">misa.einvoice.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Preview e-Invoice">
                <p class="text-muted">
                    This preview link has been generated by MISA meInvoice and is valid for <strong>5 minutes</strong>.
                </p>
                <group>
                    <field name="document_id" readonly="1"/>
                    <field name="preview_url" widget="url" readonly="1"/>
                </group>
                <footer>
                    <button name="action_open_browser" string="Open in New Tab" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
