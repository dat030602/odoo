<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Excel Report Group Categories -->
        <record id="category_excel_report" model="ir.module.category">
            <field name="name">Excel Report Framework</field>
            <field name="description">Manage Excel Report configurations and permissions</field>
        </record>

        <!-- Excel Report Administrator Group -->
        <record id="group_excel_report_admin" model="res.groups">
            <field name="name">Excel Report Administrator</field>
            <field name="category_id" ref="category_excel_report"/>
            <field name="implied_ids" eval="[(4, ref('group_excel_report_user'))]"/>
            <field name="comment">Full access to Excel Report configuration and management</field>
        </record>

        <!-- Excel Report User Group -->
        <record id="group_excel_report_user" model="res.groups">
            <field name="name">Excel Report User</field>
            <field name="category_id" ref="category_excel_report"/>
            <field name="implied_ids" eval="[(4, ref('group_excel_report_reader'))]"/>
            <field name="comment">Can create and manage Excel Reports</field>
        </record>

        <!-- Excel Report Reader Group -->
        <record id="group_excel_report_reader" model="res.groups">
            <field name="name">Excel Report Reader</field>
            <field name="category_id" ref="category_excel_report"/>
            <field name="comment">Read-only access to Excel Reports</field>
        </record>

        <!-- Model ID References -->
        <record id="model_excel_report" model="ir.model">
            <field name="name">excel.report</field>
        </record>
        <record id="model_excel_template" model="ir.model">
            <field name="name">excel.template</field>
        </record>
        <record id="model_excel_cell_format" model="ir.model">
            <field name="name">excel.cell.format</field>
        </record>
        <record id="model_excel_column_config" model="ir.model">
            <field name="name">excel.column.config</field>
        </record>
        <record id="model_excel_layout" model="ir.model">
            <field name="name">excel.layout</field>
        </record>
        <record id="model_excel_layout_cell" model="ir.model">
            <field name="name">excel.layout.cell</field>
        </record>
    </data>
</odoo>