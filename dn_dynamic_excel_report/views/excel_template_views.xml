<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Excel Template Form View -->
    <record id="view_excel_template_form" model="ir.ui.view">
        <field name="name">excel.template.form</field>
        <field name="model">excel.template</field>
        <field name="arch" type="xml">
            <form string="Excel Report Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="report_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Layout Configuration">
                            <group>
                                <group string="Header">
                                    <field name="default_header_layout_id"/>
                                </group>
                                <group string="Footer">
                                    <field name="default_footer_layout_id"/>
                                </group>
                            </group>
                            <group string="Body Layouts">
                                <field name="default_body_layout_ids" nolabel="1" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Column Configuration">
                            <field name="default_column_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="display_name"/>
                                    <field name="field_name"/>
                                    <field name="data_type"/>
                                    <field name="column_width"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Default Settings">
                            <group>
                                <group string="File Settings">
                                    <field name="default_sheet_name"/>
                                    <field name="default_file_pattern"/>
                                </group>
                                <group string="Table Settings">
                                    <field name="default_auto_filter"/>
                                    <field name="default_freeze_panes"/>
                                    <field name="default_header_height"/>
                                    <field name="default_data_height"/>
                                </group>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Excel Template Tree View -->
    <record id="view_excel_template_tree" model="ir.ui.view">
        <field name="name">excel.template.tree</field>
        <field name="model">excel.template</field>
        <field name="arch" type="xml">
            <tree string="Excel Templates">
                <field name="name"/>
                <field name="code"/>
                <field name="report_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Excel Template Search View -->
    <record id="view_excel_template_search" model="ir.ui.view">
        <field name="name">excel.template.search</field>
        <field name="model">excel.template</field>
        <field name="arch" type="xml">
            <search string="Search Excel Templates">
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Excel Template Action -->
    <record id="action_excel_template" model="ir.actions.act_window">
        <field name="name">Excel Report Templates</field>
        <field name="res_model">excel.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Excel Report template
            </p>
            <p>
                Define reusable templates for Excel reports.
            </p>
        </field>
    </record>
</odoo>