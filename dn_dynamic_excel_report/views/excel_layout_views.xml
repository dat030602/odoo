<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Excel Layout Form View -->
    <record id="view_excel_layout_form" model="ir.ui.view">
        <field name="name">excel.layout.form</field>
        <field name="model">excel.layout</field>
        <field name="arch" type="xml">
            <form string="Excel Layout Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Layout Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="layout_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="row_count" readonly="1"/>
                            <field name="default_row_height"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Layout Cells">
                            <field name="cell_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="row"/>
                                    <field name="col"/>
                                    <field name="content_type"/>
                                    <field name="static_text" invisible="content_type != 'static'"/>
                                    <field name="variable_name" invisible="content_type != 'variable'"/>
                                    <field name="merge_rows"/>
                                    <field name="merge_cols"/>
                                    <field name="format_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Background">
                            <group>
                                <group>
                                    <field name="bg_color" widget="color"/>
                                </group>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Excel Layout Tree View -->
    <record id="view_excel_layout_tree" model="ir.ui.view">
        <field name="name">excel.layout.tree</field>
        <field name="model">excel.layout</field>
        <field name="arch" type="xml">
            <tree string="Excel Layouts">
                <field name="name"/>
                <field name="code"/>
                <field name="layout_type"/>
                <field name="row_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Excel Layout Search View -->
    <record id="view_excel_layout_search" model="ir.ui.view">
        <field name="name">excel.layout.search</field>
        <field name="model">excel.layout</field>
        <field name="arch" type="xml">
            <search string="Search Excel Layouts">
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="header" string="Header" domain="[('layout_type', '=', 'header')]"/>
                <filter name="body" string="Body" domain="[('layout_type', '=', 'body')]"/>
                <filter name="footer" string="Footer" domain="[('layout_type', '=', 'footer')]"/>
                <group>
                    <filter name="type_group" string="Layout Type" context="{'group_by': 'layout_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Excel Layout Action -->
    <record id="action_excel_layout" model="ir.actions.act_window">
        <field name="name">Excel Layouts</field>
        <field name="res_model">excel.layout</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Excel layout
            </p>
            <p>
                Define reusable layouts for report sections.
            </p>
        </field>
    </record>
</odoo>