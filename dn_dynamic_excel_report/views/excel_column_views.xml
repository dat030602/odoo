<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Excel Column Config Form View -->
    <record id="view_excel_column_config_form" model="ir.ui.view">
        <field name="name">excel.column.config.form</field>
        <field name="model">excel.column.config</field>
        <field name="arch" type="xml">
            <form string="Excel Column Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="display_name"/>
                            <field name="field_name"/>
                            <field name="data_type"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="column_width"/>
                            <field name="visible"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Formatting">
                            <group>
                                <group string="Cell Formats">
                                    <field name="header_format_id"/>
                                    <field name="cell_format_id"/>
                                    <field name="summary_format_id"/>
                                </group>
                                <group string="Alignment">
                                    <field name="horizontal_align"/>
                                    <field name="vertical_align"/>
                                </group>
                            </group>
                            <group>
                                <group string="Number Format">
                                    <field name="number_format"/>
                                </group>
                            </group>
                        </page>
                        <page string="Header Merge">
                            <group>
                                <group>
                                    <field name="merge_with_column_id"/>
                                    <field name="merge_header_text"/>
                                </group>
                            </group>
                        </page>
                        <page string="Summary">
                            <group>
                                <group>
                                    <field name="summary_type"/>
                                    <field name="summary_label"/>
                                    <field name="show_summary_label"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Excel Column Config Tree View -->
    <record id="view_excel_column_config_tree" model="ir.ui.view">
        <field name="name">excel.column.config.tree</field>
        <field name="model">excel.column.config</field>
        <field name="arch" type="xml">
            <tree string="Excel Column Configurations">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="display_name"/>
                <field name="field_name"/>
                <field name="data_type"/>
                <field name="column_width"/>
                <field name="summary_type"/>
                <field name="visible"/>
            </tree>
        </field>
    </record>
</odoo>