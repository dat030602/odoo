<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ExcelReportTemplate" xml:space="preserve">
        <div class="o_excel_report_widget">
            <div class="row">
                <div class="col-md-12">
                    <label class="col-form-label"><t>Excel Report</t></label>
                    <select class="form-select o_excel_report_select">
                        <option value="">Select a report</option>
                    </select>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-6">
                    <button type="button" class="btn btn-primary o_excel_report_download" disabled>
                        <i class="fa fa-download"/> Download
                    </button>
                </div>
                <div class="col-md-6">
                    <button type="button" class="btn btn-secondary o_excel_report_preview" disabled>
                        <i class="fa fa-eye"/> Preview
                    </button>
                </div>
            </div>
        </div>
    </template>

    <template id="ExcelReportDialogTemplate" xml:space="preserve">
        <div class="o_excel_report_dialog">
            <div class="o_excel_report_widget_container"></div>
        </div>
    </template>

    <template id="error_template" xml:space="preserve">
        <div class="o_excel_report_error">
            <div class="alert alert-danger">
                <strong>Error:</strong> <t t-esc="error"/>
            </div>
            <p>Report: <t t-esc="report_name"/></p>
        </div>
    </template>
</odoo>