<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo Cell Formats -->
        <record id="format_header_bold" model="excel.cell.format">
            <field name="name">Header Bold</field>
            <field name="code">header_bold</field>
            <field name="font_bold">True</field>
            <field name="font_size">12</field>
            <field name="horizontal_align">center</field>
            <field name="bg_color">#D3D3D3</field>
            <field name="border_bottom">thin</field>
            <field name="border_top">thin</field>
            <field name="border_left">thin</field>
            <field name="border_right">thin</field>
        </record>

        <record id="format_title" model="excel.cell.format">
            <field name="name">Title</field>
            <field name="code">title</field>
            <field name="font_bold">True</field>
            <field name="font_size">16</field>
            <field name="horizontal_align">center</field>
            <field name="bg_color">#4472C4</field>
            <field name="font_color">#FFFFFF</field>
        </record>

        <record id="format_currency" model="excel.cell.format">
            <field name="name">Currency</field>
            <field name="code">currency</field>
            <field name="num_format_category">currency</field>
            <field name="horizontal_align">right</field>
        </record>

        <record id="format_date" model="excel.cell.format">
            <field name="name">Date</field>
            <field name="code">date</field>
            <field name="num_format_category">short_date</field>
            <field name="horizontal_align">center</field>
        </record>

        <record id="format_summary" model="excel.cell.format">
            <field name="name">Summary</field>
            <field name="code">summary</field>
            <field name="font_bold">True</field>
            <field name="bg_color">#FFF2CC</field>
            <field name="border_top">thin</field>
            <field name="num_format_category">currency</field>
            <field name="horizontal_align">right</field>
        </record>

        <record id="format_normal" model="excel.cell.format">
            <field name="name">Normal</field>
            <field name="code">normal</field>
            <field name="font_size">11</field>
            <field name="horizontal_align">left</field>
        </record>

        <!-- Demo Layouts -->
        <record id="layout_header_standard" model="excel.layout">
            <field name="name">Standard Header</field>
            <field name="code">header_standard</field>
            <field name="layout_type">header</field>
            <field name="default_row_height">25</field>
        </record>

        <!-- Header Cells -->
        <record id="layout_header_standard_cell_1" model="excel.layout.cell">
            <field name="layout_id" ref="layout_header_standard"/>
            <field name="row">0</field>
            <field name="col">0</field>
            <field name="content_type">variable</field>
            <field name="variable_name">company_name</field>
            <field name="format_id" ref="format_title"/>
            <field name="merge_cols">3</field>
        </record>

        <record id="layout_header_standard_cell_2" model="excel.layout.cell">
            <field name="layout_id" ref="layout_header_standard"/>
            <field name="row">1</field>
            <field name="col">0</field>
            <field name="content_type">static</field>
            <field name="static_text">Report Date:</field>
            <field name="format_id" ref="format_normal"/>
        </record>

        <record id="layout_header_standard_cell_3" model="excel.layout.cell">
            <field name="layout_id" ref="layout_header_standard"/>
            <field name="row">1</field>
            <field name="col">1</field>
            <field name="content_type">variable</field>
            <field name="variable_name">current_date</field>
            <field name="format_id" ref="format_date"/>
        </record>

        <record id="layout_header_standard_cell_4" model="excel.layout.cell">
            <field name="layout_id" ref="layout_header_standard"/>
            <field name="row">1</field>
            <field name="col">2</field>
            <field name="content_type">static</field>
            <field name="static_text">Printed By:</field>
            <field name="format_id" ref="format_normal"/>
        </record>

        <record id="layout_header_standard_cell_5" model="excel.layout.cell">
            <field name="layout_id" ref="layout_header_standard"/>
            <field name="row">1</field>
            <field name="col">3</field>
            <field name="content_type">variable</field>
            <field name="variable_name">user_name</field>
            <field name="format_id" ref="format_normal"/>
        </record>

        <record id="layout_footer_standard" model="excel.layout">
            <field name="name">Standard Footer</field>
            <field name="code">footer_standard</field>
            <field name="layout_type">footer</field>
            <field name="default_row_height">20</field>
        </record>

        <!-- Footer Cells -->
        <record id="layout_footer_standard_cell_1" model="excel.layout.cell">
            <field name="layout_id" ref="layout_footer_standard"/>
            <field name="row">0</field>
            <field name="col">0</field>
            <field name="content_type">static</field>
            <field name="static_text">Generated by Dynamic Excel Report Framework</field>
            <field name="format_id" ref="format_normal"/>
            <field name="merge_cols">4</field>
        </record>

        <record id="layout_footer_standard_cell_2" model="excel.layout.cell">
            <field name="layout_id" ref="layout_footer_standard"/>
            <field name="row">1</field>
            <field name="col">0</field>
            <field name="content_type">variable</field>
            <field name="variable_name">timestamp</field>
            <field name="format_id" ref="format_normal"/>
            <field name="merge_cols">4</field>
        </record>

        <!-- Demo Template -->
        <record id="template_standard" model="excel.template">
            <field name="name">Standard Report Template</field>
            <field name="code">template_standard</field>
            <field name="description">Standard template with header and footer</field>
            <field name="default_header_layout_id" ref="layout_header_standard"/>
            <field name="default_footer_layout_id" ref="layout_footer_standard"/>
            <field name="default_sheet_name">Report</field>
            <field name="default_file_pattern">report_{date}_{company}</field>
            <field name="default_auto_filter">True</field>
            <field name="default_freeze_panes">True</field>
            <field name="default_header_height">25</field>
            <field name="default_data_height">20</field>
        </record>

        <!-- Demo Report Configuration for Partners -->
        <record id="demo_report_partner" model="excel.report">
            <field name="name">Partner List Report</field>
            <field name="code">partner_list</field>
            <field name="description">Demo report for partner list</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="provider">excel.report.demo.partner</field>
            <field name="template_id" ref="template_standard"/>
            <field name="sheet_name">Partners</field>
            <field name="report_file_pattern">partners_{date}</field>
            <field name="header_layout_id" ref="layout_header_standard"/>
            <field name="footer_layout_id" ref="layout_footer_standard"/>
            <field name="auto_filter">True</field>
            <field name="freeze_panes">True</field>
            <field name="header_row_height">25</field>
            <field name="data_row_height">20</field>
            <field name="state">published</field>
            <field name="active">True</field>
        </record>

        <!-- Demo Column Configurations for Partner Report -->
        <record id="demo_report_partner_col_1" model="excel.column.config">
            <field name="name">name</field>
            <field name="display_name">Name</field>
            <field name="field_name">name</field>
            <field name="report_id" ref="demo_report_partner"/>
            <field name="sequence">1</field>
            <field name="column_width">30</field>
            <field name="data_type">string</field>
            <field name="horizontal_align">left</field>
            <field name="header_format_id" ref="format_header_bold"/>
            <field name="cell_format_id" ref="format_normal"/>
            <field name="visible">True</field>
            <field name="summary_type">none</field>
        </record>

        <record id="demo_report_partner_col_2" model="excel.column.config">
            <field name="name">email</field>
            <field name="display_name">Email</field>
            <field name="field_name">email</field>
            <field name="report_id" ref="demo_report_partner"/>
            <field name="sequence">2</field>
            <field name="column_width">25</field>
            <field name="data_type">string</field>
            <field name="horizontal_align">left</field>
            <field name="header_format_id" ref="format_header_bold"/>
            <field name="cell_format_id" ref="format_normal"/>
            <field name="visible">True</field>
            <field name="summary_type">none</field>
        </record>

        <record id="demo_report_partner_col_3" model="excel.column.config">
            <field name="name">phone</field>
            <field name="display_name">Phone</field>
            <field name="field_name">phone</field>
            <field name="report_id" ref="demo_report_partner"/>
            <field name="sequence">3</field>
            <field name="column_width">15</field>
            <field name="data_type">string</field>
            <field name="horizontal_align">left</field>
            <field name="header_format_id" ref="format_header_bold"/>
            <field name="cell_format_id" ref="format_normal"/>
            <field name="visible">True</field>
            <field name="summary_type">none</field>
        </record>

        <record id="demo_report_partner_col_4" model="excel.column.config">
            <field name="name">city</field>
            <field name="display_name">City</field>
            <field name="field_name">city</field>
            <field name="report_id" ref="demo_report_partner"/>
            <field name="sequence">4</field>
            <field name="column_width">20</field>
            <field name="data_type">string</field>
            <field name="horizontal_align">left</field>
            <field name="header_format_id" ref="format_header_bold"/>
            <field name="cell_format_id" ref="format_normal"/>
            <field name="visible">True</field>
            <field name="summary_type">none</field>
        </record>

        <record id="demo_report_partner_col_5" model="excel.column.config">
            <field name="name">country</field>
            <field name="display_name">Country</field>
            <field name="field_name">country</field>
            <field name="report_id" ref="demo_report_partner"/>
            <field name="sequence">5</field>
            <field name="column_width">15</field>
            <field name="data_type">string</field>
            <field name="horizontal_align">left</field>
            <field name="header_format_id" ref="format_header_bold"/>
            <field name="cell_format_id" ref="format_normal"/>
            <field name="visible">True</field>
            <field name="summary_type">none</field>
        </record>

    </data>
</odoo>