<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_excel_report_form" model="ir.ui.view">
        <field name="name">sale.excel.report.form</field>
        <field name="model">sale.excel.report</field>
        <!-- Inherit base view, inject filter fields only -->
        <field name="inherit_id" ref="dn_excel_report_base.view_base_excel_report_form"/>
        <field name="arch" type="xml">
            <group name="filter_area" position="inside">
                <field name="date_from"/>
                <field name="date_to"/>
            </group>
        </field>
    </record>

    <record id="action_sale_excel_report" model="ir.actions.act_window">
        <field name="name">Sale Order Excel Report</field>
        <field name="res_model">sale.excel.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="sale_view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.excel.report</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_sale_excel_report)d" type="action" string="Export Excel" class="btn-primary"/>
            </xpath>
        </field>
    </record>

</odoo>
