<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_stock_order_line_ccv" model="ir.ui.view">
        <field name="name">report.stock.order.line.ccv.form</field>
        <field name="model">report.stock.order.line.ccv</field>
        <field name="arch" type="xml">
            <tree edit="1" create="0" delete="0" editable="bottom">
                <field name="product_id"/>
                <field name="product_uom_id"/>
                <field name="quantity" sum="total_quantity"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="team_id" optional="hide"/>
                <field name="team_name"/>
                <field name="date_proc"/>
                <field name="picking_type_id" optional="hide"/>
                <field name="factory_name"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="view_report_stock_order_line_ccv_search" model="ir.ui.view">
        <field name="name">report.stock.order.line.ccv.search</field>
        <field name="model">report.stock.order.line.ccv</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="team_name"/>
                <field name="date_proc"/>
                <field name="factory_name"/>
                <field name="note"/>
                <group expand="1" string="Group By">
                    <filter name="group_team" string="Đội bán hàng" context="{'group_by': 'team_id'}"/>
                    <filter name="group_product" string="Sản phẩm" context="{'group_by': 'product_id'}"/>
                    <filter name="group_date" string="Ngày xử lý" context="{'group_by': 'date_proc'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_report_stock_order_line_ccv_action" model="ir.actions.act_window">
        <field name="name">Báo cáo hàng tồn kho khu vực</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">report.stock.order.line.ccv</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
