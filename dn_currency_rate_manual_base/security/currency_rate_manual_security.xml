<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_currency_rate_manual" model="ir.module.category">
        <field name="name">Manual Currency Rate</field>
        <field name="description">Permissions for manual currency rate settings</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_currency_rate_manual" model="res.groups.privilege">
        <field name="name">Manual Rate</field>
        <field name="category_id" ref="module_category_currency_rate_manual"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_manual_currency_rate" model="res.groups">
        <field name="name">Can set manual currency rate</field>
        <field name="privilege_id" ref="privilege_currency_rate_manual"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
