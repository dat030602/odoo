<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_excel_report" model="ir.module.category">
        <field name="name">Excel Template Report</field>
        <field name="description">Manage and generate Excel template reports</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_excel_report" model="res.groups.privilege">
        <field name="name">Excel Template Report</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_excel_report"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_excel_report"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="excel_report_template_comp_rule" model="ir.rule">
        <field name="name">Excel Report Template Multi-Company</field>
        <field name="model_id" ref="model_excel_report_template"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
