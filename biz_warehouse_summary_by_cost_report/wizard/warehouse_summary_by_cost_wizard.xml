<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="warehouse_summary_by_cost_wizard_form" model="ir.ui.view">
            <field name="name">Summary of import and export of warehouse by cost collection object</field>
            <field name="model">warehouse.summary.by.cost.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Print" name="%(biz_warehouse_summary_by_cost_report.action_warehouse_summary_by_cost)d" type="action" default_focus="1" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_warehouse_summary_by_cost_wizard" model="ir.actions.act_window">
            <field name="name">Summary of import and export of warehouse by cost collection object</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">warehouse.summary.by.cost.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem action="action_warehouse_summary_by_cost_wizard" id="menu_warehouse_summary_by_cost" parent="account.account_reports_legal_statements_menu" sequence="1"/>
    </data>
</odoo>