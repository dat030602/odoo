#. module: dn_hr_vietnam_id
#: code:addons/dn_hr_vietnam_id/models/hr_employee.py:0
#, python-format
msgid "The ID Card Number '%(number)s' is duplicated within the submitted records (employees '%(name1)s' and '%(name2)s')."
msgstr "Số CMND/CCCD '%(number)s' bị trùng lặp trong danh sách gửi lên (nhân viên '%(name1)s' và '%(name2)s')."

#. module: dn_hr_vietnam_id
#: code:addons/dn_hr_vietnam_id/models/hr_employee.py:0
#, python-format
msgid "The ID Card Number '%(number)s' is already registered for active employee '%(name)s'."
msgstr "Số CMND/CCCD '%(number)s' đã được đăng ký cho nhân viên đang hoạt động '%(name)s'."

#. module: dn_hr_vietnam_id
#: code:addons/dn_hr_vietnam_id/models/hr_employee.py:0
#, python-format
msgid "The ID card issue date cannot be in the future."
msgstr "Ngày cấp CMND/CCCD không thể lớn hơn ngày hiện tại."

#. module: dn_hr_vietnam_id
#: code:addons/dn_hr_vietnam_id/models/hr_employee.py:0
#, python-format
msgid "The ID card expiry date must be strictly after the issue date."
msgstr "Ngày hết hạn CMND/CCCD phải sau ngày cấp."

#. module: dn_hr_vietnam_id
#: code:addons/dn_hr_vietnam_id/models/hr_employee.py:0
#, python-format
msgid "The ID card issue date cannot be earlier than the date of birth."
msgstr "Ngày cấp CMND/CCCD không thể trước ngày sinh."
