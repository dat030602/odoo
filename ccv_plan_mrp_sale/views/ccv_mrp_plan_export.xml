<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ccv_mrp_plan_export_form" model="ir.ui.view">
        <field name="name">ccv.mrp.plan.export.form</field>
        <field name="model">ccv.mrp.plan.export</field>
        <field name="arch" type="xml">
            <form>
            <header>
                <field name="can_create_mo" invisible="1"/>
                <button name="action_create_mrp_order" string="Tạo lệnh sản xuất" type="object" class="btn-primary" attrs="{'invisible': [('can_create_mo','=',False)]}"/>
                <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary" attrs="{'invisible': [('state','!=','draft')]}"/>
                <button name="action_lock" string="Khóa" type="object" class="btn-primary" attrs="{'invisible': [('state','!=','confirm')]}"/>
                <button name="action_reset_qty" string="Cập nhật tồn kho" attrs="{'invisible':[('state','!=','confirm')]}" type="object"/>
                <button name="action_reset_description" string="Cập nhật diễn giải" attrs="{'invisible':[('state','!=','confirm')]}" type="object"/>
                <button name="action_change_state_confirm" string="Trở lại xác nhận" attrs="{'invisible':[('state','!=','locked')]}" type="object"/>
                <button name="action_change_state_draft" string="Trở lại bản nháp" attrs="{'invisible':[('state','=','draft')]}" type="object"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_summary" type="object" icon="fa-globe icon" attrs="{'invisible':[('plan_sale_count','=',0)]}">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text"><field name="plan_sale_count"/></span>
                            <span class="o_stat_text">KH Xuất hàng</span>
                        </div>
                    </button>
                    <button name="action_view_mo" type="object" icon="fa-wrench" attrs="{'invisible':[('plan_mo_count','=',0)]}">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text"><field name="plan_mo_count"/></span>
                            <span class="o_stat_text">Sản xuất</span>
                        </div>
                    </button>
                    <button name="action_view_tree" type="object" icon="fa-list-alt icon">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Kế hoạch</span>
                        </div>
                    </button>
                </div>
                <div class="oe_title">
                    <label for="name" string="Tên"/>
                    <h1>
                        <div class="d-flex">
                            <field class="text-break" name="name" placeholder="e.g. Đặt tên Kế hoạch" attrs="{'readonly': [('state','in',('confirm','locked'))]}"/>
                        </div>
                    </h1>
                </div>
                <group>
                    <field name="location_id" invisible="1" attrs="{'readonly': [('state','in',('locked'))]}"/>
                    <field name="location_ids" required="1" widget="many2many_tags" attrs="{'readonly': [('state','in',('locked'))]}"/>
                    <field name="date" required="1" attrs="{'readonly': [('state','in',('confirm','locked'))]}"/>
                </group>
                <notebook>
                    <page string="Kế hoạch" name="line_ids" attrs="{'invisible': [('state','=','draft')]}">
                        <field name="line_ids" attrs="{'readonly': [('state','=','locked')]}">
                            <tree create="1" edit="1" editable="bottom" multi_edit="1">
                                <field name="product_id" optional="show" decoration-danger="is_highlight == True"/>
                                <field name="qty_delivery" optional="show" digits="[16,3]" sum="total_qty_delivery" decoration-danger="is_highlight == True"/>
                                <field name="qty_available" optional="show" digits="[16,3]" sum="total_qty_available" decoration-danger="is_highlight == True"/>
                                <field name="qty_mrp" optional="show" digits="[16,3]" sum="total_qty_mrp" decoration-danger="is_highlight == True"/>
                                <field name="picking_type_id" optional="show" decoration-danger="is_highlight == True"/>
                                <field name="bom_id" optional="show" decoration-danger="is_highlight == True"/>
                                <field name="description" optional="show" widget="text" decoration-danger="is_highlight == True"/>
                                <field name="is_highlight" invisible="1" />
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
            </form>
        </field>
    </record>
    <record id="ccv_mrp_plan_export_tree" model="ir.ui.view">
        <field name="name">ccv.mrp.plan.export.tree.inherit</field>
        <field name="model">ccv.mrp.plan.export</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
</odoo>
