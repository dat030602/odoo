<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="ccv_sale_plan_export_line_view_tree">
        <field name="name">tree_ccv_sale_plan_export_line</field>
        <field name="model">ccv.sale.plan.export.line</field>
        <field name="arch" type="xml">
            <tree create="1" edit="1" editable="bottom">
                <field name="date" optional="show" attrs="{'readonly': [('parent_state','in',('locked'))]}"/>
                <field name="order_id" optional="show" attrs="{'readonly': [('parent_state','in',('locked'))]}" domain="[('team_id','=', team_id),('state','not in', ('cancel','done')),('delivery_status','!=', 'full'),('sale_sign_requests_state','in', ('draft','approve','approved'))]"/>
                <field name="partner_id" optional="show" attrs="{'readonly': [('parent_state','in',('locked'))]}" options="{'no_open': True, 'no_create': True}"/>
                <field name="product_id" optional="show" attrs="{'readonly': [('parent_state','in',('locked'))]}"/>
                <field name="name" optional="hide" readonly="1"/>
                <field name="product_uom_id" optional="show" readonly="1"/>
                <field name="product_uom_qty" optional="show" attrs="{'readonly': [('parent_state','in',('locked'))]}" digits="[16,3]" sum="total_product_uom_qty"/>
                <field name="qty_delivered" optional="show" readonly="1" digits="[16,3]" sum="total_qty_delivered"/>
                <field name="qty_delivery" optional="show" attrs="{'readonly': [('parent_state','in',('locked'))]}" digits="[16,3]" sum="total_qty_delivery"/>
                <field name="qty_out" optional="hide" attrs="{'readonly': [('parent_state','in',('locked'))]}" digits="[16,3]" sum="total_qty_out"/>
                <field name="qty_cur_delivered" optional="show" readonly="1" digits="[16,3]" sum="total_qty_cur_delivered"/>
                <field name="note" optional="show" attrs="{'readonly': [('parent_state','in',('locked'))]}"/>
                <!-- <field name="delivery_date" optional="show"/> -->
                <field name="secondary_label_id" optional="show" invisible="1"/>
                <field name="team_id" optional="show" readonly="1"/>
                <button name="action_push_qty_out" type="object" string="Đẩy rớt" class="btn-primary"
                        attrs="{'invisible': ['|', ('qty_out', '&lt;=', 0),'|', ('is_push_out', '=', True),('parent_state','in',('locked'))]}"/>
                <field name="is_push_out" invisible="1"/>
                <field name="parent_state" invisible="1"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="ccv_sale_plan_export_line_view_form">
        <field name="name">form_ccv_sale_plan_export_line</field>
        <field name="model">ccv.sale.plan.export.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_push_qty_out" type="object" string="Đẩy rớt" class="btn-primary"
                            attrs="{'invisible': ['|', ('qty_out', '&lt;=', 0), '|', ('is_push_out', '=', True),('parent_state','in',('locked'))]}"/>
                    <field name="parent_state" widget="statusbar" statusbar_visible="draft,locked"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="is_push_out" invisible="1"/>
                            <field name="date"/>
                            <field name="team_id"/>
                            <field name="order_id"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <label for="product_uom_qty"/>
                            <div class="o_row">
                                <field name="product_uom_qty"/>
                                <field name="product_uom_id" options="{'no_open': True, 'no_create': True}" groups="uom.group_uom"/>
                            </div>
                            <label for="qty_delivered"/>
                            <div class="o_row">
                                <field name="qty_delivered" digits="[16,3]"/>
                                <field name="product_uom_id" options="{'no_open': True, 'no_create': True}" groups="uom.group_uom"/>
                            </div>
                            <label for="qty_delivery"/>
                            <div class="o_row">
                                <field name="qty_delivery" digits="[16,3]"/>
                                <field name="product_uom_id" options="{'no_open': True, 'no_create': True}" groups="uom.group_uom"/>
                            </div>
                            <label for="qty_out"/>
                            <div class="o_row">
                                <field name="qty_out" digits="[16,3]"/>
                                <field name="product_uom_id" options="{'no_open': True, 'no_create': True}" groups="uom.group_uom"/>
                            </div>
                            <label for="qty_cur_delivered"/>
                            <div class="o_row">
                                <field name="qty_cur_delivered" digits="[16,3]"/>
                                <field name="product_uom_id" options="{'no_open': True, 'no_create': True}" groups="uom.group_uom"/>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ccv_sale_plan_export_line_search" model="ir.ui.view">
        <field name="name">ccv.sale.plan.export.line.tree</field>
        <field name="model">ccv.sale.plan.export.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" optional="show" readonly="1"/>
                <field name="order_id" optional="show" readonly="1"/>
                <field name="partner_id" optional="show" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                <field name="date" optional="show" readonly="1"/>
                <field name="name" optional="hide" readonly="1"/>
                <field name="product_uom_id" optional="show" readonly="1"/>
                <field name="note" optional="show"/>
                <field name="team_id" optional="show" readonly="1"/>
            </search>
        </field>
    </record>

    <record id="action_ccv_sale_plan_export_line_view_tree" model="ir.actions.act_window">
        <field name="name">Kế hoạch xuất hàng</field>
        <field name="res_model">ccv.sale.plan.export.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="ccv_sale_plan_export_line_view_tree"/>
        <field name="search_view_id" ref="ccv_sale_plan_export_line_search"/>
    </record>
</odoo>
