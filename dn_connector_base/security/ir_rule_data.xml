<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_connector_framework_company" model="ir.rule">
        <field name="name">Connector Framework Multi-Company</field>
        <field name="model_id" ref="model_connector_framework"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_connector_inbound_endpoint_company" model="ir.rule">
        <field name="name">Connector Inbound Endpoint Multi-Company</field>
        <field name="model_id" ref="model_connector_inbound_endpoint"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_connector_inbound_message_company" model="ir.rule">
        <field name="name">Connector Inbound Message Multi-Company</field>
        <field name="model_id" ref="model_connector_inbound_message"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
