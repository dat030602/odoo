<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron job for scheduled sync of all active connector endpoints -->
    <record id="ir_cron_connector_sync" model="ir.cron">
        <field name="name">Connector: Scheduled Sync</field>
        <field name="model_id" ref="model_connector_endpoint"/>
        <field name="state">code</field>
        <field name="code">model.browse()._cron_sync_all_endpoints()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
