<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cron job for scheduled sync of all active connector endpoints (Outbound) -->
    <record id="ir_cron_connector_sync" model="ir.cron">
        <field name="name">Connector: Outbound Scheduled Sync</field>
        <field name="model_id" ref="model_connector_outbound_endpoint"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_all_endpoints()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Inbound Gateway: Batch Message Processor -->
    <record id="ir_cron_inbound_process" model="ir.cron">
        <field name="name">Connector Inbound: Batch Processor</field>
        <field name="model_id" ref="model_connector_inbound_message"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Inbound Gateway: Retention Cleanup -->
    <record id="ir_cron_inbound_retention" model="ir.cron">
        <field name="name">Connector Inbound: Retention Purge</field>
        <field name="model_id" ref="model_connector_inbound_message"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_retention()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
