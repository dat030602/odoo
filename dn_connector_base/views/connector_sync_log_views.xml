<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Connector Sync Log Views -->
    <record id="view_connector_sync_log_list" model="ir.ui.view">
        <field name="name">connector.sync.log.list</field>
        <field name="model">connector.sync.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="endpoint_id"/>
                <field name="state"/>
                <field name="records_fetched"/>
                <field name="records_imported"/>
            </list>
        </field>
    </record>

    <record id="view_connector_sync_log_form" model="ir.ui.view">
        <field name="name">connector.sync.log.form</field>
        <field name="model">connector.sync.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="endpoint_id"/>
                        <field name="state"/>
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="records_fetched"/>
                        <field name="records_imported"/>
                    </group>
                    <separator string="Error Details"/>
                    <field name="error_message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_connector_sync_log_search" model="ir.ui.view">
        <field name="name">connector.sync.log.search</field>
        <field name="model">connector.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="endpoint_id"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <act_window id="action_connector_sync_log"
        name="Sync Logs"
        res_model="connector.sync.log"
        view_mode="list,form"
        context="{'search_default_group_by': 'create_date'}"/>
