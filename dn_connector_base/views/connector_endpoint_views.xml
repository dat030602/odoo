<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Connector Outbound Endpoint Views -->
    <record id="view_connector_outbound_endpoint_form" model="ir.ui.view">
        <field name="name">connector.outbound.endpoint.form</field>
        <field name="model">connector.outbound.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="button_sync" type="object" string="Sync Now"
                            class="oe_highlight" invisible="use_custom_prepare_request == True"/>
                        <button name="button_execute_from_record" type="object" string="Execute from Record"
                            class="oe_highlight" invisible="use_custom_prepare_request == False"/>
                    </div>
                    <group>
                        <field name="connector_id"/>
                        <field name="name"/>
                        <field name="method"/>
                        <field name="path"/>
                        <field name="target_json_path"/>
                        <field name="root_model_id"/>
                    </group>
                    <separator string="Pagination"/>
                    <group>
                        <field name="pagination_type"/>
                        <field name="pagination_param_page"/>
                        <field name="pagination_param_limit"/>
                        <field name="pagination_page_size"/>
                        <field name="pagination_next_path"/>
                    </group>
                    <separator string="Custom Request Preparation"/>
                    <group>
                        <field name="use_custom_prepare_request"/>
                        <field name="code" invisible="use_custom_prepare_request == False"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_connector_outbound_endpoint_list" model="ir.ui.view">
        <field name="name">connector.outbound.endpoint.list</field>
        <field name="model">connector.outbound.endpoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="method"/>
                <field name="path"/>
                <field name="pagination_type"/>
                <field name="use_custom_prepare_request"/>
            </list>
        </field>
    </record>

    <record id="view_connector_outbound_endpoint_search" model="ir.ui.view">
        <field name="name">connector.outbound.endpoint.search</field>
        <field name="model">connector.outbound.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="connector_id"/>
                <field name="pagination_type"/>
            </search>
        </field>
    </record>

    <record id="action_connector_outbound_endpoint" model="ir.actions.act_window">
        <field name="name">Connector Outbound Endpoints</field>
        <field name="res_model">connector.outbound.endpoint</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('connector_id.active', '=', True)]</field>
    </record>
</odoo>
