<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connector_inbound_endpoint_form" model="ir.ui.view">
        <field name="name">connector.inbound.endpoint.form</field>
        <field name="model">connector.inbound.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,paused"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_messages"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-inbox">
                            <field name="message_count" widget="statinfo" string="Messages"/>
                        </button>
                        <button name="action_view_dead_letters"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exclamation-triangle">
                            <field name="dead_letter_count" widget="statinfo" string="Dead Letters"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Endpoint Name"/>
                        <h1><field name="name" placeholder="e.g. Shopify Orders Webhook"/></h1>
                    </div>
                    <group>
                        <group string="Gateway Routing">
                            <field name="framework_id"/>
                            <field name="token"/>
                            <field name="endpoint_url" widget="CopyClipboardChar"/>
                            <field name="allowed_methods"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Security &amp; Network">
                            <field name="auth_override"/>
                            <field name="secret" password="True" invisible="auth_override == 'none'"/>
                            <field name="ip_allowlist" placeholder="e.g. 192.168.1.0/24, 10.0.0.1"/>
                            <field name="max_backlog"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Handler Configuration" name="handler_config">
                            <group>
                                <group>
                                    <field name="handler_type"/>
                                    <field name="target_model_id" invisible="handler_type not in ('raw_model', 'server_action')"/>
                                    <field name="server_action_id" invisible="handler_type != 'server_action'"/>
                                    <field name="pack_handler_id" invisible="handler_type != 'pack'"/>
                                </group>
                                <group>
                                    <field name="execution_mode"/>
                                    <field name="response_mode"/>
                                    <field name="priority"/>
                                    <field name="fallback_status"/>
                                    <field name="sync_timeout_s" invisible="execution_mode == 'deferred'"/>
                                </group>
                            </group>
                            <group string="Sequential Ordering">
                                <field name="ordering_key"/>
                                <field name="ordering_json_path" invisible="ordering_key != 'entity_id'"/>
                            </group>
                            <group string="Python Handler Code" invisible="handler_type != 'python'">
                                <field name="code" widget="ace" options="{'mode': 'python'}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_connector_inbound_endpoint_list" model="ir.ui.view">
        <field name="name">connector.inbound.endpoint.list</field>
        <field name="model">connector.inbound.endpoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="framework_id"/>
                <field name="allowed_methods"/>
                <field name="handler_type"/>
                <field name="execution_mode"/>
                <field name="message_count"/>
                <field name="dead_letter_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'paused'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_connector_inbound_endpoint_search" model="ir.ui.view">
        <field name="name">connector.inbound.endpoint.search</field>
        <field name="model">connector.inbound.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="framework_id"/>
                <field name="token"/>
                <filter string="Active" name="active_filter" domain="[('state', '=', 'active')]"/>
                <filter string="Paused" name="paused_filter" domain="[('state', '=', 'paused')]"/>
                <separator/>
                <filter string="Framework" name="group_framework" context="{'group_by': 'framework_id'}"/>
                <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_connector_inbound_endpoint" model="ir.actions.act_window">
        <field name="name">Endpoints</field>
        <field name="res_model">connector.inbound.endpoint</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_filter': 1}</field>
    </record>
</odoo>
