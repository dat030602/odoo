<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connector_inbound_message_form" model="ir.ui.view">
        <field name="name">connector.inbound.message.form</field>
        <field name="model">connector.inbound.message</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="process_message" type="object" string="Process Now"
                            class="oe_highlight" invisible="state in ('done', 'processing')"/>
                    <field name="state" widget="statusbar" statusbar_visible="received,queued,processing,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="uuid" string="Message Tracking UUID"/>
                        <h2><field name="uuid" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Routing &amp; Delivery">
                            <field name="endpoint_id"/>
                            <field name="received_at" readonly="1"/>
                            <field name="remote_ip" readonly="1"/>
                            <field name="method" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                            <field name="idempotency_key" readonly="1"/>
                            <field name="ordering_key" readonly="1"/>
                            <field name="signature_ok" readonly="1"/>
                        </group>
                        <group string="Execution &amp; Retries">
                            <field name="priority"/>
                            <field name="attempts" readonly="1"/>
                            <field name="max_attempts"/>
                            <field name="next_retry_at" readonly="1" invisible="not next_retry_at"/>
                            <field name="duration_ms" readonly="1"/>
                            <field name="response_status" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload" name="payload_tab">
                            <field name="payload"/>
                        </page>
                        <page string="Headers" name="headers_tab">
                            <field name="headers"/>
                        </page>
                        <page string="Raw Body" name="raw_body_tab">
                            <field name="body_raw" readonly="1"/>
                        </page>
                        <page string="Response" name="response_tab">
                            <field name="response_body" readonly="1"/>
                        </page>
                        <page string="Diagnostic Traceback" name="error_tab" invisible="not error_details">
                            <group>
                                <field name="error_type" readonly="1"/>
                            </group>
                            <field name="error_details" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_connector_inbound_message_list" model="ir.ui.view">
        <field name="name">connector.inbound.message.list</field>
        <field name="model">connector.inbound.message</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="received_at"/>
                <field name="uuid"/>
                <field name="endpoint_id"/>
                <field name="event_type"/>
                <field name="idempotency_key"/>
                <field name="attempts"/>
                <field name="duration_ms"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('received', 'queued')"
                       decoration-warning="state in ('processing', 'failed')"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'dead'"
                       decoration-muted="state == 'skipped'"/>
            </list>
        </field>
    </record>

    <record id="view_connector_inbound_message_search" model="ir.ui.view">
        <field name="name">connector.inbound.message.search</field>
        <field name="model">connector.inbound.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="uuid"/>
                <field name="endpoint_id"/>
                <field name="event_type"/>
                <field name="idempotency_key"/>
                <field name="ordering_key"/>
                <separator/>
                <filter string="Queued" name="queued_filter" domain="[('state', '=', 'queued')]"/>
                <filter string="Processing" name="processing_filter" domain="[('state', '=', 'processing')]"/>
                <filter string="Done" name="done_filter" domain="[('state', '=', 'done')]"/>
                <filter string="Failed" name="failed_filter" domain="[('state', '=', 'failed')]"/>
                <filter string="Dead Letter" name="dead_filter" domain="[('state', '=', 'dead')]"/>
                <separator/>
                <filter string="Endpoint" name="group_endpoint" context="{'group_by': 'endpoint_id'}"/>
                <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Event Type" name="group_event_type" context="{'group_by': 'event_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_connector_inbound_message" model="ir.actions.act_window">
        <field name="name">Inbox Messages</field>
        <field name="res_model">connector.inbound.message</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="action_connector_inbound_message_dead" model="ir.actions.act_window">
        <field name="name">Dead Letter Queue</field>
        <field name="res_model">connector.inbound.message</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'dead')]</field>
    </record>
</odoo>
