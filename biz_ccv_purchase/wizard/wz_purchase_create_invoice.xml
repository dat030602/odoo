<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="wz_purchase_invoive_view_form_inherit">
        <field name="name">wz.purchase.invoive.form.inherit</field>
        <field name="model">wz.purchase.invoive</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="purchase_id"  invisible="1"/>
                    <label for="order_line"/>
                    <field name="order_line" nolabel="1" colspan="2">
                        <tree create="0" delete="0" editable="bottom">
                            <field name="purchase_line_id" invisible="1"/>
                            <field name="is_selected"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="date_planned" optional="hide" readonly="1"/>
                            <field name="analytic_distribution" widget="analytic_distribution" optional="hide" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
                            <field name="qty_received" string="Received" readonly="1" optional="show"/>
                            <field name="qty_invoiced" string="Billed" readonly="1"/>
                            <field name="product_uom" string="UoM" groups="uom.group_uom" readonly="1" optional="show"/>
                            <field name="price_unit" readonly="1"/>
                            <field name="taxes_id" widget="many2many_tags" readonly="1" optional="show"/>
                            <field name="price_subtotal" widget="monetary" readonly="1"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button string="Confirm" class="btn btn-primary" type="object" name="action_confirm" data-hotkey="q" />
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>
</odoo>