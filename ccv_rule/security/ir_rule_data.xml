<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- MRP Production Rules -->
        
        <!-- Manager MRP: thấy tất cả MO -->
        <record id="rule_mrp_production_manager" model="ir.rule">
            <field name="name">MRP Manager can see all MO</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="groups" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <!-- User khác: chỉ thấy MO chưa Done -->
        <record id="rule_mrp_production_hide_done_for_users" model="ir.rule">
            <field name="name">Hide Done MO for non-managers</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="groups" eval="[(6, 0, [ref('mrp.group_mrp_user')])]"/>
            <field name="domain_force">[('user_id', '=', user.id), ('picking_type_id.warehouse_id', 'in', user.stock_warehouse_ids.ids),('state','!=','done')]</field>
        </record>
        <record id="rule_mrp_production_hide_done_for_managers" model="ir.rule">
            <field name="name">Hide Done MO for managers</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="groups" eval="[(6, 0, [ref('biz_client_ccv.group_mrp_manager_production')])]"/>
            <field name="domain_force">[('picking_type_id.warehouse_id', 'in', user.stock_warehouse_ids.ids),('state','!=','done')]</field>
        </record>
        
        <!-- BOM Rules -->
        
        <!-- Chỉ Quản trị viên SX mới được xem và sửa BOM -->
        <record id="rule_mrp_bom_admin_only" model="ir.rule">
            <field name="name">Only MRP Admin can access BOM</field>
            <field name="model_id" ref="mrp.model_mrp_bom"/>
            <field name="groups" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>
