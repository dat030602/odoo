<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Demo data để test các rule -->
        
        <!-- Tạo user demo để test rule -->
        <record id="demo_user_mrp" model="res.users">
            <field name="name">MRP User Demo</field>
            <field name="login">mrp_user_demo</field>
            <field name="email">mrp_user@ccv.vn</field>
            <field name="groups_id" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        </record>
        
        <record id="demo_user_purchase" model="res.users">
            <field name="name">Purchase User Demo</field>
            <field name="login">purchase_user_demo</field>
            <field name="email">purchase_user@ccv.vn</field>
            <field name="groups_id" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>
        
        <record id="demo_user_sale" model="res.users">
            <field name="name">Sale User Demo</field>
            <field name="login">sale_user_demo</field>
            <field name="email">sale_user@ccv.vn</field>
            <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
        
        <!-- Tạo Manufacturing Order demo -->
        <record id="demo_mo_done" model="mrp.production">
            <field name="name">MO/DEMO/001</field>
            <field name="product_id" ref="product.product_product_4"/>
            <field name="product_qty">10</field>
            <field name="state">done</field>
        </record>
        
        <record id="demo_mo_draft" model="mrp.production">
            <field name="name">MO/DEMO/002</field>
            <field name="product_id" ref="product.product_product_4"/>
            <field name="product_qty">5</field>
            <field name="state">draft</field>
        </record>
        
        <!-- Tạo Purchase Order demo -->
        <record id="demo_po_user1" model="purchase.order">
            <field name="partner_id" ref="base.res_partner_1"/>
            <field name="user_id" ref="demo_user_purchase"/>
            <field name="order_line" eval="[(0, 0, {
                'product_id': ref('product.product_product_4'),
                'product_qty': 10,
                'price_unit': 100,
            })]"/>
        </record>
        
        <record id="demo_po_user2" model="purchase.order">
            <field name="partner_id" ref="base.res_partner_2"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="order_line" eval="[(0, 0, {
                'product_id': ref('product.product_product_4'),
                'product_qty': 20,
                'price_unit': 200,
            })]"/>
        </record>
        
    </data>
</odoo>
