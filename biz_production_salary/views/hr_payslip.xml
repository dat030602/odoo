<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">hr.payslip.form</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <field name="basic_wage" position="attributes">
                <attribute name="sum">Total Basic Wage</attribute>
            </field>
            <field name="basic_wage" position="after">
                <field name="salary_gross" optional="hide" sum="Total Gross Salary"/>
                <field name="advance_salary" optional="hide" sum="Total Advance Salary"/>
            </field>
        </field>
    </record>
</odoo>
