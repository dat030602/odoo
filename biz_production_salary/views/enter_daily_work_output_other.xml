<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_enter_daily_work_output_other_tree" model="ir.ui.view">
        <field name="name">enter.daily.work.output.other.tree</field>
        <field name="model">enter.daily.work.output.other</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="date"/>
                <field name="product_id" attrs="{'readonly': [('day_labor_id','!=',False)]}"/>
                <field name="production_other" attrs="{'readonly': [('day_labor_id','!=',False)]}"/>
                <field name="price_unit"/>
                <field name="employee_ids" widget="many2many_tags"/>
                <field name="department_ids" widget="many2many_tags"/>
                <field name="day_labor_id" attrs="{'readonly': ['|',('product_id','!=',False),('production_other','!=',0.0)]}"/>
            </tree>
        </field>
    </record>

    <record id="view_enter_daily_work_output_other_search" model="ir.ui.view">
        <field name="name">enter.daily.work.output.other.search</field>
        <field name="model">enter.daily.work.output.other</field>
        <field name="arch" type="xml">
            <search>
                <field name="date" widget="daterange"/>
                <field name="product_id"/>
                <field name="employee_ids"/>
                <field name="department_ids"/>
                <filter string="Today" name="filter_date_today" domain="[('date', '=', context_today().to_date().strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="filter_date_this_month" domain="[('date', '>=', context_today().to_date().replace(day=1).strftime('%Y-%m-%d')), ('date', '&lt;=', context_today().to_date().strftime('%Y-%m-%d'))]"/>
                <filter string="Last 7 Days" name="filter_date_last_7_days" domain="[('date', '>=', (context_today().to_date() - relativedelta(days=6)).strftime('%Y-%m-%d')), ('date', '&lt;=', context_today().to_date().strftime('%Y-%m-%d'))]"/>
                <filter string="Last 30 Days" name="filter_date_last_30_days" domain="[('date', '>=', (context_today().to_date() - relativedelta(days=29)).strftime('%Y-%m-%d')), ('date', '&lt;=', context_today().to_date().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Date" name="filter_date" domain="[]" context="{'group_by': 'date'}"/>
                <filter string="Product" name="filter_product" domain="[]" context="{'group_by': 'product_id'}"/>
                <filter string="Employee" name="filter_employee" domain="[]" context="{'group_by': 'employee_ids'}"/>
                <filter string="Department" name="filter_department" domain="[]" context="{'group_by': 'department_ids'}"/>
            </search>
        </field>
    </record>

    <record id="action_enter_daily_work_output_other" model="ir.actions.act_window">
        <field name="name">Enter daily work output/other</field>
        <field name="res_model">enter.daily.work.output.other</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem
        id="menu_enter_daily_work_output_other"
        name="Enter daily work output/other"
        parent="biz_production_salary.menu_common_worker_output_salary"
        sequence="30"
        action="action_enter_daily_work_output_other"
        />
    
</odoo>
