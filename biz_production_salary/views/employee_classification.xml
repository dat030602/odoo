<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_classification" model="ir.ui.view">
        <field name="name">employee.classification.tree</field>
        <field name="model">employee.classification</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="employee_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_employee_classification_search" model="ir.ui.view">
        <field name="name">employee.classification.search</field>
        <field name="model">employee.classification</field>
        <field name="arch" type="xml">
            <search>
                <field name="date" widget="daterange"/>
                <field name="employee_ids"/>
                <filter string="Today" name="filter_date_today" domain="[('date', '=', context_today().to_date().strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="filter_date_this_month" domain="[('date', '>=', context_today().to_date().replace(day=1).strftime('%Y-%m-%d')), ('date', '&lt;=', context_today().to_date().strftime('%Y-%m-%d'))]"/>
                <filter string="Last 7 Days" name="filter_date_last_7_days" domain="[('date', '>=', (context_today().to_date() - relativedelta(days=6)).strftime('%Y-%m-%d')), ('date', '&lt;=', context_today().to_date().strftime('%Y-%m-%d'))]"/>
                <filter string="Last 30 Days" name="filter_date_last_30_days" domain="[('date', '>=', (context_today().to_date() - relativedelta(days=29)).strftime('%Y-%m-%d')), ('date', '&lt;=', context_today().to_date().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Date" name="filter_date" domain="[]" context="{'group_by': 'date'}"/>
                <filter string="Employee" name="filter_employee" domain="[]" context="{'group_by': 'employee_ids'}"/>
            </search>
        </field>
    </record>

    <record id="view_employee_classification_form" model="ir.ui.view">
        <field name="name">employee.classification.form</field>
        <field name="model">employee.classification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="push_up_contract" string="Push up contract" type="object"/>
                </header>
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                        <field name="classification_id"/>
                        <field name="proportion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_classification" model="ir.actions.act_window">
        <field name="name">Classification</field>
        <field name="res_model">employee.classification</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_employee_classification"
        name="Classification"
        parent="biz_production_salary.menu_common_worker_output_salary"
        sequence="40"
        action="action_employee_classification"
        />
    
</odoo>
