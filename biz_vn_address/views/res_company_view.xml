<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_bizapps_form" model="ir.ui.view">
        <field name="name">res.company.form.client</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//page/group" position="replace">
                <group>
                    <group>
                        <field name="partner_id" readonly="1" required="0" groups="base.group_no_one" />
                        <label for="street" string="Address" />
                        <div class="o_address_format">
                            <field name="parent_id" />
                            <field name="street" placeholder="Street..." class="o_address_street" attrs="{'readonly': [('parent_id', '!=', False)]}" />
                            <field name="country_id" placeholder="Country" style="width: 19%" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}" attrs="{'readonly': [('parent_id', '!=', False)]}" />
                            <field name="state_id" style="width: 27%" placeholder="Province/City" options="{&quot;no_open&quot;: True}" domain="[('country_id', '=', country_id)]" attrs="{'readonly': [('parent_id', '!=', False)]}" context="{'country_id': country_id, 'zip': zip}" />
                            <field name="district_id" placeholder="District" style="width: 27%" domain="[('state_id', '=', state_id)]" attrs="{'readonly': [('parent_id', '!=', False)]}" />
                            <field name="wards_id" placeholder="Wards" style="width: 27%" domain="[('district_id', '=', district_id)]" attrs="{'readonly': [('parent_id', '!=', False)]}" />
                            <field name="city" invisible="1" />
                            <field name="zip" invisible="1" />
                            <field name="street2" invisible="1" />
                        </div>
                        <field name="phone" />
                        <field name="email" />
                    </group>
                    <group>
                        <field name="website" widget="url" placeholder="e.g. www.odoo.com" />
                        <field name="vat" />
                        <field name="company_registry" />
                        <field name="currency_id" options="{'no_create': True, 'no_open': True}" id="company_currency" context="{'active_test': False}" />
                        <field name="parent_id" groups="base.group_multi_company" />
                        <field name="sequence" invisible="1" />
                    </group>
                    <group name="social_media" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>