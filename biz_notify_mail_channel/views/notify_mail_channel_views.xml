<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="notify_mail_channel_view_tree" model="ir.ui.view">
        <field name="name">notify.mail.channel.tree</field>
        <field name="model">notify.mail.channel</field>
        <field name="arch" type="xml">
            <tree>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="mail_channel_id"/>
                <field name="mute_notify_type"/>
                <field name="notify_datetime"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="notify_mail_channel_view_form" model="ir.ui.view">
        <field name="name">notify.mail.channel.form</field>
        <field name="model">notify.mail.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="mail_channel_id"/>
                        </group>
                        <group>
                            <field name="mute_notify_type"/>
                            <field name="notify_datetime"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="notify_mail_channel_action" model="ir.actions.act_window">
        <field name="name">Notify Mail Channel</field>
        <field name="res_model">notify.mail.channel</field>
        <field name="view_mode">tree,form</field>
    </record>

<!--    <menuitem id="notify_mail_channel_menu_action" action="notify_mail_channel_action" parent="mail.menu_root_discuss"/>-->
</odoo>