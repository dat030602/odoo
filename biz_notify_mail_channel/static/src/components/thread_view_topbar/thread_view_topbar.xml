<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="biz_notify_mail_channel.ThreadViewTopbar" t-inherit="mail.ThreadViewTopbar" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-if='threadViewTopbar.thread and threadViewTopbar.thread === messaging.starred.thread']" position="after">
            <t t-if="threadViewTopbar.thread and threadViewTopbar.thread.isShowMuteNotifyIcon">
                <t t-if="threadViewTopbar.thread and !threadViewTopbar.thread.isMuteNotify">
                    <button class="o_ThreadViewTopbar_button btn px-2 border-none rounded shadow-none" title="Do not notify me of incoming messages for this conversation" t-on-click="threadViewTopbar.onClickShowMuteNotifyDialog">
                        <i class="fa fa-lg fa-bell text-700"/>
                    </button>
                </t>
                <t t-if="threadViewTopbar.thread and threadViewTopbar.thread.isMuteNotify">
                    <button class="o_ThreadViewTopbar_button o-isActive btn px-2 border-none rounded shadow-none" title="Notify me of incoming messages for this conversation" t-on-click="threadViewTopbar.onClickTurnOffMuteNotify">
                        <i class="fa fa-lg fa-bell-slash text-700"/>
                    </button>
                </t>
            </t>
        </xpath>
    </t>

</templates>