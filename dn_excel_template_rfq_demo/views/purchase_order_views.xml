<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Purchase Order Form View -->
    <record id="purchase_order_form_hetian_excel" model="ir.ui.view">
        <field name="name">purchase.order.form.hetian.excel</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Print Excel Popup buttons to header -->
            <xpath expr="//header" position="inside">
                <button name="action_open_excel_template_popup"
                        string="Print Excel (Hetian Builder)"
                        type="object"
                        class="btn-primary"
                        icon="fa-file-excel-o"/>
                <button name="action_open_excel_python_popup"
                        string="Print Excel (Hetian Python Code)"
                        type="object"
                        class="btn-secondary"
                        icon="fa-code"/>
            </xpath>

            <!-- Add OWL Interactive Popup Widget in button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="excel_preview_button" widget="excel_preview_popup" nolabel="1"/>
            </xpath>

            <!-- Add Order Number and Design to order lines list view -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="order_number" optional="show"/>
                <field name="design" optional="show"/>
            </xpath>

            <!-- Add Hetian Specific Details Page to Notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Hetian RFQ Specs" name="hetian_specs">
                    <group>
                        <group string="Production &amp; Sourcing">
                            <field name="x_studio_order_type"/>
                            <field name="x_studio_production_country_1"/>
                            <field name="x_customer_id"/>
                        </group>
                    </group>
                    <group string="Terms &amp; Quality Conditions">
                        <field name="conditions" placeholder="Enter specific warranty, inspection, and terms..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend Partner Form View for Material Quality Standards -->
    <record id="view_partner_form_hetian" model="ir.ui.view">
        <field name="name">res.partner.form.hetian</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="inside">
                <group string="Hetian Quality &amp; Material Standards">
                    <field name="x_studio_material_quality_standards" placeholder="Define customer specific material standards..."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
