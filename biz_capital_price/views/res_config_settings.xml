<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref='account.res_config_settings_view_form'/>
        <field name="arch" type="xml">
            <div name='fiscal_localization_setting_container' position="after">
                <h2>Bình quân giá thành</h2>
                <div class="row mt16 o_settings_container" >
                    <div class="col-12 col-lg-6 o_setting_box" >
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Số lần chạy ưu tiên</span>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label string="Số lần chạy ưu tiên" for="capital_price_priority" class="col-lg-3 o_light_label"/>
                                    <field name="capital_price_priority"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>