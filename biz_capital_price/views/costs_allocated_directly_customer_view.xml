<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="costs_allocated_directly_items_view_form" model="ir.ui.view">
        <field name="name">costs.allocated.directly.items.view.form</field>
        <field name="model">costs.allocated.directly.items</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
            </tree>
        </field>
    </record>
    <record id="costs_allocated_directly_customer_view_tree" model="ir.ui.view">
        <field name="name">costs.allocated.directly.items.view.tree</field>
        <field name="model">costs.allocated.directly.items</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date" required="True"/>
                            <field name="journal_id" required="True" />
                        </group>
                    </group>
                    <notebook>
                        <page name="enter_cost" string="Enter cost">
                            <field name="enter_cost_ids">
                                <tree editable="bottom">
                                    <field name="allocation_cost"/>
                                    <field name="partner_id" required="True"/>
                                    <field name="product_id" required="True"/>
                                    <field name="tax_id"/>
                                    <field name="account_counterpart_id" required="True"/>
                                    <field name="move_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_costs_allocated_directly_items" model="ir.actions.act_window">
        <field name="name">Costs allocated directly to items</field>
        <field name="res_model">costs.allocated.directly.items</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_action_costs_allocated_directly_items"
              name="Costs allocated directly to items"
              action="action_costs_allocated_directly_items"
              parent="account.menu_finance_entries"/>
</odoo>