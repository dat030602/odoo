<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="average_capital_price_end_period_view_form" model="ir.ui.view">
        <field name="name">average.capital.price.end.period.view.form</field>
        <field name="model">average.capital.price.end.period</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0">
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="previous_period_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>
    <record id="average_capital_price_end_period_view_tree" model="ir.ui.view">
        <field name="name">average.capital.price.end.period.view.tree</field>
        <field name="model">average.capital.price.end.period</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="product_ids" >
                                <tree limit="20" count_limit="20">
                                    <field name="default_code"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                            <field name="is_finished_products"/>
                            <field name="from_date" required="1"/>
                            <field name="to_date" required="1"/>
                            <field name="previous_period_id" 
                                context="{'filter_previous_period_id': product_ids, 'filter_period_id': id}"/>
                            <field name="previous_period_ids" 
                                context="{'filter_previous_period_id': product_ids, 'filter_period_id': id}" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="final_information" string="Final information">
                            <field name="period_line_ids" readonly="1">
                                <tree>
                                    <field name="product_id"/>
                                    <field name="initital_quantity"/>
                                    <field name="initital_value"/>
                                    <field name="total_quantity_import"/>
                                    <field name="total_value_import" invisible="1"/>
                                    <field name="actual_value_import" force_save="1"/>
                                    <field name="value_per_unit"/>
                                    <field name="quantity_in_period" invisible="1"/>
                                    <field name="unit_value" invisible="1"/>
                                    <field name="period_id" invisible="1"/>
                                    <field name="is_internal" invisible="1"/> 
                                    <field name="stock_valuation_layer_ids" widget="many2many_tags" invisible="1"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="initital_quantity"/>
                                            <field name="initital_value"/>
                                            <field name="total_quantity_import"/>
                                            <field name="total_value_import" />
                                            <field name="value_621" />
                                        </group>
                                        <group>
                                            <field name="actual_value_import" force_save="1"/>
                                            <field name="value_per_unit"/>
                                            <field name="quantity_in_period" />
                                            <field name="unit_value" />
                                            <field name="period_id" />
                                            <field name="is_internal" /> 
                                            <field name='ex_warehouse_price'/>
                                            <field name="total_quantity_export"/>
                                            <field name="total_value_export" />
                                            <field name="stock_valuation_layer_ids" widget="many2many_tags" invisible="1"/>
                                        </group>
                                    </group>
                                    <notebook>
                                        <page name="allocation_details_by_account" string="Allocation details by account">
                                            <field name="allocation_details_by_account_ids">
                                                <tree editable="bottom" options="{'no_create': True,'no_open':True}">
                                                    <field name="end_period_cost_allocation_id" invisible="1"/>
                                                    <field name="account_ids" widget="many2many_tags"/>
                                                    <field name="allocated_value_for_product"/>
                                                </tree>
                                            </field>
                                        </page>
                                        <page string="Layer details">
                                            <field name="stock_valuation_layer_ids" group="base.group_no_one"/>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                        <page string="End of period cost allocation" invisible="1">
                            <group>
                                <group>
                                    <field name="allocation_rate"/>
                                    <field name="total_allocation_value"/>
                                </group>
                            </group>
                            <field name="end_cost_allocation_ids">
                                <tree editable="bottom">
                                    <field name="cost_id"/>
                                    <field name="date" invisible="1"/>
                                    <field name="total_cost"/>
                                    <field name="value"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Internal transfer" groups="base.group_no_one">
                            <field name='stock_valuation_layer_ids'/>
                            <field name='account_move_ids'/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="average_capital_price_end_period_view_search" model="ir.ui.view">
        <field name="name">average.capital.price.end.period.view.search</field>
        <field name="model">average.capital.price.end.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_ids"/>
            </search>
        </field>
    </record>
    <record id="action_average_capital_price_end_period" model="ir.actions.act_window">
        <field name="name">Action Average Capital Price End Period</field>
        <field name="res_model">average.capital.price.end.period</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_action_average_capital_price_end_period"
              name="Calculate the average cost of capital at the end of the period"
              action="action_average_capital_price_end_period"
              parent="account.menu_finance_entries"/>


    <record id="cost_allocation_view_form" model="ir.ui.view">
        <field name="name">cost.allocation.view.form</field>
        <field name="model">cost.allocation</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="account_consolidated_ids" widget="many2many_tags"/>
                </group>
            </form>
        </field>
    </record>
</odoo>