<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hr_payslip_pdf_template">
        <t t-call="web.html_container">
            <t t-call="biz_ccv_payslip.hr_payslip_pdf_template_document"/>
        </t>
    </template>

    <template id="hr_payslip_pdf_template_document">
        <div class="header" style="border-bottom: none; display: none;">
        </div>
        <div class="article o_report_layout_standard" style="margin-top: 0 !important; padding-top: 0 !important;">
            <div class="page" style="font-family: 'Times New Roman';font-size:14px; line-height: 25px; padding-top: 0px;">
                <style>
                    @page { margin-top: 0; }
                    .o_report_layout_standard .article { margin-top: 0 !important; padding-top: 0 !important; }
                    .o_report_layout_standard .page { padding-top: 0 !important; }
                </style>
                <div class="row" style="margin-bottom: 5px;">
                    <div class="col-2" style="text-align: left;">
                        <img t-if="user.company_id.logo" t-att-src="image_data_uri(user.company_id.logo)" style="max-height: 50px; width: auto;"/>
                    </div>
                    <div class="col-6" style="font-size: 12px; padding-top: 5px;">
                        <span t-esc="user.company_id.name"/> - Mã số thuế: <span t-esc="user.company_id.vat"/><br/>
                        <span t-esc="user.company_id.street or ''"/>
                    </div>
                </div>
                <div class="text-center">
                    <h5 style="font-weight: bold;">DANH SÁCH THANH TOÁN LƯƠNG <t t-esc="docs and docs[0].payslip_run_id.name or ''"/></h5>
                    <h6 style="font-weight: bold; font-style: italic;">Từ ngày <span t-esc="docs and docs[0].date_from and docs[0].date_from.strftime('%d/%m/%Y') or ''"/> đến ngày <span t-esc="docs and docs[0].date_to and docs[0].date_to.strftime('%d/%m/%Y') or ''"/></h6>
                </div>
                <table class="table-line" style="border-collapse: collapse; width: 100%;">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 5%; border: 1px solid black; padding: 4px;">STT</th>
                            <th class="text-left" style="width: 8%; border: 1px solid black; padding: 4px;">Mã nhân viên</th>
                            <th class="text-left" style="width: 18%; border: 1px solid black; padding: 4px;">Nhân viên</th>
                            <th class="text-center" style="width: 15%; border: 1px solid black; padding: 4px;">Số tài khoản</th>
                            <th class="text-left" style="width: 18%; border: 1px solid black; padding: 4px;">Ngân hàng</th>
                            <th class="text-center" style="width: 10%; border: 1px solid black; padding: 4px;">Tiền Lương</th>
                            <th class="text-center" style="width: 10%; border: 1px solid black; padding: 4px;">Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="docs" t-as="doc">
                            <td class="text-center vertical" style="border: 1px solid black; padding: 4px;"><span t-esc="doc_index + 1"/></td>
                            <td class="text-left vertical" style="border: 1px solid black; padding: 4px;"><span t-esc="doc.employee_code or ''"/></td>
                            <td class="text-left vertical" style="border: 1px solid black; padding: 4px;"><span t-esc="doc.employee_pure_name or ''"/></td>
                            <td class="text-center vertical" style="border: 1px solid black; padding: 4px;"><span t-esc="doc.bank_acc_number or ''"/></td>
                            <td class="text-left vertical" style="border: 1px solid black; padding: 4px;"><span t-esc="doc.bank_id.name or ''"/></td>
                            <td class="text-center vertical" style="border: 1px solid black; padding: 4px;"><span t-esc="'{:,.0f}'.format(doc.net_wage or 0)"/></td>
                            <td class="text-center vertical" style="border: 1px solid black; padding: 4px;"></td>
                        </tr>
                        <t t-set="total_net_wage" t-value="sum(doc.net_wage or 0 for doc in docs)"/>
                        <tr>
                            <td colspan="5" class="text-right" style="border: 1px solid black; padding: 4px; font-weight: bold;">Tổng cộng</td>
                            <td class="text-center vertical" style="border: 1px solid black; padding: 4px; font-weight: bold;"><span t-esc="'{:,.0f}'.format(total_net_wage)"/></td>
                            <td style="border: 1px solid black; padding: 4px;"></td>
                        </tr>
                    </tbody>
                </table>
                <div style="margin-top: 10px; font-style: italic;">
                    <span style="text-decoration: underline;">Bằng chữ:</span> <span style="font-weight: bold;" t-esc="(docs and docs[0].env['hr.payslip'].number_to_vietnamese_words(int(round(total_net_wage))) or '').capitalize()"/>
                </div>
                <div style="text-align: right; margin-bottom: 5px;">
                    <span>Gò Dầu, ngày <span t-esc="datetime.datetime.now().strftime('%d')"/> tháng <span t-esc="datetime.datetime.now().strftime('%m')"/> năm <span t-esc="datetime.datetime.now().strftime('%Y')"/></span>
                </div>
                <div class="row" style="text-align: center;">
                    <div class="col-4">
                        <strong>Người lập</strong><br/><span style="font-style: italic;">(Ký, họ tên)</span>
                    </div>
                    <div class="col-4">
                        <strong>P.TCKT</strong><br/><span style="font-style: italic;">(Ký, họ tên)</span>
                    </div>
                    <div class="col-4">
                        <strong>Thủ Trưởng đơn vị</strong><br/><span style="font-style: italic;">(Ký, họ tên)</span>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>
