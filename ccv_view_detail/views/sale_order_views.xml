<odoo>
    <record id="view_sale_order_tree_detail" model="ir.ui.view">
        <field name="name">sale.order.tree.detail.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <button name="action_view_detail_wizard" type="object" string="Chi tiết đơn" icon="fa-info-circle"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_tree_detail_2" model="ir.ui.view">
        <field name="name">sale.order.tree.detail.button.2</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <button name="action_view_detail_wizard" type="object" string="Chi tiết đơn" icon="fa-info-circle"/>
            </xpath>
        </field>
    </record>
</odoo> 