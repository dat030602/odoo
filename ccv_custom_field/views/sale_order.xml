    <record id="view_order_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="move_amount_paid" optional="hide"/>
                <field name="move_amount_residual" optional="hide"/>
                <field name="payment_state" optional="show" widget="badge"
                    decoration-danger="payment_state == 'not_paid'"
                    decoration-warning="payment_state in ('partial')"
                    decoration-success="payment_state in ('paid', 'in_payment')"
                />
                <field name="internal_note" optional="hide" string="Ghi chú"/>
            </xpath>
        </field>
    </record>

    <record id="biz_ccv_sale_view_order_form_sale_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="biz_ccv_sale.view_order_form_sale_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='packaging_image'][1]" position="attributes">
                <attribute name="name">packaging_image_128</attribute>
            </xpath>
            <xpath expr="//field[@name='packaging_image'][1]" position="attributes">
                <attribute name="name">packaging_image_128</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_invoice_product_image_app_view_sale_order_line_procduct_image" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_invoice_product_image_app.view_sale_order_line_procduct_image"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_image'][1]" position="attributes">
                <attribute name="name">product_image_128</attribute>
            </xpath>
            <xpath expr="//field[@name='product_image'][1]" position="attributes">
                <attribute name="name">product_image_128</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_action_payment_state_paid" model="ir.actions.act_window">
        <field name="name">Đơn hàng đã thanh toán</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('payment_state','in',['in_payment','paid'])]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="sale.view_sales_order_filter"/>
    </record>
    <record id="sale_order_action_payment_state_not_paid" model="ir.actions.act_window">
        <field name="name">Đơn hàng chưa thanh toán</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('payment_state','not in',['in_payment','paid'])]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="sale.view_sales_order_filter"/>
    </record>
    <!-- This Menu Item must have a parent and an action -->
    <menuitem id="sale_order_action_payment_state_paid_menu_act" name="Đơn hàng đã thanh toán" parent="sale.menu_sale_invoicing" action="sale_order_action_payment_state_paid" sequence="-20"/>
    <menuitem id="sale_order_action_payment_state_not_paid_menu_act" name="Đơn hàng chưa thanh toán" parent="sale.menu_sale_invoicing" action="sale_order_action_payment_state_not_paid" sequence="-10"/>
</odoo>
