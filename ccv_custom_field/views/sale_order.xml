<odoo>
    <record id="view_sale_order_inherit_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="payment_state" invisible="1"/>
                <widget name="web_ribbon" title="Đã thanh toán" attrs="{'invisible': [('payment_state', '!=', 'paid')]}"/>
                <widget name="web_ribbon" title="Thanh toán" attrs="{'invisible': [('payment_state', '!=', 'in_payment')]}"/>
                <widget name="web_ribbon" title="Một phần" attrs="{'invisible': [('payment_state', '!=', 'partial')]}"/>
            </xpath>
        </field>
    </record>
