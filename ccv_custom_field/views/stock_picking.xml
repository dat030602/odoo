<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_inherit_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="biz_ccv_sale.view_picking_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='load_department_id']" position="after">
                <field name="department_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//field[@name='packaging_image']" position="attributes">
                <attribute name="name">packaging_image_128</attribute>
            </xpath>
            <xpath expr="//field[@name='product_image']" position="attributes">
                <attribute name="name">product_image_128</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_picking_form_inherit_validate_draft" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.validate.draft</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="button_validate"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                        string="Xác nhận" type="object" class="oe_highlight"
                        groups="stock.group_stock_user" data-hotkey="v"/>
            </xpath>
        </field>
    </record>
    <!-- <record id="view_picking_form_inherit_inherit_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.inherit.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity_done']" position="after">
                <field name="price_unit" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record> -->
    <record id="view_picking_tree_inherit_inherit_inherit" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.inherit.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="description_export_import" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
