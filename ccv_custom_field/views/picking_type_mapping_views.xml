<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_mapping_tree" model="ir.ui.view">
        <field name="name">picking.type.mapping.tree</field>
        <field name="model">picking.type.mapping</field>
        <field name="arch" type="xml">
            <tree editable="bottom" multi_edit="1">
                <field name="warehouse_id" options="{'no_create': True}"/>
                <field name="product_id" options="{'no_create': True}"/>
                <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="picking_type_id" options="{'no_create': True}"/>
            </tree>
        </field>
    </record>

    <record id="action_picking_type_mapping" model="ir.actions.act_window">
        <field name="name">Ánh xạ Loại hoạt động</field>
        <field name="res_model">picking.type.mapping</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo cấu hình ánh xạ mới
            </p>
            <p>
                Cấu hình này giúp hệ thống tự động xác định Loại hoạt động khi người dùng chọn Kho và Tài khoản chi phí trên Đề xuất phê duyệt.
            </p>
        </field>
    </record>

    <!-- Menu được đưa ra ngoài danh mục chính của Phê duyệt -->
    <menuitem id="menu_picking_type_mapping"
              name="Ánh xạ Loại hoạt động"
              parent="approvals.approvals_menu_root"
              action="action_picking_type_mapping"
              sequence="20"/>
</odoo>
