<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_leave_form_inherit_inherit" model="ir.ui.view">
        <field name="name">hr.leave.form.inherit.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='col_left']/div[@class='o_row'][2]/field[@name='request_date_from']" position="attributes">
                <attribute name="widget"/>
            </xpath>
            <xpath expr="//group[@name='col_left']/div[@class='o_row'][2]/field[@name='request_date_to']" position="attributes">
                <attribute name="widget"/>
            </xpath>
        </field>
    </record>
</odoo>
