<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="fleet.fleet_vehicle_action" model="ir.actions.act_window">
        <field name="context">{'search_default_groupby_status': 1}</field>
    </record>
    <record id="fleet.fleet_vehicle_log_contract_action" model="ir.actions.act_window">
        <field name="name">Bảo dưỡng</field>
    </record>
    <record id="fleet_vehicle_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.inherit.view.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='write_off_date']" position="after">
                <field name="end_date"/>
            </xpath>
            <xpath expr="//label[@for='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='future_driver_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='plan_to_change_car']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='plan_to_change_bike']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='next_assignation_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='acquisition_date']" position="attributes">
                <attribute name="string">Ngày đăng kiểm</attribute>
            </xpath>
            <xpath expr="//notebook/page[1]/group[1]/group[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook/page[1]/group[1]/group[2]/field[@name='net_car_value']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook/page[1]/group[1]/group[2]/field[@name='residual_value']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook/page[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook/page[3]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='open_assignation_logs']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@icon='fa-tachometer']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- <xpath expr="//button[@icon='fa-wrench'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
            <!-- <xpath expr="//button[@icon='fa-wrench'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
            <!-- <xpath expr="//button[@icon='fa-wrench'][3]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
            <xpath expr="//button[@icon='fa-book']/field[@name='contract_count']" position="attributes">
                <attribute name="string">Bảo dưỡng</attribute>
            </xpath>
        </field>
    </record>
    <record id="fleet_vehicle_view_kanban_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.inherit.view.kanban</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='o_kanban_record_bottom']" position="replace"/>
        </field>
    </record>
    <record id="fleet_vehicle_log_contract_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.contract.inherit.view.form</field>
        <field name="model">fleet.vehicle.log.contract</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="string">Phí bảo dưỡng</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="string">Ngày bảo dưỡng</attribute>
            </xpath>
            <xpath expr="//field[@name='cost_generated']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='cost_frequency']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='service_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='start_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='expiration_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='insurer_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='cost_subtype_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='ins_ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet/group/group/field[@name='company_id']" position="after">
                <field name="km_start"/>
                <field name="km_end"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Bảo dưỡng">
                        <field name="product_note_ids">
                            <tree editable="bottom" edit="1" no_open="1">
                                <field name="name"/>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                                <field name="price_unit"/>
                                <field name="tax_id"/>
                                <field name="amount_untax" readonly="1"/>
                                <field name="amount_tax" readonly="1"/>
                                <field name="amount_total" readonly="1"/>
                            </tree>
                        </field>
                        <group name="note_group" col="6" class="mt-2 mt-md-0">
                            <group class="oe_subtotal_footer oe_right" colspan="6" name="sale_total">
                                <field name="tax_totals" widget="account-tax-totals-field" nolabel="1" colspan="2" readonly="1"/>
                            </group>
                            <div class="clearfix"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <record id="fleet_vehicle_log_contract_tree_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.contract.inherit.view.tree</field>
        <field name="model">fleet.vehicle.log.contract</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_contract_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='cost_generated']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='cost_frequency']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='insurer_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='start_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='expiration_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <field name="date" string="Ngày bảo dưỡng"/>
            </xpath>
            <xpath expr="//field[@name='purchaser_id']" position="after">
                <field name="amount" string="Phí bảo dưỡng"/>
            </xpath>
        </field>
    </record>
    <record id="fleet_vehicle_log_services_tree_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.inherit.view.tree</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vendor_id']" position="attributes">
                <attribute name="string">Người thực hiện</attribute>
            </xpath>
            <xpath expr="//field[@name='notes']" position="after">
                <field name="amount_total"></field>
            </xpath>
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="fleet_vehicle_log_services_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.inherit.view.form</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vendor_id']" position="attributes">
                <attribute name="string">Người thực hiện</attribute>
            </xpath>
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Dịch vụ">
                        <field name="product_note_ids" widget="many2many_tree">
                            <tree editable="bottom" edit="1">
                                <field name="name"/>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                                <field name="price_unit"/>
                                <field name="tax_id"/>
                                <field name="amount_untax" readonly="1"/>
                                <field name="amount_tax" readonly="1"/>
                                <field name="amount_total" readonly="1"/>
                            </tree>
                        </field>
                        <group name="note_group" col="6" class="mt-2 mt-md-0">
                            <group class="oe_subtotal_footer oe_right" colspan="6" name="sale_total">
                                <field name="tax_totals" widget="account-tax-totals-field" nolabel="1" colspan="2" readonly="1"/>
                            </group>
                            <div class="clearfix"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
