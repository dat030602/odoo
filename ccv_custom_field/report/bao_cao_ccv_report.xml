        <field name="report_file">ccv_custom_field.phieu_de_xuat_dat_bao_bi_template</field>
        <field name="print_report_name">'Phiếu đề xuất đặt bao bì - %s' % (object.request_owner_id.name)</field>
        <field name="attachment_use">False</field>
        <field name="binding_model_id" ref="model_approval_request"/>
        <field name="binding_view_types">form</field>
        <field name="paperformat_id" ref="ccv_sql.format_a4"/>
    </record>
    <!-- Word -->
</odoo>
