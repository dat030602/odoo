        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ccv_custom_field.de_xuat_phat_sinh_hang_ban_template</field>
        <field name="report_file">ccv_custom_field.de_xuat_phat_sinh_hang_ban_template</field>
        <field name="print_report_name">'Đề xuất phát sinh hàng bán - %s' % (object.team_id.user_id.name_without_position)</field>
        <field name="attachment_use">False</field>
        <field name="binding_model_id" ref="model_approval_request"/>
        <field name="binding_view_types">form</field>
        <field name="paperformat_id" ref="ccv_sql.format_a4"/>
