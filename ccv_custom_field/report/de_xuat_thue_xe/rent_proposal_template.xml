<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template chính để gọi báo cáo -->
        <template id="rent_proposal_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="ccv_custom_field.rent_proposal_document" t-lang="user.partner_id.lang"/>
                </t>
            </t>
        </template>
        <!-- Body của báo cáo -->
        <template id="rent_proposal_document">
            <t t-call="ccv_bao_cao.ccv_header_img">
                <style>
                    .name-user {
                        margin-top: 80px;
                        font-weight: bold;
                    }
                </style>
                <div class="page" style="font-size: 16px; font-family: Times New Roman">
                    <!-- Header -->
                    <div class="row">
                        <div class="col-6" style="text-align: center;">
                            <span style="font-size: 16px;">
                                <strong>Công ty TNHH Con Cò Vàng</strong>
                            </span>
                            <br/>
                            <span style="font-size: 16px;">Số: <t t-esc="doc.name"/>
                            </span>
                            <br/>
                        </div>
                        <div class="col-6" style="text-align: center;">
                            <span style="font-size: 16px;">
                                <strong>Cộng hòa Xã hội Chủ nghĩa Việt Nam</strong>
                            </span>
                            <br/>
                            <span style="font-size: 16px;">
                                <strong>Độc lập - Tự do - Hạnh phúc</strong>
                            </span>
                            <br/>
                            <span>
                                <strong>-----------------&amp;---------------</strong>
                            </span>
                            <br/>
                            <span>
                                <strong>Con Cò Vàng, ngày
                                    <t t-esc="doc.create_date.strftime('%d')"/>
                                    tháng
                                    <t t-esc="doc.create_date.strftime('%m')"/>
                                    năm
                                    <t t-esc="doc.create_date.strftime('%Y')"/>
                                </strong>
                            </span>
                            <br/>
                        </div>
                    </div>
                    <!-- Title -->
                    <div class="row" style="padding-top: 10px;">
                        <div class="col-12" style="text-align: center; font-size: 20px;">
                            <strong>ĐỀ XUẤT THUÊ XE</strong>
                        </div>
                    </div>
                    <!-- Kính gửi -->
                    <div class="row" style="padding-top: 10px;">
                        <div class="col-12">
                            <span>
                                <strong>Kính gửi:</strong> Tổng Giám đốc
                            </span>
                        </div>
                    </div>
                    <!-- Mở đầu -->
                    <div class="row" style="padding-top: 10px;">
                        <div class="col-12">
                            <span>
                                Căn cứ vào nhu cầu thực tế
                                <br/>
                                Căn cứ vào quy định của Tập đoàn Con Cò Vàng
                                <br/>
                                Căn cứ vào lệnh điều động xe của Phòng Kinh doanh
                                <br/>
                                Phòng Thương mại kính trình Ban Tổng Giám đốc phê duyệt cho thuê xe chở hàng 
                                <t t-esc="doc.location"/>
                            </span>
                        </div>
                    </div>
                    <!-- Thông tin đơn hàng -->
                    <div class="row" style="padding-top: 10px;">
                        <div class="col-12">
                            <span>
                                <strong>1. Thông tin đơn hàng:</strong>
                            </span>
                        </div>
                    </div>
                    <table class="table table-bordered" style="width: 100%; margin-top: 10px;">
                        <thead>
                            <tr>
                                <th class="text-center">STT</th>
                                <th>Khách hàng</th>
                                <th>Sản phẩm</th>
                                <th class="text-center">Khối lượng (tấn)</th>
                                <th class="text-center">Cước phí</th>
                                <th class="text-center">Thành tiền</th>
                                <th>Đơn vị vận chuyển</th>
                                <th>Lộ trình</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total_weight" t-value="0"/>
                            <t t-set="total_amount" t-value="0"/>
                            <t t-set="total_total" t-value="0"/>
                            <t t-set="index" t-value="0"/>

                            <t t-foreach="doc.rent_line_ids" t-as="line">
                                <t t-set="index" t-value="index + 1"/>
                                <tr>
                                    <td class="text-center">
                                        <t t-esc="index"/>
                                    </td>
                                    <td>
                                        <t t-esc="line.partner_id.name"/>
                                    </td>
                                    <td>
                                        <t t-esc="line.product_id.name"/>
                                    </td>
                                    <td class="text-center">
                                        <t t-esc="format_float_number_weight(line.weight)"/>
                                    </td>
                                    <td class="text-center">
                                        <t t-esc="format_float_number(line.amount )"/>đ
                                    </td>
                                    <td class="text-center">
                                        <t t-esc="format_float_number(line.total)"/>đ

                                    </td>
                                    <td class="text-center">
                                        <t t-esc="line.transporter"/>
                                    </td>
                                    <td class="text-center">
                                        <t t-esc="line.routes"/>
                                    </td>
                                </tr>
                                <t t-set="total_weight" t-value="total_weight + (line.weight)"/>
                                <t t-set="total_amount" t-value="total_amount + (line.amount)"/>
                                <t t-set="total_total" t-value="total_total + (line.total)"/>
                            </t>
                            <tr>
                                <td colspan="3" class="text-center">
                                    <strong>Tổng cộng</strong>
                                </td>
                                <td class="text-center">
                                    <strong>
                                        <t t-esc="format_float_number_weight(total_weight)"/>
                                    </strong>
                                </td>
                                <td class="text-center">
                                    <strong>
                                        <t t-esc="format_float_number(total_amount)" />đ
                                    </strong>
                                </td>
                                <td class="text-center">
                                    <strong>
                                        <t t-esc="format_float_number(total_total)" />đ
                                    </strong>
                                </td>
                                <td colspan="2"></td>
                            </tr>
                        </tbody>
                    </table>
                    <div style="padding-top: 20px;">
                        <strong>Bằng chữ:</strong>
                        <t t-esc="vietnam_number_upper(int(total_total))"/>
                    </div>
                    <div style="padding-top: 4px;">
                        <strong>Lưu ý:</strong> Chưa bao gồm VAT 8%, đã bao gồm bốc xếp kho NCC, không thu bốc xếp tại kho CCV
                    </div>
                    <!-- Thời gian -->
                    <div class="row" style="padding-top: 10px;">
                        <div class="col-12">
                            <span>
                                <strong> 2. Thời gian giao hàng:</strong>
                                <br/>
                                Phòng thương mại, kinh trình Ban Tổng Giám đốc phê duyệt để tiến hành thuê xe chở hàng kịp tiến độ
                                <br/>
                                Trân trọng!
                            </span>
                        </div>
                    </div>
                    <!-- Chữ ký -->
                    <div class="row text-center" style="padding-top: 20px; page-break-inside: avoid;">
                        <div class="col-6">
                            <strong>PHÊ DUYỆT</strong>
                            <br/>
                            <em>(Ký, ghi rõ họ tên)</em>
                            <br/>
                            <t t-set="approver" t-value="doc.sudo().approver_ids and doc.sudo().approver_ids[0].user_id"/>
                            <t t-if="approver and approver.sign_signature and doc.sudo().approver_ids[0].status == 'approved'">
                                <img t-att-src="image_data_uri(approver.sign_signature)" width="110px" height="40px"/>
                                <br/>
                                <strong>
                                    <span t-esc="approver.name_without_position or approver.name"/>
                                </strong>
                            </t>
                            <t t-else="">
                                <div class="name-user">
                                    <span t-esc="approver.name_without_position or approver.name if approver else ''"/>
                                </div>
                            </t>
                        </div>

                        <div class="col-6">
                            <strong>Người lập</strong>
                            <br/>
                            <em>(Ký, ghi rõ họ tên, đóng dấu)</em>
                            <br/>
                            <t t-set="creator" t-value="doc.sudo().create_uid"/>
                            <t t-if="creator.sign_signature is not False">
                                <img t-att-src="image_data_uri(creator.sign_signature)" width="110px" height="40px"/>
                                <br/>
                                <strong>
                                    <span t-esc="creator.name_without_position or creator.name"/>
                                </strong>
                            </t>
                            <t t-else="">
                                <div class="name-user">
                                    <span t-esc="creator.name_without_position or creator.name"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
