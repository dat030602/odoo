<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- có thể chạy nhiều báo cáo pdf-->
        <template id="de_xuat_phat_sinh_hang_ban_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="ccv_custom_field.de_xuat_phat_sinh_hang_ban_document"/>
                </t>
            </t>
        </template>

        <!-- body của báo cáo-->
        <template id="de_xuat_phat_sinh_hang_ban_document">
            <t t-call="ccv_bao_cao.ccv_header_img">
                <style>
                    .page * {
                        font-size: 15px;
                        line-height: 18px;
                    }
                </style>
                <div class="page" style="font-size: 14px;font-family: Times New Roman; padding-top: 20px;">
                    <div class="row" style="padding-top: 4px;">
                        <div class="col-12" style="text-align: center; font-size: 20px">
                            <p><strong style="font-size: 20px">ĐỀ XUẤT PHÁT SINH HÀNG BÁN</strong></p>
                            <p style="font-size: 14px;margin-top: -12px;">(Trong ngày <t t-esc="doc.date.strftime('%d/%m/%Y')"/>)</p>
                        </div>
                    </div>
                    <div class="row" style="padding-top: 4px;">
                        <div class="col-3" style="text-align: right;padding-right: 8px;padding-top: 3px;">
                            Kính gửi:
                        </div>
                        <div class="col-9">
                            <strong>Ban Lãnh Đạo</strong>
                        </div>
                    </div>
                    <div class="row" style="padding-top: 0;">
                        <div class="col-3"/>
                        <div class="col-9">
                            <strong>Khối Sản Xuất</strong>
                        </div>
                    </div>
                    <div class="row" style="padding-top: 4px;">
                        <div class="col-6">
                            Khu vực kinh doanh: <strong><t t-esc="doc.team_id.report_name"/></strong>
                        </div>
                        <div class="col-6">
                            Phụ trách khu vực: <strong><t t-esc="doc.team_id.user_id.name_without_position"/></strong>
                        </div>
                    </div>
                    <div class="row" style="padding-top: 4px;">
                        <div class="col-12">
                            Nhân sự bán hàng: <strong><t t-esc="doc.sale_order_id.user_id.name_without_position"/></strong>
                        </div>
                    </div>
                    <div class="row" style="padding-top: 4px;">
                        <t t-set="sum_quantity" t-value="sum(doc.product_line_ids.mapped('quantity'))"/>
                        <t t-set="sum_qty_produced" t-value="sum(doc.product_line_ids.mapped('qty_produced'))"/>
                        
                        <div class="col-12">
                            Khách hàng: <t t-esc="doc.sudo().partner_id.name"/>, tổng phát sinh số lượng <t t-esc="'%.3f' % float(sum_quantity + sum_qty_produced)"/> tấn hàng:
                        </div>
                    </div>
                    <div class="row" style="padding-top: 4px;">
                        <div class="col-12">
                            Đơn hàng: <strong><t t-esc="doc.sale_order_id.name"/></strong>
                        </div>
                    </div>
                    <div class="row" style="margin-top: 12px">
                        <table class="table table-sm" style="padding:0px;border: solid 1px; width: 100%; margin-top: 4px;">
                            <thead>
                                <tr>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;">
                                        <strong>STT</strong>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;">
                                        <strong>Mẫu bao</strong>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;">
                                        <strong>Mã hàng</strong>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;">
                                        <strong>Tên hàng</strong>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;">
                                        <strong>Tồn kho (tấn)</strong>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;">
                                        <strong>Sản xuất (tấn)</strong>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;">
                                        <strong>Ghi chú</strong>
                                    </td>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="number" t-value="0"/>
                                <tr t-foreach="doc.product_line_ids" t-as="line">
                                    <t t-set="number" t-value="number + 1"/>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle;">
                                        <span style="padding:0 6px;text-align: center; vertical-align: middle;" t-esc="number"/>
                                    </td>
                                    <td class='text-center'>
                                        <img t-if="line.product_image" alt="product image" t-att-src="image_data_uri(line.product_image)" style="margin: 0 auto;max-width: 100px;max-height: 75px;"/>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle">
                                        <span t-esc="line.product_id.default_code"/>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: left; vertical-align: middle">
                                        <span t-esc="line.product_id.name"/>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle">
                                        <span t-esc="'%.3f' % float(line.quantity)"/>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center; vertical-align: middle">
                                        <span t-esc="'%.3f' % float(line.qty_produced)"/>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: left; vertical-align: middle">
                                        <span t-esc="line.note"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="border border-dark" colspan="4" style="padding:0 6px;text-align: left;">
                                        <strong>Tổng cộng</strong>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center;">
                                        <strong>
                                            <span style="padding:0 6px;text-decoration: underline;" t-esc="'%.3f' % float(sum_quantity)"/>
                                        </strong>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center;">
                                        <strong>
                                            <span style="padding:0 6px;text-decoration: underline;" t-esc="'%.3f' % float(sum_qty_produced)"/>
                                        </strong>
                                    </td>
                                    <td class="border border-dark" style="padding:0 6px;text-align: center;"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="row" style="padding-top: 4px;">
                        <div class="col-12">
                            <span><strong>Số lần sản xuất</strong>: <t t-esc="doc.count_production"/> tháng <t t-esc="doc.date.strftime('%m/%Y')"/></span>
                        </div>
                    </div>
                    <div class="row" style="padding-top: 4px;">
                        <div class="col-12">
                            <span><strong>Số lần tồn kho</strong>: <t t-esc="doc.count_stock"/> tháng <t t-esc="doc.date.strftime('%m/%Y')"/></span>
                        </div>
                    </div>
                    <div class="row" style="padding-top: 4px;">
                        <div class="col-12">
                            <span><strong>Nguyên nhân</strong>: <t t-esc="doc.description_convert"/></span>
                        </div>
                    </div>
                    
                    <div class="row" style="padding-top: 4px;">
                        <div class="col-12">
                            <span>Các đơn về sau trong tháng sẽ không còn lấy gấp nữa. Khu Vực cam kết phần phát sinh này nếu có xảy ra khiếu nại sẽ tự giải quyết, không phản hồi Khối sản xuất.</span>
                        </div>
                    </div>
                    <div class="row rowp" style="text-align: center; margin-top: 12px">
                        <t t-set="team_lead" t-value="doc.sudo().approver_ids.filtered(lambda l:l.user_id.id in doc.team_id.sudo().user_id.ids and l.status == 'approved')"/>
                        <t t-set="sale_admin" t-value="doc.sudo().approver_ids.filtered(lambda l:l.user_id.id in [56] and l.status == 'approved')"/>
                        <t t-set="unit_head" t-value="doc.sudo().approver_ids.filtered(lambda l:l.user_id.id in [43,60,62,61] and l.status == 'approved')"/>
                        <t t-set="stocker" t-value="doc.sudo().approver_ids.filtered(lambda l:l.status == 'approved') - team_lead - sale_admin - unit_head"/>
                        <div class="col-4">
                            <span>
                                <strong>Chịu trách nhiệm</strong>
                            </span>
                            <br/>
                            <t t-if="team_lead and team_lead.sudo().user_id.sign_signature is not False">
                                <br/>
                                <img t-att-src="image_data_uri(team_lead.sudo().user_id.sign_signature)" width='120px' height="50px"/>
                            </t>
                            <t t-else=""><br/><br/><br/><br/></t>
                            <br/>
                            <span><strong t-if="team_lead" t-esc="team_lead.sudo().user_id.name_without_position"/></span>
                        </div>
                        <div class="col-4">
                            <span>
                                <strong>Sản xuất</strong>
                            </span>
                            <br/>
                            <t t-if="stocker and stocker[0].sudo().user_id.sign_signature is not False">
                                <br/>
                                <img t-att-src="image_data_uri(stocker[0].sudo().user_id.sign_signature)" width='120px' height="50px"/>
                            </t>
                            <t t-else=""><br/><br/><br/><br/></t>
                            <br/>
                            <span><strong t-if="stocker" t-esc="stocker[0].sudo().user_id.name_without_position"/></span>
                        </div>
                        <div class="col-4">
                            <span>
                                <strong>Ban Lãnh Đạo</strong>
                                <!-- <t t-if="doc.sudo().create_uid.sign_signature is not False">
                                    <img t-att-src="image_data_uri(doc.sudo().create_uid.sign_signature)" width='60px' height="25px" style="margin-top: -30px"/>
                                </t> -->
                                <t t-if="sale_admin and sale_admin.sudo().user_id.sign_signature is not False">
                                    <img t-att-src="image_data_uri(sale_admin.sudo().user_id.sign_signature)" width='60px' height="25px"/>
                                </t>
                            </span>
                            <br/>
                            <t t-if="unit_head and unit_head.sudo().user_id.sign_signature is not False">
                                <br/>
                                <img t-att-src="image_data_uri(unit_head.sudo().user_id.sign_signature)" width='120px' height="50px"/>
                            </t>
                            <t t-else=""><br/><br/><br/><br/></t>
                            <br/>
                            <span><strong t-if="unit_head" t-esc="unit_head.sudo().user_id.name_without_position"/></span>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>