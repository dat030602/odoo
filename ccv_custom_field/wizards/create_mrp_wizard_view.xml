<odoo>
    <record id="view_create_mrp_wizard" model="ir.ui.view">
        <field name="name">create.mrp.wizard.form</field>
        <field name="model">create.mrp.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo">
                <group>
                    <field name="approval_request_id" readonly="1" invisible="1"/>
                    <field name="picking_type_id"/>
                    <field name="scheduled_date"/>
                </group>
                <notebook>
                    <page string="Chi tiết" name="line_ids">
                        <field name="line_ids">
                            <tree editable='bottom'>
                                <field name="picking_type_id"/>
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="product_uom"/>
                                <field name="bom_id"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Tạo phiếu" type="object" name="action_create_mrp_order" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_create_mrp_wizard"
        name="Tạo phiếu kho"
        res_model="create.mrp.wizard"
        view_mode="form"
        target="new"
        binding_model="approval.request"
    />
</odoo>
