<odoo>
    <record id="view_remove_internal_picking_mrp_wizard" model="ir.ui.view">
        <field name="name">remove.internal.picking.mrp.wizard.form</field>
        <field name="model">remove.internal.picking.mrp.wizard</field>
        <field name="arch" type="xml">
            <form string="Xóa phiếu nội bộ">
                <group>
                    <field name="mrp_production_ids" readonly="1" invisible="1"/>
                    <field name="picking_type_id"/>
                    <field name="location_src_id"/>
                    <field name="location_dest_id"/>
                </group>
                <notebook>
                    <page string="Chi tiết" name="mrp_production_ids">
                        <field name="mrp_production_ids">
                            <tree editable='bottom'>
                                <field name="name"/>
                                <field name="product_id"/>
                                <field name="company_id" invisible="1"/>
                                <field name="picking_type_id"/>
                                <field name="location_src_id"/>
                                <field name="location_dest_id"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Xóa phiếu" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_remove_internal_picking_mrp_wizard"
        name="Xóa phiếu nội bộ"
        res_model="remove.internal.picking.mrp.wizard"
        view_mode="form"
        target="new"
        binding_model="mrp.production"
    />
</odoo>
