<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_shortage" model="ir.ui.view">
        <field name="name">mrp.production.form.shortage</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_start']" position="after">
                <field name="readiness_percentage" widget="progressbar"/>
                <field name="shortage_line_count"/>
            </xpath>
        </field>
    </record>
</odoo>
