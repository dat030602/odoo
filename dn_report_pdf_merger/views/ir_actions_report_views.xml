<odoo>
    <record id="view_ir_actions_report_pdf_merger_form" model="ir.ui.view">
        <field name="name">ir.actions.report.inherit.pdf.merger</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="PDF Attachments" invisible="report_type != 'qweb-pdf'">
                    <group>
                        <field name="prepend_file_ids" context="{'default_position': 'prepend'}">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="attachment_id"/>
                                <field name="position" column_invisible="1"/>
                            </list>
                        </field>
                        <field name="append_file_ids" context="{'default_position': 'append'}">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="attachment_id"/>
                                <field name="position" column_invisible="1"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
