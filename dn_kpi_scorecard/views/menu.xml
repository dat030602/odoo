<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main App Root Menu -->
    <menuitem name="KPI Scorecard"
              id="menu_kpi_main"
              sequence="45"
              groups="base.group_user"
              web_icon="dn_kpi_scorecard,static/description/icon.png"
    />

    <!-- 1. Scorecards Menu -->
    <menuitem name="Scorecards"
              id="menu_kpi_scorecard_section"
              parent="menu_kpi_main"
              sequence="10"
              groups="base.group_user"
    />
    <menuitem name="Scorecard Dashboard"
              id="menu_kpi_scorecard"
              parent="menu_kpi_scorecard_section"
              action="dn_kpi_scorecard.kpi_scorecard_line_action"
              sequence="10"
              groups="base.group_user"
    />
    <menuitem name="Periods"
              id="menu_kpi_period"
              parent="menu_kpi_scorecard_section"
              action="dn_kpi_scorecard.kpi_period_action"
              sequence="20"
              groups="dn_kpi_scorecard.group_kpi_admin"
    />

    <!-- 2. KPIs Menu -->
    <menuitem name="KPIs"
              id="menu_kpi_definitions_section"
              parent="menu_kpi_main"
              sequence="20"
              groups="dn_kpi_scorecard.group_kpi_admin,dn_kpi_scorecard.group_kpi_user_see_all_kpi"
    />
    <menuitem name="KPI Items"
              id="menu_kpi_kpi"
              parent="menu_kpi_definitions_section"
              action="dn_kpi_scorecard.kpi_item_action"
              sequence="10"
              groups="dn_kpi_scorecard.group_kpi_admin,dn_kpi_scorecard.group_kpi_user_see_all_kpi"
    />
    <menuitem name="Categories / Perspectives"
              id="menu_kpi_categories_mgmt"
              parent="menu_kpi_definitions_section"
              action="dn_kpi_scorecard.kpi_category_action"
              sequence="20"
              groups="dn_kpi_scorecard.group_kpi_admin"
    />

    <!-- 3. Measurements Menu -->
    <menuitem name="Measurements"
              id="menu_kpi_measurements_general"
              parent="menu_kpi_main"
              sequence="30"
              groups="dn_kpi_scorecard.group_kpi_admin"
    />
    <menuitem name="Variables"
              id="menu_kpi_measures"
              parent="menu_kpi_measurements_general"
              action="dn_kpi_scorecard.kpi_measure_item_action"
              sequence="10"
              groups="dn_kpi_scorecard.group_kpi_admin"
    />
    <menuitem name="Base Measurements"
              id="menu_kpi_basic_measures"
              parent="menu_kpi_measurements_general"
              action="dn_kpi_scorecard.kpi_measure_action"
              sequence="30"
              groups="dn_kpi_scorecard.group_kpi_admin"
    />

    <!-- 4. Configuration Menu -->
    <menuitem name="Configuration"
              id="menu_kpi_conf"
              parent="menu_kpi_main"
              sequence="100"
              groups="dn_kpi_scorecard.group_kpi_admin"
    />
    <menuitem name="Settings"
              id="menu_kpi_settings"
              parent="menu_kpi_conf"
              action="dn_kpi_scorecard.res_config_settings_kpi_scorecard_action"
              sequence="10"
              groups="dn_kpi_scorecard.group_kpi_admin"
    />
    <menuitem name="KPI Categories"
              id="menu_kpi_categories"
              parent="menu_kpi_conf"
              action="dn_kpi_scorecard.kpi_category_action"
              sequence="20"
              groups="dn_kpi_scorecard.group_kpi_admin"
    />

</odoo>
