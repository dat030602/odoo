<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.kpi.scorecard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="KPI Scorecard" string="KPI Scorecard" name="dn_kpi_scorecard">
                    <block title="General Configuration" id="kpi_scorecard_general">
                        <setting id="kpi_company" title="Company" help="Select company to configure KPI management settings" groups="base.group_multi_company">
                            <field name="kpi_company_id" options="{'no_create_edit': 1, 'no_quick_create': 1}"/>
                        </setting>
                        <setting id="kpi_tolerance" title="History Tolerance (Days)" help="Define how to distinguish similar periods. For example, 7-days periods might be compared to 5-days and 9-days periods. Then, tolerance would be 2. If you have monthly or quarterly periods you should have at least 3-days tolerance.">
                            <field name="kpi_history_tolerance"/>
                        </setting>
                        <setting id="kpi_cron_setting" title="Automatic Recalculation" help="Configure when and how frequent KPIs actual values should be re-calculated">
                            <button name="action_open_kpi_cron" type="object" icon="fa-arrow-right" string="Configure Cron Job" class="btn-link"/>
                        </setting>
                        <setting id="show_kpi_help_setting" title="Help Notes" help="Turn on / off help notes on KPI settings objects">
                            <field name="show_kpi_help"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_kpi_scorecard_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module' : 'dn_kpi_scorecard'}</field>
    </record>

</odoo>
