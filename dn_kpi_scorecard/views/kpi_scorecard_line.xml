<?xml version="1.0"?>
<odoo>

    <record id="kpi_scorecard_line_view_search" model="ir.ui.view">
        <field name="name">kpi.scorecard.line.search</field>
        <field name="model">kpi.scorecard.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="kpi_id"/>
                <filter string="Failed Targets"
                        name="failures" 
                        domain="[('result', '=', 'failure')]"
                />
                <filter string="Reached Targets"
                        name="success" 
                        domain="[('result', '=', 'success')]"
                />
                <filter string="Computation Errors"
                        name="errors" 
                        domain="[('result', '=', 'error')]"
                />
            </search>
        </field>
    </record>
    <record id="kpi_scorecard_line_view_form" model="ir.ui.view">
        <field name="name">kpi.scorecard.line.form</field>
        <field name="model">kpi.scorecard.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="kpi_id"/>
                        <field name="employee_id"/>
                        <field name="target_value"/>
                        <field name="period_id"
                               options="{'no_create_edit': 1, 'no_quick_create': 1}" 
                               invisible="1" 
                        />
                    </group>
                    <div >
                        <field name="kpi_help_dummy" invisible="1"/>
                        <label for="help_notes"  invisible="1"/>
                        <field name="help_notes"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="kpi_scorecard_line_view_tree" model="ir.ui.view">
        <field name="name">kpi.scorecard.line.tree</field>
        <field name="model">kpi.scorecard.line</field>
        <field name="arch" type="xml">
            <list decoration-success="result == 'success'"
                  decoration-danger="result == 'failure'"
                  decoration-muted="result == 'error'"
            >
                <field name="period_id"/>
                <field name="kpi_id"/>
                <field name="employee_id"/>
                <field name="formatted_target_value" string="Target"/>
                <field name="formatted_actual_value" string="Actual"/>
                <field name="progress_rate" widget="progressbar" string="Progress"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'success'"
                       decoration-danger="result == 'failure'"
                       decoration-muted="result == 'error'"
                />
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="kpi_scorecard_line_view_kanban" model="ir.ui.view">
        <field name="name">kpi.scorecard.line.kanban</field>
        <field name="model">kpi.scorecard.line</field>
        <field name="arch" type="xml">
            <kanban  
                    class="kpi-kanban-view"
                    group_create="0"
                    group_delete="0"
                    group_edit="0" 
                    archivable="0"
                    quick_create="0"
                    records_draggable="0"   
            >
                <field name="id"/>
                <field name="kpi_id"/>
                <field name="category_id"/>
                <field name="employee_id"/>
                <field name="formatted_target_value"/>
                <field name="formatted_actual_value"/>
                <field name="progress_rate"/>
                <field name="computation_error"/>
                <field name="result"/>
                <field name="all_parents"/>
                <field name="sequence"/>
                <field name="description"/>
                <field name="edit_rights"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="kpi-kanban-record-card py-2 px-3 d-flex align-items-center #{record.result.raw_value == 'success' ? 'border-start-success' : (record.result.raw_value == 'failure' ? 'border-start-danger' : 'border-start-muted')}"
                             t-att-id="id"
                        >
                            <!-- 1. Progress Bar on the LEFT -->
                            <div class="kpi-kanban-progress me-3 text-center d-flex flex-column align-items-center justify-content-center">
                                <div t-attf-class="fw-bold fs-6 #{record.result.raw_value == 'success' ? 'text-success' : (record.result.raw_value == 'failure' ? 'text-danger' : 'text-muted')}">
                                    <field name="progress_rate"/>%
                                </div>
                                <div class="progress mt-1" style="width: 56px; height: 6px; background-color: #e9ecef; border-radius: 3px;">
                                    <div t-attf-class="progress-bar #{record.result.raw_value == 'success' ? 'bg-success' : (record.result.raw_value == 'failure' ? 'bg-danger' : 'bg-secondary')}"
                                         t-attf-style="width: #{Math.min(Math.max(record.progress_rate.raw_value or 0, 0), 100)}%; border-radius: 3px;"/>
                                </div>
                            </div>

                            <!-- 2. Middle: Name and figures UNDER the name -->
                            <div class="kpi-kanban-main flex-grow-1 overflow-hidden">
                                <!-- Line 1: KPI Name & Tags -->
                                <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                                    <span class="fw-bold text-dark fs-6 text-truncate" t-att-title="record.description.raw_value or ''">
                                        <field name="kpi_id"/>
                                    </span>
                                    <t t-if="record.category_id.raw_value">
                                        <span class="badge bg-light text-secondary border">
                                            <field name="category_id"/>
                                        </span>
                                    </t>
                                    <t t-if="record.employee_id.raw_value">
                                        <span class="badge rounded-pill bg-light text-secondary border">
                                            <i class="fa fa-user me-1"/><field name="employee_id"/>
                                        </span>
                                    </t>
                                    <i t-if="record.computation_error.raw_value"
                                       class="fa fa-warning text-danger" 
                                       t-att-title="record.computation_error.raw_value"/>
                                </div>

                                <!-- Line 2: Figures UNDER name -->
                                <div class="d-flex align-items-center flex-wrap gap-3 text-muted small">
                                    <span>
                                        Target: <strong class="text-dark"><field name="formatted_target_value"/></strong>
                                    </span>
                                    <span>
                                        Actual: 
                                        <strong t-attf-class="#{record.result.raw_value == 'success' ? 'text-success' : (record.result.raw_value == 'failure' ? 'text-danger' : 'text-muted')}">
                                            <field name="formatted_actual_value"/>
                                        </strong>
                                    </span>
                                    <span t-attf-class="badge #{record.result.raw_value == 'success' ? 'bg-success' : (record.result.raw_value == 'failure' ? 'bg-danger' : 'bg-secondary')}">
                                        <t t-if="record.result.raw_value == 'success'">Achieved</t>
                                        <t t-elif="record.result.raw_value == 'failure'">Failed</t>
                                        <t t-else="">Error</t>
                                    </span>
                                </div>
                            </div>

                            <!-- 3. Action Buttons on the RIGHT -->
                            <div class="kpi-kanban-buttons ms-auto ps-2 d-flex gap-1 align-items-center flex-shrink-0">
                                <button type="open" 
                                        class="btn btn-sm btn-outline-primary kpi-kanban-row-btn"
                                        title="Change Target"
                                        t-if="record.edit_rights.raw_value">
                                    <i class="fa fa-edit"/>
                                </button>    
                                <button type="object" 
                                        name="action_show_history"
                                        class="btn btn-sm btn-outline-secondary kpi-kanban-row-btn"
                                        title="History">
                                    <i class="fa fa-signal"/>
                                </button> 
                                <button type="delete" 
                                        class="btn btn-sm btn-outline-danger kpi-kanban-row-btn"
                                        title="Delete Target"
                                        t-if="record.edit_rights.raw_value">
                                    <i class="fa fa-trash"/>
                                </button> 
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="kpi_scorecard_line_action" model="ir.actions.act_window">
        <field name="name">KPI Scorecard</field>
        <field name="res_model">kpi.scorecard.line</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="target">main</field> 
        <field name="search_view_id" ref="kpi_scorecard_line_view_search"/>
    </record>

</odoo>
