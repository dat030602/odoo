<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security group that gates the internal transfer valuation feature -->
        <record id="group_internal_transfer_valuation" model="res.groups">
            <field name="name">Internal Transfer Valuation</field>
        </record>

        <!-- Multi-company record rule for stock.valuation.layer -->
        <record id="stock_valuation_layer_rule" model="ir.rule">
            <field name="name">Stock Valuation Layer multi-company</field>
            <field name="model_id" ref="model_stock_valuation_layer"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
