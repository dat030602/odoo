<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_inherit_account_invoice_ccv" model="ir.ui.view">
        <field name="name">view.config.settings.account.invoice.ccv</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account_reports.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='account_reports_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="remove_customer_reports_ccv"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="remove_customer_reports_ccv"/>
                        <span class="fa fa-lg fa-building-o" groups="base.group_multi_company"/>
                        <div class="text-muted">
                            If checked, reports including customer will be removed.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>