<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="document_number_sale" attrs="{'invisible': [('move_type','not in',['out_invoice','out_refund'])]}"/>
            </xpath>
            <!-- <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='account_id']" position="after">
                <field name="product_not_taxable"/>
            </xpath> -->
            <xpath expr="//field[@name='line_ids']//tree//field[@name='account_id']" position="after">
                <field name="product_not_taxable"/>
            </xpath>
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="report_date" attrs="{'readonly': [('state', '=', 'posted')]}"/>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="is_gift_entries" attrs="{'readonly':[('state','!=','draft')]}"/>
            </xpath>
        </field>
    </record>
</odoo>