<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paper_format_proposal_form" model="report.paperformat">
            <field name="name">Format Proposal Form</field>
            <field name="default" eval="True"/>
            <field name="format">A5</field>
            <field name="orientation">Landscape</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_spacing">23</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_proposal_form" model="ir.actions.report">
            <field name="name">Print Proposal Form</field>
            <field name="model">approval.request</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">biz_ccv_approvals.proposal_form_template</field>
            <field name="report_file">biz_ccv_approvals.proposal_form_template</field>
            <field name="print_report_name">'Proposal %s' % (object.name)</field>
            <field name="binding_model_id" ref="approvals.model_approval_request"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref='paper_format_proposal_form'/>
        </record>
    </data>
</odoo>