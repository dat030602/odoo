<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_manual_rate" model="ir.ui.view">
        <field name="name">account.move.form.inherit.manual.rate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='currency_conversion_div']" position="before">
                <div class="d-flex gap-2 align-items-center mb-1"
                     invisible="currency_id == company_currency_id or move_type == 'entry'"
                     groups="dn_currency_rate_manual_base.group_manual_currency_rate">
                    <span class="text-muted">Rate Mode:</span>
                    <field name="rate_mode" readonly="state != 'draft'" class="w-auto"/>
                    <field name="selected_rate_id"
                           invisible="rate_mode != 'custom'"
                           readonly="state != 'draft'"
                           options="{'no_create': True, 'no_open': True}"
                           class="w-auto"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='invoice_currency_rate']" position="attributes">
                <attribute name="readonly">state != 'draft' or rate_mode == 'custom'</attribute>
            </xpath>
            <xpath expr="//button[@name='refresh_invoice_currency_rate']/parent::div" position="attributes">
                <attribute name="invisible">show_journal or state != 'draft' or invoice_currency_rate == expected_currency_rate or rate_mode == 'custom'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
