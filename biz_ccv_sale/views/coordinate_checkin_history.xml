<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="coordinate_checkin_history_tree" model="ir.ui.view">
        <field name="name">coordinate.checkin.history.tree</field>
        <field name="model">coordinate.checkin.history</field>
        <field name="arch" type="xml">
            <tree string="Coordinate Checkin History" create="0" edit="0">
                <field name="latitude" readonly="1"/>
                <field name="Longitude" readonly="1"/>
                <field name="partner_id" readonly="1"/>
                <field name="sale_person_id" readonly="1"/>
                
                <field name="user_id" readonly="1"/>
                <field name="checkin_date" readonly="1"/>
                <field name="status" readonly="1"/>
                <field name="checkin_image" widget="image" class="oe_avatar"/>
            </tree>
        </field>
    </record>

    <record id="coordinate_checkin_history_form" model="ir.ui.view">
        <field name="name">coordinate.checkin.history.form</field>
        <field name="model">coordinate.checkin.history</field>
        <field name="arch" type="xml">
            <form string="Coordinate Checkin History" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="latitude" readonly="1"/>
                            <field name="Longitude" readonly="1"/>
                            <field name="tolerance" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="sale_person_id"/>
                            <field name="checkin_date" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group name="image">
                            <field name="checkin_image" context="{'show_preview_image': True}" widget='image' class="oe_avatar biz_img" options='{"preview_image": "image", "size": [200, 200]}'  nolabel="1"/>
                        </group>                     
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="coordinate_checkin_history_search" model="ir.ui.view">
        <field name="name">coordinate.checkin.history.search</field>
        <field name="model">coordinate.checkin.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="sale_person_id"/>
                <group expand="1" string="Group by">
                    <filter string="Customer" name="group_partner_id" context="{'group_by': 'partner_id'}" />
                    <filter string="Sale Person" name="group_sale_person" context="{'group_by': 'sale_person_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_coordinate_checkin_history" model="ir.actions.act_window">
        <field name="name">Coordinate Checkin History</field>
        <field name="res_model">coordinate.checkin.history</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_sale_person': True}</field>
    </record>

<!--     <menuitem id="coordinate_checkin_history_menu" name="Coordinate Checkin History" parent="contacts.menu_contacts"
              action="action_coordinate_checkin_history" sequence="3"/> -->

    <menuitem id="coordinate_checkin_history_menu_crm" name="Coordinate Checkin History" 
                parent="crm.crm_menu_root" action="action_coordinate_checkin_history" 
                sequence="-4"/>

</odoo>
