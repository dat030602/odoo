<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_search_form_view_inherit" model="ir.ui.view">
        <field name="name">product.product.search.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="default_code"
                       filter_domain="[('default_code', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>


    <record id="view_stock_product_template_tree_inherit" model="ir.ui.view">
        <field name="name">product.template.stock.tree.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_stock_product_template_tree"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='responsible_id']" position="replace">
               <field name="responsible_id" widget="many2one_avatar_user" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_ccv" model="ir.ui.view">
        <field name="name">product.template.common.form.ccv</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="attributes">
               <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="property_account_expense_id"
                       string="Tài khoản chi phí"
                       groups="account.group_account_readonly"
                       options="{'no_create': True}"
                       domain="[]"
                       placeholder="Sử dụng tài khoản từ danh mục sản phẩm"/>
            </xpath>

            <field name="image_1920" position="attributes">
                <attribute name="help">Packaging Image</attribute>
            </field>
            <field name="image_1920" position="after">
                <field name="packaging_image" widget="image" class="oe_avatar" help="Product Image"/>
            </field>
        </field>
    </record>
</odoo>
