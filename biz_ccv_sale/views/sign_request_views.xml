<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  SIGN REQUEST  -->
    <record model="ir.ui.view" id="sign_request_view_form_inherit">
        <field name="name">sign.request.form.inherit</field>
        <field name="model">sign.request</field>
        <field name="inherit_id" ref="sign.sign_request_view_form"/>
        <field name="arch" type="xml">
            <field name="request_item_ids" position="before">
                <group>
                    <field name="sale_order_id"/>
                </group>
<!--                <label for="sale_order_id"/>-->
<!--                <field name="sale_order_id" options="{'no_create': True}"/>-->
            </field>
        </field>
    </record>

    <record id="sign_request_view_search_inherited" model="ir.ui.view">
        <field name="name">sign.request.search.inherited</field>
        <field name="model">sign.request</field>
        <field name="inherit_id" ref="sign.sign_request_view_search"/>
        <field name="arch" type="xml">
            <field name="template_id" position="after">
                <field name="sale_order_id"/>
            </field>
            <group position="inside">
                <filter string="Sale Order" name="group_sale_order" domain="[]" context="{'group_by': 'sale_order_id'}"/>
            </group>

            <field name="reference" position="replace">
                <field name="reference" string="Document"/>
                <field name="request_item_ids" string="Signer" filter_domain="['|',('request_item_ids.partner_id.email', 'ilike', self), ('request_item_ids.partner_id.name', 'ilike', self)]"/>
            </field>
        </field>
    </record>

</odoo>