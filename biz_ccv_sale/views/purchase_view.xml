<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='product_uom']" position="replace">
                <field name="product_uom" groups="!uom.group_uom"/>
            </xpath>
            <xpath expr="//field[@name='product_qty']" position="before">
                <field name="amount_conversion" force_save="1" optional="hide"/>
                <field name="conversion_unit" options="{'no_create': True}"
                       attrs="{'invisible': [('product_uom', '=', False)]}"
                       domain="[('category_id', '=', product_uom_category_id)]" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='date_order']/.." position="inside">
                <field name="purchase_order_type_id"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_search_inherited_ccv" model="ir.ui.view">
        <field name="name">purchase.order.select.inherited.ccv</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="purchase_order_type_id"/>
                <filter string="Purchase Order Type" name="filter_purchase_order_type" domain="[('purchase_order_type_id', '!=', False)]"/>
                <separator/>
            </field>

            <group position="inside">
                <filter string="Purchase Order Type" name="group_purchase_order_type" domain="[]" context="{'group_by': 'purchase_order_type_id'}"/>
            </group>
        </field>
    </record>

    <record id="view_purchase_order_filter_inherited_ccv" model="ir.ui.view">
        <field name="name">request.quotation.select.inherited.ccv</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="purchase_order_type_id"/>
                <filter string="Purchase Order Type" name="filter_purchase_order_type" domain="[('purchase_order_type_id', '!=', False)]"/>
                <separator/>
            </field>

            <group position="inside">
                <filter string="Purchase Order Type" name="group_purchase_order_type" domain="[]" context="{'group_by': 'purchase_order_type_id'}"/>
            </group>
        </field>
    </record>
</odoo>

