<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.team.form.inherit</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="member_ids_domain" invisible="1"/>
            </field>
            <xpath expr="//field[@name='member_ids']" position="replace">
                <field name="member_ids" widget="many2many">
                    <tree>
                        <field name="name"/>
                        <field name="login"/>
                        <field name="email"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
</odoo>