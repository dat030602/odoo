<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Báo cáo tuyến bán hàng -->
    <record model="ir.ui.view" id="sale_route_report_kanban_view">
        <field name="name">sale.route.report.kanban</field>
        <field name="model">sale.route.report</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="id"/>
                <field name="partner_id"/>
                <field name="checkin_latitude"/>
                <field name="checkin_longitude"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details d-flex flex-column justify-content-between">
                                <div>
                                    <strong class="o_kanban_record_title oe_partner_heading"><field name="partner_id"/></strong>
                                    <div class="o_kanban_tags_section"/>
                                    <ul>
                                        <li t-if="record.checkin_address">Address: <field name="checkin_address"/></li>
                                        <li t-if="record.checkin_latitude">Latitude: <field name="checkin_latitude"/></li>
                                        <li t-if="record.checkin_longitude">Longtitude: <field name="checkin_longitude"/></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="sale_route_report_graph_view" model="ir.ui.view">
        <field name="name">sale.route.report.view.graph</field>
        <field name="model">sale.route.report</field>
        <field name="arch" type="xml">
            <graph  sample="1">
                <field name="partner_id"/>
                <field name="checkin_latitude"/>
                <field name="checkin_longitude"/>
            </graph>
        </field>
    </record>

    <record id="sale_route_report_pivot_view" model="ir.ui.view">
        <field name="name">sale.route.report.view.pivot</field>
        <field name="model">sale.route.report</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="partner_id" type="col"/>
                <field name="checkin_status" type="row"/>
                <field name="time" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sale_route_report_tree_report" model="ir.ui.view">
        <field name="name">sale.route.report.tree.report</field>
        <field name="model">sale.route.report</field>
        <field name="arch" type="xml">
            <tree string="Sale route report">
                <field name="sale_route_code" optional="show"/>
                <field name="sale_route_id" optional="show" invisible="1"/>
                <field name="user_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="checkin_latitude"  optional="show"/>
                <field name="checkin_longitude"  optional="show"/>
                <field name="checkin_date" optional="show"/>
                <field name="checkin_status" optional="show"/>
                <field name="checkin_image" widget="image" class="oe_avatar" optional="show"/>
                <field name="checkin_address" optional="show"/>
                <field name="checkout_latitude" optional="show"/>
                <field name="checkout_longitude" optional="show"/>
                <field name="checkout_date" optional="show"/>
                <field name="checkout_status" optional="show"/>
                <field name="checkout_image" widget="image" class="oe_avatar" optional="show"/>
                <field name="checkout_address" optional="show"/>
                <field name="time" widget="float_time" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="sale_route_report_form_view_report" model="ir.ui.view">
        <field name="name">sale.route.report.form.report</field>
        <field name="model">sale.route.report</field>
        <field name="arch" type="xml">
            <form string="Sale route report"  create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sale_person_id"/>
                            <field name="sale_route_id"/>
                        </group>
                        <group>
                            <field name="tolerance"/>
                            <field name="time" widget="float_time"/>
                        </group>
                    </group>
                    <group>
                        <group string="Check-in information">
                            <field name="checkin_latitude" />
                            <field name="checkin_longitude" />
                            <field name="checkin_date" />
                            <field name="checkin_status" />
                            <field name="checkin_address"/>
                            <label for="checkin_image"/>
                            <div>
                                <field name="checkin_image" class="oe_left oe_avatar" widget="image"/>
                                <button name="down_load_checkin_image" type="object" icon="fa-download"/>
                            </div>
                        </group>
                        <group string="Check-out information">
                            <field name="checkout_latitude"/>
                            <field name="checkout_longitude"/>
                            <field name="checkout_date"/>
                            <field name="checkout_status"/>
                            <field name="checkout_address"/>
                            <label for="checkout_image"/>
                            <div>
                                <field name="checkout_image" class="oe_left oe_avatar" widget="image"/>
                                <button name="down_load_checkout_image" type="object" icon="fa-download"/>
                            </div>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_sale_route_report_report" model="ir.actions.act_window">
        <field name="name">Sale route report</field>
        <field name="res_model">sale.route.report</field>
        <field name="context">{'create': 0, 'edit': 0}</field>
        <field name="domain">[]</field>
        <field name="view_mode">tree,form,pivot,kanban,graph</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('sale_route_report_tree_report')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sale_route_report_form_view_report')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('sale_route_report_pivot_view')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('sale_route_report_graph_view')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('sale_route_report_kanban_view')})]"/>
    </record>

  <!--   <menuitem id="sale_route_report_menu_report" name="Sale route report" parent="contacts.menu_contacts"
              action="action_sale_route_report_report" sequence="3"/>
 -->
    <menuitem id="sale_route_report_menu_report_crm" name="Sale route report" parent="crm.crm_menu_root"
              action="action_sale_route_report_report" sequence="0"/>
</odoo>
