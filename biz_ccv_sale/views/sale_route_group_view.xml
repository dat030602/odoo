<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_route_group_tree" model="ir.ui.view">
        <field name="name">sale.route.group.tree</field>
        <field name="model">sale.route.group</field>
        <field name="arch" type="xml">
            <tree string="Sale route group">
                <field name="name" />
                <field name="code" />
                <field name="company_id" />
            </tree>
        </field>
    </record>

    <record id="sale_route_group_form" model="ir.ui.view">
        <field name="name">sale.route.group.form</field>
        <field name="model">sale.route.group</field>
        <field name="arch" type="xml">
            <form string="Sale route group" >
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <div class="o_row">
                                <field name="name"  placeholder="Name group" nolabel="1"/>
                            </div>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="company_id" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="sale_route_group_form_popup" model="ir.ui.view">
        <field name="name">sale.route.group.form.popup</field>
        <field name="model">sale.route.group</field>
        <field name="arch" type="xml">
            <form string="Sale route group" >
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <div class="o_row">
                                <field name="name"  placeholder="Name group" nolabel="1"/>
                            </div>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_route_group" model="ir.actions.act_window">
        <field name="name">Sale route group</field>
        <field name="res_model">sale.route.group</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_sale_person': True}</field>
    </record>

<!--     <menuitem id="sale_route_group_menu" name="Sale route group" parent="contacts.res_partner_menu_config"
              action="action_sale_route_group" sequence="99"/> -->

    <menuitem id="sale_route_group_menu_crm" name="Sale route group" parent="crm.crm_menu_config"
              action="action_sale_route_group" sequence="99"/>
</odoo>
