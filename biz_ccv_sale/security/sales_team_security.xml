<?xml version="1.0"?>
<odoo>

<data noupdate="0">
    <!-- I> RULE: Lịch sử check in tọa độ -->
    <record id="all_history_checkin_coordinates" model="ir.rule">
        <field name="name">coordinate.checkin.history: All History check in coordinates</field>
        <field name="model_id" ref="biz_ccv_sale.model_coordinate_checkin_history"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(6,0,[ref('sales_team.group_sale_salesman_all_leads'), ref('sales_team.group_sale_manager')])]"/>
    </record>

    <record id="coordinate_checkin_history_personal_rule" model="ir.rule">
        <field name="name">coordinate.checkin.history: Personal Orders</field>
        <field ref="model_coordinate_checkin_history" name="model_id"/>
        <field name="domain_force">[('user_id','=',user.id),('user_id','!=',False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="coordinate_checkin_history_team_lead" model="ir.rule">
        <field name="name">coordinate.checkin.history: Team Leader</field>
        <field name="model_id" ref="biz_ccv_sale.model_coordinate_checkin_history"/>
        <field name="domain_force">
            [('user_id.sale_team_id.user_id', '=', user.id)]  
        </field>
        <field name="groups" eval="[
            Command.link(ref('biz_ccv_account.group_sales_team_leader')),
        ]"/>
    </record>

    <record id="coordinate_checkin_history_team_assistant" model="ir.rule">
        <field name="name">coordinate.checkin.history: Team Assistant</field>
        <field name="model_id" ref="biz_ccv_sale.model_coordinate_checkin_history"/>
        <field name="domain_force">
            [('user_id.sale_team_id.sales_assistant_ids', 'in', [user.id])]
        
        </field>
        <field name="groups" eval="[
            Command.link(ref('biz_ccv_account.group_sales_admin_sales_team_leader')),
        ]"/>
    </record>


    <!-- <record id="coordinate_checkin_history_team_assistant" model="ir.rule">
        <field name="name">coordinate.checkin.history: Team Assistant</field>
        <field name="model_id" ref="biz_ccv_sale.model_coordinate_checkin_history"/>
        <field name="domain_force">
            [('user_id.sale_team_id.sales_assistant_ids', 'in', [user.id])]
        
        </field>
        <field name="groups" eval="[
            Command.link(ref('biz_ccv_account.group_sales_admin_sales_team_leader')),
        ]"/>
    </record> -->


    <!-- II> RULE: Tuyến bán hàng -->
    <record id="all_sales_routes" model="ir.rule">
        <field name="name">sale.route: All Sales Routes</field>
        <field name="model_id" ref="biz_ccv_sale.model_sale_route"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(6,0,[ref('sales_team.group_sale_salesman_all_leads'), ref('sales_team.group_sale_manager')])]"/>
    </record>

    <record id="sale_route_personal_rule" model="ir.rule">
        <field name="name">sale.route: Personal Orders</field>
        <field ref="biz_ccv_sale.model_sale_route" name="model_id"/>
        <field name="domain_force">['|',('user_id','=',user.id),('user_id','=',False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="sale_route_team_lead" model="ir.rule">
        <field name="name">sale.route: Team Leader</field>
        <field name="model_id" ref="biz_ccv_sale.model_sale_route"/>
        <field name="domain_force">
            ['|',('sales_team_captain_id', '=', False),('sales_team_captain_id', '=', user.id)
    ]  
        </field>
        <field name="groups" eval="[
            Command.link(ref('biz_ccv_account.group_sales_team_leader')),
        ]"/>
    </record>

    <record id="sale_route_team_assistant_rule" model="ir.rule">
        <field name="name">sale.route: Team Assistant</field>
        <field name="model_id" ref="biz_ccv_sale.model_sale_route"/>
        <field name="domain_force">
            [
                '|', 
                    ('sales_assistant_ids','=', False)
                    ,('sales_assistant_ids', 'in', [user.id])
            ]
        </field>
        <field name="groups" eval="[
            Command.link(ref('biz_ccv_account.group_sales_admin_sales_team_leader')),
        ]"/>
    </record>

    <!-- III> RULE: Báo cáo tuyến bán hàng-->
    <record id="all_sales_route_report" model="ir.rule">
        <field name="name">sale.route.report: All Sales Route Report</field>
        <field name="model_id" ref="biz_ccv_sale.model_sale_route_report"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(6,0,[ref('sales_team.group_sale_salesman_all_leads'), ref('sales_team.group_sale_manager')])]"/>
    </record>

    <record id="sale_route_report_personal_rule" model="ir.rule">
        <field name="name">sale.route.report: Personal Orders</field>
        <field ref="biz_ccv_sale.model_sale_route_report" name="model_id"/>
        <field name="domain_force">[('sale_person_id','=',user.id),('sale_person_id','!=',False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>


    <record id="sale_route_report_team_lead" model="ir.rule">
        <field name="name">sale.route.report: Team Leader</field>
        <field name="model_id" ref="biz_ccv_sale.model_sale_route_report"/>
        <field name="domain_force">
            [('sale_person_id.sale_team_id.user_id', '=', user.id)]  
        </field>
        <field name="groups" eval="[
            Command.link(ref('biz_ccv_account.group_sales_team_leader')),
        ]"/>
    </record>

    <record id="sale_route_report_team_assistant" model="ir.rule">
        <field name="name">sale.route.report: Team Assistant</field>
        <field name="model_id" ref="biz_ccv_sale.model_sale_route_report"/>
        <field name="domain_force">
            [('sale_person_id.sale_team_id.sales_assistant_ids', 'in', [user.id])]   
        
        </field>
        <field name="groups" eval="[
            Command.link(ref('biz_ccv_account.group_sales_admin_sales_team_leader')),
        ]"/>
    </record>

</data>
</odoo>
