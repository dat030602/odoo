<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="trp_approve_config_tree" model="ir.ui.view">
            <field name="name">trp.approve.config.tree</field>
            <field name="model">trp.approve.config</field>
            <field name="arch" type="xml">
                <tree string="Cấu hình phê duyệt">
                    <field name="name"/>
                    <field name="model_id"/>
                    <field name="date_effective"/>
                    <field name="date_expiration"/>
                </tree>
            </field>
        </record>

        <record id="trp_approve_config_line_tree" model="ir.ui.view">
            <field name="name">trp.approve.config.line.tree</field>
            <field name="model">trp.approve.config.line</field>
            <field name="arch" type="xml">
                <tree string="Quy tắc" default_order="level, priority" editable="bottom">
                    <field name="type" optional="hide"/>
                    <field name="name" optional="hide"/>
                    <field name="level"/>
                    <field name="priority"/>
                    <field name="condition" optional="hide"/>
                    <field name="manager_type"/>
                    <field name="approval_mode"/>
<!--                    <field name="job_ids" widget="many2many_tags"/>-->
                    <field name="user_ids" widget="many2many_tags"/>
                    <field name="do_agree" optional="hide"/>
                    <field name="do_refuse" optional="hide"/>
                    <field name="is_applied" invisible="1"/>
                    <field name="title" optional="hide"/>
                    <field name="allow_sign" optional="hide"/>
                    <field name="delegate_approver_ids" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <record id="trp_approve_config_form" model="ir.ui.view">
            <field name="name">trp.approve.config.form</field>
            <field name="model">trp.approve.config</field>
            <field name="arch" type="xml">
                <form string="Quy tắc">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="True"/>
                                <field name="model_id" domain="[('id', 'in', model_ids)]" required="True"/>
                                <field name="model_ids" widget="many2many_tags" invisible="1"/>
                                <field name="account_id" string="Tài khoản gửi"/>
                                <field name="company_id" invisible="1"/>
                                <field name="destination_account_id" string="Tài khoản nhận"/>
                                <field name="journal_id"/>
                                <field name="product_id"/>
                            </group>
                            <group>
                                <field name="date_effective"/>
                                <field name="date_expiration"/>
                                <field name="is_applied" invisible="1"/>
                            </group>
                        </group>
                        <field name="trp_approve_config_line_ids" nolabel="1" context="{
									'tree_view_ref': 'trp_approve_config.trp_approve_config_line_tree',
							   }">
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_trp_approve_config" model="ir.actions.act_window">
            <field name="name">Cấu hình phê duyệt</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">trp.approve.config</field>

            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
        </record>

        <menuitem id="menu_trp_approve_config" name="Cấu hình phê duyệt" parent="account.menu_finance_configuration" sequence="1"
                  action="action_trp_approve_config"/>
        <menuitem id="menu_trp_approve_config_expense" name="Cấu hình phê duyệt" parent="hr_expense.menu_hr_expense_configuration" sequence="1"
                  action="action_trp_approve_config"/>

        <record id="trp_approve_reason_tree" model="ir.ui.view">
            <field name="name">trp.approve.reason.tree</field>
            <field name="model">trp.approve.reason</field>
            <field name="arch" type="xml">
                <tree string="Danh mục lý do" editable="bottom">
                    <field name="name"/>
                    <field name="res_model"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <record id="action_trp_approve_reason" model="ir.actions.act_window">
            <field name="name">Danh mục lý do</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">trp.approve.reason</field>
            <field name="view_mode">tree</field>
        </record>

        <menuitem id="menu_trp_approve_reason" name="Danh mục lý do" parent="account.menu_finance_configuration" sequence="2"
                  action="action_trp_approve_reason"/>
        <menuitem id="menu_trp_approve_reason_expense" name="Danh mục lý do" parent="hr_expense.menu_hr_expense_configuration" sequence="2"
                  action="action_trp_approve_reason"/>
    </data>
</odoo>