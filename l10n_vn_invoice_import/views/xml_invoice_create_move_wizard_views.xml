<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Create Move Wizard Form View -->
        <record id="view_xml_invoice_create_move_wizard_form" model="ir.ui.view">
            <field name="name">xml.invoice.create.move.wizard.form</field>
            <field name="model">xml.invoice.create.move.wizard</field>
            <field name="arch" type="xml">
                <form string="Create Account Move">
                    <group>
                        <field name="xml_import_id" readonly="1"/>
                        <field name="buyer_partner_id"/>
                        <field name="move_type"/>
                        <field name="journal_id"/>
                        <field name="invoice_date"/>
                    </group>
                    <footer>
                        <button name="action_create_move" string="Create Move" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
