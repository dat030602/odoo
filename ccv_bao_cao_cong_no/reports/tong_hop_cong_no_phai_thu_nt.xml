<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- có thể chạy nhiều báo cáo pdf-->
        <template id="tong_hop_cong_no_phai_thu_nt_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="ccv_bao_cao_cong_no.tong_hop_cong_no_phai_thu_nt_document"/>
                </t>
            </t>
        </template>

        <!-- body của báo cáo-->
        <template id="tong_hop_cong_no_phai_thu_nt_document">
            <t t-call="ccv_sql.ccv_header">
                <div class="page" style="font-size: 14px;font-family: Times New Roman">
                    <div class="col-xs-12" style="text-align: center; font-size: 20px;">
                        <strong>Tổng hợp Công Nợ Phải Thu Ngoại Tệ<t t-if="doc.report_type == 'team' and doc.team_id" t-esc="doc.team_id.report_name"/></strong>
                    </div>
                    <div class="col-xs-12" style="text-align: center; margin-top: 10px;">
                        <strong>Tài khoản: &amp;nbsp;<t t-esc="','.join(doc.account_ids.mapped('code'))"/>;Loại tiền: <t t-if="doc.currency_id"><t t-esc="doc.currency_id.name"/> </t><t t-else="">VND</t><t t-if="not is_many">; Khách hàng:&amp;nbsp;
                            <t t-esc="doc.partner_id.name"/></t>; Từ ngày &amp;nbsp;<t
                                    t-esc="doc.convert_print(doc.date_from)"/>&amp;nbsp; đến ngày &amp;nbsp;
                            <t t-esc="doc.convert_print(doc.date_to)"/>
                        </strong>
                    </div>
                    <div class="row">
                        <table class="table table-sm fixed" style="border: solid 1px;width: 100%; margin-top: 10px;">
                            <col width="5%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <col width="7%"/>
                            <tr>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>STT</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Mã khách hàng</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Tên khách hàng</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Địa chỉ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Mã số thuế</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" rowspan="2">
                                    <strong>Tài khoản công nợ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" colspan="2">
                                    <strong>Dư Nợ đầu kỳ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" colspan="2">
                                    <strong>Dư Có đầu kỳ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" colspan="2">
                                    <strong>Phát sinh Nợ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" colspan="2">
                                    <strong>Phát sinh Có</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" colspan="2">
                                    <strong>Dư Nợ cuối kỳ</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;" colspan="2">
                                    <strong>Dư Có cuối kỳ</strong>
                                </td>
                            </tr>
                            <tr>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Số tiền</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Quy đổi</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Số tiền</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Quy đổi</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Số tiền</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Quy đổi</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Số tiền</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Quy đổi</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Số tiền</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Quy đổi</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Số tiền</strong>
                                </td>
                                <td style="text-align: center; vertical-align: middle;">
                                    <strong>Quy đổi</strong>
                                </td>
                            </tr>

                            <t t-set="number" t-value="0"/>
                            <t t-foreach="doc.sudo().line1_th_nt_ids" t-as="line">
                                <t t-set="number" t-value="number + 1"/>
                                <tr>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span style="text-align: center; vertical-align: middle;" t-esc="number"/>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;color:blue">
                                        <span t-esc="line.partner_code"/>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span t-esc="line.partner_name"/>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span t-esc="line.address"/>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span t-esc="line.vat"/>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span t-esc="line.account_id.code"/>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.start_debit_nt > 0">
                                            <span t-esc="doc.convert_vnd(line.start_debit_nt)"/>
                                        </t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.start_debit > 0">
                                            <span t-esc="doc.convert_vnd(line.start_debit)"/>
                                        </t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.start_credit_nt > 0">
                                            <span t-esc="doc.convert_vnd(line.start_credit_nt)"/>
                                        </t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.start_credit > 0">
                                            <span t-esc="doc.convert_vnd(line.start_credit)"/>
                                        </t>
                                    </td>
                                    
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.ps_debit_nt > 0">
                                            <span t-esc="doc.convert_vnd(line.ps_debit_nt)"/>
                                        </t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.ps_debit > 0">
                                            <span t-esc="doc.convert_vnd(line.ps_debit)"/>
                                        </t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.ps_credit_nt > 0">
                                            <span t-esc="doc.convert_vnd(line.ps_credit_nt)"/>
                                        </t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.ps_credit > 0">
                                            <span t-esc="doc.convert_vnd(line.ps_credit)"/>
                                        </t>
                                    </td>

                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.end_debit_nt > 0">
                                            <span t-esc="doc.convert_vnd(line.end_debit_nt)"/>
                                        </t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.end_debit > 0">
                                            <span t-esc="doc.convert_vnd(line.end_debit)"/>
                                        </t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.end_credit_nt > 0">
                                            <span t-esc="doc.convert_vnd(line.end_credit_nt)"/>
                                        </t>
                                    </td>
                                    <td style="text-align: right; vertical-align: middle;">
                                        <t t-if="line.end_credit > 0">
                                            <span t-esc="doc.convert_vnd(line.end_credit)"/>
                                        </t>
                                    </td>
                                </tr>
                            </t><!--end for-->
                            <tr>
                                <td colspan="6" style="text-align: left;">
                                    <strong>Tổng cộng</strong>
                                </td>
                                <t t-set="total_start_debit" t-value="sum(doc.sudo().line1_th_nt_ids.mapped('start_debit'))"/>
                                <t t-set="total_start_credit" t-value="sum(doc.sudo().line1_th_nt_ids.mapped('start_credit'))"/>
                                <t t-set="total_ps_debit" t-value="sum(doc.sudo().line1_th_nt_ids.mapped('ps_debit'))"/>
                                <t t-set="total_ps_credit" t-value="sum(doc.sudo().line1_th_nt_ids.mapped('ps_credit'))"/>
                                <t t-set="total_end_debit" t-value="sum(doc.sudo().line1_th_nt_ids.mapped('end_debit'))"/>
                                <t t-set="total_end_credit" t-value="sum(doc.sudo().line1_th_nt_ids.mapped('end_credit'))"/>

                                <t t-set="total_start_debit_nt" t-value="sum(doc.sudo().line1_th_nt_ids.mapped('start_debit_nt'))"/>
                                <t t-set="total_start_credit_nt" t-value="sum(doc.sudo().line1_th_nt_ids.mapped('start_credit_nt'))"/>
                                <t t-set="total_ps_debit_nt" t-value="sum(doc.sudo().line1_th_nt_ids.mapped('ps_debit_nt'))"/>
                                <t t-set="total_ps_credit_nt" t-value="sum(doc.sudo().line1_th_nt_ids.mapped('ps_credit_nt'))"/>
                                <t t-set="total_end_debit_nt" t-value="sum(doc.sudo().line1_th_nt_ids.mapped('end_debit_nt'))"/>
                                <t t-set="total_end_credit_nt" t-value="sum(doc.sudo().line1_th_nt_ids.mapped('end_credit_nt'))"/>

                                <td style="text-align: right;">
                                    <t t-if="total_start_debit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_start_debit_nt)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_start_debit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_start_debit)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_start_credit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_start_credit_nt)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_start_credit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_start_credit)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_ps_debit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_ps_debit_nt)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_ps_debit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_ps_debit)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_ps_credit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_ps_credit_nt)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_ps_credit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_ps_credit)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_end_debit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_end_debit_nt)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_end_debit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_end_debit)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_end_credit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_end_credit_nt)"/>
                                        </strong>
                                    </t>
                                </td>
                                <td style="text-align: right;">
                                    <t t-if="total_end_credit > 0">
                                        <strong>
                                            <span t-esc="doc.convert_vnd(total_end_credit)"/>
                                        </strong>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <t t-if="doc.is_break">
                        <p style="page-break-after:always;"></p>
                    </t>
                    <t t-if="doc.is_sale or doc.report_type == 'team'">
                        <div class="row rowp" style="padding-top: 10px; margin-left: 2px;text-align: center;">
                            <div class="col-4">
                            </div>
                            <div class="col-4">
                            </div>
                            <div class="col-4">
                                <span>Ngày .... tháng .... năm ....</span>
                                <br/>
                            </div>
                        </div>
                        <div class="row rowp" style="padding-top: 2px; margin-left: 2px;text-align: center;">
                            <div class="col-2">
                                <span>
                                    <strong>Lập Phiếu</strong>
                                </span>
                                <br/>
                                <span>(Ký, họ tên)</span>
                                <t t-if="doc.voter_id">
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <span>
                                        <strong t-esc="doc.sudo().voter_id.name_without_position"/>
                                    </span>
                                </t>
                            </div>
                            <div class="col-2">
                                <span>
                                    <strong>Trưởng khu vực</strong>
                                </span>
                                <br/>
                                <span>(Ký, họ tên)</span>
                                <t t-if="doc.sudo().lead_team_id">
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <span>
                                        <strong t-esc="doc.sudo().lead_team_id.name_without_position"/>
                                    </span>
                                </t>
                            </div>
                            <div class="col-2">
                                <span>
                                    <strong>Phòng Kinh doanh</strong>
                                </span>
                                <br/>
                                <span>(Ký, họ tên)</span>
                                <t t-if="doc.lead_sale_id">
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <span>
                                        <strong t-esc="doc.sudo().lead_sale_id.name_without_position"/>
