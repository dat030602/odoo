                                </span>
                                <br/>
                                <span>(Ký, họ tên)</span>
                                <t t-if="doc.voter_id">
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <br/>
                                    <span>
                                        <strong t-esc="doc.voter_id.name"/>
                                    </span>
                                </t>
                            </div>
                            <div class="col-4">
                                <span>
                                    <strong>Kế toán trưởng</strong>
                                </span>
                                <br/>
                                <span>(Ký, họ tên)</span>
                                <t t-if="doc.chief_acc_id">
                                    <br/>
                                    <br/>
                                    <br/>
