<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for salary.sales.summary.total.line -->
    <record id="view_salary_sales_summary_total_line_tree" model="ir.ui.view">
        <field name="name">salary.sales.summary.total.line.tree</field>
        <field name="model">salary.sales.summary.total.line</field>
        <field name="arch" type="xml">
            <tree string="Tổng hợp theo khu vực" decoration-muted="not active" editable="bottom">
                <field name="name" optional="show" readonly="1"/>
                <field name="team_id" invisible="1"/>
                <field name="old_customer_plan_quantity" digits="[16,3]" sum="Tổng KH khách hàng cũ" optional="show" readonly="1"/>
                <field name="old_customer_actual_quantity" digits="[16,3]" sum="Tổng thực hiện OC" optional="show" readonly="1"/>
                <field name="old_customer_rate" widget="percentage" optional="show" readonly="1"/>
                <field name="new_customer_plan_quantity" digits="[16,3]" sum="Tổng KH khách hàng mới" optional="show" readonly="1"/>
                <field name="new_customer_actual_quantity" digits="[16,3]" sum="Tổng thực hiện NC" optional="show" readonly="1"/>
                <field name="new_customer_rate" widget="percentage" optional="show" readonly="1"/>
                <field name="planned_quantity" digits="[16,3]" sum="Tổng kế hoạch" optional="show" readonly="1"/>
                <field name="production_quantity" digits="[16,3]" sum="Tổng sản lượng" optional="show" readonly="1"/>
                <field name="achievement_rate" widget="percentage" optional="show" readonly="1"/>
                <field name="progress_compensation_rate" widget="percentage" optional="show" readonly="1"/>
                <field name="total_rate" widget="percentage" optional="show" readonly="1"/>
                <field name="total_revenue" options="{'currency_field': 'currency_id'}" sum="Tổng doanh thu" optional="show" readonly="1"/>
                <button name="action_view_revenue_lines" string="Xem" type="object" class="oe_stat_button" icon="fa-bar-chart" attrs="{'invisible': [('total_revenue', '=', 0)]}"/>
                <field name="total_payment_received" options="{'currency_field': 'currency_id'}" sum="Tổng thu tiền" readonly="1"/>
                <button name="action_view_payment_lines" string="Xem" type="object" class="oe_stat_button" icon="fa-money" attrs="{'invisible': [('total_payment_received', '=', 0)]}"/>
                <field name="payment_rate" widget="percentage" optional="show" readonly="1"/>
                <field name="total_invoice_quantity" digits="[16,3]" sum="Tổng số lượng xuất hóa đơn trước" optional="show" readonly="1"/>
                <field name="total_invoice_amount" options="{'currency_field': 'currency_id'}" sum="Tổng xuất hóa đơn" optional="show" readonly="1"/>
                <button name="action_view_invoice_lines" string="Xem" type="object" class="oe_stat_button" icon="fa-file-text-o" attrs="{'invisible': [('total_invoice_amount', '=', 0)]}"/>
                <field name="is_apply_pre_invoice"/>
                <field name="discount_price_oc" optional="show"/>
                <field name="discount_price_nc" optional="show"/>
                <field name="discount_price_humic_bag" optional="hide"/>
                <field name="discount_price_humic_small" optional="hide"/>
                <field name="currency_id" invisible="1"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form View for salary.sales.summary.total.line -->
    <record id="view_salary_sales_summary_total_line_form" model="ir.ui.view">
        <field name="name">salary.sales.summary.total.line.form</field>
        <field name="model">salary.sales.summary.total.line</field>
        <field name="arch" type="xml">
            <form string="Tổng hợp theo khu vực">
                <sheet>
                    <group>
                        <group>
                            <field name="summary_id" readonly="1"/>
                            <field name="team_id"/>
                        </group>
                        <group>
                            <field name="old_customer_plan_quantity" digits="[16,3]" readonly="1"/>
                            <field name="new_customer_plan_quantity" digits="[16,3]" readonly="1"/>
                            <field name="planned_quantity" digits="[16,3]" readonly="1"/>
                            <field name="production_quantity" digits="[16,3]" readonly="1"/>
                            <field name="old_customer_actual_quantity" digits="[16,3]" readonly="1"/>
                            <field name="old_customer_rate" widget="percentage" readonly="1"/>
                            <field name="new_customer_actual_quantity" digits="[16,3]" readonly="1"/>
                            <field name="new_customer_rate" widget="percentage" readonly="1"/>
                            <field name="achievement_rate" widget="percentage" readonly="1"/>
                            <field name="progress_compensation_rate" widget="percentage" readonly="1"/>
                            <field name="total_rate" widget="percentage" readonly="1"/>
                            <field name="is_apply_pre_invoice"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="total_revenue" options="{'currency_field': 'currency_id'}" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_payment_received" options="{'currency_field': 'currency_id'}" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_invoice_amount" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="payment_rate" widget="percentage" readonly="1"/>
                        </group>
                    </group>
                    <group string="Đơn giá chiết khấu">
                        <group>
                            <field name="discount_price_oc"/>
                            <field name="discount_price_nc"/>
                        </group>
                        <group>
                            <field name="discount_price_humic_bag"/>
                            <field name="discount_price_humic_small"/>
                        </group>
                    </group>
                    <field name="currency_id" invisible="1"/>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for salary.sales.summary.total.line -->
    <record id="view_salary_sales_summary_total_line_search" model="ir.ui.view">
        <field name="name">salary.sales.summary.total.line.search</field>
        <field name="model">salary.sales.summary.total.line</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm tổng hợp theo khu vực">
                <field name="summary_id"/>
                <field name="name" string="Khu vực"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Khu vực" name="group_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Tổng hợp" name="group_summary" context="{'group_by': 'summary_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
