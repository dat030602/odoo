<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Salary Commission Result Views -->
    <record id="view_salary_commission_result_tree" model="ir.ui.view">
        <field name="name">salary.commission.result.tree</field>
        <field name="model">salary.commission.result</field>
        <field name="arch" type="xml">
            <tree string="Kết quả tính toán hoa hồng" decoration-danger="not active">
                <field name="summary_id" invisible="1"/>
                <field name="result_name" optional="show"/>
                <field name="calc_id" optional="hide"/>
                <field name="commission_type" invisible="1"/>
                <field name="team_id" optional="show"/>
                <field name="employee_code" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="plan_rate" widget="percentage" optional="show"/>
                <field name="completion_rate" widget="percentage" optional="show"/>
                <field name="achievement_rate" widget="percentage" optional="hide"/>
                <field name="sales_discount_amount" sum="Tổng chiết khấu bán hàng" optional="show"/>
                <field name="humic_discount_amount" sum="Tổng chiết khấu Humic" optional="show"/>
                <field name="amount" sum="Tổng hoa hồng" optional="show"/>
                <field name="amount_80" sum="Tổng thực nhận 80%" optional="show"/>
                <field name="amount_20" sum="Tổng giữ lại 20%" optional="show"/>
                <field name="currency_id" invisible="1" optional="show"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_salary_commission_result_form" model="ir.ui.view">
        <field name="name">salary.commission.result.form</field>
        <field name="model">salary.commission.result</field>
        <field name="arch" type="xml">
            <form string="Kết quả tính toán hoa hồng">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_calculation" type="object" class="oe_stat_button" icon="fa-calculator" attrs="{'invisible': [('calc_id', '=', False)]}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Công thức</span>
                            </div>
                        </button>
                        <button name="action_view_employee" type="object" class="oe_stat_button" icon="fa-user" attrs="{'invisible': [('employee_id', '=', False)]}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Nhân viên</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="summary_id"/>
                            <field name="result_name"/>
                            <field name="calc_id"/>
                            <field name="team_id"/>
                            <field name="employee_code" readonly="1"/>
                            <field name="employee_id"/>
                            <field name="plan_rate" widget="percentage"/>
                            <field name="completion_rate" widget="percentage"/>
                            <field name="achievement_rate" widget="percentage"/>
                        </group>
                        <group>
                            <field name="commission_type"/>
                            <field name="sales_discount_amount"/>
                            <field name="humic_discount_amount"/>
                            <field name="amount"/>
                            <field name="amount_80"/>
                            <field name="amount_20"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="note" placeholder="Ghi chú về kết quả tính toán..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_salary_commission_result_search" model="ir.ui.view">
        <field name="name">salary.commission.result.search</field>
        <field name="model">salary.commission.result</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm kết quả hoa hồng">
                <field name="employee_id"/>
                <field name="team_id"/>
                <field name="result_name"/>
                <field name="summary_id"/>
                <field name="commission_type"/>
                <field name="calc_id"/>
                <separator/>
                <filter string="Kích hoạt" name="active" domain="[('active', '=', True)]"/>
                <filter string="Không kích hoạt" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Tổng hợp" name="group_summary" context="{'group_by':'summary_id'}"/>
                    <filter string="Công thức" name="group_calc" context="{'group_by':'calc_id'}"/>
                    <filter string="Khu vực" name="group_team" context="{'group_by':'team_id'}"/>
                    <filter string="Khoản mục" name="group_result_name" context="{'group_by':'result_name'}"/>
                    <filter string="Nhân viên" name="group_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Loại hoa hồng" name="group_type" context="{'group_by':'commission_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_salary_commission_result_kanban" model="ir.ui.view">
        <field name="name">salary.commission.result.kanban</field>
        <field name="model">salary.commission.result</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="calc_id"/>
                <field name="employee_id"/>
                <field name="commission_type"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="calc_id"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="employee_id"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div class="o_kanban_record_bottom">
                                            <div class="oe_kanban_bottom_left">
                                                <span class="badge badge-info">
                                                    <field name="commission_type"/>
                                                </span>
                                            </div>
                                            <div class="oe_kanban_bottom_right">
                                                <span class="o_kanban_record_bottom_right">
                                                    <field name="amount" widget="monetary"/>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
