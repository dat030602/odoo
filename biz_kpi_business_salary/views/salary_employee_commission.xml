<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Commission Views -->
    <record id="view_salary_employee_commission_tree" model="ir.ui.view">
        <field name="name">salary.employee.commission.tree</field>
        <field name="model">salary.employee.commission</field>
        <field name="arch" type="xml">
            <tree string="Hoa hồng nhân viên">
                <field name="item_name" optional="show"/>
                <field name="team_id" optional="hide"/>
                <field name="total_amount_80" sum="Tổng nhận 80%" optional="show"/>
                <field name="total_amount_20" sum="Tổng giữ lại 20%" optional="show"/>
                <field name="total_amount" sum="Tổng cộng" optional="show"/>
                <field name="currency_id" invisible="1" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_salary_employee_commission_form" model="ir.ui.view">
        <field name="name">salary.employee.commission.form</field>
        <field name="model">salary.employee.commission</field>
        <field name="arch" type="xml">
            <form string="Hoa hồng nhân viên">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="item_name"/>
                            <field name="team_id"/>
                            <field name="summary_id"/>
                        </group>
                        <group>
                            <field name="total_amount_80"/>
                            <field name="total_amount_20"/>
                            <field name="total_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_salary_employee_commission_search" model="ir.ui.view">
        <field name="name">salary.employee.commission.search</field>
        <field name="model">salary.employee.commission</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm hoa hồng nhân viên">
                <field name="item_name"/>
                <field name="summary_id"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Khoản mục" name="group_item" context="{'group_by':'item_name'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
