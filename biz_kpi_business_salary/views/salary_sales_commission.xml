<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales Commission Views -->
    <record id="view_salary_sales_commission_tree" model="ir.ui.view">
        <field name="name">salary.sales.commission.tree</field>
        <field name="model">salary.sales.commission</field>
        <field name="arch" type="xml">
            <tree string="Hoa hồng khu vực" decoration-danger="status == 'not-achieved'">
                <field name="name" optional="show"/>
                <field name="team_id" invisible="1"/>
                <field name="total_revenue" sum="Tổng doanh thu" optional="show"/>
                <field name="total_payment_received" sum="Tổng thu tiền" optional="show"/>
                <field name="achievement_rate" widget="percentage" optional="show"/>
                <field name="revenue_ratio" widget="percentage" optional="show"/>
                <field name="commission_amount" sum="Tổng hoa hồng" optional="show"/>
                <field name="status" widget="badge" decoration-success="status == 'achieved'" decoration-danger="status == 'not-achieved'" optional="show"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_salary_sales_commission_form" model="ir.ui.view">
        <field name="name">salary.sales.commission.form</field>
        <field name="model">salary.sales.commission</field>
        <field name="arch" type="xml">
            <form string="Hoa hồng khu vực">
                <sheet>
                    
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_summary_lines" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="summary_id" widget="statinfo" string="Chi tiết"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="summary_id"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="total_revenue"/>
                            <field name="total_payment_received"/>
                            <field name="achievement_rate" widget="percentage"/>
                            <field name="revenue_ratio" widget="percentage"/>
                            <field name="commission_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_salary_sales_commission_search" model="ir.ui.view">
        <field name="name">salary.sales.commission.search</field>
        <field name="model">salary.sales.commission</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm hoa hồng khu vực">
                <field name="name" string="Khu vực"/>
                <field name="summary_id"/>
                <field name="status"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Đội" name="group_team" context="{'group_by':'team_id'}"/>
                    <filter string="Trạng thái" name="group_status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
