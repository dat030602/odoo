<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Salary Commission Calculation Views -->
    <record id="view_salary_commission_calculation_tree" model="ir.ui.view">
        <field name="name">salary.commission.calculation.tree</field>
        <field name="model">salary.commission.calculation</field>
        <field name="arch" type="xml">
            <tree string="Tính toán hoa hồng" decoration-danger="not active">
                <field name="display_name" optional="show"/>
                <field name="commission_type" optional="show"/>
                <field name="employee_ids" widget="many2many_tags" optional="show"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_salary_commission_calculation_form" model="ir.ui.view">
        <field name="name">salary.commission.calculation.form</field>
        <field name="model">salary.commission.calculation</field>
        <field name="arch" type="xml">
            <form string="Tính toán hoa hồng">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nhập tên tính toán hoa hồng..."/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="commission_type"/>
                            <field name="calculation_field"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                    
                    <group>
                        <field name="formula" placeholder="Ví dụ: result = records * 0.05 hoặc result = records * 0.1 if records > 1000000 else records * 0.05"/>
                    </group>
                    
                    <group>
                        <field name="description" placeholder="Mô tả chi tiết về cách tính toán hoa hồng..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_salary_commission_calculation_search" model="ir.ui.view">
        <field name="name">salary.commission.calculation.search</field>
        <field name="model">salary.commission.calculation</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm tính toán hoa hồng">
                <field name="name" invisible="1"/>
                <field name="commission_type"/>
                <field name="employee_ids"/>
                <separator/>
                <filter string="Kích hoạt" name="active" domain="[('active', '=', True)]"/>
                <filter string="Không kích hoạt" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Loại hoa hồng" name="group_type" context="{'group_by':'commission_type'}"/>
                    <filter string="Trạng thái" name="group_active" context="{'group_by':'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_salary_commission_calculation_kanban" model="ir.ui.view">
        <field name="name">salary.commission.calculation.kanban</field>
        <field name="model">salary.commission.calculation</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" invisible="1"/>
                <field name="commission_type"/>
                <field name="active" invisible="1"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name" invisible="1"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="commission_type"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div class="o_kanban_record_bottom">
                                            <div class="oe_kanban_bottom_left">
                                                <span class="badge badge-info">
                                                    <field name="commission_type"/>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
