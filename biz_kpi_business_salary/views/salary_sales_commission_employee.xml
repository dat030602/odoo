<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales Commission Employee Views -->
    <record id="view_salary_sales_commission_employee_tree" model="ir.ui.view">
        <field name="name">salary.sales.commission.employee.tree</field>
        <field name="model">salary.sales.commission.employee</field>
        <field name="arch" type="xml">
            <tree string="Hoa Hồng SS" decoration-danger="status == 'not_achieved'">
                <field name="employee_id" string="Họ tên nhân viên" optional="show"/>
                <field name="sales_quantity" sum="Tổng số lượng bán hàng" optional="show"/>
                <field name="minimum_quantity" sum="Tổng số lượng min" optional="show"/>
                <field name="planned_quantity" sum="Tổng số lượng chỉ tiêu" optional="show"/>
                <field name="commission_quantity" sum="Tổng SL tính hoa hồng" optional="show"/>
                <field name="commission_amount" sum="Tổng tiền hoa hồng" optional="show"/>
                <field name="amount_80" sum="Tổng thực nhận 80%" optional="show"/>
                <field name="amount_20" sum="Tổng giữ lại 20%" optional="show"/>
                <field name="commission_90_percent" invisible="1" optional="show"/>
                <field name="commission_10_percent" invisible="1" optional="show"/>
                <field name="status" optional="show"/>
                <field name="currency_id" invisible="1" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_salary_sales_commission_employee_form" model="ir.ui.view">
        <field name="name">salary.sales.commission.employee.form</field>
        <field name="model">salary.sales.commission.employee</field>
        <field name="arch" type="xml">
            <form string="Hoa hồng nhân viên phòng kinh doanh">
                <sheet>
                    
                    <div class="oe_button_box" name="button_box">
                        <button name="action_compute_data" type="object" class="oe_stat_button" icon="fa-calculator">
                            <field name="commission_amount" widget="statinfo" string="Tính toán"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="summary_id"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="sales_quantity"/>
                            <field name="minimum_quantity"/>
                            <field name="planned_quantity"/>
                            <field name="commission_quantity"/>
                        </group>
                    </group>
                    
                    <group>
                        <group>
                            <field name="commission_amount"/>
                            <field name="amount_80"/>
                            <field name="amount_20"/>
                            <field name="commission_90_percent"/>
                            <field name="commission_10_percent"/>
                        </group>
                        <group>
                            <field name="revenue_amount"/>
                            <field name="cash_revenue_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_salary_sales_commission_employee_search" model="ir.ui.view">
        <field name="name">salary.sales.commission.employee.search</field>
        <field name="model">salary.sales.commission.employee</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm hoa hồng NV Kinh doanh">
                <field name="employee_id"/>
                <field name="summary_id"/>
                <field name="status"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhân viên" name="group_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Trạng thái" name="group_status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
