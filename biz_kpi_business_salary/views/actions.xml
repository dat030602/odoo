<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales Commission Actions -->
    <record id="action_salary_sales_commission" model="ir.actions.act_window">
        <field name="name">Hoa hồng khu vực</field>
        <field name="res_model">salary.sales.commission</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Employee Commission Actions -->
    <record id="action_salary_employee_commission" model="ir.actions.act_window">
        <field name="name">Hoa hồng nhân viên</field>
        <field name="res_model">salary.employee.commission</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Personnel Commission Actions -->
    <record id="action_salary_personnel_commission" model="ir.actions.act_window">
        <field name="name">Hoa hồng nhân sự khu vực</field>
        <field name="res_model">salary.personnel.commission</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Bonus Commission Actions -->
    <record id="action_salary_bonus_commission" model="ir.actions.act_window">
        <field name="name">Hoa hồng thưởng thêm</field>
        <field name="res_model">salary.bonus.commission</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Sales Commission Employee Actions -->
    <record id="action_salary_sales_commission_employee" model="ir.actions.act_window">
        <field name="name">Hoa hồng nhân viên phòng kinh doanh</field>
        <field name="res_model">salary.sales.commission.employee</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Humic Sales Detail Actions -->
    <record id="action_salary_humic_sales_detail" model="ir.actions.act_window">
        <field name="name">Chi tiết bán hàng sản phẩm humic</field>
        <field name="res_model">salary.humic.sales.detail</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Customer Open List Actions -->
    <record id="action_salary_customer_open_list" model="ir.actions.act_window">
        <field name="name">Danh sách khách hàng mở</field>
        <field name="res_model">salary.customer.open.list</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Commission Setup Actions -->
    <record id="action_salary_commission_setup" model="ir.actions.act_window">
        <field name="name">Setup tỷ lệ hoa hồng</field>
        <field name="res_model">salary.commission.setup</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>


    <!-- Salary Plan Sales Actions -->
    <record id="action_salary_plan_sales" model="ir.actions.act_window">
        <field name="name">Kế hoạch doanh số</field>
        <field name="res_model">salary.plan.sales</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_salary_plan_sales_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo kế hoạch doanh số mới
            </p>
            <p>
                Kế hoạch doanh số giúp thiết lập mục tiêu bán hàng cho từng đội bán hàng theo từng tỉnh thành.
            </p>
        </field>
    </record>

    <!-- Salary Commission Calculation Actions -->
    <record id="action_salary_commission_calculation" model="ir.actions.act_window">
        <field name="name">Tính toán hoa hồng</field>
        <field name="res_model">salary.commission.calculation</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">{}</field>
    </record>

    <!-- Salary Commission Result Actions -->
    <record id="action_salary_commission_result" model="ir.actions.act_window">
        <field name="name">Kết quả tính toán hoa hồng</field>
        <field name="res_model">salary.commission.result</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="context">{}</field>
    </record>

    <!-- Res Config Settings Action -->
    <record id="action_res_config_settings" model="ir.actions.act_window">
        <field name="name">Cấu hình KPI Business Salary</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'biz_kpi_business_salary'}</field>
    </record>
    
    <!-- Action for salary.sales.summary.line -->
    <record id="action_salary_sales_summary_line" model="ir.actions.act_window">
        <field name="name">Chi tiết tổng hợp doanh thu</field>
        <field name="res_model">salary.sales.summary.line</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_salary_sales_summary_line_search"/>
        <field name="context">{}</field>
        <field name="domain">[]</field>
    </record>

    <!-- Salary Sales Summary Action -->
    <record id="action_salary_sales_summary" model="ir.actions.act_window">
        <field name="name">Tổng hợp hoa hồng</field>
        <field name="res_model">salary.sales.summary</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_salary_sales_summary_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo Tổng hợp hoa hồng mới
            </p>
            <p>
                Tổng hợp hoa hồng giúp theo dõi hiệu quả kinh doanh theo từng đội bán hàng, khu vực và tỉnh thành.
            </p>
        </field>
    </record>

</odoo>
