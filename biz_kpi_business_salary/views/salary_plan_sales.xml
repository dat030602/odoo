<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Salary Plan Sales Tree View -->
    <record id="view_salary_plan_sales_tree" model="ir.ui.view">
        <field name="name">salary.plan.sales.tree</field>
        <field name="model">salary.plan.sales</field>
        <field name="arch" type="xml">
            <tree string="Kế hoạch doanh số">
                <field name="name" optional="show"/>
                <field name="team_id" invisible="1"/>
                <field name="month" optional="show"/>
                <field name="currency_id" invisible="1"/>
                <field name="discount_fund_oc" optional="show"/>
                <field name="discount_fund_nc" optional="show"/>
                <field name="discount_fund" optional="show"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Salary Plan Sales Form View -->
    <record id="view_salary_plan_sales_form" model="ir.ui.view">
        <field name="name">salary.plan.sales.form</field>
        <field name="model">salary.plan.sales</field>
        <field name="arch" type="xml">
            <form string="Kế hoạch doanh số">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="month"/>
                            <field name="year"/>
                            <field name="progress_compensation_rate"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="discount_fund_oc"/>
                            <field name="discount_fund_nc"/>
                            <field name="discount_fund"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Chi tiết kế hoạch" name="lines">
                            <field name="line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="target_type"/>
                                    <field name="employee_id" attrs="{'invisible': [('target_type', '!=', 'employee')]}"/>
                                    <field name="state_ids" widget="many2many_tags" attrs="{'invisible': [('target_type', '!=', 'state')]}"/>
                                    <field name="target_code" attrs="{'invisible': [('target_type', 'not in', ('oc', 'nc'))]}"/>
                                    <field name="quantity"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="target_type"/>
                                        <field name="employee_id" attrs="{'invisible': [('target_type', '!=', 'employee')]}"/>
                                        <field name="state_ids" widget="many2many_tags" attrs="{'invisible': [('target_type', '!=', 'state')]}"/>
                                        <field name="target_code" attrs="{'invisible': [('target_type', 'not in', ('oc', 'nc'))]}"/>
                                        <field name="quantity"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Salary Plan Sales Search View -->
    <record id="view_salary_plan_sales_search" model="ir.ui.view">
        <field name="name">salary.plan.sales.search</field>
        <field name="model">salary.plan.sales</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm kế hoạch doanh số">
                <field name="name" string="Khu vực"/>
                <field name="team_id" invisible="1"/>
                <field name="month"/>
                <field name="year"/>
                <separator/>
                <filter string="Năm hiện tại" name="current_year" domain="[('year', '=', datetime.datetime.now().year)]"/>
                <filter string="Tháng hiện tại" name="current_month" domain="[('month', '=', str(datetime.datetime.now().month))]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Đội bán hàng" name="group_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Tháng" name="group_month" context="{'group_by': 'month'}"/>
                    <filter string="Năm" name="group_year" context="{'group_by': 'year'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
