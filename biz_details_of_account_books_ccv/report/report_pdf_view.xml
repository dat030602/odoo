<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    	<template id="rp_detail_book_pdf_ccv">
		    <t t-call="web.html_container">
		        <t t-call="web.basic_layout">
			    	<t t-set="company" t-value="doc.env.company"/>
			        <div class="page" style="font-family: 'Times New Roman';font-size:12px">
			        	<div class="row">
			        		<div class="col-6">
			        			<p><b>Đơn vị: <span t-esc="company.name"/></b></p>
			        			<p><b>Địa chỉ: <span t-esc="get_company_address(company)"/></b></p>
			        		</div>
			        		<div class="col-6 text-center">
			        			<p><b>Mẫu số S38-DN</b></p>
			        			<p>(Ban hành theo Thông tư số 200/2014/TT-BTC</p>
			        			<p>Ngày 22/12/2014 của Bộ Tài chính)</p>
			        		</div>
			        	</div>
			        	<div class="mt-3 text-center">
			        		<h5 class="bold">SỔ CHI TIẾT CÁC TÀI KHOẢN</h5>
			        		<p class="bold" t-esc='sub_title'/>
			        		<p class="bold">(Dùng cho các TK: 136, 138, 141, 157, 161, 171, 221, 222, 242, 244, 333, 334,</p>
			        		<p class="bold">335, 336, 338, 344, 352, 353, 356,  411, 421, 441,  461, 466, ...)</p>
			        		<p class="bold">Tài khoản: <span t-esc="get_accounts"/></p>
			        		<p class="bold">Đối tượng: <span t-esc="get_partners"/></p>
			        	</div>
				        <div class="text-right">
				        	<p class="bold"><i>Loại tiền: VNĐ</i></p>
				        </div>
				        <table>
				        	<thead>
				        		<!-- <tr>
				        			<th rowspan="2">Ngày, tháng ghi sổ</th>
				        			<th colspan="2">Chứng từ</th>
				        			<th class="td-explan" rowspan="2">Diễn giải</th>
				        			<th rowspan="2">TK đối ứng</th>
				        			<th colspan="2">Số phát sinh</th>
				        			<th colspan="2">Số dư</th>
				        		</tr> -->
				        		<tr>
				        			<th style="width: 70px">Ngày hạch toán</th>
				        			<th style="width: 70px">Ngày chứng từ </th>
				        			<th style="width: 100px">Số chứng từ</th>
				        			<th style="width: 70px">Ngày hoá đơn</th>
				        			<th style="width: 70px">Số hoá đơn</th>
				        			<th style="width: 180px">Diễn giải</th>
				        			<th style="width: 40px">Tài khoản</th>
				        			<th style="width: 40px">TK đối ứng</th>
				        			<th style="width: 90px">Phát sinh nợ</th>
				        			<th style="width: 90px">Phát sinh có</th>
				        			<th style="width: 90px">Dư nợ</th>
				        			<th style="width: 110px">Dư có</th>
				        			<th style="width: 100px">Mã đối tượng</th>
				        			<th style="width: 150px">Tên đối tượng</th>
				        			<!-- <th>Mã khoản mục CP</th>
				        			<th>Mã thống kê</th>
				        			<th>Mã đơn vị</th> -->
				        		</tr>
				        		<tr>
				        			<th>A</th>
				        			<th>B</th>
				        			<th>C</th>
				        			<th>D</th>
				        			<th>E</th>
				        			<th>F</th>
				        			<th>G</th>
				        			<th>H</th>
				        			<th>1</th>
				        			<th>2</th>
				        			<th>3</th>
				        			<th>4</th>
				        			<th>M</th>
				        			<th>N</th>
				        			<!-- <th>O</th>
				        			<th>P</th>
				        			<th>Q</th> -->
				        		</tr>
				        	</thead>
				        	<tbody>
				        		<t t-foreach="lines" t-as="index">
				        			<t t-set="line" t-value="lines[index]"/>
				        			<tr class="bold" t-if="line['is_bold']">
					        			<td></td>
					        			<td></td>
					        			<td></td>
					        			<td></td>
					        			<td></td>
					        			<td class="nowrap td-content"><span t-esc="line['d']"/></td>
					        			<td class="td-tk text-center td-content"><span t-esc="line['a']"/></td>
					        			<td class="td-tk td-content"><span t-esc="line['e']"/></td>
					        			<td class="text-right"><span t-esc="line['1']"/></td>
					        			<td class="text-right"><span t-esc="line['2']"/></td>
					        			<td class="text-right"><span t-esc="line['3']"/></td>
					        			<td class="text-right"><span t-esc="line['4']"/></td>
										<td></td>
										<td></td>
					        		</tr>
					        		<tr t-else="">
					        			<td class="text-center td-content" ><span t-esc="line['a']"/></td>
					        			<td class="text-center td-content"><span t-esc="line['c']"/></td>
					        			<td class="text-left td-content"><span t-esc="line['b']"/></td>
					        			<td><span style="padding-left: 50px;padding-right: 50px;"/></td>
					        			<td><span style="padding-left: 50px;padding-right: 50px;"/></td>
					        			<td class="text-left td-content"><span t-esc="line['d']"/></td>
					        			<td class="text-center td-content"><span t-esc="line['f']"/></td>
					        			<td class="text-center td-tk td-content"><span t-esc="line['e']"/></td>
					        			<td class="text-right td-content"><span t-esc="line['1']"/></td>
					        			<td class="text-right td-content"><span t-esc="line['2']"/></td>
					        			<td class="text-right td-content"><span t-esc="line['3']"/></td>
					        			<td class="text-right td-content"><span t-esc="line['4']"/></td>
					        			<td class="text-left td-content"><span t-esc="line['g']"/><span/></td>
					        			<td class="text-left td-content"><span t-esc="line['h']"/><span/></td>
					        			<!-- <td class="text-right"><span/></td>
					        			<td class="text-right"><span/></td>
					        			<td class="text-right"><span/></td> -->
					        		</tr>
				        		</t>
				        	</tbody>
				        </table>
				        <div class="mt-3">
				        	<p>- Sổ này có ... trang, đánh số từ trang 01 đến trang ...</p>
				        	<p>- Ngày mở sổ ...</p>
				        </div>
				        <div class="row bold italic text-center">
				        	<div class="col-8"/>
				        	<div class="col-4">
				        		<p>Ngày...tháng...năm...</p>
				        	</div>
				        </div>
				        <div class="row text-center">
				        	<div class="col-4">
				        		<p class="bold">Người ghi sổ</p>
				        		<p class="italic">(Ký, họ tên)</p>
				        	</div>
				        	<div class="col-4">
				        		<p class="bold">Kế toán trưởng</p>
				        		<p class="italic">(Ký, họ tên)</p>
				        	</div>
				        	<div class="col-4">
				        		<p class="bold">Giám đốc</p>
				        		<p class="italic">(Ký, họ tên, đóng dấu)</p>
				        	</div>
				        </div>
				        <div class="footer">
			                <div class="text-right" style="text-align: right">
			                    <div class="text-muted">
			                        Trang: <span class="page"/> / <span class="topage"/>
			                    </div>
			                </div>
			            </div>
				        <style>
				        	p {
				        		margin: 0;
				        	}
				        	.bold{
				        		font-weight: bold;
				        	}
				        	.italic{
				        		font-style: italic;
				        	}
				        	.text-right {
				        		text-align: right;
				        	}
				        	.nowrap{
				        		white-space: nowrap;
				        	}
				        	table{
				        		width: 100%;
								table-layout: fixed;
				        	}
				        	thead{
				        		text-align: center;
				        	}
				        	td, th{
				        		padding: 2px;
				        		vertical-align: middle;
				        	}
				        	tr, td, th{
				        		page-break-inside: avoid;
				        		border: 1px  solid;

				        	}
							.td-content {
								word-wrap: break-word; 
        						overflow-wrap: break-word;
							}
				        	.td-explan{
				        		min-width: 20%;
				        		width: 30%;
				        	}
				        	.td-tk{
				        		width: 10%;
				        	}
				        </style>
			        </div>
			    </t>
		    </t>
		</template>

		<record id="paperformat_rp_detail_book_a4_ccv" model="report.paperformat">
            <field name="name">Detail book account CCV</field>
            <field name="default" eval="True" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">7</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

		<record id="action_print_detail_book_pdf_ccv" model="ir.actions.report">
	        <field name="name">Detail book account</field>
	        <field name="model">detail.book.account.ccv</field>
	        <field name="report_type">qweb-pdf</field>
	        <field name="report_name">biz_details_of_account_books_ccv.rp_detail_book_pdf_ccv</field>
	        <field name="report_file">biz_details_of_account_books_ccv.rp_detail_book_pdf_ccv</field>
	        <field name="paperformat_id" ref="paperformat_rp_detail_book_a4_ccv"/>
	        <field name="binding_type">report</field>
	    </record>
    </data>
</odoo>