<odoo>
    <!-- Form View for Import Tax Wizard -->
    <record id="view_wz_account_move_import_tax_form" model="ir.ui.view">
        <field name="name">wz.account.move.import.tax.form</field>
        <field name="model">wz.account.move.import.tax</field>
        <field name="arch" type="xml">
            <form string="Thuế nhập khẩu cho hóa đơn">
                <group>
                    <field name="account_move_id" required="1" invisible="1"/>
                </group>
                <notebook>
                    <page string="Thuế nhập khẩu" name="line_ids">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="move_id" invisible="1"/>
                                <field name="product_id"/>
                                <field name="account_id"/>
                                <field name="tax_id"/>
                                <field name="price_total" sum="price_total"/>
                                <field name="price_tax" options="{'currency_field': 'currency_id'}" sum="price_tax"/>
                                <field name="price_tax_w_company_currency" options="{'currency_field': 'currency_company_id'}" sum="price_tax_w_company_currency"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="currency_company_id" invisible="1"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create_invoice" type="object" string="Tạo hóa đơn thuế" class="oe_highlight"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to Open Import Tax Wizard -->
    <record id="action_wz_account_move_import_tax" model="ir.actions.act_window">
        <field name="name">Thuế nhập khẩu</field>
        <field name="res_model">wz.account.move.import.tax</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wz_account_move_import_tax_form"/>
        <field name="target">new</field>
    </record>
</odoo>
