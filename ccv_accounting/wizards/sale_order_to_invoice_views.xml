<odoo>
    <!-- Form View for Wizard -->
    <record id="view_sale_order_to_invoice_form" model="ir.ui.view">
        <field name="name">sale.order.to.invoice.form</field>
        <field name="model">sale.order.to.invoice</field>
        <field name="arch" type="xml">
            <form string="Chọn dòng đơn hàng để tạo hóa đơn">
                <group>
                    <field name="sale_order_id" readonly="1"/>
                </group>
                <notebook>
                    <page string="Dòng hóa đơn" name="line_ids">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="product_id"/>
                                <field name="uom_qty"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create_invoice" type="object" string="Tạo hóa đơn" class="oe_highlight"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to Open Wizard -->
    <record id="action_sale_order_to_invoice" model="ir.actions.act_window">
        <field name="name">Chọn dòng đơn hàng</field>
        <field name="res_model">sale.order.to.invoice</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sale_order_to_invoice_form"/>
        <field name="target">new</field>
    </record>
</odoo>
