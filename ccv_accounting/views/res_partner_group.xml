<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_partner_group_tree" model="ir.ui.view">
        <field name="name">res.partner.group.tree</field>
        <field name="model">res.partner.group</field>
        <field name="arch" type="xml">
            <tree string="Nhóm đối tác">
                <field name="name"/>
                <field name="credit_limit"/>
                <field name="credit"/>
                <field name="debit_limit"/>
                <field name="debit"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_res_partner_group_form" model="ir.ui.view">
        <field name="name">res.partner.group.form</field>
        <field name="model">res.partner.group</field>
        <field name="arch" type="xml">
            <form string="Nhóm đối tác">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="credit_limit"/>
                            <field name="credit" readonly="1"/>
                            <field name="debit_limit"/>
                            <field name="debit" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Đối tác">
                            <field name="partner_ids">
                                <tree>
                                    <field name="code_contact"/>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="district_id"/>
                                    <field name="state_id"/>
                                    <field name="user_id"/>
                                    <field name="team_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_res_partner_group" model="ir.actions.act_window">
        <field name="name">Nhóm đối tác</field>
        <field name="res_model">res.partner.group</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_res_partner_group" name="Nhóm đối tác"
        parent="contacts.menu_contacts" sequence="30"
        action="action_res_partner_group"/>
</odoo>
