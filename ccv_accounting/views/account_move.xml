<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_move_inherit_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="biz_custom_invoice.view_move_form_biz_custom_invoice"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_amount_value']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_reference']" position="attributes">
                <attribute name="attrs">{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))],'readonly': [('state', '=', 'posted')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='ref'][1]" position="attributes">
                <attribute name="attrs">{'invisible':[('move_type', 'not in', ('in_invoice', 'in_receipt', 'in_refund'))],'readonly': [('state', '=', 'posted')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='ref'][2]" position="attributes">
                <attribute name="attrs">{'invisible':[('move_type', 'in', ('in_invoice', 'in_receipt', 'in_refund', 'out_invoice', 'out_refund'))],'readonly': [('state', '=', 'posted')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='series']" position="attributes">
                <attribute name="attrs">{'readonly': [('state', '=', 'posted')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                <attribute name="attrs">{'invisible': [('invoice_payment_term_id', '!=', False)],'readonly': [('state', '=', 'posted')]}</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="attrs">{'invisible': [('invoice_payment_term_id', '!=', False)],'readonly': [('state', '=', 'posted')]}</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab']/field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="ccv_accounting.action_wz_account_move_import_tax" type="action" string="Thuế nhập khẩu" class="oe_highlight" attrs="{'invisible': ['|',('move_type', '!=', 'in_invoice'),('state', '!=', 'posted')]}" context="{'default_account_move_id': id}"/>
                <button name="action_copy_invoice_info" type="object" string="Copy thông tin HĐ" class="btn-secondary" attrs="{'invisible': [('state', '=', 'posted')]}" title="Copy Ký hiệu HĐ, Số HĐ, Ngày HĐ từ dòng đầu tiên sang tất cả các dòng"/>
            </xpath>
        </field>
    </record>
</odoo>
