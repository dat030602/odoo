<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_details_sales_book_by_customer_line_tree" model="ir.ui.view">
        <field name="name">details.sales.book.by.customer.line.view.tree</field>
        <field name="model">details.sales.book.by.customer.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sm_date" optional="hide"/>
                <field name="sm_write_date" optional="hide"/>
                <field name="sm_partner_id" optional="hide"/>
                <field name="reference" optional="show"/>
                <field name="date" optional="show"/>
                <field name="vat_sinvoice_number" optional="show"/>
                <field name="vat_sinvoice_date" optional="show"/>
                <field name="picking_id" optional="hide"/>
                <field name="stock_sale_export" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="product_uom" optional="show"/>
                <field name="qty_invoiced" optional="show" sum="total_qty_invoiced" digits="[16,3]"/>
                <field name="price_unit" optional="show"/>
                <field name="price_subtotal" optional="show" sum="total_price_subtotal"/>
                <field name="amount_tax" optional="show" sum="total_amount_tax"/>
                <field name="price_subtotal_tax" optional="show" sum="total_price_subtotal_tax"/>
                <field name="qty_done" optional="show" sum="total_qty_done" digits="[16,3]"/>
                <field name="price_done" optional="show" sum="total_price_done"/>
                <field name="sale_line_id" optional="hide"/>
                <field name="user_id" optional="show"/>
                <field name="partner_ward_district" optional="show"/>
                <field name="order_state_id" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="currency_id" optional="hide"/>
                <field name="team_id" optional="hide"/>
                <field name="currency_id" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="view_details_sales_book_by_customer_line_search" model="ir.ui.view">
        <field name="name">details.sales.book.by.customer.line.view.search</field>
        <field name="model">details.sales.book.by.customer.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="order_state_id"/>
                <field name="order_id"/>
                <field name="stock_sale_export"/>
                <field name="reference"/>
                <field name="vat_sinvoice_number"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Đội bán hàng" name="group_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Khách hàng" name="group_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Ngày chứng từ" name="group_queue" context="{'group_by': 'date'}"/>
                    <filter string="Tỉnh/Thành phố" name="group_create_date" context="{'group_by': 'order_state_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id='action_details_sales_book_by_customer_line' model='ir.actions.act_window'>
        <field name='name'>Sổ chi tiết bán hàng theo khách hàng</field>
        <field name="type">ir.actions.act_window</field>
        <field name='res_model'>details.sales.book.by.customer.line</field>
        <field name='view_mode'>tree,form</field>
        <field name='target'>current</field>
    </record>
</odoo>
