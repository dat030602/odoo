<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_users_form_inherited_biz" model="ir.ui.view">
        <field name="name">users.form.inherited.biz</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="biz_hide_menu.view_users_form_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hide_menu_access_ids']" position="before">
                <field name="is_hide_menu_chat"/>
                <field name="commercial_partner_id"/>
                <field name="is_admin_all_channel" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='hide_menu_access_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>