<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.biz_mail</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='emails']/div[5]" position="after">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Main Admin</span>
                            <div class="row">
                                <div class="text-muted col-md-12">
                                    Choose main admin for mail channel
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 col-lg-12 o_light_label">
                                     <field name="user_id"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
