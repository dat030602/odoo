<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_balance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.balance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="fiscalyear" position="after">
                <div class="col-12 col-lg-6" style="padding-left: 0; padding-right: 0;">
                    <div class="col-12 col-lg-12 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="business_cycle"/>
                            <field name="business_cycle"/>
                        </div>
                    </div>
                </div>
            </div>
            <xpath expr="//div[@name='fiscal_localization_setting_container']//div[@class='content-group']" position="after">
                <div class="content-group">
                    <div class="row mt16">
                        <button name="update_accounting_balance_sheet" string="Update Data accounting balance sheet" type="object"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>