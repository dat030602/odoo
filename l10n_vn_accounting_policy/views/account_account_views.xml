<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_form" model="ir.ui.view">
        <field name="name">account.account.form.inherit.l10n_vn_accounting_policy</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_type']" position="after">
                <field name="vn_allow_mixed_usage" widget="boolean_toggle" invisible="account_type not in ('liability_payable', 'asset_receivable')"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_list" model="ir.ui.view">
        <field name="name">account.account.list.inherit.l10n_vn_accounting_policy</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reconcile']" position="after">
                <field name="vn_allow_mixed_usage" widget="boolean_toggle" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
