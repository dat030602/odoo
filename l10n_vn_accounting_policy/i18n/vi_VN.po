#. module: l10n_vn_accounting_policy
#: model:ir.model.fields,field_description:l10n_vn_accounting_policy.field_account_account__vn_allow_mixed_usage
msgid "Allow Mixed Usage"
msgstr "Cho phép sử dụng hỗn hợp"

#. module: l10n_vn_accounting_policy
#: model:ir.model.fields,help:l10n_vn_accounting_policy.field_account_account__vn_allow_mixed_usage
msgid ""
"Allow using this receivable/payable account flexibly across sales, purchases, "
"and miscellaneous entries without strict document-type enforcement "
"(e.g., Vietnamese Account 141 - Employee Advances, Account 131 - Customer Prepayments)."
msgstr ""
"Cho phép sử dụng linh hoạt tài khoản phải thu/phải trả này trên các hóa đơn bán hàng, "
"mua hàng và bút toán tổng hợp mà không bị ràng buộc chặt chẽ theo loại chứng từ "
"(ví dụ: TK 141 - Tạm ứng, TK 131 - Khách hàng trả trước)."

#. module: l10n_vn_accounting_policy
#: model:ir.model.fields,field_description:l10n_vn_accounting_policy.field_account_move__vn_allow_different_partner
msgid "Allow Different Line Partner"
msgstr "Cho phép khác đối tác dòng"

#. module: l10n_vn_accounting_policy
#: model:ir.model.fields,help:l10n_vn_accounting_policy.field_account_move__vn_allow_different_partner
msgid ""
"When unchecked, follows standard Odoo behavior (lines sync with invoice partner). "
"When checked, allows lines to have a different partner when created, but lines "
"cannot be updated with a different partner afterwards."
msgstr ""
"Khi không chọn, hoạt động theo chuẩn Odoo (dòng đồng bộ theo đối tác hóa đơn). "
"Khi chọn, cho phép tự do chọn/sửa đối tác khác nhau trên các dòng ở trạng thái "
"Nháp và khóa khi Đã vào sổ."

#. module: l10n_vn_accounting_policy
#: model:ir.model,name:l10n_vn_accounting_policy.model_account_move
msgid "Journal Entry"
msgstr "Bút toán"

#. module: l10n_vn_accounting_policy
#: model:ir.model,name:l10n_vn_accounting_policy.model_account_move_line
msgid "Journal Item"
msgstr "Dòng bút toán"

#. module: l10n_vn_accounting_policy
#: model:ir.model,name:l10n_vn_accounting_policy.model_account_account
msgid "Account"
msgstr "Tài khoản"

#. module: l10n_vn_accounting_policy
#: code:addons/l10n_vn_accounting_policy/models/account_move_line.py:0
#, python-format
msgid "You cannot change the partner on journal items once posted."
msgstr "Bạn không thể thay đổi đối tác trên các dòng phát sinh khi chứng từ đã vào sổ."

#. module: l10n_vn_accounting_policy
msgid "Vietnam Accounting - Flexible Mixed Account Usage"
msgstr "Kế toán Việt Nam - Cho phép sử dụng tài khoản hỗn hợp linh hoạt"

#. module: l10n_vn_accounting_policy
msgid "Allow flexible usage of receivable and payable accounts across document types"
msgstr "Cho phép sử dụng linh hoạt tài khoản phải thu và phải trả trên các loại chứng từ"
