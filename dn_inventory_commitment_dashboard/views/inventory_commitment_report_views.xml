<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_commitment_report_tree" model="ir.ui.view">
        <field name="name">inventory.commitment.report.tree</field>
        <field name="model">inventory.commitment.report</field>
        <field name="arch" type="xml">
            <list string="Commitment Report" create="false" edit="false" delete="false">
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="picking_id"/>
                <field name="demand_qty"/>
                <field name="reserved_qty"/>
                <field name="commit_date"/>
                <field name="state"/>
                <button name="action_release_reservation" string="Release" type="object" icon="fa-unlock"/>
            </list>
        </field>
    </record>

    <record id="view_inventory_commitment_report_search" model="ir.ui.view">
        <field name="name">inventory.commitment.report.search</field>
        <field name="model">inventory.commitment.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <separator/>
                    <filter string="Product" name="group_product" context="{'group_by':'product_id'}"/>
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by':'warehouse_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by':'partner_id'}"/>
                
            </search>
        </field>
    </record>

    <record id="action_inventory_commitment_report" model="ir.actions.act_window">
        <field name="name">Commitment Dashboard</field>
        <field name="res_model">inventory.commitment.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_group_product': 1, 'search_default_group_partner': 1}</field>
    </record>

    <menuitem id="menu_inventory_commitment_report" name="Commitments" parent="stock.menu_stock_warehouse_mgmt" action="action_inventory_commitment_report"/>
</odoo>
