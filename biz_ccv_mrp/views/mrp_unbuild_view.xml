<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_unbuild_form_view_ccv" model="ir.ui.view">
            <field name="name">mrp.unbuild.form.inherit</field>
            <field name="model">mrp.unbuild</field>
            <field name="inherit_id" ref="mrp.mrp_unbuild_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/group[1]/group[1]" position="inside">
                    <field name="actual_date" required="1"/>
                </xpath>
            </field>
        </record>

        <record id="action_update_old_produce_line_date" model="ir.actions.server">
            <field name="name">Update ngày tháo dỡ</field>
            <field name="model_id" ref="mrp.model_mrp_unbuild"/>
            <field name="binding_model_id" ref="mrp.model_mrp_unbuild"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = records.update_old_produce_line_date()</field>
        </record>
    </data>
</odoo>
