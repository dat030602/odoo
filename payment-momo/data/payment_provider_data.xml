<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- Visible in dashboard Payment Provider -->
   <record id="payment_provider_momo" model="payment.provider">
      <field name="code">momo</field>
      <field name="name">Momo</field>
      <!-- <field name="redirect_form_view_id" ref="redirect_form"/> -->
      <field name="module_id" ref="base.module_payment_momo"/>
      <field name="image_128" type="base64" file="payment_momo/static/description/icon.png"/>
      <field name="payment_method_ids"
            eval="[Command.set([
                        ref('payment_momo.payment_icon_cc_momo')
                     ])]"/>
  </record>
</odoo>
