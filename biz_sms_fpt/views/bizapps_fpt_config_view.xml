<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bizapps_fpt_sms_config_form" model="ir.ui.view">
            <field name="name">res.config.settings.form</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="SMS FPT" string="SMS FPT" data-key="biz_sms_fpt">
                        <h2 style="font-size:25px;background-color:#e9ecef;">SMS FPT</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <group>
                                        <field name="fpt_active"/>
		                                <field name="fpt_client_id" attrs="{'required': [('fpt_active', '=', True)],'invisible': [('fpt_active', '!=', True)]}" password="True"/>
		                                <field name="fpt_client_secret" attrs="{'required': [('fpt_active', '=', True)],'invisible': [('fpt_active', '!=', True)]}" password="True"/>
		                                <field name="fpt_type_endpoint" attrs="{'required': [('fpt_active', '=', True)],'invisible': [('fpt_active', '!=', True)]}"/>
		                                <field name="fpt_brand_name" attrs="{'required': [('fpt_active', '=', True)],'invisible': [('fpt_active', '!=', True)]}"/>
		                           </group>
		                           <div><button name="sms_fpt_check_connect" class="oe_highlight" string="Check Connect" type="object" attrs="{'invisible': [('fpt_active', '!=', True)]}"/></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
        <record id="action_bizapps_fpt_sms_config" model="ir.actions.act_window">
            <field name="name">Configuration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="context">{'module' : 'biz_sms_fpt', 'bin_size': False}</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
        </record>

    </data>
</odoo>