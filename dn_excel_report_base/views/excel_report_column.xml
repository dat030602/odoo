<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_excel_report_column_list" model="ir.ui.view">
        <field name="name">excel.report.column.list</field>
        <field name="model">excel.report.column</field>
        <field name="arch" type="xml">
            <list string="Columns" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="field_id"/>
                <field name="width"/>
                <field name="function_id"/>
                <field name="group"/>
                <field name="merge_row"/>
                <field name="merge_col"/>
                <field name="format_id"/>
            </list>
        </field>
    </record>
</odoo>