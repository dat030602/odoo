<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_excel_report_form" model="ir.ui.view">
        <field name="name">excel.report.form</field>
        <field name="model">excel.report</field>
        <field name="arch" type="xml">
            <form string="Excel Report">
                <header>
                    <button name="action_create_report_action" type="object" string="Confirm" class="btn-primary" invisible="state == 'confirmed' or report_action"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}" statusbar_colors='{"draft": "blue", "confirmed": "green"}'/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Report Name" readonly="state == 'confirmed'"/>
                        </h1>
                    </div>
                    <group>
                        <field name="model_id" options="{'no_create': True}" readonly="state == 'confirmed'"/>
                        <field name="technical_name" readonly="state == 'confirmed'"/>
                        <field name="report_action" readonly="state == 'confirmed'"/>
                    </group>
                    <notebook>
                        <page string="Columns">
                            <field name="column_ids" context="{'default_report_id': id}" readonly="state == 'confirmed'"/>
                        </page>
                        <page string="Signatures">
                            <field name="signature_ids" readonly="state == 'confirmed'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_excel_report_list" model="ir.ui.view">
        <field name="name">excel.report.list</field>
        <field name="model">excel.report</field>
        <field name="arch" type="xml">
            <list string="Excel Reports">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_excel_report" model="ir.actions.act_window">
        <field name="name">Excel Templates</field>
        <field name="res_model">excel.report</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Excel Template
            </p>
        </field>
    </record>

    <menuitem id="menu_excel_report_base_root" name="Excel Report Base" sequence="50" parent="base.menu_custom"/>
    <menuitem id="menu_excel_report_base_main" parent="menu_excel_report_base_root" name="Templates" sequence="10" action="action_excel_report"/>
</odoo>
