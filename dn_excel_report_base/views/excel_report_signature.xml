<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_excel_report_signature_list" model="ir.ui.view">
        <field name="name">excel.report.signature.list</field>
        <field name="model">excel.report.signature</field>
        <field name="arch" type="xml">
            <list string="Signatures" editable="bottom">
                <field name="is_readonly" column_invisible="True"/>
                <field name="name"/>
                <field name="user_id" readonly="is_readonly"/>
                <field name="fixed_text" readonly="not is_readonly" />
            </list>
        </field>
    </record>
</odoo>
