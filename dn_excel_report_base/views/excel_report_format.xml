<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_excel_report_format_list" model="ir.ui.view">
        <field name="name">excel.report.format.list</field>
        <field name="model">excel.report.format</field>
        <field name="arch" type="xml">
            <list string="Formats">
                <field name="type"/>
                <field name="name"/>
                <field name="display_name" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="view_excel_report_format_search" model="ir.ui.view">
        <field name="name">excel.report.format.search</field>
        <field name="model">excel.report.format</field>
        <field name="arch" type="xml">
            <search string="Search Formats">
                <field name="name" filter_domain="[
                ('display_name', 'ilike', self),
                ]" />
            </search>
        </field>
    </record>
    <record id="view_excel_report_format_form" model="ir.ui.view">
        <field name="name">excel.report.format.form</field>
        <field name="model">excel.report.format</field>
        <field name="arch" type="xml">
            <form string="Format">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Format Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="type"/>
                        <field name="display_name" readonly="1"/>
                        <field name="font_name" invisible="type != 'font_name'"/>
                        <field name="font_size" invisible="type != 'font_size'"/>
                        <field name="font_color" invisible="type != 'font_color'"/>
                        <field name="bold" invisible="type != 'bold'"/>
                        <field name="italic" invisible="type != 'italic'"/>
                        <field name="underline" invisible="type != 'underline'"/>
                        <field name="font_strikeout" invisible="type != 'font_strikeout'"/>
                        <field name="font_script" invisible="type != 'font_script'"/>
                        <field name="align" invisible="type != 'align'"/>
                        <field name="valign" invisible="type != 'valign'"/>
                        <field name="text_wrap" invisible="type != 'text_wrap'"/>
                        <field name="rotation" invisible="type != 'rotation'"/>
                        <field name="indent" invisible="type != 'indent'"/>
                        <field name="border" invisible="type != 'border'"/>
                        <field name="border_color" invisible="type != 'border_color'"/>
                        <field name="top" invisible="type != 'top'"/>
                        <field name="top_color" invisible="type != 'top_color'"/>
                        <field name="bottom" invisible="type != 'bottom'"/>
                        <field name="bottom_color" invisible="type != 'bottom_color'"/>
                        <field name="left" invisible="type != 'left'"/>
                        <field name="left_color" invisible="type != 'left_color'"/>
                        <field name="right" invisible="type != 'right'"/>
                        <field name="right_color" invisible="type != 'right_color'"/>
                        <field name="pattern" invisible="type != 'pattern'"/>
                        <field name="bg_color" invisible="type != 'bg_color'"/>
                        <field name="fg_color" invisible="type != 'fg_color'"/>
                        <field name="num_format" invisible="type != 'num_format'"/>
                        <field name="locked" invisible="type != 'locked'"/>
                        <field name="hidden" invisible="type != 'hidden'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_excel_report_format" model="ir.actions.act_window">
        <field name="name">Excel Report Formats</field>
        <field name="res_model">excel.report.format</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
