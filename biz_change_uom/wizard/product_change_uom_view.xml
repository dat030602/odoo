<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_product_change_uom_form" model="ir.ui.view">
        <field name="name">Change invoice number</field>
        <field name="model">product.change.uom</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="uom_id" />
                    <field name="uom_po_id" />
                    <field name="is_update_uom_sale"/>
                    <field name="uom_used_sale_id" attrs="{'invisible': [('is_update_uom_sale','=', False)], 'required': [('is_update_uom_sale','=', True)]}"/>
                    <field name="uom_substitute_sale_id" attrs="{'invisible': [('is_update_uom_sale','=', False)], 'required': [('is_update_uom_sale','=', True)]}"/>
                    <field name="is_update_uom_purchase"/>
                    <field name="uom_used_purchase_id" attrs="{'invisible': [('is_update_uom_purchase','=', False)], 'required': [('is_update_uom_purchase','=', True)]}"/>
                    <field name="uom_substitute_purchase_id" attrs="{'invisible': [('is_update_uom_purchase','=', False)], 'required': [('is_update_uom_purchase','=', True)]}"/>
                </group>
                <footer>
                    <button name="do_change" string="_Apply" type="object" class="oe_highlight" />
                    or
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>


    <record id="action_product_change_uom" model="ir.actions.act_window">
        <field name="name">Change Uom</field>
        <field name="res_model">product.change.uom</field>
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="binding_view_types">list,form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_product_product_change_uom" model="ir.actions.act_window">
        <field name="name">Change Uom</field>
        <field name="res_model">product.change.uom</field>
        <field name="binding_model_id" ref="product.model_product_product" />
        <field name="binding_view_types">list,form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
