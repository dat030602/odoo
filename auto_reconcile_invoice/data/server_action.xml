<!-- custom_module/data/ir_action_server.xml -->
<odoo noupdate="1">
    <!-- Define the IR Action Server -->
    <record id="model_account_payment_action_reconcile" model="ir.actions.server">
        <field name="name">Đối soát</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.reconcile_payments()</field>
    </record>
    <record id="model_vietqr_bank_transaction_action_create_qr" model="ir.actions.server">
        <field name="name">Tạo QR</field>
        <field name="model_id" ref="model_sale_order"/>
        <field name="binding_model_id" ref="model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_open_vietqr_bank_transactions()</field>
    </record>
</odoo>
