<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_view_account_payment_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <header position="before">
                <div class="alert alert-warning oe_edit_only" role="alert" attrs="{'invisible': [('same_payment_id', '=', False)]}">
                    Có một thanh toán đã tồn tại <field name="same_payment_id"/>, bạn có muốn tạo mới?
                </div>
            </header>
            <xpath expr="//field[@name='partner_id'][last()]" position="after">
                <field name="sale_ids" string="Đơn bán hàng (nhiều)" widget="many2many_tags" domain="[('partner_id','=',partner_id)]" attrs="{'readonly':[('state','=','posted')],'invisible':[('payment_type','!=','inbound')]}"/>
                <field name="purchase_ids" string="Đơn mua hàng (nhiều)" widget="many2many_tags" domain="[('partner_id','=',partner_id)]" attrs="{'readonly':[('state','=','posted')],'invisible':[('payment_type','!=','outbound')]}"/>
            </xpath>
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="transaction_number" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
