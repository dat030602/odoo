<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_order_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_invoiced']" position="after">
                <field name="move_amount_invoiced" optional="hide"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="payment_state" invisible="1"/>
                <widget name="web_ribbon" title="Đã thanh toán" attrs="{'invisible': [('payment_state', '!=', 'paid')]}"/>
                <widget name="web_ribbon" title="Thanh toán" attrs="{'invisible': [('payment_state', '!=', 'in_payment')]}"/>
                <widget name="web_ribbon" title="Một phần" attrs="{'invisible': [('payment_state', '!=', 'partial')]}"/>
            </xpath>
        </field>
    </record>
    <record id="view_purchase_order_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="move_amount_invoiced" optional="hide"/>
                <field name="move_amount_payment" optional="hide"/>
                <field name="move_amount_paid" optional="hide"/>
                <field name="move_amount_residual" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='invoice_status']" position="before">
                <field name="payment_state" optional="show" widget="badge"
                    decoration-danger="payment_state == 'not_paid'"
                    decoration-warning="payment_state in ('partial')"
                    decoration-success="payment_state in ('paid', 'in_payment')"
                />
                <field name="move_invoice_status"
                    decoration-success="move_invoice_status in ('to_invoice','invoiced')"
                    widget="badge" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
