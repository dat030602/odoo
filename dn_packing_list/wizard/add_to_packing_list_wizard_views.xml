<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="add_to_packing_list_wizard_form_view" model="ir.ui.view">
        <field name="name">add.to.packing.list.wizard</field>
        <field name="model">add.to.packing.list.wizard</field>
        <field name="arch" type="xml">
            <form string="Order to packing list">
                <h4>When you click confirm, it will add lines to the packing list.</h4>
                <group>
                    <field name="name" invisible="1" />
                    <field name="partner_id" string="Customer" readonly="1" />
                    <field name="order_ids" widget="many2many_tags" string="Order" options="{'no_create':true}" domain="[('partner_id','=',partner_id)]" />
                    <field name="target_packing_list" string="Add to Packing List" options="{'no_create':true}" domain="[('customer','=',partner_id)]" />
                    <button name="load_all_order_lines" string="Load All Order Lines" type="object" class="btn-primary"/>
                </group>
                    <field name="order_line_wizard_ids" widget="section_and_note_one2many" mode="list,kanban">
                        <list string="Sales Order Lines" editable="bottom">
                            <control>
                                <create name="add_product_control" string="Add a product"/>
                                <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="display_type" column_invisible="True"/>
                            <!-- <field name="order_id" decoration-info="(not display_type)" decoration-bf="(not display_type)"/> -->
                            <field name="order_line_ids" column_invisible="True"/>
                            <field name="store_order_line_ids" column_invisible="True"/>
                            <field name="order_line_id" domain="[('id', 'in', order_line_ids),('id','not in', store_order_line_ids),('product_id.type','=','consu'),('product_id.is_storable','=',True),('packable_remaining_qty','>',0)]" string="Order Line" options="{&quot;no_create&quot;:true,&quot;no_open&quot;:true}"/>
                            <field name="product_id" readonly="1"/>
                            <field name="name" widget="section_and_note_text" string="Description" optional="show"/>
                            <field name="product_uom_qty" string="Qty" decoration-info="(not display_type)" decoration-bf="(not display_type)"/>
                            <field name="price_unit" string="Price" decoration-info="(not display_type)" decoration-bf="(not display_type)"/>
                            <field name="price_subtotal" sum="Total" decoration-info="(not display_type)" decoration-bf="(not display_type)"/>
                            <field name="currency_id" column_invisible="True" />
                        </list>
                    </field>
                <footer>
                    <button name="confirm_form" string="Confirm" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="add_to_packing_list_wizard_action" model="ir.actions.act_window">
        <field name="name">Picking List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">add.to.packing.list.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="add_to_packing_list_wizard_form_view" />
        <field name="target">new</field>
    </record>
</odoo>