<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="dn_inherited_view_sale_advance_payment_inv" model="ir.ui.view">
            <field name="name">mjb.inherited.sale.advance.payment.inv.form</field>
            <field name="model">sale.advance.payment.inv</field>
            <field name="inherit_id" ref="sale.view_sale_advance_payment_inv"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='advance_payment_method']" position="before">
                    <field name="x_is_packing_list" invisible="1"/>
                    <field name="x_invoice_service" invisible="not x_is_packing_list"/>
                    <field name="x_deduct_downpayments" invisible="not x_is_packing_list"/>
                    <!-- <field name="x_packing_payment_method" class="oe_inline" widget="radio" invisible="not x_is_packing_list"/> -->
                </xpath>

                <xpath expr="//field[@name='advance_payment_method']" position="attributes">
                    <attribute name="invisible">x_is_packing_list</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
