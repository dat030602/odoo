<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_packing_list_user" model="res.groups">
            <field name="name">Packing List User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_packing_list_manager" model="res.groups">
            <field name="name">Packing List Manager</field>
            <field name="implied_ids" eval="[(4, ref('dn_packing_list.group_packing_list_user'))]"/>
        </record>

        <record id="packing_list_comp_rule" model="ir.rule">
            <field name="name">Packing List multi-company</field>
            <field name="model_id" ref="model_packing_list"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="packing_list_line_comp_rule" model="ir.rule">
            <field name="name">Packing List Line multi-company</field>
            <field name="model_id" ref="model_packing_list_line"/>
            <field name="domain_force">['|', ('packing_list_id.company_id', '=', False), ('packing_list_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
