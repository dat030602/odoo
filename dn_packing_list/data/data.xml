<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="dn_sequence_packing_list_increase" model="ir.sequence">
            <field name="name">Sequence Packing List</field>
            <field name="code">sequence_packing_list</field>
            <field name="prefix">PACK/%(y)s/</field>
            <field name="padding">4</field>
        </record>

        <record id="dn_sequence_packing_list_line_increase" model="ir.sequence">
            <field name="name">Sequence Packing List</field>
            <field name="code">sequence_packing_list_line</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
        </record>

        <record id="dn_packinglist_shipping" model="ir.sequence">
            <field name="name">Sequence Shipping Destination</field>
            <field name="code">sequence_shipping_destination</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
        </record>

        <!-- PACKING LIST STAGE -->
        <record id="dn_packing_list_stage__new" model="packing.list.stage">
            <field name="name">New</field>
            <field name="sequence">10</field>
            <field name="is_new">True</field>
        </record>
        <record id="dn_packing_list_stage__packing" model="packing.list.stage">
            <field name="name">Packing</field>
            <field name="sequence">11</field>
            <field name="is_packing">True</field>
        </record>
        <record id="dn_packing_list_stage__loading" model="packing.list.stage">
            <field name="name">Loading</field>
            <field name="sequence">12</field>
            <field name="is_loading">True</field>
        </record>
        <record id="dn_packing_list_stage__review" model="packing.list.stage">
            <field name="name">Review</field>
            <field name="sequence">13</field>
            <field name="is_review">True</field>
            <field name="is_delivery">True</field>
        </record>
        <record id="dn_packing_list_stage__delivered" model="packing.list.stage">
            <field name="name">Delivered</field>
            <field name="sequence">14</field>
            <field name="is_invoice">True</field>
        </record>
        <record id="dn_packing_list_stage__invoiced" model="packing.list.stage">
            <field name="name">Invoiced</field>
            <field name="sequence">15</field>
        </record>
        <record id="dn_packing_list_stage__cancelled" model="packing.list.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">16</field>
            <field name="is_closed">True</field>
        </record>
    </data>
</odoo>