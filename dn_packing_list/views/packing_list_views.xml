<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_update_pl" model="ir.actions.server">
        <field name="name">Update PL</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_packing_list"/>
        <field name="binding_model_id" ref="model_packing_list"/>
        <field name="state">code</field>
        <field name="code">records.action_update_pl()</field>
    </record>

    <record id="action_update_pl_line_title" model="ir.actions.server">
        <field name="name">Update PL Line Title</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_packing_list"/>
        <field name="binding_model_id" ref="model_packing_list"/>
        <field name="state">code</field>
        <field name="code">records.action_update_pl_line_title()</field>
    </record>

    <record id="external_packing_list_form_view" model="ir.ui.view">
        <field name="name">packing.list</field>
        <field name="model">packing.list</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button context="{'default_partner_id': customer,'default_order_ids': orders,'default_target_packing_list': id,}" class="btn btn-secondary" string="Add to Packing List" type="object" name="add_to_pl" invisible="lines_locked or parent_packing_list_id"/>
                    <button class="btn btn-secondary" string="Create Child Packing List" type="object" name="action_create_child_packing_list" confirm="Create a new child packing list with the selected lines?" invisible="parent_packing_list_id or not lines_locked"/>
                    <field name="can_move_forward" invisible="1" />
                    <field name="can_move_back" invisible="1" />
                    <field name="show_deliver_button" invisible="1" />
                    <field name="show_invoice_button" invisible="1" />
                    <field name="is_cancel_allowed" invisible="1" />
                    <field name="lines_locked" invisible="1" />
                    <field name="parent_packing_list_id" invisible="1" />
                    <field name="stage_lock" invisible="1" />
                    <button class="btn btn-secondary" type="object" name="move_forward" invisible="not can_move_forward or parent_packing_list_id">
                        <field name="next_stage_name" readonly="1" nolabel="1"/>
                    </button>
                    <button class="btn btn-secondary" string="Back" name="move_back" type="object" invisible="not can_move_back or parent_packing_list_id" />
                    <button class="btn btn-secondary" string="Deliver" type="object" name="action_deliver" confirm="Confirm delivery? This will validate the linked delivery order and deduct stock." invisible="not show_deliver_button or parent_packing_list_id"/>
                    <button class="btn btn-secondary" string="Invoice" type="object" name="action_create_invoice" confirm="Are you sure you want to invoice this packing list ?" invisible="not show_invoice_button or parent_packing_list_id" />
                    <button class="btn btn-secondary" string="Cancel" name="button_cancel" type="object" invisible="not is_cancel_allowed or parent_packing_list_id" confirm="Are you sure you want to cancel this packing list ?" />
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}" domain="[('active', '=', True), ('is_closed', '=', False)]" invisible="stage_lock == True or parent_packing_list_id" />
                    <field name="stage_id_lock" widget="statusbar" invisible="stage_lock == False or parent_packing_list_id" />
                    <field name="stage_id" widget="statusbar" readonly="1" invisible="not parent_packing_list_id" />
                </header>
                <sheet string="Packing List">
                    <div class="oe_button_box" name="button_box">
                        <button name="pl_display_so" type="object" class="oe_stat_button" icon="fa-dollar">
                            <field name="packing_list_id__sales_order_count" string="Sales" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button" icon="fa-sitemap" type="object" name="action_view_lines">
                            <field name="line_count" string="Lines" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-cubes" type="object" name="packing_list_id__stock_picking">
                            <field name="packing_list_id__stock_picking_count" string="Deliveries" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button" icon="fa-balance-scale" type="object" name="packing_list_id__account_move">
                            <field name="packing_list_id__account_move_count" string="Invoices" widget="statinfo" />
                        </button>
                        <button class="oe_stat_button" icon="fa-sitemap" type="object" name="action_view_child_packing_lists" invisible="child_packing_list_count == 0">
                            <field name="child_packing_list_count" string="Child PLs" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="kanban_state" widget="state_selection" />
                    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True" />
                    <field name="active" invisible="1" />
                    <field name="child_packing_list_count" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="title"/>
                            <field name="name" invisible="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="parent_packing_list_id" readonly="1" invisible="not parent_packing_list_id"/>
                            <field name="ref" invisible="1"/>
                            <field name="customer"/>
                            <field name="delivery_address" domain="['|', ('parent_id', '=', customer), ('id', '=', customer)]" options="{'no_create':true,'no_open':true}"/>
                            <field name="orders" widget="many2many_tags" domain="[('partner_id', '=',customer)]"  options="{'no_create':true}"/>
                            <field name="shipping_type"/>
                            <field name="goods_origin"/>
                            <field name="manufacturer_id" options="{'no_create':true}"/>
                            <field name="consignee" options="{'no_create':true}"/>
                            <field name="company_id" options="{'no_create':true}"/>
                        </group>
                        <group>
                            <field name="shipper" options="{'no_create':true}"/>
                            <field name="forwarder_id" options="{'no_create':true}"/>
                            <field name="port_from_id" options="{'no_create':true}" />
                            <field name="port_to_id" options="{'no_create':true}" />
                            <field name="date_loading"/>
                            <field name="date_departure"/>
                            <field name="invoice_date"/>
                            <field name="ship_status"/>
                            <field name="date_arrival"/>
                            <field name="stage_lock" widget="boolean_toggle"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" widget="section_and_note_one2many" mode="list" readonly="parent_packing_list_id" options="{'delete': [('lines_locked', '=', False), ('parent_packing_list_id', '=', False)]}">
                                <list string="Packing List Line" create="0" editable="bottom" order="sequence">
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" column_invisible="True"/>
                                    <field name="is_split" column_invisible="True"/>
                                    <field name="lines_locked" column_invisible="True"/>
                                    <field name="is_checked" readonly="is_split" invisible="is_split"/>
                                    <button icon="fa-copy" decoration-warning="True" type="object" name="pll_duplicate" confirm="Are you sure to duplicate this line ?" invisible="lines_locked"/>
                                    <field name="name" widget="section_and_note_text" string="Description" optional="show"/>
                                    <field name="vendor_pl" string="Vendor PL" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="vendor_po_no" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="inventory_site" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="partner_id" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="order_id" readonly="1" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="order_ref" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="selectable_order_line_ids" column_invisible="True"/>
                                    <field name="order_line_id" readonly="lines_locked" options="{'no_create':true}" domain="[('id', 'in', selectable_order_line_ids)]" required="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="product_id" readonly="1" string="P/N" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="order_line_id_ref" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="product_tmpl_id" optional="hide" readonly="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="customer_number" optional="show" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="description_text" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="name" column_invisible="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="create_date" column_invisible="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="code" column_invisible="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="all_shipped" column_invisible="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="barcode" column_invisible="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="id" column_invisible="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="quantity" readonly="lines_locked" optional="show" string="TOTAL QTY (PCS)" decoration-dark="True" sum="Sum of TOTAL QTY (PCS)" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="order_remaining_qty" optional="show" string="REMAINING QTY (PCS)" decoration-dark="True" sum="Sum of REMAINING QTY (PCS)" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="shipped_quantity" column_invisible="1" decoration-dark="True" sum="Sum of Shipped Quantity" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="order_qty" optional="show" decoration-dark="True" sum="Sum of Order Qty" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="order_delivered_qty" optional="hide" decoration-dark="True" sum="Sum of Order Delivered Qty" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="size" column_invisible="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="ctn_type_id" string="Type CTN" decoration-success="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="qty_per_carton" string="Qty/CTN" optional="show" decoration-success="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="carton_quantity" string="Total CTN(s)" optional="show" decoration-success="True" sum="Sum of Total CTN(s)" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="inner_ctn_qty" string="Total Inner CTN(s)" optional="show" decoration-success="True" sum="Total inners" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="carton_start" string="Start CTN" decoration-success="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="carton_end" string="End CTN" decoration-success="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="product_net_weight" string="Product NW" optional="show" decoration-warning="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="ctn_weight" string="Weight CTN" decoration-warning="True" optional="show" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="gross_weight" optional="show" string="G.W./CTN (KGS)" decoration-warning="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="total_gross_weight" optional="show" string="TOTAL G.W.(KG)" decoration-warning="True" sum="Sum of TOTAL G.W.(KG)" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="net_weight" optional="hide" decoration-warning="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="total_net_weight" optional="show" decoration-warning="True" sum="Sum of Total Net Weight" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="length" string="LENGTH (cm)" optional="show" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="width" string="WIDTH (cm)" optional="show" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="height" string="HEIGHT (cm)" optional="show" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="ctn_cbm" string="CBM CTN" optional="show" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="total_cbm" optional="show" sum="Sum of Total Cbm" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="type_pallet_id" string="Type Pallet" optional="show" decoration-primary="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="pallet_qty" string="Pallet Qty" optional="show" decoration-primary="True" sum="Sum of Pallet Qty" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="pallet_gross_weight" string="Pallet G.W." optional="hide" decoration-primary="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="pallet_net_weight" string="Pallet Weight" optional="show" decoration-primary="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="pallet_length" string="Pallet LENGTH (cm)" optional="show" decoration-primary="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="pallet_width" string="Pallet WIDTH (cm)" optional="show" decoration-primary="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="pallet_height" string="Pallet HEIGHT (cm)" optional="show" decoration-primary="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="pallet_cbm" string="CBM Pallet" optional="show" decoration-primary="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="pallet_total_cbm" string="Pallet Total CBM" optional="show" decoration-primary="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="pallet_description" string="Pallet Description" optional="hide" decoration-primary="True" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="delivery_slip" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="unit_price" optional="show" string="U/P (USD)" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="total_amount" optional="show" string="Total (USD)" sum="Sum of Total (USD)" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="hs_code" optional="show" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="freight_prepaid" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="estimated_freight_cost" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="actual_freight_cost" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="freight_invoiced_customer" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="ship_status" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="tracking" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="active" column_invisible="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="packing_list_id" column_invisible="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="parent_line_id" column_invisible="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="distance_uom_id" column_invisible="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="weight_uom_id" column_invisible="1" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="write_uid" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                    <field name="write_date" optional="hide" decoration-info="(not display_type)" decoration-bf="(not display_type)" />
                                </list>
                            </field>
                        </page>
                        <page string="Tracking">
                            <group>
                                <group>
                                    <field name="loading_ref"/>
                                    <field name="vessel"/>
                                    <field name="container_number"/>
                                    <field name="tracking"/>
                                    <field name="container_information"/>
                                </group>
                                <group>
                                    <field name="tradelink_udr"/>
                                    <field name="shipping_marks"/>
                                    <field name="vendor_pl" string="Vendor PL"/>
                                    <field name="vendor_po_no" string="Vendor PO No"/>
                                    <field name="inventory_site" string="Inventory Site"/>
                                </group>
                            </group>
                        </page>
                        <page string="Freight Charges">
                            <group>
                                <group>
                                    <field name="estimated_freight_cost"/>
                                    <field name="actual_freight_cost"/>
                                    <field name="freight_prepaid" widget="boolean_toggle"/>
                                    <field name="freight_invoiced_customer"/>
                                </group>
                                <group>
                                    <field name="declare" widget="boolean_toggle"/>
                                    <field name="local_charges" widget="boolean_toggle"/>
                                    <field name="mate_receipt" widget="boolean_toggle"/>
                                    <field name="payment_terms_id"/>
                                    <field name="invoice_number"/>
                                    <field name="incoterm"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Child Packing Lists" invisible="child_packing_list_count == 0">
                            <field name="child_packing_list_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="title"/>
                                    <field name="customer"/>
                                    <field name="stage_id"/>
                                    <field name="total_quantity"/>
                                    <field name="line_count" string="Lines"/>
                                </list>
                            </field>
                        </page>
                        <page string="Others">
                            <group>
                                <group>
                                    <field name="number_cartons"/>
                                    <field name="total_nw"/>
                                    <field name="total_quantity"/>
                                    <field name="total_gw"/>
                                    <field name="total_cbm"/>
                                    <field name="total_amount"/>
                                </group>
                                <group>
                                    <field name="active"/>
                                    <field name="create_uid"/>
                                    <field name="write_uid"/>
                                    <field name="sequence"/>
                                    <field name="create_date"/>
                                    <field name="write_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="external_packing_list_list_view" model="ir.ui.view">
        <field name="name">packing.list.list.view</field>
        <field name="model">packing.list</field>
        <field name="arch" type="xml">
            <list string="Packing List">
                <field name="sequence"/>
                <field name="name" invisible="1"/>
                <field name="create_date"  optional="hide"/>
                <field name="code"/>
                <field name="title"/>
                <field name="vendor_pl"/>
                <field name="vendor_po_no"/>
                <field name="customer" />
                <field name="orders" widget="many2many_tags" />
                <field name="loading_ref" optional="hide"/>
                <field name="vessel"  optional="hide"/>
                <field name="container_number"  optional="hide"/>
                <field name="container_information"  optional="hide"/>
                <field name="goods_origin"  optional="hide"/>
                <field name="shipping_marks"  optional="hide"/>
                <field name="invoice_number"  optional="hide"/>
                <field name="active" optional="hide"/>
                <field name="id" optional="hide"/>
                <field name="write_uid" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="date_loading"/>
                <field name="date_departure" />
                <field name="date_arrival"/>
                <field name="stage_lock" widget="boolean_toggle"/>
                <field name="invoice_date" optional="hide"/>
                <field name="total_quantity" optional="hide"/>
                <field name="number_cartons" optional="hide"/>
                <field name="total_gw" optional="hide"/>
                <field name="total_nw" optional="hide"/>
                <field name="total_cbm" optional="hide"/>
                <field name="shipper" options="{'no_create':true}" optional="hide"/>
                <field name="consignee" options="{'no_create':true}" optional="hide"/>
                <field name="incoterm" optional="hide"/>
                <field name="payment_terms_id" optional="hide"/>
                <field name="company_id" options="{'no_create':true}" optional="hide"/>
                <field name="port_from_id" optional="hide"/>
                <field name="port_to_id" optional="hide"/>
                <field name="stage_id"/>
            </list>
        </field>
    </record>

    <record id="external_packing_list_kanban_view" model="ir.ui.view">
        <field name="name">packing.list.kanban.view</field>
        <field name="model">packing.list</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" default_order="priority desc, sequence asc, id desc">
                <progressbar field="kanban_state" colors="{'normal': 'muted', 'done': 'success', 'blocked': 'danger'}" />
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_record_details">
                                <div class="o_kanban_record_top" name="studio_auto_kanban_top">
                                    <div class="o_kanban_record_headings" name="studio_auto_kanban_headings">
                                        <field name="priority" widget="boolean_favorite" nolabel="1" />
                                        <strong class="o_kanban_record_title" name="studio_auto_kanban_title">
                                            <field name="name" />
                                            <field display="full" name="customer" />
                                        </strong>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" data-display="static" href="#" aria-label="Dropdown Menu" title="Dropdown Menu">
                                            <span class="fa fa-ellipsis-v" />
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">Edit
                                            </a>
                                            <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body" name="studio_auto_kanban_body" />
                                <div class="o_kanban_record_bottom" name="studio_auto_kanban_bottom">
                                    <div class="oe_kanban_bottom_left" name="studio_auto_kanban_bottom_left" />
                                    <div class="oe_kanban_bottom_right" name="studio_auto_kanban_bottom_right">
                                        <field name="kanban_state" widget="state_selection" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="packing_list_action" model="ir.actions.act_window">
        <field name="name">Packing List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">packing.list</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Packing List
            </p>
        </field>
    </record>

</odoo>