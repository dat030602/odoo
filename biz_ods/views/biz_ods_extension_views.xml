<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="biz_ods_extension_view_tree" model="ir.ui.view">
        <field name="name">biz.ods.extension.tree</field>
        <field name="model">biz.ods.extension</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="ods_id"/>
                <field name="ods_user_id"/>
            </tree>
        </field>
    </record>

    <record id="biz_ods_extension_view_form" model="ir.ui.view">
        <field name="name">biz.ods.extension.form</field>
        <field name="model">biz.ods.extension</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="ods_id" readonly="1"/>
                            <field name="ods_user_id" options="{'no_create': True}"/>
                            <field name="ods_partner_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="ods_data" password="True" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="biz_ods_extension_action" model="ir.actions.act_window">
        <field name="name">List Extension</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">biz.ods.extension</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>