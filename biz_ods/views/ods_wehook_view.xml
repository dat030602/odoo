<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ods_webhook_view_tree" model="ir.ui.view">
        <field name="name">ods.webhook.tree</field>
        <field name="model">ods.webhook</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="name"/>
                <field name="json_data"/>
            </tree>
        </field>
    </record>

    <record id="ods_webhook_action" model="ir.actions.act_window">
        <field name="name">Webhook</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ods.webhook</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>