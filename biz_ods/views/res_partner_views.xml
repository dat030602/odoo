<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form_inherited_biz_ods" model="ir.ui.view">
        <field name="name">view.partner.form.inherited.biz_ods</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_ods_call_history" type="object" class="oe_stat_button" icon="fa-phone">
                    <field name="ods_history_call_count" widget="statinfo" string="Calls"/>
                </button>
            </div>
            <xpath expr="//field[@name='website']" position="before">
                <field name="ods_number_extension" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>