<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="biz_ods_call_history_view_tree" model="ir.ui.view">
        <field name="name">biz.ods.call.history.tree</field>
        <field name="model">biz.ods.call.history</field>
        <field name="arch" type="xml">
            <tree default_order='ods_call_date desc'>
                <field name="ods_key" optional="show"/>
                <field name="ods_head_number" optional="hide"/>
                <field name="ods_call_date" optional="show"/>
                <field name="caller_name" optional="hide"/>
                <field name="caller_user_id" optional="hide"/>
                <field name="ods_caller_number" optional="show"/>
                <field name="receive_name" optional="hide"/>
                <field name="receive_user_id" optional="hide"/>
                <field name="ods_receive_number" optional="show"/>
                <field name="recording_data" optional="show" filename="recording_name" widget="binary_audio" readonly="1"/>
                <field name="ods_status" optional="show"/>
                <field name="ods_type_call" optional="show"/>
                <field name="ods_call_only_date" optional="hide"/>
                <field name="ods_real_call_time" optional="show"/>
                <field name="ods_total_call_time" optional="hide"/>
                <field name="call_content" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="biz_ods_call_history_view_form" model="ir.ui.view">
        <field name="name">biz.ods.call.history.form</field>
        <field name="model">biz.ods.call.history</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_download_ods_link_file" string="Download Recording" type="object" class="oe_stat_button"/>
                </header>
                <sheet>
                    <div class="oe_title mb8">
                        <label for="ods_key"/>
                        <h1 class="o_row">
                            <field name="ods_key"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ods_head_number"/>
                            <field name="ods_caller_number"/>
                            <field name="caller_name"/>
                            <field name="caller_partner_id"/>
                            <field name="caller_user_id"/>
                            <field name="ods_receive_group"/>
                            <field name="ods_receive_number"/>
                            <field name="receive_name"/>
                            <field name="receive_partner_id"/>
                            <field name="receive_user_id"/>
                            <field name="recording_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="ods_call_only_date" readonly="1"/>
                            <field name="ods_call_date"/>
                            <field name="ods_type_call"/>
                            <field name="ods_status" readonly="1"/>
                            <field name="ods_real_call_time" readonly="1"/>
                            <field name="ods_total_call_time" readonly="1"/>
                            <field name="ods_link_file" widget="url"/>
                            <field name="recording_data" filename="recording_name" widget="binary_audio" readonly="1"/>
                            <field name="recording_file_id"/>
                            <field name="call_content"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="biz_ods_call_history_view_search" model="ir.ui.view">
        <field name="name">biz.ods.call.history.search</field>
        <field name="model">biz.ods.call.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="ods_key"/>
                <field name="ods_type_call"/>
                <field name="ods_caller_number"/>
                <field name="ods_receive_number"/>
                <field name="caller_user_id"/>
                <field name="receive_user_id"/>
                <field name="ods_call_date" invisible="1"/>
                <field name="ods_type_call" invisible="1"/>
                <field name="ods_status" invisible="1"/>
                <field name="ods_head_number" invisible="1"/>
                <field name="caller_user_id" invisible="1"/>
                <field name="receive_user_id" invisible="1"/>
                <field name="recording_file_id" invisible="1"/>
                <filter name="filter_today" string="Today" domain="[('ods_call_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('ods_call_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="filter_yesterday" string="Yesterday" domain="[('ods_call_date', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')), ('ods_call_date', '&lt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="filter_month" string="Month" date="ods_call_date" default_period="this_year,this_month"/>
                <separator/>
                <filter name="filter_answered" string="Answer" domain="[('ods_status', '=', 'answered')]"/>
                <filter name="filter_no_answer" string="No Answer" domain="[('ods_status', '=', 'no_answer')]"/>
                <filter name="filter_busy" string="Busy" domain="[('ods_status', '=', 'busy')]"/>
                <filter name="filter_failed" string="Failed" domain="[('ods_status', '=', 'failed')]"/>
                <separator/>
                <filter name="filter_inbound" string="Inbound" domain="[('ods_type_call', '=', 'inbound')]"/>
                <filter name="filter_outbound" string="Outbound" domain="[('ods_type_call', '=', 'outbound')]"/>
                <filter name="filter_local" string="Local" domain="[('ods_type_call', '=', 'local')]"/>
                <separator/>
                <filter name="filter_recording_file" string="Recording file" domain="[('recording_file_id', '!=', False)]"/>
                <filter name="filter_no_recording_file" string="No recording file" domain="[('recording_file_id', '=', False)]"/>
                <group expand="1" string="Group by">
                    <filter string="Call Date" name="group_call_date" context="{'group_by':'ods_call_date'}"/>
                    <filter string="Head Number" name="group_head_number" context="{'group_by':'ods_head_number'}"/>
                    <filter string="Type Call" name="group_type_call" context="{'group_by':'ods_type_call'}"/>
                    <filter string="Status" name="group_status" context="{'group_by':'ods_status'}"/>
                    <separator/>
                    <filter string="Saleperson Outbound" name="group_saleperson_outbound" domain="[('ods_type_call', '=', 'outbound')]" context="{'group_by':'caller_user_id'}"/>
                    <filter string="Saleperson Inbound" name="group_saleperson_inbound" domain="[('ods_type_call', '=', 'inbound')]" context="{'group_by':'receive_user_id'}"/>
                    <separator/>
                    <filter string="Recording File" name="group_recording_file" domain="[]" context="{'group_by':'recording_file_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="biz_ods_call_history_view_pivot" model="ir.ui.view">
        <field name="name">biz.ods.call.history.pivot</field>
        <field name="model">biz.ods.call.history</field>
        <field name="arch" type="xml">
            <pivot string="Call History" sample="1">
                <field name="ods_status" type="row"/>
                <field name="ods_total_call_time"/>
                <field name="ods_real_call_time"/>
            </pivot>
        </field>
    </record>

    <record id="biz_ods_call_history_view_graph" model="ir.ui.view">
        <field name="name">biz.ods.call.history.graph</field>
        <field name="model">biz.ods.call.history</field>
        <field name="arch" type="xml">
            <graph string="Call History" type="bar" sample="1">
                <field name="ods_status"/>
            </graph>
        </field>
    </record>

    <record id="biz_ods_call_history_action" model="ir.actions.act_window">
        <field name="name">Call History</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">biz.ods.call.history</field>
        <field name="view_mode">tree,pivot,graph,form</field>
    </record>

    <record id="biz_ods_call_history_partner_action" model="ir.actions.act_window">
        <field name="name">Call History</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">biz.ods.call.history</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
    </record>
</odoo>