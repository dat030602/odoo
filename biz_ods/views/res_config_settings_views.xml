<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
         <record id="res_config_settings_view_form_inherited_biz_ods" model="ir.ui.view">
	        <field name="name">res.config.settings.form.inherited.biz.ods</field>
	        <field name="model">res.config.settings</field>
	        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
	        <field name="arch" type="xml">
                <xpath expr="//field[@name='module_voip']/../.." position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
	        	<xpath expr="//div[hasclass('settings')]" position="inside">
					<div class="app_settings_block" data-string="ODS" string="ODS" data-key="biz_ods">
						<h2>ODS</h2>
						<div class="row mt16 o_settings_container">
                            <div class="col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                </div>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">
                                        Connect ODS
                                    </span>
                                    <div class="text-muted" title="">
                                        Network Information API
                                    </div>
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label for="ods_service_name" class="col-lg-3 o_light_label"/>
                                            <field name="ods_service_name" class="col-lg-2 p-0"/>
                                        </div>
                                        <div class="row mt2">
                                            <label for="ods_auth_user" class="col-lg-3 o_light_label"/>
                                            <field name="ods_auth_user" class="col-lg-2 p-0"/>
                                        </div>
                                        <div class="row mt2">
                                            <label for="ods_auth_key" class="col-lg-3 o_light_label"/>
                                            <field name="ods_auth_key" class="col-lg-2 p-0"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="module_voip" widget="upgrade_boolean"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="module_voip"/>
                                    <div class="text-muted">
                                        Schedule &amp; make calls from your database
                                    </div>
                                    <div class="content-group" attrs="{'invisible': [('module_voip','=',False)]}">
                                        <div class="row mt16">
                                            <label for="pbx_ip" class="col-4 col-lg-4 o_light_label"/>
                                            <field name="pbx_ip" nolabel="1"/>
                                            <label for="wsServer" class="col-4 col-lg-4 o_light_label"/>
                                            <field name="wsServer" nolabel="1"/>
                                            <label for="mode" class="col-4 col-lg-4 o_light_label"/>
                                            <field name="mode" nolabel="1"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
<!--                            <div class="col-12 col-lg-6 o_setting_box">-->
<!--                                <div class="o_setting_left_pane">-->
<!--                                </div>-->
<!--                                <div class="o_setting_right_pane">-->
<!--                                    <span class="o_form_label">-->
<!--                                        Call History-->
<!--                                    </span>-->
<!--                                    <div class="text-muted" title="">-->
<!--                                        Get detailed call history by date and time-->
<!--                                    </div>-->
<!--                                    <div class="content-group">-->
<!--                                        <div class="row mt16">-->
<!--                                            <label for="ods_from_datetime" class="col-lg-3 o_light_label"/>-->
<!--                                            <field name="ods_from_datetime" class="col-lg-2 p-0"/>-->
<!--                                        </div>-->
<!--                                        <div class="row mt2">-->
<!--                                            <label for="ods_to_datetime" class="col-lg-3 o_light_label"/>-->
<!--                                            <field name="ods_to_datetime" class="col-lg-2 p-0"/>-->
<!--                                        </div>-->
<!--                                    </div>-->
<!--                                </div>-->
<!--                            </div>-->
                        </div>
					</div>
	            </xpath>
	        </field>
	    </record>

	    <record id="action_biz_ods_configuration" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'biz_ods', 'bin_size': False}</field>
        </record>
    </data>
</odoo>
