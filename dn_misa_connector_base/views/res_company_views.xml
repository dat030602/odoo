<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_misa" model="ir.ui.view">
        <field name="name">res.company.form.misa.connector</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="MISA Connector" name="misa_connector_config">
                    <group>
                        <group string="Shared Credentials">
                            <field name="misa_tax_code"/>
                            <field name="misa_username"/>
                            <field name="misa_password" password="True"/>
                            <field name="misa_client_id"/>
                            <field name="misa_client_secret" password="True"/>
                            <field name="misa_device_id"/>
                        </group>
                        <group string="2FA Verification">
                            <field name="misa_meinvoice_user_id" readonly="1"/>
                            <label for="misa_otp_code" string="OTP Code"/>
                            <div class="o_row">
                                <field name="misa_otp_code" placeholder="Enter OTP code..."/>
                                <button name="action_verify_meinvoice_2fa" string="Verify 2FA" type="object" class="btn-secondary"/>
                            </div>
                        </group>
                    </group>

                    <group>
                        <group string="meInvoice Configuration (e-Invoice Publishing)">
                            <field name="misa_meinvoice_base_url"/>
                            <field name="misa_meinvoice_token" readonly="1" password="True"/>
                            <field name="misa_meinvoice_token_draft" readonly="1" password="True"/>
                            <field name="misa_meinvoice_token_expiry" readonly="1"/>
                            <div>
                                <button name="action_test_meinvoice_connection" string="Test meInvoice Connection" type="object" class="btn-primary me-2"/>
                                <button name="action_refresh_meinvoice_token" string="Refresh Token" type="object" class="btn-secondary"/>
                            </div>
                        </group>
                        <group string="INBOT Configuration (Input / Output Invoices)">
                            <field name="misa_inbot_base_url"/>
                            <field name="misa_inbot_subscribers_id"/>
                            <field name="misa_inbot_jwt_token" readonly="1" password="True"/>
                            <field name="misa_inbot_token_expiry" readonly="1"/>
                            <div>
                                <button name="action_test_inbot_connection" string="Test INBOT Connection" type="object" class="btn-primary me-2"/>
                                <button name="action_sync_inbot_subscribers_and_organizations" string="Sync Organizations" type="object" class="btn-secondary"/>
                            </div>
                        </group>
                    </group>

                    <group string="INBOT Quota &amp; Subscription Monitoring">
                        <group>
                            <field name="misa_inbot_product_pack_code"/>
                            <field name="misa_inbot_pack_status"/>
                            <field name="misa_inbot_pack_start_date"/>
                            <field name="misa_inbot_pack_expired_date"/>
                        </group>
                        <group>
                            <field name="misa_inbot_number_of_invoice"/>
                            <field name="misa_inbot_number_inv_used"/>
                            <field name="misa_inbot_number_inv_still"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
