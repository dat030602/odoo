<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_misa_organization_tree" model="ir.ui.view">
        <field name="name">misa.organization.list</field>
        <field name="model">misa.organization</field>
        <field name="arch" type="xml">
            <list string="MISA Organizations">
                <field name="org_code"/>
                <field name="org_name"/>
                <field name="org_id"/>
                <field name="parent_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="number_of_invoice"/>
                <field name="number_inv_used"/>
                <field name="number_inv_still"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_misa_organization_form" model="ir.ui.view">
        <field name="name">misa.organization.form</field>
        <field name="model">misa.organization</field>
        <field name="arch" type="xml">
            <form string="MISA Organization">
                <sheet>
                    <div class="oe_title">
                        <label for="org_name" class="oe_edit_only"/>
                        <h1><field name="org_name" placeholder="Department / Branch Name"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="org_code"/>
                            <field name="org_id" readonly="1"/>
                            <field name="parent_id"/>
                            <field name="parent_org_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Subscription Quota">
                            <field name="product_pack_code"/>
                            <field name="status"/>
                            <field name="start_date"/>
                            <field name="expired_date"/>
                            <field name="number_of_invoice"/>
                            <field name="number_inv_used"/>
                            <field name="number_inv_still"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_misa_organization_search" model="ir.ui.view">
        <field name="name">misa.organization.search</field>
        <field name="model">misa.organization</field>
        <field name="arch" type="xml">
            <search string="Search Organizations">
                <field name="org_name"/>
                <field name="org_code"/>
                <field name="org_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_by_company" domain="[]" context="{'group_by': 'company_id'}"/>
                    <filter string="Parent Organization" name="group_by_parent" domain="[]" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_misa_organization" model="ir.actions.act_window">
        <field name="name">MISA Organizations</field>
        <field name="res_model">misa.organization</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_misa_organization_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No MISA Organizations found.
            </p>
            <p>
                Click "Sync Organizations" from Company Settings to synchronize your organizational structure from MISA INBOT.
            </p>
        </field>
    </record>

    <!-- Top Menu for MISA Integration -->
    <menuitem id="menu_misa_root" name="MISA Integration" sequence="70" web_icon="dn_misa_connector_base,static/description/icon.png"/>
    <menuitem id="menu_misa_configuration" name="Configuration" parent="menu_misa_root" sequence="100"/>
    <menuitem id="menu_misa_organization" name="Organizations" parent="menu_misa_configuration" action="action_misa_organization" sequence="10"/>
</odoo>
