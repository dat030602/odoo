<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_misa_queue_job_tree" model="ir.ui.view">
        <field name="name">misa.queue.job.list</field>
        <field name="model">misa.queue.job</field>
        <field name="arch" type="xml">
            <list string="Queue Jobs" decoration-info="state == 'queued'" decoration-warning="state in ['processing', 'retry']" decoration-success="state == 'done'" decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="create_date" string="Created"/>
                <field name="inv_series"/>
                <field name="service_type"/>
                <field name="action_type"/>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="retry_count"/>
                <field name="next_retry_time"/>
                <field name="state" widget="badge" decoration-info="state == 'queued'" decoration-warning="state in ['processing', 'retry']" decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_misa_queue_job_form" model="ir.ui.view">
        <field name="name">misa.queue.job.form</field>
        <field name="model">misa.queue.job</field>
        <field name="arch" type="xml">
            <form string="MISA Queue Job">
                <header>
                    <button name="action_retry" string="Retry Now" type="object" invisible="state not in ['failed', 'retry']" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,processing,done,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Job Specifications">
                            <field name="inv_series"/>
                            <field name="service_type"/>
                            <field name="action_type"/>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Execution Status">
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                            <field name="next_retry_time"/>
                            <field name="create_date" string="Created On" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Error Log" invisible="not error_message">
                            <field name="error_message" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_misa_queue_job_search" model="ir.ui.view">
        <field name="name">misa.queue.job.search</field>
        <field name="model">misa.queue.job</field>
        <field name="arch" type="xml">
            <search string="Search Queue Jobs">
                <field name="name"/>
                <field name="inv_series"/>
                <field name="model_name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter string="Pending / Queued" name="pending" domain="[('state', 'in', ['queued', 'retry'])]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Completed" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Series" name="group_by_series" domain="[]" context="{'group_by': 'inv_series'}"/>
                    <filter string="Action" name="group_by_action" domain="[]" context="{'group_by': 'action_type'}"/>
                    <filter string="Company" name="group_by_company" domain="[]" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_misa_queue_job" model="ir.actions.act_window">
        <field name="name">Queue Jobs</field>
        <field name="res_model">misa.queue.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_misa_queue_job_search"/>
    </record>

    <menuitem id="menu_misa_queue_job" name="Queue Jobs" parent="menu_misa_root" action="action_misa_queue_job" sequence="80"/>
</odoo>
