<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_credit_viewer" model="res.groups">
        <field name="name">Credit Viewer</field>
    </record>
    <record id="group_credit_approver" model="res.groups">
        <field name="name">Credit Approver</field>
        <field name="implied_ids" eval="[(4, ref('group_credit_viewer'))]"/>
    </record>
    <record id="group_credit_admin" model="res.groups">
        <field name="name">Credit Admin</field>
        <field name="implied_ids" eval="[(4, ref('group_credit_approver'))]"/>
    </record>
</odoo>
