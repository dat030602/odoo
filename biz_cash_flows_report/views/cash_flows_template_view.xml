<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
        <record id="view_cash_flows_template_tree" model="ir.ui.view">
            <field name="name">cash.flows.template.tree</field>
            <field name="model">cash.flows.template</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                </tree>
            </field>
        </record>

		<record id="view_cash_flows_template_form" model="ir.ui.view">
            <field name="name">cash.flows.template.form</field>
            <field name="model">cash.flows.template</field>
            <field name="arch" type="xml">
              	<form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="template_type" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="cash_flows_ids" nolabel="1" colspan="2">
                                <tree>
                                    <field name="categ_name"/>
                                    <field name="code"/>
                                </tree>
                            </field>
                        </group>
                        <group>
                            <field name="line_ids" nolabel="1" colspan="2" invisible="1">
                                <tree editable="bottom">
                                    <field name="domain_balance" invisible="1"/>
                                    <field name="balance_id"/>
                                    <field name="code"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
      	</record>

        <record id="action_cash_flows_template" model="ir.actions.act_window">
            <field name="name">Cash flows template</field>
            <field name="res_model">cash.flows.template</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>