<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="cash_flow_comp_rule" model="ir.rule">
            <field name="name">Cash flow multi company rule</field>
            <field name="model_id" ref="model_cash_flows"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

        <record id="statements_cash_flows_report_comp_rule" model="ir.rule">
            <field name="name">Statements cash flows report multi company rule</field>
            <field name="model_id" ref="model_statements_cash_flows_report"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>