<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="view_move_form_other_business" model="ir.ui.view">
		<field name="name">account.move.form</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<group name="misc_group" position="inside">
				<field name="note" attrs="{'readonly': [('state', '=', 'posted')]}" />
				<field name="creator_id" attrs="{'readonly': [('state', '=', 'posted')]}" />
				<field name="chief_id" attrs="{'readonly': [('state', '=', 'posted')]}" />
				<field name="unit_head_id" attrs="{'readonly': [('state', '=', 'posted')]}" />
			</group>
		</field>
	</record>
</odoo>