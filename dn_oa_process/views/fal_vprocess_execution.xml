<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="fal_vprocess_execution_tree_view">
        <field name="name">fal_vprocess_execution.tree</field>
        <field name="model">fal.vprocess.execution</field>
        <field name="arch" type="xml">
          <list string="fal.vprocess.execution">
            <field name="name"/>
            <field name="process_id" optional="hide"/>
            <field name="process_model"/>
            <field name="target"/>
            <field name="step_id" optional="show"/>
            <field name="finished" optional="show"/>
            <field name="cancelled" optional="show"/>
          </list>
        </field>
    </record>
    <record model="ir.ui.view" id="fal_vprocess_execution_form_view">
        <field name="name">fal_vprocess_execution.form</field>
        <field name="model">fal.vprocess.execution</field>
        <field name="arch" type="xml">
          <form>
            <sheet string="fal.vprocess.execution">
            <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True" />
              <div class="oe_title">
                <h1>
                  <field name="name" required="1"/>
                </h1>
              </div>
              <group name="main_group">
                <group name="group_left">
                  <field name="process_id"/>
                  <field name="process_model"/>
                  <field name="target"/>
                  <field name="step_id"/>
                  <field name="step_sequence"/>
                  <field name="previous_step_id"/>
                  <field name="last_action"/>
                </group>
                <group name="group_right">
                  <field name="finished"/>
                  <field name="cancelled"/>
                </group>
              </group>
            </sheet>
            <chatter/>
          </form>
        </field>
    </record>

    <record id="fal_vprocess_execution_search_view" model="ir.ui.view">
        <field name="name">fal_vprocess_execution.search</field>
        <field name="model">fal.vprocess.execution</field>
        <field name="arch" type="xml">
            <search string="fal.vprocess.execution">
                <field name="name" />
                <field name="process_id"/>
                <field name="process_model"/>
                <field name="step_id"/>
                <field name="previous_step_id"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Process" name="process" domain="[]" context="{'group_by':'process_id'}" />
                    <filter string="Process Model" name="process_model" domain="[]" context="{'group_by':'process_model'}" />
                    <filter string="Step" name="step_id" domain="[]" context="{'group_by':'step_id'}" />
                    <filter string="Previous Step" name="previous_step_id" domain="[]" context="{'group_by':'previous_step_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_vprocess_execution" model="ir.actions.act_window">
        <field name="name">Executions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fal.vprocess.execution</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_vprocess_execution" name="Executions" parent="menu_validation_process" action="action_vprocess_execution"/>
</odoo>
